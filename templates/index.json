                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_TAPFxf"
              ]
            },
            "accordion_row_P9ABDr": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "¿Que coste tiene Gunloupe?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_pAn8nx": {
                  "type": "text",
                  "settings": {
                    "text": "Registrarse y usar Gunloupe no tiene ningún coste para el usuario ni para las armerías. Es un servicio gratuito que pretende facilitar el intercambio entre particulares y profesionales en un entorno profesional y seguro.",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",

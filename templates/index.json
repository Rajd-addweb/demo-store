            "accordion_row_Q9jJ9Q": {
              "type": "_accordion-row",
              "settings": {
                "heading": "¿Para qué necesito crear una cuenta?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_EHGRky": {
                  "type": "text",
                  "settings": {
                    "text": "La creación de una cuenta te permite tener acceso a todas las funciones de la plataforma y ver las ofertas de las armerías profesionales. Además, la verificación de cuenta nos ayuda a mantener un entorno seguro y confiable para todos los usuarios.",
                    "width": "100%",

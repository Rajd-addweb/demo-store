                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "Gunloupe ofrece el catalogo mas completo y extenso de armas, donde podrás encontrar toda la información necesaria para poder buscar y comparar las armas que quieras.",
                    "width": "100%",
                    "max_width": "none",

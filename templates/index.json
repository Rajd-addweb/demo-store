          },
          "blocks": {
            "accordion_row_XWFcn3": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "¿Qué es Gunloupe?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_yxF9ik": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "Gunloupe es un motor de búsqueda especializado en armas de caza y tiro que permite a cazadores, tiradores deportivos y profesionales del sector buscar, filtrar, comparar y localizar armas disponibles en el mercado, todas ellas publicadas por armerías profesionales. Nuestra misión es proporcionar un entorno seguro parala compraventa de armas entre particulares y profesionales en cumplimiento dela legislación vigente y de los procedimientos establecidos por las autoridades competentes.",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
                    "background": false,
                    "background_color": "#00000026",
                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_yxF9ik"
              ]
            },
            "accordion_row_QMQphU": {
              "type": "_accordion-row",
              "name": "t:names.accordion_row",
              "settings": {
                "heading": "¿Qué ventajas ofrece Gunloupe?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_TAPFxf": {
                  "type": "text",
                  "settings": {
                    "text": "A los usuarios les ayuda a poder buscar, filtrar,comparar, ver reviews y elegir el arma que cumpla sus necesidades y poder elegir entre las ofertas de las armerías profesionales que anuncien sus productos en Gunloupe. De esa manera el usuario esta comprando en un entorno seguro,a profesionales de confianza y productos revisados por profesionales. A las armerías profesionales Gunloupe les ofrece un entorno profesional, con un catalogo muy extenso donde poder dar publicidad a sus productos a unos usuarios con una misma afición: las armas para la caza y el tiro.",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "1rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",

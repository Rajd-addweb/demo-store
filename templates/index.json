            "accordion_row_yhPUKU": {
              "type": "_accordion-row",
              "settings": {
                "heading": "¿Cómo puedo contactar con vosotros?",
                "open_by_default": false,
                "icon": "none",
                "width": 50
              },
              "blocks": {
                "text_Y3xUMM": {
                  "type": "text",
                  "settings": {
                    "text": "Puedes contactar con nuestro equipo de soporte a través del formulario en nuestra web o enviando un email info@gunloupe.com . Estamos disponibles para ayudarte con cualquier duda sobre el uso de la plataforma, problemas técnicos o consultas sobre el proceso de compraventa.",

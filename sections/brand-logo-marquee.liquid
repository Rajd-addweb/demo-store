<div class="container">
    <section class="brand-marquee">
        <div class="brand-marquee__track">
          <!-- First set -->
          <div class="brand-marquee__group">
            {% for block in section.blocks %}
              <div class="brand-item">
                  {% if block.settings.logo != blank %}
                      {{
                          block.settings.logo
                          | image_url: width: 400
                          | image_tag:
                          loading: 'lazy',
                          widths: '200,300,400',
                          sizes: '(max-width: 768px) 160px, 220px',
                          class: 'brand-logo'
                      }}
                  {% endif %}
              </div>
            {% endfor %}
          </div>
      
          <!-- Duplicate set for seamless loop -->
          <div class="brand-marquee__group">
            {% for block in section.blocks %}
              <div class="brand-item">
                  {% if block.settings.logo != blank %}
                      {{
                          block.settings.logo
                          | image_url: width: 400
                          | image_tag:
                          loading: 'lazy',
                          widths: '200,300,400',
                          sizes: '(max-width: 768px) 160px, 220px',
                          class: 'brand-logo'
                      }}
                  {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="clients-markee_overlay-wrap">
          <div class="clients-markee_overlay-fade"></div>
          <div class="clients-markee_overlay-fade is-right"></div>
        </div>
    </section>
</div>

<style>
.brand-marquee {
  overflow: hidden;
  background: #f3f4f3;
  padding: 30px 32px;
  position: relative;
  margin-bottom: 24px;
}

.brand-marquee__track {
  display: flex;
  width: max-content;
  animation: brand-scroll 25s linear infinite;
}

.brand-marquee:hover .brand-marquee__track {
  animation-play-state: paused;
}

.brand-marquee__group {
  display: flex;
}

.brand-item {
  min-width: 220px;
  height: 110px;
  margin: 0 18px;
  background: white;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}

.brand-item img {
  max-width: 160px;
  max-height: 70px;
  object-fit: contain;
  filter: grayscale(100%);
  opacity: 0.8;
  transition: all .3s ease;
}

.brand-item:hover img {
  filter: grayscale(0);
  opacity: 1;
}

.clients-markee_overlay-wrap {
  flex-flow: wrap;
  place-content: stretch space-between;
  align-items: stretch;
  display: flex;
  z-index: 2;
  pointer-events: none;
  position: absolute;
  inset: 0%;
}

.clients-markee_overlay-wrap .clients-markee_overlay-fade {
  background-image: linear-gradient(90deg, #f3f4f3 20%, transparent);
  width: 4rem;
}

.clients-markee_overlay-wrap .clients-markee_overlay-fade.is-right {
  background-image: linear-gradient(275deg, #f3f4f3 20%, transparent);
}

@keyframes brand-scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

/* Responsive */
@media (max-width: 768px) {
  .brand-item {
    min-width: 160px;
    height: 90px;
  }
}
</style>

{% schema %}
{
  "name": "Brand Logo Marquee",
  "max_blocks": 20,
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Logo Marquee"
    }
  ]
}
{% endschema %}

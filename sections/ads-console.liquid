{% comment %}
section.ads-console.liquid
Gunloupe — Admin Ads Console
Access restricted to admin emails defined in ADMIN_EMAILS array
{% endcomment %}

{% comment %} ── ADMIN EMAIL WHITELIST — add/remove emails here ── {% endcomment %}
{% assign admin_emails = "dharmit.f@addwebsolution.in,jota@ctd.io,abertrand@gunloupe.com" | split: "," %}
{% assign is_admin = false %}
{% if customer %}
{% for email in admin_emails %}
{% if customer.email == email %}
{% assign is_admin = true %}
{% endif %}
{% endfor %}
{% endif %}

{% if is_admin %}

<section class="ads-console-section"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">

  <div class="container">

    <!-- HEADER -->
    <div class="ac-header">
      <div class="ac-header__left">
      </div>
      <div class="ac-header__right">
        <span class="ac-admin-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
          {{ "custom.admin" | t }}
        </span>
      </div>
    </div>

    <!-- TOOLBAR -->
    <div class="ac-toolbar">
      <div class="ac-toolbar__left">
        <span class="ac-toolbar__label">{{ "custom.filter_by" | t}}:</span>
        <div class="ac-filter-dropdown-wrap" id="ac-filter-dropdown-wrap">
          <button class="ac-filter-trigger" id="ac-filter-trigger" type="button">
            <span id="ac-filter-label">{{ "custom.all" | t }}</span>
            {% render 'icon-arrowdown' %}
          </button>
          <div class="ac-filter-popover" id="ac-filter-popover">
            <div class="ac-filter-popover__header">
              <span class="ac-filter-popover__title">{{ 'custom.filter_by_status' | t }}</span>
              <button class="ac-filter-popover__clear" id="ac-filter-clear" type="button"></button>
            </div>
            <ul class="ac-filter-list">
              <li class="ac-filter-item">
                <label class="ac-filter-item__label">
                  <input type="checkbox" class="ac-filter-check" value="pending">
                  <span class="ac-filter-item__dot pending"></span>
                  {{ 'custom.under_review' | t }}
                </label>
              </li>
              <li class="ac-filter-item">
                <label class="ac-filter-item__label">
                  <input type="checkbox" class="ac-filter-check" value="published">
                  <span class="ac-filter-item__dot published"></span>
                  {{ 'custom.published' | t }}
                </label>
              </li>
              <li class="ac-filter-item">
                <label class="ac-filter-item__label">
                  <input type="checkbox" class="ac-filter-check" value="rejected">
                  <span class="ac-filter-item__dot rejected"></span>
                  {{ 'custom.status_rejected' | t }}
                </label>
              </li>
              <li class="ac-filter-item">
                <label class="ac-filter-item__label">
                  <input type="checkbox" class="ac-filter-check" value="archived">
                  <span class="ac-filter-item__dot archived"></span>
                  {{ 'custom.archived' | t }}
                </label>
              </li>
              <li class="ac-filter-item">
                <label class="ac-filter-item__label">
                  <input type="checkbox" class="ac-filter-check" value="sold">
                  <span class="ac-filter-item__dot sold"></span>
                  {{ 'custom.sold' | t }}
                </label>
              </li>
              <li class="ac-filter-item">
                <label class="ac-filter-item__label">
                  <input type="checkbox" class="ac-filter-check" value="deleted">
                  <span class="ac-filter-item__dot deleted"></span>
                  {{ 'custom.deleted' | t }}
                </label>
              </li>
            </ul>
          </div>
        </div>
        <button class="button ac-btn-apply" id="ac-apply" type="button">{{ 'custom.apply' | t }}</button>
        <button class="ac-btn-reset" id="ac-reset">{{ 'custom.reset_all' | t }}</button>
      </div>
      <div class="ac-toolbar__right">
        <select class="ac-sort-select" id="ac-sort">
          <option value="date_desc">{{ "custom.date" | t}} ({{ 'custom.newest' | t }})</option>
          <option value="date_asc">{{ "custom.date" | t}} ({{ 'custom.oldest' | t }})</option>
          <option value="name_asc">{{ 'custom.seller_name' | t }} A–Z</option>
          <option value="name_desc">{{ 'custom.seller_name' | t }} Z–A</option>
        </select>
        {% render 'icon-arrowdown' %}
      </div>
    </div>

    <!-- STATS BAR -->
    <div class="ac-stats-bar" id="ac-stats-bar">
      <div class="ac-stat-pill ac-stat-pill--all" data-filter="all">
        <span class="ac-stat-pill__dot all"></span>
        {{ 'custom.all' | t }}
      </div>
      <div class="ac-stat-pill" data-filter="pending">
        <span class="ac-stat-pill__dot pending"></span>
        <span id="stat-pending">0</span> {{ 'custom.under_review' | t }}
      </div>
      <div class="ac-stat-pill" data-filter="published">
        <span class="ac-stat-pill__dot published"></span>
        <span id="stat-published">0</span> {{ 'custom.published' | t }}
      </div>
      <div class="ac-stat-pill" data-filter="rejected">
        <span class="ac-stat-pill__dot rejected"></span>
        <span id="stat-rejected">0</span> {{ 'custom.status_rejected' | t }}
      </div>
      <div class="ac-stat-pill" data-filter="archived">
        <span class="ac-stat-pill__dot archived"></span>
        <span id="stat-archived">0</span> {{ 'custom.archived' | t }}
      </div>
      <div class="ac-stat-pill" data-filter="sold">
        <span class="ac-stat-pill__dot sold"></span>
        <span id="stat-sold">0</span> {{ 'custom.sold' | t }}
      </div>
      <div class="ac-stat-pill" data-filter="deleted">
        <span class="ac-stat-pill__dot deleted"></span>
        <span id="stat-deleted">0</span> {{ 'custom.deleted' | t }}
      </div>
    </div>

    <!-- LOADING -->
    <div class="ac-loading" id="ac-loading">
      <div class="ac-spinner"></div>
      <p>{{ 'custom.loading_ads' | t }}...</p>
    </div>

    <!-- EMPTY -->
    <div class="ac-empty" id="ac-empty" style="display:none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <p>{{ 'custom.no_ads_found' | t }}</p>
    </div>

    <!-- TABLE -->
    <div class="ac-table-wrap" id="ac-table-wrap" style="display:none;">
      <table class="ac-table">
        <thead>
          <tr>
            <th class="ac-th ac-th--img img-wrapper">{{ 'custom.image' | t }}</th>
            <th class="ac-th wapon-name">{{ 'custom.advert_title' | t }}</th>
            <th class="ac-th seller-name">{{ 'custom.seller' | t }}</th>
            <th class="ac-th city-name">{{ 'custom.city' | t }}</th>
            <th class="ac-th wapon-price">{{ 'custom.price' | t }}</th>
            <th class="ac-th date">{{ 'custom.posted_on' | t }}</th>
            <th class="ac-th status">{{ 'custom.status' | t }}</th>
            <th class="ac-th btn-title">{{ 'custom.action' | t }}</th>
          </tr>
        </thead>
        <tbody id="ac-tbody"></tbody>
      </table>
    </div>

    <!-- PAGINATION -->
    <div class="ac-pagination" id="ac-pagination" style="display:none;">
      <button class="ac-page-btn" id="ac-prev-page">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
      <div class="ac-page-numbers" id="ac-page-numbers"></div>
      <button class="ac-page-btn" id="ac-next-page">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
    </div>

  </div>
</section>

<!-- REASON MODAL -->
<div class="ac-modal-overlay" id="ac-reason-modal" style="display:none;">
  <div class="ac-modal">
    <div class="ac-modal__header">
      <h3 class="ac-modal__title" id="ac-reason-modal-title">{{ 'custom.reject_ad' | t }}</h3>
      <button class="ac-modal__close" id="ac-reason-modal-close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
    <div class="ac-modal__body">
      <div class="ac-modal__ad-info" id="ac-reason-modal-ad-info"></div>
      <label class="ac-modal__label" id="ac-reason-modal-label">{{ 'custom.rejection_reason' | t }} <span
          class="ac-required">*</span></label>
      <textarea class="ac-modal__textarea" id="ac-reason-input" rows="4"
        placeholder="{{ 'custom.explain_rejection' | t }}..."></textarea>
      <div class="ac-modal__error" id="ac-reason-error" style="display:none;">{{ 'custom.provide_reason' | t }}</div>
    </div>
    <div class="ac-modal__footer">
      <button class="button is-small button-secondary ac-modal__btn-cancel" id="ac-reason-cancel">{{ 'custom.cancel' | t }}</button>
      <button class="button is-small bg-color-orange ac-modal__btn-confirm" id="ac-reason-confirm">{{ 'custom.confirm' | t }}</button>
    </div>
  </div>
</div>

<!-- ── CUSTOM CONFIRM POPUP (matches my-adverts style) ──────────────────── -->
<div class="delete-confirm-overlay" id="ac-customConfirmOverlay" style="display:none;">
  <div class="delete-confirm-popup">
    <button type="button" class="delete-confirm-close" id="ac-customConfirmClose">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" rx="8" fill="#F3F4F3"/>
        <path d="M7.59961 16.0047C7.59961 12.2355 7.59961 10.3508 8.77058 9.17988C9.94153 8.00891 11.8262 8.00891 15.5954 8.00891C19.3647 8.00891 21.2494 8.00891 22.4203 9.17988C23.5913 10.3508 23.5913 12.2355 23.5913 16.0047C23.5913 19.774 23.5913 21.6587 22.4203 22.8296C21.2494 24.0006 19.3647 24.0006 15.5954 24.0006C11.8262 24.0006 9.94153 24.0006 8.77058 22.8296C7.59961 21.6587 7.59961 19.774 7.59961 16.0047Z" stroke="#295a31" stroke-width="1.19938"/>
        <path d="M17.5931 14.006L13.5957 18.0034M13.5957 14.006L17.5931 18.0034" stroke="#295a31" stroke-width="1.19938" stroke-linecap="round"/>
      </svg>
    </button>
    <p class="delete-confirm-title" id="ac-customConfirmMessage"></p>
    <div class="delete-confirm-actions">
      <button type="button" class="delete-confirm-btn delete-confirm-btn--cancel" id="ac-customConfirmCancel">{{ 'custom.No_cancel' | t }}</button>
      <button type="button" class="delete-confirm-btn delete-confirm-btn--confirm" id="ac-customConfirmYes"></button>
    </div>
  </div>
</div>

<!-- SUCCESS TOAST -->
<div class="ac-toast" id="ac-toast" style="display:none;">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
    <polyline points="20 6 9 17 4 12" />
  </svg>
  <span id="ac-toast-msg">{{ 'custom.done' | t }}!</span>
</div>

<style>
  /* ── Custom Confirm Popup (shared with my-adverts) ── */
  .delete-confirm-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .delete-confirm-popup {
    background: var(--color-background, #fff);
    border-radius: 16px;
    padding: 28px 24px 24px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    position: relative;
    text-align: center;
  }
  .delete-confirm-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.15s;
  }
  .delete-confirm-close:hover { opacity: 1; }
  .delete-confirm-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 8px 0 24px;
    line-height: 1.5;
    padding: 0 20px;
  }
  .delete-confirm-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
  }
  .delete-confirm-btn {
    flex: 1;
    padding: 11px 16px;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s;
    border: none;
  }
  .delete-confirm-btn--cancel {
    background: #f3f4f6;
    color: var(--color-foreground);
    border: 1px solid #e5e7eb;
  }
  .delete-confirm-btn--cancel:hover { background: #e5e7eb; }
  .delete-confirm-btn--confirm {
    background: var(--color-foreground);
    color: #fff;
  }
  .delete-confirm-btn--confirm:hover { opacity: 0.85; }
  .delete-confirm-btn--confirm.is-danger { background: var(--color-foreground); }
  .delete-confirm-btn--confirm.is-danger:hover { background: #b91c1c; }

  .ac-admin-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--color-foreground);
    color: var(--color-background, white);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
    letter-spacing: 0.04em;
    width: fit-content;
    margin: 24px 0 24px auto;
  }

  .ac-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .ac-toolbar__left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .ac-toolbar__right {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
    min-width: 180px;
    background: #fff;
    box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    cursor: pointer;
  }

  .ac-toolbar__label {
    white-space: nowrap;
  }

  .ac-filter-dropdown-wrap {
    position: relative;
    gap: 4px;
    width: 155px;
    height: 34px;
    background: #FFFFFF;
    box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.25);
    border-radius: 4px;
  }

  .ac-filter-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 8px;
    cursor: pointer;
    outline: none;
    transition: border-color 0.15s;
    min-width: 100%;
    justify-content: space-between;
    user-select: none;
    height: 100%;
    color: var(--color-foreground);
  }

  .ac-filter-trigger:hover,
  .ac-filter-trigger.is-open {
    border-color: var(--color-foreground);
    color: var(--color-foreground);
  }

  .ac-filter-trigger.has-selection {
    border-color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-foreground) 8%, white);
  }

  .ac-filter-trigger svg {
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .ac-filter-trigger.is-open svg {
    transform: rotate(180deg);
  }

  .ac-filter-popover {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    background: #fff;
    border: 1px solid var(--color-foreground);
    border-radius: 10px;
    box-shadow: 0px 0px 4px rgba(0, 0, 0, 0.25);
    z-index: 999;
    min-width: 200px;
    overflow: hidden;
  }

  .ac-filter-popover.is-open {
    display: block;
    animation: acDropIn 0.15s ease;
  }

  @keyframes acDropIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .ac-filter-popover__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 8px;
    border-bottom: 1px solid #e5e7eb;
  }

  .ac-filter-popover__title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ac-filter-popover__clear {
    font-size: 12px;
    color: var(--color-foreground);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
  }

  .ac-filter-popover__clear:hover { text-decoration: underline; }

  .ac-filter-list {
    list-style: none;
    margin: 0;
    padding: 6px 0;
  }

  .ac-filter-item { padding: 0; }

  .ac-filter-item__label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    cursor: pointer;
    font-size: 13px;
    transition: background 0.1s;
  }

  .ac-filter-item__label:hover {
    background: color-mix(in srgb, var(--color-primary, #295A31) 6%, transparent);
  }

  .ac-filter-check {
    width: 16px;
    height: 16px;
    accent-color: var(--color-primary, #295A31);
    cursor: pointer;
    flex-shrink: 0;
    margin: 0;
  }

  .ac-filter-item__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ac-filter-item__dot.pending   { background: #f59e0b; }
  .ac-filter-item__dot.published { background: #10b981; }
  .ac-filter-item__dot.rejected  { background: #FF383C; }
  .ac-filter-item__dot.archived  { background: #8b5cf6; }
  .ac-filter-item__dot.sold      { background: #E06D31; }
  .ac-filter-item__dot.deleted   { background: #9ca3af; }
  .ac-stat-pill__dot.deleted     { background: #9ca3af; }

  .ac-btn-apply {
    padding: 6px 16px;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.15s;
    font-family: inherit;
  }

  .ac-btn-apply:hover { opacity: 0.85; }

  .ac-btn-reset {
    padding: 6px 14px;
    background: none;
    color: var(--color-foreground);
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
    text-decoration: underline;
  }

  .ac-sort-select {
    padding: 6px 12px;
    padding-right: 45px;
    border-radius: 6px;
    color: var(--color-foreground);
    cursor: pointer;
    outline: none;
    border: none;
    -webkit-appearance: none;
    z-index: 1;
    background: transparent;
  }

  .ac-toolbar__right svg {
    position: absolute;
    right: 10px;
    top: 13px;
  }

  /* ── Stats Bar ── */
  .ac-stats-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .ac-stat-pill {
    display: flex;
    align-items: center;
    gap: 7px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 13px;
    cursor: pointer;
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .ac-stat-pill:hover { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); }

  .ac-stat-pill.is-active {
    border-color: #295A31;
    background: color-mix(in srgb, #295A31 8%, white);
    font-weight: 600;
  }

  .ac-stat-pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ac-stat-pill__dot.all       { background: #295A31; }
  .ac-stat-pill__dot.pending   { background: #f59e0b; }
  .ac-stat-pill__dot.published { background: #10b981; }
  .ac-stat-pill__dot.rejected  { background: #FF383C; }
  .ac-stat-pill__dot.archived  { background: #8b5cf6; }
  .ac-stat-pill__dot.sold      { background: #E06D31; }

  /* ── Loading / Empty ── */
  .ac-loading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 80px 0;
    color: #6b7280;
  }

  .ac-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid #e5e7eb;
    border-top-color: #295A31;
    border-radius: 50%;
    animation: acSpin 0.8s linear infinite;
  }

  @keyframes acSpin { to { transform: rotate(360deg); } }

  .ac-action-trigger .ac-btn-spinner {
    width: 12px;
    height: 12px;
    border: 2px solid rgba(0,0,0,0.15);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: acSpin 0.7s linear infinite;
    flex-shrink: 0;
  }

  .ac-empty {
    text-align: center;
    padding: 80px 0;
    color: #6b7280;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  /* ── Table ── */
  .ac-table-wrap {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 24px;
    width: 100%;
    overflow-x: auto;
    padding-bottom: 120px;
  }

  .ac-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 12px;
    padding: 1px 6px;
  }

  .ac-table thead tr th,
  .ac-table #ac-tbody .ac-tr td {
    border-top: 1px solid #E4E4E4;
    border-bottom: 1px solid #e4e4e4;
    background: #fff;
  }

  .ac-table thead,
  .ac-table #ac-tbody .ac-tr {
    box-shadow: 0px 0px 1px rgba(0, 0, 0, 1);
  }

  .ac-th {
    padding: 12px 10px;
    text-align: left;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #f9fafb;
    white-space: nowrap;
  }

  .ac-th--img { width: 90px; }

  .ac-td {
    padding: 8px 10px;
    font-size: 14px;
    color: var(--color-foreground);
    border-bottom: 1px solid #e5e7eb;

</style>

<script>
  (function () {
    'use strict';

    const API = 'https://shopify-gunloupe.addwebprojects.com';
    const PER_PAGE = 10;

     // ── Get dynamic route ──────────────────────────────────────────────────
    const R = window.GunloupeRoutes || {};
    const AD_DETAIL_BASE = R.adDetail || '/pages/detalle-anuncio';

    // ── State ──────────────────────────────────────────────────────────────
    let allAds = [];
    let filteredAds = [];
    let currentPage = 1;
    let activeFilters = [];
    let activeSort = 'date_desc';
    let pendingAction = null;

    // ── DOM refs ───────────────────────────────────────────────────────────
    const loadingEl  = document.getElementById('ac-loading');
    const emptyEl    = document.getElementById('ac-empty');
    const tableWrap  = document.getElementById('ac-table-wrap');
    const tbody      = document.getElementById('ac-tbody');
    const paginEl    = document.getElementById('ac-pagination');
    const modal      = document.getElementById('ac-reason-modal');
    const modalTitle = document.getElementById('ac-reason-modal-title');
    const modalAdInfo= document.getElementById('ac-reason-modal-ad-info');
    const modalLabel = document.getElementById('ac-reason-modal-label');
    const reasonInput= document.getElementById('ac-reason-input');
    const reasonError= document.getElementById('ac-reason-error');
    const confirmBtn = document.getElementById('ac-reason-confirm');

    // ── Custom confirm popup ───────────────────────────────────────────────
    const customConfirmOverlay  = document.getElementById('ac-customConfirmOverlay');
    const customConfirmMessage  = document.getElementById('ac-customConfirmMessage');
    const customConfirmYesBtn   = document.getElementById('ac-customConfirmYes');
    const customConfirmNoBtn    = document.getElementById('ac-customConfirmCancel');
    const customConfirmCloseBtn = document.getElementById('ac-customConfirmClose');

    let _confirmCallback = null;

    function customConfirm(message, onConfirm, opts) {
      opts = opts || {};
      customConfirmMessage.textContent = message;
      customConfirmYesBtn.textContent  = opts.confirmLabel || 'Yes';
      customConfirmYesBtn.classList.toggle('is-danger', !!opts.danger);
      _confirmCallback = onConfirm;
      customConfirmOverlay.style.display = 'flex';
    }

    function closeCustomConfirm() {
      customConfirmOverlay.style.display = 'none';
      _confirmCallback = null;
    }

    customConfirmYesBtn.addEventListener('click', function () {
      const cb = _confirmCallback;
      closeCustomConfirm();
      if (cb) cb();
    });
    customConfirmNoBtn.addEventListener('click', closeCustomConfirm);
    customConfirmCloseBtn.addEventListener('click', closeCustomConfirm);
    customConfirmOverlay.addEventListener('click', function (e) {
      if (e.target === customConfirmOverlay) closeCustomConfirm();
    });

    // ── Helpers ────────────────────────────────────────────────────────────
    function formatDate(str) {
      if (!str) return '—';
      return new Date(str).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    }

    function formatPrice(val, adCurrency) {
      if (!val) return 'N/A';
      const n = parseFloat(String(val).replace(/[^0-9.]/g, ''));
      if (isNaN(n) || n === 0) return 'N/A';

      const sourceCurrency = adCurrency || 'EUR';
      const currency = localStorage.getItem('currency') || 'EUR';
      const rate = parseFloat(localStorage.getItem('eur_to_usd') || '1.08');
      const nInEur = sourceCurrency === 'USD' ? n / rate : n;

      if (currency === 'USD') return '$' + Math.round(nInEur * rate);
      return nInEur.toLocaleString('en-US') + '€';
    }

    function parseImages(ad) {
      try {
        const arr = JSON.parse(ad.ad_images || '[]');
        if (arr.length) return arr[0];
      } catch {}
      return ad.product_image || '';
    }

    function statusLabel(s) {
      const map = {
        pending: '{{ "custom.under_review" | t }}', published: '{{ "custom.published" | t }}', rejected: '{{ "custom.rejected" | t }}',
        archived: '{{ "custom.archived" | t }}', sold: '{{ "custom.sold" | t }}', deleted: '{{ "custom.deleted" | t }}', deactivated: '{{ "custom.deactivated" | t }}'
      };
      return map[s] || s;
    }

    function showToast(msg, isError) {
      const toast = document.getElementById('ac-toast');
      document.getElementById('ac-toast-msg').textContent = msg;
      toast.style.background = isError ? '#dc2626' : '#111827';
      toast.style.display = 'flex';
      setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }

    // ── Fetch ──────────────────────────────────────────────────────────────
    async function fetchAds() {
      loadingEl.style.display = 'flex';
      emptyEl.style.display   = 'none';
      tableWrap.style.display  = 'none';
      paginEl.style.display    = 'none';

      try {
        const res  = await fetch(API + '/admin/ads?t=' + Date.now());
        const data = await res.json();
        allAds = data.ads || [];
        updateStats();
        applyFilterAndSort();
      } catch (e) {
        loadingEl.style.display = 'none';
        showToast('{{ "custom.ads_load_failed" | t }}', true);
      }
    }

    // ── Stats ──────────────────────────────────────────────────────────────
    function updateStats() {
      const counts = { pending: 0, published: 0, rejected: 0, archived: 0, sold: 0, deleted: 0 };
      allAds.forEach(a => { if (counts[a.ad_status] !== undefined) counts[a.ad_status]++; });
      Object.keys(counts).forEach(k => {
        const el = document.getElementById('stat-' + k);
        if (el) el.textContent = counts[k];
      });
    }

    // ── Filter + Sort ──────────────────────────────────────────────────────
    function applyFilterAndSort(preservePage) {
      let ads = [...allAds];

      if (activeFilters.length > 0) {
        ads = ads.filter(a => activeFilters.includes(a.ad_status));
      }

      // Ad ordering uses the numeric part of the metaobject gid, not createdAt.
      // The API's `createdAt` is really the metaobject's updatedAt (Shopify
      // exposes no createdAt for metaobjects), so it means "last modified" —
      // incrementing a view counter or editing an ad re-dated it and pushed it
      // to the top. Metaobject IDs increase with creation, so they give true
      // newest-first order.
      function adOrder(ad) {
        var n = parseInt(String((ad && ad.id) || '').split('/').pop(), 10);
        return isNaN(n) ? 0 : n;
      }
      ads.sort((a, b) => {
        if (activeSort === 'date_desc') return adOrder(b) - adOrder(a);
        if (activeSort === 'date_asc')  return adOrder(a) - adOrder(b);
        if (activeSort === 'name_asc') {
          const nameA = (a.seller_name || a.seller_email || '').trim();
          const nameB = (b.seller_name || b.seller_email || '').trim();
          return nameA.localeCompare(nameB);
        }

        if (activeSort === 'name_desc') {
          const nameA = (a.seller_name || a.seller_email || '').trim();
          const nameB = (b.seller_name || b.seller_email || '').trim();
          return nameB.localeCompare(nameA);
        }
        return 0;
      });

      filteredAds = ads;

      if (!preservePage) {
        currentPage = 1;
      } else {
        const totalPages = Math.max(1, Math.ceil(filteredAds.length / PER_PAGE));
        if (currentPage > totalPages) currentPage = totalPages;
      }

      renderTable();
    }

    // ── Render table ───────────────────────────────────────────────────────
    function renderTable() {
      loadingEl.style.display = 'none';

      if (!filteredAds.length) {
        emptyEl.style.display   = 'flex';
        tableWrap.style.display = 'none';
        paginEl.style.display   = 'none';
        return;
      }

      emptyEl.style.display   = 'none';
      tableWrap.style.display = 'block';

      const totalPages = Math.ceil(filteredAds.length / PER_PAGE);
      const start      = (currentPage - 1) * PER_PAGE;
      const pageAds    = filteredAds.slice(start, start + PER_PAGE);

      tbody.innerHTML = pageAds.map(ad => renderRow(ad)).join('');

      // ── Bind custom dropdown triggers ──
      tbody.querySelectorAll('.ac-action-trigger').forEach(btn => {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          document.querySelectorAll('.ac-action-dropdown.is-open').forEach(d => {
            if (d !== this.parentElement.querySelector('.ac-action-dropdown')) {
              d.classList.remove('is-open');
            }
          });
          document.querySelectorAll('.ac-action-trigger.is-open').forEach(b => {
            if (b !== this) b.classList.remove('is-open');
          });
          const dropdown = this.parentElement.querySelector('.ac-action-dropdown');
          if (!dropdown) return;
          const isOpen = dropdown.classList.contains('is-open');
          dropdown.classList.toggle('is-open', !isOpen);
          this.classList.toggle('is-open', !isOpen);
        });
      });

      // ── Bind custom dropdown items ──
      tbody.querySelectorAll('.ac-action-item').forEach(item => {
        item.addEventListener('click', function (e) {
          e.stopPropagation();
          const dropdown = this.closest('.ac-action-dropdown');
          const wrap     = this.closest('.ac-action-select-wrap');
          const btn      = wrap.querySelector('.ac-action-trigger');
          const action   = this.dataset.value;
          const adId     = btn.dataset.adId;
          const adTitle  = btn.dataset.adTitle;

          dropdown.classList.remove('is-open');
          btn.classList.remove('is-open');

          if (action === 'reject' || action === 'archive') {
            openReasonModal(action, adId, adTitle, btn);
          } else if (action === 'delete') {
            // ── Custom confirm instead of native alert ──
            customConfirm(
              `{{ "custom.delete_confirm_heading" | t }}`,
              function () { updateAdStatus(adId, 'deleted', '', btn); },
              { confirmLabel: '{{ "custom.Yes_delete" | t }}', danger: true }
            );
          } else if (action === 'publish') {
            updateAdStatus(adId, 'published', '', btn);
          } else if (action === 'sold') {
            updateAdStatus(adId, 'sold', '', btn);
          }
        });
      });

      if (totalPages > 1) {
        paginEl.style.display = 'flex';
        renderPagination(totalPages);
      } else {
        paginEl.style.display = 'none';
      }

      if (typeof updatePrices === 'function') updatePrices();
    }

    // ── Render row ─────────────────────────────────────────────────────────
    function renderRow(ad) {
      const imgSrc = parseImages(ad);
      const imgHtml = imgSrc
        ? `<img src="${imgSrc}" alt="${ad.firearm_brand || ''}" loading="lazy" />`
        : `<div style="width:100%;height:100%;background:#f3f4f6;display:flex;align-items:center;justify-content:center;">
             <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5">
               <rect x="3" y="3" width="18" height="18" rx="2"/>
               <circle cx="8.5" cy="8.5" r="1.5"/>
               <polyline points="21 15 16 10 5 21"/>
             </svg>
           </div>`;

      const numericId   = ad.id.split('/').pop();
      const status      = ad.ad_status || 'pending';
      const isDeleted   = status === 'deleted';
      const disabledAttr = isDeleted ? 'disabled' : '';

      let triggerClass  = 'ac-action-trigger';
      let selectedLabel = '{{ 'custom.select_action' | t }}';

      if (status === 'published')  { triggerClass += ' is-published'; selectedLabel = '{{ 'custom.published' | t }}'; }
      else if (status === 'rejected')  { triggerClass += ' is-rejected';  selectedLabel = '{{ 'custom.rejected' | t }}'; }
      else if (status === 'sold')      { triggerClass += ' is-sold';      selectedLabel = '{{ 'custom.sold' | t }}'; }
      else if (status === 'pending')   { triggerClass += ' is-pending';   selectedLabel = '{{ 'custom.under_review' | t }}'; }

      const options   = buildOptions(status);
      const adminNote = ad.admin_note
        ? `<div class="ac-admin-note hidden" title="${ad.admin_note}">Note: ${ad.admin_note}</div>` : '';

      return `
      <tr class="ac-tr${isDeleted ? ' is-deleted' : ''}" data-ad-id="${ad.id}">
        <td class="ac-td ac-td-img-wrapper">
          <div class="admin-table-label">{{ 'custom.image' | t }}:</div>
          <div class="ac-td-img">${imgHtml}</div>
        </td>
        <td class="ac-td wapon-name">
          <div class="admin-table-label">{{ 'custom.advert_title' | t }}:</div>
          <div class="ac-ad-title">${ad.firearm_brand || ''} || ${ad.firearm_model || ''}</div>
          <div class="ac-ad-sub">${ad.firearm_type || ''} ${ad.firearm_caliber ? '· ' + ad.firearm_caliber : ''}</div>
        </td>
        <td class="ac-td seller-name">
          <div class="admin-table-label">{{ 'custom.seller' | t }}:</div>
          <div class="ac-seller-name">${ad.seller_name || ad.seller_email || '—'}</div>
          <div class="ac-seller-alias">${ad.seller_email ? `<a href="mailto:${ad.seller_email}" style="color:inherit;text-decoration:none;">${ad.seller_email}</a>` : ''}</div>
        </td>
        <td class="ac-td city-name">
          <div class="admin-table-label">{{ 'custom.city' | t }}:</div>
          ${ad.city || '—'}</td>
        <td class="ac-td wapon-price">
          <div class="admin-table-label">{{ 'custom.price' | t }}:</div>
          <span class="price" data-price="${ad.price || 0}" data-currency="${ad.currency || 'EUR'}">${formatPrice(ad.price, ad.currency)}</span>
        </td>
        <td class="ac-td date" style="white-space:nowrap;">
          <div class="admin-table-label">{{ 'custom.posted_on' | t }}:</div>
          ${formatDate(ad.createdAt)}</td>
        <td class="ac-td status">
          <div class="admin-table-label">{{ 'custom.status' | t }}:</div>
          <span class="ac-status-badge ${status} btn-div">${statusLabel(status)}</span>
          ${adminNote}
        </td>
        <td class="ac-td btn-div">
          <div class="admin-table-label">{{ 'custom.action' | t }}:</div>
          <div class="ac-action-wrap">
            <div class="ac-action-select-wrap">
              <button
                class="${triggerClass}"
                type="button"
                data-ad-id="${ad.id}"
                data-ad-title="${(ad.firearm_brand || '') + ' ' + (ad.firearm_model || '')}"
                data-current-status="${status}"
                ${disabledAttr}
              >
                <span class="ac-action-trigger__label">${selectedLabel}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              ${!isDeleted ? `
              <ul class="ac-action-dropdown">
                ${options}
              </ul>` : ''}
            </div>
            <a href="${AD_DETAIL_BASE}?handle=${numericId}&admin=1" class="button is-small button-secondary ac-see-ad-btn">{{ "custom.see_ad" | t }}</a>
          </div>
        </td>
      </tr>`;
    }

    // ── Build dropdown options ─────────────────────────────────────────────
    function buildOptions(currentStatus) {
      const allOptions = [
        { value: 'publish', label: '{{ "custom.publish" | t  }}',       show: ['pending', 'rejected', 'archived', 'deactivated'] },
        { value: 'reject',  label: '{{ 'custom.reject' | t }}',         show: ['pending', 'published'] },
        { value: 'archive', label: '{{ 'custom.archive' | t }}',        show: ['pending', 'published', 'rejected'] },
        { value: 'sold',    label: '{{ 'custom.mark_as_sold' | t }}',   show: ['published'] },
        { value: 'delete',  label: '{{ 'custom.delete' | t }}',         show: ['pending', 'published', 'rejected', 'archived', 'sold', 'deactivated'] },
      ];
      return allOptions
        .filter(o => o.show.includes(currentStatus))
        .map(o => `<li class="ac-action-item" data-value="${o.value}">${o.label}</li>`)
        .join('');
    }

    // ── Close dropdowns when clicking outside ──────────────────────────────
    document.addEventListener('click', function () {
      document.querySelectorAll('.ac-action-dropdown.is-open').forEach(d => d.classList.remove('is-open'));
      document.querySelectorAll('.ac-action-trigger.is-open').forEach(b => b.classList.remove('is-open'));
    });

    // ── Reason modal ───────────────────────────────────────────────────────
    function openReasonModal(action, adId, adTitle, triggerBtn) {
      pendingAction = { action, adId, adTitle, triggerBtn };
      const isReject = action === 'reject';
      modalTitle.textContent = isReject ? '{{ "custom.reject_ad" | t  }}' : '{{ "custom.archive_ad" | t  }}';
      modalLabel.innerHTML   = isReject
        ? '{{ "custom.rejection_For_reason" | t }} <span class="ac-required">*</span>'
        : '{{ "custom.archive_For_reason" | t }} <span class="ac-required">*</span>';
      modalAdInfo.innerHTML  = `<strong>${adTitle}</strong><br>{{ 'custom.notify_seller_email' | t }}`;
      reasonInput.value       = '';
      reasonInput.placeholder = isReject
        ? '{{ "custom.explain_rejection" | t  }}...'
        : '{{ "custom.explain_ad_archived" | t  }}...';
      reasonError.style.display = 'none';
      confirmBtn.className = 'ac-modal__btn-confirm' + (isReject ? ' is-danger' : '');
      confirmBtn.textContent = isReject ? '{{ "custom.reject_ad" | t  }}' : '{{ "custom.archive_ad" | t  }}';
      modal.style.display = 'flex';
      setTimeout(() => reasonInput.focus(), 100);
    }

    function closeReasonModal() {
      modal.style.display = 'none';
      pendingAction = null;
    }

    document.getElementById('ac-reason-modal-close').addEventListener('click', closeReasonModal);
    document.getElementById('ac-reason-cancel').addEventListener('click', closeReasonModal);
    // modal.addEventListener('click', function (e) { if (e.target === modal) closeReasonModal(); });

    confirmBtn.addEventListener('click', function () {
      if (!pendingAction) return;
      const reason = reasonInput.value.trim();
      if (!reason) { reasonError.style.display = 'block'; return; }
      reasonError.style.display = 'none';
      const statusMap = { reject: 'rejected', archive: 'archived' };
      updateAdStatus(pendingAction.adId, statusMap[pendingAction.action], reason, pendingAction.triggerBtn);
      closeReasonModal();
    });

    // ── Update ad status ───────────────────────────────────────────────────
    // ── Update ad status ───────────────────────────────────────────────────
    async function updateAdStatus(adId, newStatus, adminNote, triggerBtn) {

      // ── 1. Show loader on button immediately ──────────────────────────
      const liveTrigger = document.querySelector(`.ac-action-trigger[data-ad-id="${adId}"]`);
      let originalBtnHTML = '';
      if (liveTrigger) {
        originalBtnHTML = liveTrigger.innerHTML;
        liveTrigger.disabled = true;
        liveTrigger.innerHTML = `
          <span class="ac-action-trigger__label">{{ 'custom.updating' | t }}...</span>
          <span class="ac-btn-spinner"></span>
        `;
      }

      try {
        const body = { isAdminUpdate: true, adStatus: newStatus };
        if (adminNote) body.adminNote = adminNote;

        const numericId = adId.split('/').pop();
        const res  = await fetch(API + '/my-adverts/' + encodeURIComponent(numericId), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();

        if (data.success) {
          // ── 2. Update allAds state ──────────────────────────────────
          const idx = allAds.findIndex(a => a.id === adId);
          if (idx > -1) {
            allAds[idx].ad_status = newStatus;
            if (adminNote) allAds[idx].admin_note = adminNote;
          }

          // ── 3. Update badge + button label simultaneously ───────────
          const tr = document.querySelector(`tr[data-ad-id="${adId}"]`);
          if (tr) {
            const badgeEl = tr.querySelector('.ac-status-badge');
            if (badgeEl) {
              badgeEl.className   = 'ac-status-badge ' + newStatus + ' btn-div';
              badgeEl.textContent = statusLabel(newStatus);
            }
          }

          if (liveTrigger) {
            liveTrigger.disabled = false;
            liveTrigger.dataset.currentStatus = newStatus;

            // Update trigger color class
            liveTrigger.className = liveTrigger.className
              .replace(/\bis-published\b|\bis-rejected\b|\bis-sold\b|\bis-pending\b|\bis-archived\b/g, '')
              .trim();
            if (newStatus === 'published')  liveTrigger.classList.add('is-published');
            else if (newStatus === 'rejected') liveTrigger.classList.add('is-rejected');
            else if (newStatus === 'sold')     liveTrigger.classList.add('is-sold');

            liveTrigger.innerHTML = `
              <span class="ac-action-trigger__label">${statusLabel(newStatus)}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            `;

            // Rebuild dropdown options for new status
            const dropdown = liveTrigger.parentElement.querySelector('.ac-action-dropdown');
            if (dropdown) {
              dropdown.innerHTML = buildOptions(newStatus);
              // Rebind click events on new items
              dropdown.querySelectorAll('.ac-action-item').forEach(item => {
                item.addEventListener('click', function (e) {
                  e.stopPropagation();
                  const action   = this.dataset.value;
                  const btn      = liveTrigger;
                  const aId      = btn.dataset.adId;
                  const aTitle   = btn.dataset.adTitle;
                  dropdown.classList.remove('is-open');
                  btn.classList.remove('is-open');
                  if (action === 'reject' || action === 'archive') {
                    openReasonModal(action, aId, aTitle, btn);
                  } else if (action === 'delete') {
                    customConfirm(
                      `{{ "custom.delete_confirm_heading" | t }}`,
                      function () { updateAdStatus(aId, 'deleted', '', btn); },
                      { confirmLabel: '{{ "custom.Yes_delete" | t }}', danger: true }
                    );
                  } else if (action === 'publish') {
                    updateAdStatus(aId, 'published', '', btn);
                  } else if (action === 'sold') {
                    updateAdStatus(aId, 'sold', '', btn);
                  }
                });
              });
            }
          }

          updateStats();
          showToast('{{ "custom.done" | t }}! ' + statusLabel(newStatus));

        } else {
          // ── Restore button on failure ───────────────────────────────
          if (liveTrigger) {
            liveTrigger.disabled = false;
            liveTrigger.innerHTML = originalBtnHTML;
          }
          showToast('{{ "custom.update_failed" | t }}', true);
        }
      } catch (e) {
        // ── Restore button on error ─────────────────────────────────
        if (liveTrigger) {
          liveTrigger.disabled = false;
          liveTrigger.innerHTML = originalBtnHTML;
        }
        showToast('{{ "custom.network_error" | t }}', true);
      }
    }

    // ── Pagination ─────────────────────────────────────────────────────────
    function renderPagination(totalPages) {
      const nums    = document.getElementById('ac-page-numbers');
      nums.innerHTML = '';
      const prevBtn = document.getElementById('ac-prev-page');
      const nextBtn = document.getElementById('ac-next-page');
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages;

      const pages = [];
      if (totalPages <= 7) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        pages.push(1);
        if (currentPage > 3) pages.push('...');
        for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) pages.push(i);
        if (currentPage < totalPages - 2) pages.push('...');
        pages.push(totalPages);
      }

      pages.forEach(p => {
        if (p === '...') {
          const dots = document.createElement('span');
          dots.className   = 'ac-page-dots';
          dots.textContent = '...';
          nums.appendChild(dots);
        } else {
          const btn = document.createElement('button');
          btn.className   = 'ac-page-num' + (p === currentPage ? ' active' : '');
          btn.textContent = p;
          btn.addEventListener('click', () => {
            currentPage = p;
            renderTable();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
          nums.appendChild(btn);
        }
      });
    }

    document.getElementById('ac-prev-page').addEventListener('click', () => {
      if (currentPage > 1) { currentPage--; renderTable(); }
    });
    document.getElementById('ac-next-page').addEventListener('click', () => {
      const total = Math.ceil(filteredAds.length / PER_PAGE);
      if (currentPage < total) { currentPage++; renderTable(); }
    });

    // ── Filter dropdown ────────────────────────────────────────────────────
    const filterTrigger = document.getElementById('ac-filter-trigger');
    const filterPopover = document.getElementById('ac-filter-popover');
    const filterLabel   = document.getElementById('ac-filter-label');
    const filterClear   = document.getElementById('ac-filter-clear');
    const filterChecks  = document.querySelectorAll('.ac-filter-check');

    function updateFilterLabel() {
      if (!activeFilters.length) {
        filterLabel.textContent = '{{ "custom.all" | t }}';
        filterTrigger.classList.remove('has-selection');
      } else {
        const labelMap = {
          pending: '{{ "custom.under_review" | t }}', published: '{{ "custom.publish" | t }}', rejected: '{{ "custom.status_rejected" | t }}',
          archived: '{{ "custom.archived" | t }}', sold: '{{ "custom.sold" | t }}', deleted: '{{ "custom.deleted" | t }}'
        };
        const labels = activeFilters.map(f => labelMap[f] || f);
        filterLabel.textContent = labels.length <= 2
          ? labels.join(', ')
          : labels[0] + ' +' + (labels.length - 1);
        filterTrigger.classList.add('has-selection');
      }
    }

    function syncCheckboxes() {
      filterChecks.forEach(cb => { cb.checked = activeFilters.includes(cb.value); });
    }

    function syncStatPills() {
      document.querySelectorAll('.ac-stat-pill').forEach(pill => {
        pill.classList.remove('is-active');
        const filter = pill.dataset.filter;
        if (filter === 'all' && activeFilters.length === 0) {
          pill.classList.add('is-active');
        } else if (activeFilters.length === 1 && activeFilters[0] === filter) {
          pill.classList.add('is-active');
        }
      });
    }

    filterTrigger.addEventListener('click', function (e) {
      e.stopPropagation();
      const isOpen = filterPopover.classList.contains('is-open');
      filterPopover.classList.toggle('is-open', !isOpen);
      filterTrigger.classList.toggle('is-open', !isOpen);
    });

    document.addEventListener('click', function (e) {
      if (!document.getElementById('ac-filter-dropdown-wrap').contains(e.target)) {
        filterPopover.classList.remove('is-open');
        filterTrigger.classList.remove('is-open');
      }
    });

    filterClear.addEventListener('click', function () {
      activeFilters = [];
      syncCheckboxes();
      updateFilterLabel();
    });

    document.getElementById('ac-apply').addEventListener('click', function () {
      activeFilters = Array.from(filterChecks).filter(cb => cb.checked).map(cb => cb.value);
      updateFilterLabel();
      syncStatPills();
      filterPopover.classList.remove('is-open');
      filterTrigger.classList.remove('is-open');
      applyFilterAndSort(false);
    });

    document.getElementById('ac-stats-bar').addEventListener('click', function (e) {
      const pill = e.target.closest('.ac-stat-pill');
      if (!pill) return;
      const filter = pill.dataset.filter;

      if (filter === 'all') {
        activeFilters = [];
      } else {
        activeFilters = [filter];
      }

      syncCheckboxes();
      updateFilterLabel();
      syncStatPills();
      applyFilterAndSort(false);
    });

    document.getElementById('ac-reset').addEventListener('click', () => {
      activeFilters = [];
      activeSort    = 'date_desc';
      syncCheckboxes();
      updateFilterLabel();
      syncStatPills();
      document.getElementById('ac-sort').value = 'date_desc';
      applyFilterAndSort(false);
    });

    document.getElementById('ac-sort').addEventListener('change', function () {
      activeSort = this.value;
      applyFilterAndSort(false);
    });

    // ── Init ───────────────────────────────────────────────────────────────
    fetchAds();

    // ── Silent background refresh every 30s ───────────────────────────────
    // Only re-fetches if no modal is open — safe for admin workflow
    setInterval(async function () {
      const reasonModalOpen  = document.getElementById('ac-reason-modal').style.display === 'flex';
      const confirmModalOpen = document.getElementById('ac-customConfirmOverlay').style.display === 'flex';

      // Don't refresh if admin is actively doing something
      if (reasonModalOpen || confirmModalOpen) return;

      try {
        const res       = await fetch(API + '/admin/ads?t=' + Date.now());
        const data      = await res.json();
        const freshAds  = data.ads || [];

        // Only re-render if ad count changed
        if (freshAds.length !== allAds.length) {
          allAds = freshAds;
          updateStats();
          applyFilterAndSort(true);
        }
      } catch (e) {
        // Silent fail — no toast for background refresh
      }
    }, 30000);

  })();
</script>

{% else %}

<div style="text-align:center;padding:100px 24px;">
  <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.5"

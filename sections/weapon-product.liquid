<div class="container product-detail-page">

  {%- comment -%} EN → ES VALUE NORMALISER {%- endcomment -%}

  {%- assign _raw_type = product.type -%}
  {%- case _raw_type -%}
    {%- when 'Shotgun'         -%}{%- assign _es_type = 'Escopeta'             -%}
    {%- when 'Pistol'          -%}{%- assign _es_type = 'Pistola'              -%}
    {%- when 'Cannons'         -%}{%- assign _es_type = 'Cañones'              -%}
    {%- when 'Rifle - Rimfire' -%}{%- assign _es_type = 'Rifle - Fuego anular' -%}
    {%- else                   -%}{%- assign _es_type = _raw_type               -%}
  {%- endcase -%}

  {%- assign _raw_subtype = product.metafields.custom.sub_tipo_de_arma.value -%}
  {%- case _raw_subtype -%}
    {%- when 'Semi-automatic'            -%}{%- assign _es_subtype = 'Semi Automatico'           -%}
    {%- when 'Semi-automatic Precision'  -%}{%- assign _es_subtype = 'Semi Automatico Precision' -%}
    {%- when 'Slider'                    -%}{%- assign _es_subtype = 'Corredera'                 -%}
    {%- when 'Bolt'                      -%}{%- assign _es_subtype = 'Cerrojo'                   -%}
    {%- when 'Overlay'                   -%}{%- assign _es_subtype = 'Superpuesta'               -%}
    {%- when 'Single shot'               -%}{%- assign _es_subtype = 'Monotiro'                  -%}
    {%- when 'Lever action'              -%}{%- assign _es_subtype = 'Palanca'                   -%}
    {%- when 'Straight-pull bolt'        -%}{%- assign _es_subtype = 'Cerrojo Rectilineo'        -%}
    {%- else                             -%}{%- assign _es_subtype = _raw_subtype                 -%}
  {%- endcase -%}

  {%- assign _raw_category = product.metafields.custom.categoria_web.value -%}
  {%- case _raw_category -%}
    {%- when 'Hunting'     -%}{%- assign _es_category = 'Caza'        -%}
    {%- when 'Competition' -%}{%- assign _es_category = 'Competicion' -%}
    {%- when 'Tactical'    -%}{%- assign _es_category = 'Tactico'     -%}
    {%- when 'Defense'     -%}{%- assign _es_category = 'Defensa'     -%}
    {%- when 'Sport'       -%}{%- assign _es_category = 'Deportivo'   -%}
    {%- else               -%}{%- assign _es_category = _raw_category  -%}
  {%- endcase -%}

  {%- assign _es_brand = product.metafields.custom.marca.value -%}
  {%- comment -%}
    Was `modelo | default: submodelo | default: title`. A prior attempt at
    this fix concatenated modelo + submodelo, assuming submodelo was just a
    trailing word to append (e.g. "ELEVATE") — that was wrong and produced
    duplicated text like "PREMIER PREMIER ELEVATE". Checked the actual data:
    `submodelo` is consistently the FULL descriptive model name already
    (e.g. modelo:"828 U", submodelo:"828 U Black" — matches product.title
    minus the brand), never a bare suffix. So it should be preferred outright,
    not joined with modelo, falling back to modelo only if submodelo is
    blank, and to product.title if neither is set. This is what feeds the
    Sell button's data-sell-model (and, via the same variable, Favorites'
    data-fav-model) — matching the same firearm sold via the ad-popup's own
    manual search, which uses the full product.title directly.
  {%- endcomment -%}
  {%- assign _es_model = product.metafields.custom.submodelo.value | default: product.metafields.custom.modelo.value | default: product.title -%}
  {% assign user_type = customer.metafields.custom.user_type.value %}

  <section id="Descripcion-del-producto" class="weapon-hero">
    <div class="page-width">
      <div class="weapon-grid">
        <div class="weapon-info">
          <div class="weapon-subtitle">{{ product.metafields.custom.subtitle }}</div>
          <h2 class="heading-style-h2">{{ product.title }}</h2>
          <p class="weapon-hero-price">{{ "custom.price_from" | t }}
            <span class="price" data-price="{{ product.price | divided_by: 100.0 | round: 0 }}">
              {{- product.price | default: '—' | divided_by: 100.0 | round: 0 -}}€
            </span>
          </p>
          <div class="weapon-description">{{ product.description }}</div>
        </div>
        <div class="weapon-image-wrapper">
          <div class="weapon-image">
            {% for image in product.images %}
              <a href="{{ image | image_url: width: 1600 }}" data-fancybox="product-gallery">
                <img src="{{ image | image_url: width: 900 }}">
              </a>
            {% endfor %}
          </div>

          {% unless customer %}
          <div class="banner-action-buttons product-options_buttons-wrap">
            <button onclick="window.location.href='{{ routes.storefront_login_url }}'" title="{{ 'custom.signup_cta' | t }}" class="product-card_button">
              <div class="product-card_icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M9.25 1.69043C8.83516 1.69043 8.5 2.02559 8.5 2.44043C8.5 2.85527 8.83516 3.19043 9.25 3.19043H11.1883L6.47031 7.91074C6.17734 8.20371 6.17734 8.67949 6.47031 8.97246C6.76328 9.26543 7.23906 9.26543 7.53203 8.97246L12.25 4.25215V6.19043C12.25 6.60527 12.5852 6.94043 13 6.94043C13.4148 6.94043 13.75 6.60527 13.75 6.19043V2.44043C13.75 2.02559 13.4148 1.69043 13 1.69043H9.25ZM3.625 2.44043C2.58906 2.44043 1.75 3.27949 1.75 4.31543V11.8154C1.75 12.8514 2.58906 13.6904 3.625 13.6904H11.125C12.1609 13.6904 13 12.8514 13 11.8154V9.19043C13 8.77559 12.6648 8.44043 12.25 8.44043C11.8352 8.44043 11.5 8.77559 11.5 9.19043V11.8154C11.5 12.0217 11.3313 12.1904 11.125 12.1904H3.625C3.41875 12.1904 3.25 12.0217 3.25 11.8154V4.31543C3.25 4.10918 3.41875 3.94043 3.625 3.94043H6.25C6.66484 3.94043 7 3.60527 7 3.19043C7 2.77559 6.66484 2.44043 6.25 2.44043H3.625Z" fill="#295A31"/></svg>
              </div>
              <div>{{ 'custom.signup_cta' | t }}</div>
            </button>
          </div>
          {% endunless %}

          {% if customer %}
          <div class="banner-action-buttons product-options_buttons-wrap">
            {% if user_type == 'private' %}
              <button title="{{ 'custom.buy_firearm' | t }}" class="product-card_button buy-btn">
                <div class="product-card_icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.31959 9.7171H12.0029C12.5122 9.7171 12.9522 9.35414 13.0728 8.83445L14.1912 4.01548C14.2142 3.91659 14.1926 3.81213 14.1327 3.73206C14.0729 3.65202 13.9813 3.60529 13.8844 3.60529H10.3746C10.2002 3.60529 10.0588 3.75378 10.0588 3.93693C10.0588 4.12009 10.2002 4.26858 10.3746 4.26858H13.4824L12.4592 8.67736C12.4069 8.90249 12.2236 9.05377 12.0029 9.05377H4.82511L3.74011 4.26855H7.05035C7.22474 4.26855 7.36614 4.12006 7.36614 3.93691C7.36614 3.75376 7.22474 3.60526 7.05035 3.60526H3.58972L3.14522 1.64495C3.11133 1.49557 2.98425 1.39014 2.83801 1.39014H1.51598C1.34159 1.39014 1.2002 1.53863 1.2002 1.72178C1.2002 1.90494 1.34159 2.05343 1.51598 2.05343H2.58859L4.17788 9.06273C3.5718 9.13674 3.09972 9.67887 3.09972 10.3349C3.09972 11.0413 3.64693 11.616 4.31956 11.616H4.4338C3.94025 11.8354 3.59306 12.3491 3.59306 12.9464C3.59306 13.7425 4.20975 14.3901 4.96777 14.3901C5.7258 14.3901 6.34248 13.7425 6.34248 12.9464C6.34248 12.3491 5.9953 11.8354 5.50174 11.616H11.5551C11.0615 11.8354 10.7143 12.3491 10.7143 12.9464C10.7143 13.7425 11.331 14.3901 12.089 14.3901C12.8471 14.3901 13.4637 13.7425 13.4637 12.9464C13.4637 12.3491 13.1166 11.8354 12.623 11.616H13.0744C13.2488 11.616 13.3902 11.4676 13.3902 11.2844C13.3902 11.1013 13.2488 10.9528 13.0744 10.9528H4.31959C3.99522 10.9528 3.73132 10.6756 3.73132 10.3349C3.7313 9.99427 3.99519 9.7171 4.31959 9.7171ZM4.9678 13.7268C4.55803 13.7268 4.22467 13.3767 4.22467 12.9464C4.22467 12.5161 4.55803 12.1659 4.9678 12.1659C5.37756 12.1659 5.71093 12.5161 5.71093 12.9464C5.71093 13.7268 5.37756 13.7268 4.9678 13.7268ZM12.0891 13.7268C11.6793 13.7268 11.346 13.3767 11.346 12.9464C11.346 12.5161 11.6793 12.1659 12.0891 12.1659C12.4988 12.1659 12.8322 12.5161 12.8322 12.9464C12.8322 13.7268 12.4988 13.7268 12.0891 13.7268ZM8.39669 6.74709V1.91566C8.39669 1.73251 8.53808 1.58401 8.71248 1.58401C8.88687 1.58401 9.02827 1.73251 9.02827 1.91566V6.74709L10.1965 5.58323C10.323 5.4572 10.5229 5.4627 10.6429 5.59558C10.763 5.72846 10.7577 5.9384 10.6312 6.06445L8.92982 7.75944C8.8689 7.82013 8.79069 7.85048 8.71248 7.85048C8.63427 7.85048 8.55606 7.82013 8.49514 7.75944L6.7938 6.06445C6.66727 5.9384 6.66201 5.72846 6.78203 5.59558C6.90209 5.4627 7.10195 5.45718 7.22848 5.58323L8.39669 6.74709Z" fill="#295A31"/></svg>
                </div>
                <div>{{ 'custom.buy_firearm' | t }}</div>
              </button>
            {% endif %}
            <button title="{{ 'custom.add_or_remove_firearm' | t }}" class="product-card_button fav-button"
              data-fav-handle="{{ product.handle }}"
              data-fav-title="{{ product.title }}"
              data-fav-product-title="{{ product.title }}"
              data-fav-image="{{ product.featured_image | image_url: width: 600 }}"
              data-fav-price="{{ product.price }}"
              data-fav-type="{{ _es_type }}"
              data-fav-subtype="{{ _es_subtype }}"
              data-fav-category="{{ _es_category }}"
              data-fav-status="In catalog">
              <div class="product-card_icon">
                <svg width="16" height="16" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10.6953 22.1172C11.1943 22.5056 11.6682 22.8589 12.1328 23.1299C12.5365 23.3653 12.9097 23.5231 13.2607 23.5938V24.5684C12.6948 24.4899 12.1529 24.258 11.6436 23.9609C11.1233 23.6574 10.6052 23.2692 10.0977 22.874L10.6953 22.1172ZM17.2217 22.875C16.7144 23.27 16.1967 23.6576 15.6768 23.9609C15.1676 24.2579 14.6263 24.4898 14.0605 24.5684V23.5938C14.4115 23.523 14.7848 23.3653 15.1885 23.1299C15.6528 22.8591 16.1253 22.5053 16.624 22.1172L17.2217 22.875ZM2.37695 11.1611C2.48089 13.6757 3.55988 15.6386 5.04492 17.3076C6.53049 18.9773 8.38397 20.3205 10.0645 21.627L9.4668 22.3848C7.82397 21.1087 5.8748 19.6923 4.32129 17.9463C2.72574 16.153 1.51556 13.9745 1.41016 11.1611H2.37695ZM25.9102 11.1611C25.8047 13.9746 24.5946 16.1529 22.999 17.9463C21.4456 19.6922 19.4963 21.1078 17.8535 22.3838L17.2559 21.627C18.9363 20.3205 20.7897 18.9773 22.2754 17.3076C23.7605 15.6386 24.8404 13.6757 24.9443 11.1611H25.9102ZM14.2607 5.27539C16.7879 3.20028 19.5256 2.97245 21.7373 3.98145C24.09 5.05483 25.7665 7.49492 25.9102 10.3613H24.9414C24.7989 7.85884 23.3314 5.76829 21.335 4.85742C19.3411 3.94778 16.7377 4.18131 14.292 6.53809L14.2373 6.48633L14.5742 6.16406L14.8623 5.88672L14.585 5.59766C14.4779 5.48663 14.3691 5.37989 14.2607 5.27539ZM5.58301 3.98145C7.79472 2.97238 10.5324 3.20042 13.0596 5.27539C12.9513 5.37974 12.8432 5.4868 12.7363 5.59766L12.458 5.88672L12.7471 6.16406L13.082 6.48633L13.0283 6.53809C10.5826 4.18146 7.97923 3.94773 5.98535 4.85742C3.98899 5.76833 2.52236 7.85893 2.37988 10.3613H1.41113C1.55478 7.49498 3.23042 5.05485 5.58301 3.98145ZM13.7246 5.86914L13.6602 5.93164L13.5947 5.86914C13.6163 5.84825 13.6386 5.82822 13.6602 5.80762C13.6816 5.82806 13.7032 5.84841 13.7246 5.86914Z" fill="#295A31" stroke="#295A31" stroke-width="0.799583"/><path d="M21.5 4.5C18.5943 2.83962 15.1131 4.76419 14.1791 6.00947L13.6603 6.52834L11.6886 5.07551L8.99046 4.03778L5.35838 4.55665L2.66027 7.35853L1.83008 11.8208L3.28291 16.0755L7.84895 20.434L13.8678 24.3774L15.0093 23.7548L19.264 20.434L23.1037 16.6982L25.2829 12.7548V9.22646C24.937 8.29249 24.4057 6.16038 21.5 4.5Z" stroke="#295A31"/></svg>
              </div>
              <div data-fav-text="add">{{ 'custom.add_to_favorites' | t }}</div>
              <div data-fav-text="remove" style="display:none;">{{ 'custom.remove_from_favorites' | t }}</div>
            </button>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <section id="Configuracion-del-arma" class="weapon-config">
    <h2>{{ 'custom.firearm_configuration' | t }}</h2>
    <div class="product-options_table">
      <div class="product-options_header-row product-table_row">
        <div class="product-table_cell">{{ 'custom.barrel_lengths' | t }}<span class="product-table_tooltip text-size-tiny">(cm / in)</span></div>
        <div class="product-table_cell">{{ 'custom.total_length' | t }}<span class="product-table_tooltip text-size-tiny">(cm / in)</span></div>
        <div class="product-table_cell">{{ 'custom.calibers' | t }}</div>
        <div class="product-table_cell">{{ 'custom.twist_rate' | t }}</div>
        <div class="product-table_cell">{{ 'custom.weight' | t }}<span class="product-table_tooltip text-size-tiny">(kg / lbs)</span></div>
        <div class="product-table_cell">{{ 'custom.magazine_capacity' | t }}</div>
        <div class="product-table_cell">{{ 'custom.thread_diameter' | t }}</div>
        <div class="product-options_buttons-wrap is-placeholder"></div>
      </div>
      <div class="product-options_list">
        <div class="product-options_accordeon is-single">
          <div class="product-options_accordeon_content">
            <div class="product-options_accordeon_list">

              {%- assign caliber_order = "4,8,10,12/70,12/76,16/67,16/70,20/67,20/70,20/76,24/65,28/70,32,410,4.5mm,22LR,32WC,9mm Luger,9x19 Parabellum,9x21,.357 Magnum,357-38,.38 Special,.380 ACP,.40 S&W,.44 Magnum,.45 ACP,45 Auto,10mm Auto,.454 Casull,5.7 FN,17 Remington,17 Hornet,17 WSM,17 HMR,5.45x39mm,22 LR,22 Hornet,22 Winchester Magnum Rimfire,22 Nosler,22 Creedmoor,204 Ruger,218 Bee,221 Fireball,222 Remington,223 Remington,222 Remington Magnum,225 Winchester,224 Weatherby Magnum,224 Valkyrie,22-250 Remington,223 Winchester Super Short Magnum,220 Swift,5.6x50R,5.6x52mm Rimmed,5.7x28mm,6x45mm,6mm Norma BR,6mm XC,6mm Remington,6mm Creedmoor,6mm ARC,240 Weatherby Magnum,240 Holand&Holand,243 Winchester,243 Winchester Super Short Magnum,25-20 WCF,25-35 WCF,250 Savage,257 Roberts,25-06 Remington,25 Winchester Super Short Magnum,25 Creedmoor,257 Weatherby Magnum,6.5 Grendel,6.5x50mm Japanese Arisaka,6.5mm Carcano,6.5x52mm Mannlicher-Carcano,6.5 Creedmoor,6.5x47mm Lapua,260 Remington,6.5x55mm Swedish Mauser,6.5x57mm Mauser,6.5x57R,6.5mm-284 Norma,6.5mm Remington Magnum,6.5 PRC,6.5x65R,6.5x68,6.5-300 Weatherby Magnum,264 Winchester Magnum,6.8mm Remington SPC,6.8 Western,270 Winchester,270 Winchester Short Magnum,270 Weatherby Magnum,7-30 Waters,7mm-08 Remington,7x57R,7x57mm Mauser,284 Winchester,7x64mm Brenneke,7x65mm Rimmed,280 Remington,280 Remington Ackley Improved,28 Nosler,7mm Backcountry,7mm Blaser Magnum,7LRM,7mm Mauser,7mm PRC,7mm Remington Magnum,7mm SAUM,7mm STW,7mm Weatherby Magnum,7mm Winchester Short Magnum,7mm WSM,7.21 Firebird,7mm Remington Ultra Magnum,30 Carbine,300 Whisper,30 Remington AR,30-30 Winchester,308 Marlin Express,300 Savage,30 TC,308 Winchester,307 Winchester,7.5x54mm French MAS,7.62x39,7.62x54mm Rimmed Russian,7.5x55mm Swiss,300 Blaser Magnum,30-06 Springfield,7.82 Patriot,30 Nosler,300 Ruger Compact Magnum,300 Remington Short Action Ultra Magnum,300 Blackout,300 Winchester Short Magnum,300 Norma Magnum,300 H&H Magnum,300 Winchester Magnum,300 Weatherby Magnum,300 Remington Ultra Magnum,300 PRC,7.82 Warbird,30-378 Weatherby Magnum,300 Pegasus,303 British,7.65mm Argentine Mauser,7.7mm Japanese,7.92x33mm Kurz Mauser,32-40 WCF,32 Winchester Special,325 Winchester Short Magnum,8x57mm Rimmed J Mauser,8x56mm Mannlicher-Schoenauer,8x57mm Mauser,8x57mm JS Mauser,8x57mm JRS,8mm Lebel,8x68mm S Magnum,8mm Remington Magnum,318 Westley Richards,33 Nosler,333 Jeffery Rimless,333 Jeffery Flanged,8.5x55 Blaser,8.5x63,338 Marlin Express,338 Federal,338-06 A-Square,338 Ruger Compact Magnum,338 Winchester Magnum,340 Weatherby Magnum,338 Remington Ultra Magnum,8.59 Titan,338 Lapua Magnum,338-378 Weatherby Magnum,338 Blaser Magnum,338 Excalibur,338 ARC,348 Winchester,35 Remington,350 Legend,356 Winchester,358 Winchester,35 Whelen,350 Remington Magnum,358 Norma Magnum,358 Shooting Times Alaskan,9.3x57mm Mauser,370 Sako Magnum,9.3x72mm Rimmed,9.3x62mm Mauser,9.3x74mm Rimmed,9.3x64mm Brenneke,38-56 WCF,375 Winchester,375 CheyTac,375 Nitro Express Flanged,375 Blaser Magnum,375 H&H Magnum,375 Flanged Magnum,375 Ruger,375 Weatherby Magnum,375 Remington Ultra Magnum,378 Weatherby Magnum,38-40 WCF,38-55 WCF,10.3x60 R,10.3x68 Magnum,450-400 Nitro Express,40-60 WCF,40-65 WCF,40-82 WCF,400 A-Square,405 Winchester,408 Cheyene Tactical,416 Taylor,416 Remington Magnum,416 Ruger,416 Weatherby Magnum,416 Rigby,500-416 Nitro Express,404 Jeffery,44-40 WCF,444 Marlin,.45 Cal,45-110 Sharps,45-120 Sharps,450 Bushmaster,45-60 WCF,45-75 WCF,577-450 Martini-Henry,458 SOCOM,45-70 Government,450 Marlin,45-90 WCF,458 Winchester Magnum,458 Lott,450 Ackley Magnum,450 Assegai,460 Short A-Square,450 Nitro Express,450 Rigby Rimless,460 Weatherby Magnum,500-465 Nitro Express,470 Capstick,470 Nitro Express,475 Turnbull,475 Jeffery Nitro Express,50 Beowulf,50 Alaskan,50-70 Government,50-90 Sharps,50-95 WCF,500 Nitro Express,500 A-Square,500 Jeffery,505 Gibbs,50 BMG,56-50 Spencer,.50 Caliber,577 Nitro Express" | split: "," -%}

              {%- assign all_barrels = "" -%}
              {%- for variant in product.variants -%}
                {%- assign barrel = variant.option2 | remove: "cm" | strip -%}
                {%- unless all_barrels contains barrel -%}
                  {%- assign all_barrels = all_barrels | append: barrel | append: "," -%}
                {%- endunless -%}
              {%- endfor -%}
              {%- assign barrel_array = all_barrels | split: "," | sort_natural -%}
              
              {%- for barrel in barrel_array -%}
                {% if barrel == blank %}
                  {% continue %}
                {% endif %}
                <!-- varient count -->
                {% assign barrel_variant_count = 0 %}
                {% for variant in product.variants %}

                    {% assign v_barrel = variant.option2 | remove: "cm" | strip %}

                    {% if v_barrel == barrel %}
                        {% assign barrel_variant_count = barrel_variant_count | plus: 1 %}
                    {% endif %}

                {% endfor %}

                {%- assign should_group = false -%}
                {%- if barrel_variant_count > 1 -%}
                  {%- assign should_group = true -%}
                {%- endif -%}
                <!-- varient count -->
                {% assign barrel_in = '' %}

                {% for variant in product.variants %}
                  {% assign v_barrel = variant.option2 | remove: 'cm' | strip %}

                  {% if v_barrel == barrel %}
                    {% if barrel_in == blank %}
                      {% assign barrel_in = variant.metafields.custom.longitud_canon_pulgadas.value %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
                <!-- header group code if varient more then 3 -->
                {% if should_group %}
                <div class="product-options_group">
                  <button type="button" class="product-options_group-header">
                    <div class="product-table_cell product-options_group-title">
                      {{ barrel }}cm / {{ barrel_in }}
                    </div>

                    <div class="flex product-options_group-toggle">
                      <span class="product-options_group-count">
                          ({{ barrel_variant_count }} variants)
                      </span>
                      <span class="product-options_group-arrow icon-plus">
                        {{- 'icon-plus.svg' | inline_asset_content -}}
                      </span>
                    </div>

                  </button>
                    <div class="product-options_group-content">
                {% endif %}
                <!-- header group code if varient more then 3 -->

                {%- comment -%}
                  caliber_order is used for sort order only, never as an
                  inclusion filter — a variant whose caliber isn't an exact
                  string match in that curated list (e.g. "6XC" vs "6mm XC",
                  "22 WMR" vs "22 Winchester Magnum Rimfire", or a value with
                  an extra suffix like "8x57mm Mauser (8mm Mauser)") must
                  still render inside this same barrel group, not fall
                  through to an ungrouped row elsewhere. rendered_ids tracks
                  what this pass already output so the second pass below
                  doesn't duplicate it.
                {%- endcomment -%}
                {%- assign rendered_ids = "" -%}
                {%- for caliber in caliber_order -%}
                  {%- for variant in product.variants -%}
                    {%- assign v_barrel = variant.option2 | remove: "cm" | strip -%}
                    {%- assign v_caliber = variant.option1 | strip -%}
                    {%- if v_barrel == barrel and v_caliber == caliber -%}
                      {%- assign rendered_ids = rendered_ids | append: variant.id | append: ',' -%}
                      {%- assign barrel_cm = variant.option2 | remove: 'cm' | strip | plus: 0 -%}
                      {%- assign barrel_in = variant.metafields.custom.longitud_canon_pulgadas.value -%}
                      {%- if barrel_cm > 0 -%}
                        {%- assign variant_title = product.title | append: ' // ' | append: variant.option1 | append: ' // ' | append: barrel_cm | append: 'cm (' | append: barrel_in | append: 'in)' -%}
                      {%- else -%}
                        {%- assign variant_title = product.title | append: ' // ' | append: variant.option1 -%}
                      {%- endif -%}


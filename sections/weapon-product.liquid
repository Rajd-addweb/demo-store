  <section id="Ficha-tecnica" class="technical-data">
    <div class="page-width">
      <h2>{{ 'custom.technical_data' | t }}</h2>
      <div class="tech-grid">
        <div class="tech-row"><span>{{ 'custom.brand' | t }}</span><span>{{ product.metafields.custom.marca.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.model' | t }}</span><span>{{ product.metafields.custom.modelo.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.submodel' | t }}</span><span>{{ product.metafields.custom.submodelo.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.firearm_type' | t }}</span><span>{{ product.type | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.firearm_sub_type' | t }}</span><span>{{ product.metafields.custom.sub_tipo_de_arma.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.modality' | t }}</span><span>{{ product.metafields.custom.modalidad.value | default: '—' }}</span></div>
        {%- assign has_available_variant = false -%}
        {%- for variant in product.variants -%}
          {%- assign v_disp = variant.metafields.custom.availability.value | downcase | strip -%}
          {%- if v_disp == 'disponible' or v_disp == 'available' -%}
            {%- assign has_available_variant = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="tech-row">
          <span>{{ 'custom.availability' | t }}</span>
          <span>
          {%- if has_available_variant -%}
            {{ 'custom.available' | t }}
          {%- else -%}
            {{ 'custom.discontinued' | t }}
          {%- endif -%}
        </span>
        </div>
        <div class="tech-row"><span>{{ 'custom.handedness' | t }}</span><span>{{ product.metafields.custom.lateralidad.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.precision_warranty' | t }}</span><span>{% render 'gl-tech-bool', value: product.metafields.custom.garantia_precision.value %}</span></div>
        <div class="tech-row"><span>{{ 'custom.interchangeable_barrel' | t }}</span>
          <span>
            {%- assign canon = product.metafields.custom.canon_intercambiable.value -%}
            {%- if canon == '1' or canon == 1 -%}{{ 'custom.gunval_yes' | t }}
            {%- elsif canon == '0' or canon == 0 -%}{{ 'custom.gunval_no' | t }}
            {%- else -%}—{%- endif -%}
          </span>
        </div>
        <div class="tech-row"><span>{{ 'custom.barrel_diameter' | t }} (mm)</span><span>{{ product.metafields.custom.diametro_del_canon_mm.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.barrel_diameter' | t }} {{ 'custom.inches' | t }}</span><span>{{ product.metafields.custom.diametro_canon_pulgadas.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.thread' | t }}</span><span>{% render 'gl-tech-bool', value: product.metafields.custom.rosca.value %}</span></div>
        <div class="tech-row"><span>{{ 'custom.barrel_fluted' | t }}</span><span>{% render 'gl-tech-bool', value: product.metafields.custom.canon_fluteado.value %}</span></div>
        <div class="tech-row"><span>{{ 'custom.muzzle_brake' | t }}</span><span>{% render 'gl-tech-bool', value: product.metafields.custom.freno_de_boca.value %}</span></div>
        <div class="tech-row"><span>{{ 'custom.barrel_finish' | t }}</span><span>{{ product.metafields.custom.acabado_de_canon.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.barrel_material' | t }}</span><span>{{ product.metafields.custom.material_del_canon.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.barrel_brand' | t }}</span><span>{{ product.metafields.custom.banda_canon.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.stock_type' | t }}</span><span>{{ product.metafields.custom.tipo_de_culata.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.stock_material' | t }}</span><span>{{ product.metafields.custom.material_caja.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.caja_larga' | t }}</span><span>{% render 'gl-tech-bool', value: product.metafields.custom.caja_larga.value %}</span></div>
        <div class="tech-row"><span>{{ 'custom.stock_finish' | t }}</span><span>{{ product.metafields.custom.acabado_caja.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.trigger_type' | t }}</span><span>{{ product.metafields.custom.tipo_disparador.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.trigger_type1' | t }}</span><span>{{ product.metafields.custom.tipo_de_gatillo.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.adjustable_trigger' | t }}</span>
          <span>
            {%- assign gatillo_raw = product.metafields.custom.gatillo_ajustable.value | strip | downcase -%}
            {%- if gatillo_raw == 'si' or gatillo_raw == 'sí' or gatillo_raw == 'yes' or gatillo_raw == 'true' or gatillo_raw == '1' -%}{{ 'custom.gunval_yes' | t }}
            {%- elsif gatillo_raw == 'no' or gatillo_raw == 'false' or gatillo_raw == '0' -%}{{ 'custom.gunval_no' | t }}
            {%- else -%}{% render 'gl-tech-bool', value: product.metafields.custom.gatillo_ajustable.value %}{%- endif -%}
          </span>
        </div>
        <div class="tech-row"><span>{{ 'custom.removable_magazine' | t }}</span>
          <span>
            {%- assign cargador_raw = product.metafields.custom.cargador_extraible.value | strip | downcase -%}
            {%- if cargador_raw == 'si' or cargador_raw == 'sí' or cargador_raw == 'yes' or cargador_raw == 'true' or cargador_raw == '1' -%}{{ 'custom.gunval_yes' | t }}
            {%- elsif cargador_raw == 'no' or cargador_raw == 'false' or cargador_raw == '0' -%}{{ 'custom.gunval_no' | t }}
            {%- else -%}{% render 'gl-tech-bool', value: product.metafields.custom.cargador_extraible.value %}{%- endif -%}
          </span>
        </div>
        <div class="tech-row"><span>{{ 'custom.open_sights' | t }}</span><span>{% render 'gl-tech-bool', value: product.metafields.custom.miras_abiertas.value %}</span></div>
        <div class="tech-row"><span>{{ 'custom.choke' | t }}</span><span>{% render 'gl-tech-bool', value: product.metafields.custom.choke.value %}</span></div>
        <div class="tech-row"><span>{{ 'custom.choke_type' | t }}</span><span>{{ product.metafields.custom.tipo_de_choke.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.choke_number' | t }}</span><span>{{ product.metafields.custom.numero_chokes.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.bases' | t }}</span><span>{{ product.metafields.custom.bases.value | default: '—' }}</span></div>
        <div class="tech-row"><span>{{ 'custom.optics' | t }}</span><span>{{ product.metafields.custom.optica.value | default: '—' }}</span></div>
      </div>
    </div>
  </section>

  {% assign has_related_content = false %}

  {% if product.metafields.custom.related_content_url_1 != blank
    or product.metafields.custom.related_content_url_2 != blank
    or product.metafields.custom.related_content_url_3 != blank
    or product.metafields.custom.related_content_url_4 != blank %}
    {% assign has_related_content = true %}
  {% endif %}

  {% if has_related_content %}

    <section id="contenido-adicional" class="additional-content-section">
      <div class="page-width">

        <h2>{{ 'custom.additional_content' | t }}</h2>

        <div class="additional-content-grid">

          {% for i in (1..4) %}

            {% case i %}
              {% when 1 %}
                {% assign video_url = product.metafields.custom.related_content_url_1.value %}
                {% assign title = product.metafields.custom.related_content_titulo_1.value %}
                {% assign thumbnail = product.metafields.custom.related_content_thumbnail_1.value %}

              {% when 2 %}
                {% assign video_url = product.metafields.custom.related_content_url_2.value %}
                {% assign title = product.metafields.custom.related_content_titulo_2.value %}
                {% assign thumbnail = product.metafields.custom.related_content_thumbnail_2.value %}

              {% when 3 %}
                {% assign video_url = product.metafields.custom.related_content_url_3.value %}
                {% assign title = product.metafields.custom.related_content_titulo_3.value %}
                {% assign thumbnail = product.metafields.custom.related_content_thumbnail_3.value %}

              {% when 4 %}
                {% assign video_url = product.metafields.custom.related_content_url_4.value %}
                {% assign title = product.metafields.custom.related_content_titulo_4.value %}
                {% assign thumbnail = product.metafields.custom.related_content_thumbnail_4.value %}
            {% endcase %}

            {% if video_url != blank %}

              {% assign youtube_thumb = '' %}
              {% assign youtube_id = '' %}

              {% if thumbnail == blank %}

                {% if video_url contains 'youtube.com/watch' %}
                  {% assign youtube_id = video_url | split: 'v=' | last | split: '&' | first %}

                {% elsif video_url contains 'youtu.be/' %}
                  {% assign youtube_id = video_url | split: 'youtu.be/' | last | split: '?' | first %}

                {% elsif video_url contains 'youtube.com/shorts/' %}
                  {% assign youtube_id = video_url | split: 'shorts/' | last | split: '?' | first %}

                {% elsif video_url contains 'youtube.com/embed/' %}
                  {% assign youtube_id = video_url | split: 'embed/' | last | split: '?' | first %}
                {% endif %}

                {% if youtube_id != blank %}
                  {% assign youtube_thumb = 'https://img.youtube.com/vi/' | append: youtube_id | append: '/hqdefault.jpg' %}
                {% endif %}

              {% endif %}

              <a
                href="{{ video_url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="additional-content-card"
              >
                <div class="additional-content-image">

                  {% if thumbnail != blank %}
                    <img
                      src="{{ thumbnail }}"
                      alt="{{ title }}"
                      loading="lazy"
                    >

                  {% elsif youtube_thumb != blank %}
                    <img
                      src="{{ youtube_thumb }}"
                      alt="{{ title }}"
                      loading="lazy"
                    >

                  {% else %}
                    <div class="additional-content-placeholder">
                      No Image
                    </div>
                  {% endif %}

                </div>

                <div class="additional-content-title">
                  {{ title }}
                </div>

              </a>

            {% endif %}

          {% endfor %}

        </div>

      </div>
    </section>

  {% endif %}

  {% render 'product-ads', product: product %}

  <section id="productos-similares"></section>

  <div class="section_product-page_toc">
    <div class="container">
      <div class="w-layout-blockcontainer container-large w-container">
        <nav id="product-toc" class="toc_layout">
          <a href="#Descripcion-del-producto" class="toc_link active">{{ 'custom.product_description' | t }}</a>
          <a href="#Configuracion-del-arma" class="toc_link">{{ 'custom.weapon_configuration' | t }}</a>
          <a href="#Ficha-tecnica" class="toc_link">{{ 'custom.technical_data' | t }}</a>
          {% if related_content != blank %}
            <a href="#contenido-adicional" class="toc_link">{{ 'custom.additional_content' | t }}</a>
          {% endif %}
          <a href="#section-all-ads" class="toc_link">{{ 'custom.where_to_buy' | t }}</a>
          <div class="toc_shadow"></div>
          <a href="#productos-similares" class="toc_link">{{ 'custom.similar_products' | t }}</a>
        </nav>
      </div>
    </div>
  </div>

</div>

<script>
  document.querySelectorAll('.buy-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.getElementById('section-all-ads').scrollIntoView({ behavior: 'smooth' });
    });
  });

  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".product-options_group").forEach(function (group) {
      const header = group.querySelector(".product-options_group-header");
      header.addEventListener("click", function () {
          group.classList.toggle("is-open");
        });
      });
  });
</script>

<script>
  (function () {
    const targetSection = document.getElementById('productos-similares');
    function moveElement() {
      const el = document.querySelector('.ctm-similar-product');
      if (el && targetSection && !targetSection.contains(el)) {
        targetSection.appendChild(el);
        return true;
      }
      return false;
    }
    if (!moveElement()) {
      const observer = new MutationObserver(function (mutations, obs) {
        if (moveElement()) { obs.disconnect(); }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>


{% schema %}
{
  "name": "Weapon product",
  "settings": []
}
{% endschema %}

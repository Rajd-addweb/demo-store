<section id="section-ad-detail" class="section_add-detail"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="ad-detail-page" id="ad-detail-root">
      <!-- Loading State -->
      <div class="ad-loading" id="ad-loading">
        <div class="ad-loading__spinner"></div>
        <p>{{ 'custom.loading_ad' | t }}...</p>
      </div>

      {%- comment -%}
        Shown both for an ad that doesn't exist and for one the visitor isn't
        allowed to see. The message is the same in both cases on purpose, so
        that trying ids tells you nothing about which ads are real.
      {%- endcomment -%}
      {%- liquid
        assign clf_url = '/pages/clasificados'
        if request.locale.iso_code != 'es'
          assign clf_url = '/en/pages/classifieds'
        endif
      -%}
      <div class="ad-error" id="ad-error" style="display:none;">
        <p>{{ 'custom.ad_not_found' | t }}</p>
        <a class="button button-secondary is-small" href="{{ clf_url }}">
          {{- 'custom.browse_classifieds' | t -}}
        </a>
      </div>

      <!-- Main Content -->
      <div class="ad-detail-content" id="ad-detail-content" style="display:none;">
        <div class="ad-detail-container">
          <!-- MAIN LAYOUT: IMAGE LEFT | INFO RIGHT -->
          <div class="ad-detail-layout">
            <!-- LEFT: Image Gallery -->
            <div class="ad-gallery" id="ad-gallery">
              <a id="ad-fancybox-link" href="" >
                <div class="ad-gallery__main">
                  <img 
                    id="ad-main-image"
                    src=""
                    alt="Ad image"
                    width="600"
                    height="450"
                    data-placeholder="https://cdn.shopify.com/s/files/1/0977/9986/4694/files/product-placeholder.svg"
                  >
                </div>
              </a>
              <div class="ad-gallery__thumbs" id="ad-gallery-thumbs" style="display:none;">
                <button class="ad-thumb-nav ad-thumb-nav--prev" id="thumb-prev">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="15 18 9 12 15 6" />
                  </svg>
                </button>
                <div class="ad-thumb-track" id="thumb-track"></div>
                <button class="ad-thumb-nav ad-thumb-nav--next" id="thumb-next">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
              </div>
              <!-- Description -->
              <div class="ad-description">
                <h3 class="ad-description__heading">{{ 'custom.description' | t }}</h3>
                <div class="ad-description__body" id="ad-description">—</div>
              </div>
            </div>


            <!-- RIGHT: Ad Info -->
            <div class="ad-info">
              <!-- TOP META BAR -->
              <div class="ad-meta-bar">
                <div class="ad-meta-bar__left">
                  <span class="ad-meta-stat">
                    {% render 'icon-eye' %}
                    <span id="ad-views-count">0</span> {{ "custom.views" | t }}
                  </span>
                  <span class="ad-meta-stat">
                    {% render 'icon-share' %}
                    <span id="ad-share-count">0</span> <span id="ad-share-label">{{ "custom.sent" | t }}</span>
                  </span>
                </div>
                <div class="ad-meta-bar__right">
                  <button class="button button-secondary is-small ad-btn-share" id="btn-share-ad"
                    title="{{ 'custom.share_ad' | t }}">
                    {% render 'icon-share' %}
                    {{ "custom.send" | t }}
                  </button>
                </div>
              </div>

              {%- comment -%}
                Three lines, per the client's structure:
                  1. Brand + Model // Barrel length      e.g. Sako 90 Quest // 62 cm (24.4")
                  2. Caliber                             e.g. 308 Winchester
                  3. Type // Sub-type                    e.g. Rifle // Cerrojo
                Lines 1 and 2 share a font size; line 3 is smaller.

                Lines 2 and 3 are <p>, not the <h4> line 3 used to be: they're
                a spec pair, not a heading, and an h4 under the h3 was padding
                the heading outline for no benefit (cf. the heading-style SEO
                pass in 2a0e736).
              {%- endcomment -%}
              <div class="ad-info-name-wrapper">
                <div class="ad-info__label" id="ad-personalized-name"></div>
                <h4 class="ad-info__title" id="ad-title">—</h4>
                <h4 class="ad-info__caliber" id="ad-caliber">—</h4>
                <p class="ad-info__subtitle" id="ad-subtitle">—</p>
              </div>

              <!-- Key Stats Grid -->
              <div class="ad-stats-grid">
                <div class="ad-stat-cell">
                  <span class="ad-stat-cell__label">{{ 'content.price' | t }}</span>
                  <span class="ad-stat-cell__value price" id="ad-price" data-price="0">—</span>
                </div>
                <div class="ad-stat-cell">
                  <span class="ad-stat-cell__label">{{ 'custom.availability' | t }}</span>
                  <span class="ad-stat-cell__value" id="ad-availability">—</span>
                </div>
                <div class="ad-stat-cell">
                  <span class="ad-stat-cell__label">{{ 'custom.status' | t }}</span>
                  <span class="ad-stat-cell__value" id="ad-status">—</span>
                </div>
                <div class="ad-stat-cell">
                  <span class="ad-stat-cell__label">{{ 'custom.city_' | t }}</span>
                  <span class="ad-stat-cell__value" id="ad-city">—</span>
                </div>
                {%- comment -%}
                  Purchase date is commented out rather than removed at the
                  client's request: it's an optional field at ad creation, so
                  it was showing "—" on most ads. The JS that fills it is
                  likewise left in place (guarded), so restoring this cell is
                  just deleting these comment markers.

                  <div class="ad-stat-cell">
                    <span class="ad-stat-cell__label">{{ 'custom.purchase_date' | t }}</span>
                    <span class="ad-stat-cell__value" id="ad-purchase-date-display">—</span>
                  </div>
                {%- endcomment -%}
                <div class="ad-stat-cell">
                  <span class="ad-stat-cell__label">{{ 'custom.barrel_length' | t }}</span>
                  <span class="ad-stat-cell__value" id="ad-barrel-length">—</span>
                </div>
                <div class="ad-stat-cell">
                  <span class="ad-stat-cell__label">{{ 'custom.handedness' | t }}</span>
                  <span class="ad-stat-cell__value" id="ad-handedness">—</span>
                </div>
              </div>

              <!-- Seller Info -->
              <div class="ad-seller-row">
                <div class="ad-seller-info">
                  <div id="ad-seller-avatar">{% render "icon-profile" %}</div>
                  <div class="ad-seller-info__col">
                    <span class="ad-seller-info__label">{{ 'custom.user_name' | t }}:</span>
                    <span class="ad-seller-info__value" id="ad-seller-name">—</span>
                  </div>
                </div>
                <div class="ad-contact-btns" id="ad-contact-btns">
                  <button class="button button-secondary is-small ad-btn-phone" id="btn-see-phone">
                    {% render 'icon-eye' %}
                    {{ 'custom.see_phone' | t }}
                  </button>
                  <button class="button button-secondary is-small ad-btn-contact" id="btn-contact">
                    {% render 'icon-form' %}
                    {{ 'custom.contact' | t }}
                  </button>
                </div>
              </div>

              <!-- <div class="ad-seller-type">{{ 'custom.seller_type' | t }}: {{ 'custom.private_seller' | t }}</div> -->
              

              <div class="ad-extra-details" id="ad-extra-details" style="display:none;">
                <h5 class="ad-extra-details__heading" style="display:none;">{{ 'custom.details' | t }}:</h5>
                <p id="ad-firearm-details" style="display:none;"></p>
              </div>

              <div class="ad-product-link" id="ad-product-link" style="display:none;">
                <a id="ad-product-url" href="#" target="_blank" class="button is-small" style="display:none;">
                  {{ 'custom.view_in_catalogue' | t }} →
                </a>
              </div>
            </div>
          </div>
        </div>
 
        <!-- BUYER SAFETY TIPS -->
        <!-- <div class="ad-safety-section">
          <div class="ad-detail-container">
            <h3 class="ad-safety-section__heading">{{ 'custom.buyer_safety_tips' | t }}</h3>
            <ul class="ad-safety-list">
              <li>{{ 'custom.ffl_transfer_notice' | t }}</li>
              <li>{{ 'custom.verify_seller_notice' | t }}</li>
              <li>{{ 'custom.inspect_condition_notice' | t }}</li>
              <li>{{ 'custom.firearm_law_notice' | t }}</li>
              <li>{{ 'custom.safe_payment_warning' | t }}</li>
            </ul>
          </div>
        </div> -->

        <!-- RELATED ADS -->
        <div class="ad-related-section">
          <div class="ad-detail-container">
            <h3 class="ad-related-section__heading">{{ 'custom.related_ads' | t }}</h3>
            <div class="ad-related-list" id="ad-related-list">
              <p class="ad-related-empty" id="ad-related-empty" style="display:none;">{{ 'custom.no_related_ads' | t }}</p>
            </div>
            <div class="ad-related-more-wrap">
              <button type="button" class="button button-secondary ad-related-more" id="ad-related-more" style="display:none;">{{ 'actions.show_more' | t }}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%}
  ── STICKY BOTTOM CTA STRIP ─────────────────────────────────────────────────
  Identity + price + actions, fixed to the bottom of the viewport at every
  breakpoint (the earlier version was mobile-only and carried the buttons
  alone).

  Sits OUTSIDE #section-ad-detail, which has its own padding and containers —
  a position:fixed element inside it would still work, but any future
  transform or overflow on an ancestor would silently trap it. As a top-level
  sibling it can't be.

  The buttons here are MIRRORS, not the originals: #btn-contact and
  #btn-see-phone keep living in the seller row, where all the contact-modal
  and phone-reveal logic is already bound. These forward their clicks to those
  originals and copy their visibility, so there is exactly one source of truth
  for "does this ad have a phone" and "is the viewer the owner".
{%- endcomment -%}
<div class="ad-sticky-cta" id="ad-sticky-cta" aria-hidden="true">
  <div class="ad-sticky-cta__inner container">
    <div class="ad-sticky-cta__identity">
      <img
        class="ad-sticky-cta__thumb"
        id="ad-sticky-thumb"
        src=""
        alt=""
        width="48"
        height="48"
        loading="lazy"
      >
      <div class="ad-sticky-cta__text">
        <span class="ad-sticky-cta__title" id="ad-sticky-title">—</span>
        <span class="ad-sticky-cta__meta" id="ad-sticky-meta">—</span>
      </div>
    </div>

    <div class="ad-sticky-cta__actions">
      <span class="ad-sticky-cta__price price" id="ad-sticky-price">—</span>
      <div class="ad-sticky-cta__btns" id="ad-sticky-btns">
        {%- comment -%}
          The labels stay visible at every breakpoint — both buttons fit
          beside the price down to ~340px, below which the ICONS are dropped
          and the words kept. The span is the styling hook for that, and for
          the tighter type the two-button row uses.
        {%- endcomment -%}
        <button
          type="button"
          class="button button-secondary is-small ad-btn-phone"
          id="btn-see-phone-strip"
        >
          {% render 'icon-eye' %}
          <span class="ad-sticky-cta__btn-label">{{ 'custom.see_phone' | t }}</span>
        </button>
        <button type="button" class="button is-small ad-btn-contact" id="btn-contact-strip">
          {% render 'icon-form' %}
          <span class="ad-sticky-cta__btn-label">{{ 'custom.contact' | t }}</span>
        </button>
      </div>
    </div>
  </div>
</div>


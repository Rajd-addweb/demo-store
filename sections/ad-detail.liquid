<script>window.GL_LOCALE = {{ request.locale.iso_code | json }};</script>
<script>
  // Locale-aware value translation for firearm type / subtype (mirrors the
  // homepage search section's verified valueMap — same source of truth).
  // Ad data may be stored in EITHER language, so we normalise to a canonical
  // (English) key first, then render in the active locale. Storage language
  // is therefore irrelevant. Add pairs here to translate more fields later.
  window.GLI18n = window.GLI18n || (function () {
    {% render 'gl-ads-value-translations' %}

    var ES_TO_EN = {};
    Object.keys(EN_TO_ES).forEach(function (en) {
      var es = EN_TO_ES[en];
      if (!(es in ES_TO_EN)) ES_TO_EN[es] = en; // first wins; identical dups are harmless
    });

    function locale() {
      var l = (window.GL_LOCALE || '').toLowerCase();
      return l === 'en' ? 'en' : 'es'; // Spanish is the default
    }

    // Any stored value (EN or ES) → its English canonical form.
    function canonical(value) {
      if (value == null) return '';
      var v = String(value).trim();
      if (EN_TO_ES.hasOwnProperty(v)) return v;          // already English
      if (ES_TO_EN.hasOwnProperty(v)) return ES_TO_EN[v]; // Spanish → English
      return v;                                          // unknown → pass through
    }

    // Translate a stored value into the active (or given) locale.
    function t(value, loc) {
      var target = loc || locale();
      var canon  = canonical(value);
      if (target === 'en') return canon;
      return EN_TO_ES.hasOwnProperty(canon) ? EN_TO_ES[canon] : canon;
    }

    return { t: t, canonical: canonical, locale: locale };
  })();
</script>


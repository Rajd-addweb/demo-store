                <div class="stat-item"><div><span class="icon">{% render 'icon-share' %}</span><span>${ad.shares || 0}</span></div><p>{{ 'custom.sent' | t }}</p></div>
                <div class="stat-item highlight"><div><span class="icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.37905 9.63746C4.3711 9.68633 4.37488 9.7364 4.39009 9.78352C4.4053 9.83064 4.43149 9.87347 4.46652 9.90848C4.77292 10.2148 5.43655 11.9838 6.15722 14.4149C6.24458 14.7108 6.41784 14.9741 6.65503 15.1714L8.12515 16.3964V16.875H7.81265C7.72977 16.875 7.65028 16.9079 7.59168 16.9665C7.53307 17.0251 7.50015 17.1046 7.50015 17.1875V19.0625C7.50015 19.1454 7.53307 19.2249 7.59168 19.2835C7.65028 19.3421 7.72977 19.375 7.81265 19.375H14.6876C14.7705 19.375 14.85 19.3421 14.9086 19.2835C14.9672 19.2249 15.0001 19.1454 15.0001 19.0625V17.1875C15.0001 17.1046 14.9672 17.0251 14.9086 16.9665C14.85 16.9079 14.7705 16.875 14.6876 16.875H14.3751V16.0938L15.0001 15.625C15.1938 15.4791 15.351 15.2903 15.4594 15.0734C15.5678 14.8565 15.6246 14.6175 15.6251 14.375V9.12352C15.6249 8.93513 15.5681 8.75116 15.462 8.5955C15.3559 8.43983 15.2054 8.31966 15.0301 8.25059C14.4967 8.04473 13.961 8.09043 13.4351 8.38516C13.1471 8.23242 12.8261 8.15257 12.5 8.15257C12.174 8.15257 11.8529 8.23242 11.5649 8.38516C11.0509 8.0984 10.5199 8.05 10.0001 8.24004V4.375C10.0001 4.04348 9.86845 3.72554 9.63403 3.49112C9.39961 3.2567 9.08167 3.125 8.75015 3.125C8.41863 3.125 8.10069 3.2567 7.86626 3.49112C7.63184 3.72554 7.50015 4.04348 7.50015 4.375V10.1419C7.28837 9.81502 6.99457 9.54941 6.64808 9.37156C5.64593 8.87059 4.5923 9.38578 4.54788 9.40801C4.50357 9.43014 4.46516 9.46248 4.4358 9.50238C4.40645 9.54227 4.387 9.58857 4.37905 9.63746Z" fill="#295A31"/></svg></span><span>${ad.contact_clicks || 0}</span></div><p>{{ 'custom.contact_clicks' | t }}</p></div>
                ${ad.seller_phone ? `<div class="stat-item"><div><span class="icon"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#phoneClip)"><path d="M15.8054 12.3893C15.396 11.9629 14.9021 11.735 14.3787 11.735C13.8595 11.735 13.3614 11.9587 12.9351 12.3851L11.6012 13.7147C11.4914 13.6556 11.3817 13.6007 11.2762 13.5459C11.1242 13.4699 10.9807 13.3981 10.8583 13.3222C9.6088 12.5286 8.47332 11.4944 7.38426 10.1563C6.85662 9.48936 6.50204 8.92795 6.24455 8.3581C6.59069 8.04151 6.9115 7.71226 7.22386 7.39568C7.34205 7.27749 7.46024 7.15507 7.57843 7.03688C8.46487 6.15044 8.46487 5.00229 7.57843 4.11585L6.42606 2.96348C6.29521 2.83263 6.16013 2.69755 6.0335 2.56248C5.78023 2.30077 5.5143 2.03061 5.23992 1.77734C4.83047 1.37211 4.34082 1.15684 3.82584 1.15684C3.31086 1.15684 2.81277 1.37211 2.39066 1.77734L2.38221 1.78579L0.947028 3.23364C0.406722 3.77394 0.0985794 4.43244 0.0310412 5.19647C-0.0702661 6.42904 0.292752 7.57719 0.571347 8.32855C1.25517 10.1732 2.27669 11.8827 3.80052 13.7147C5.64937 15.9224 7.87391 17.6657 10.415 18.8941C11.3859 19.3542 12.6818 19.8987 14.1296 19.9915C14.2183 19.9958 14.3111 20 14.3956 20C15.3707 20 16.1896 19.6496 16.8312 18.9531C16.8354 18.9447 16.8438 18.9405 16.8481 18.932C17.0676 18.6661 17.3208 18.4255 17.5868 18.168C17.7683 17.995 17.954 17.8134 18.1355 17.6235C18.5534 17.1887 18.7729 16.6822 18.7729 16.163C18.7729 15.6396 18.5492 15.1372 18.1228 14.7151L15.8054 12.3893Z" fill="#295A31"/></g><defs><clipPath id="phoneClip"><rect width="20" height="20" fill="white"/></clipPath></defs></svg></span><span>${ad.phone_visible || 0}</span></div><p>{{ 'custom.phone_visible' | t }}</p></div>` : ''}
              </div>
            </div>
            <div class="ad-card_button-wrap u-vflex-stretch-top u-gap-xxsmall">${renderButtons(ad)}</div>
          </div>
        </div>`;
      }

      function initSliders() {
        // Guarded so this can be called again after inserting a single new
        // card (see pollForNewAd) without double-binding sliders that a
        // previous full render() already wired up.
        document.querySelectorAll('.gun-slider[data-slider]').forEach((slider) => {
          if (slider.dataset.sliderBound) return; slider.dataset.sliderBound = '1';
          const track = slider.querySelector('.gun-slider-track');
          const dots = slider.querySelectorAll('.gun-dot');
          const prev = slider.querySelector('.gun-prev');
          const next = slider.querySelector('.gun-next');
          const slides = slider.querySelectorAll('.gun-slide');
          if (!track || slides.length <= 1) return;
          let current = 0;
          function goTo(index) {
            current = (index + slides.length) % slides.length;
            track.style.transform = `translateX(-${current * 100}%)`;
            dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
          }
          if (prev) prev.addEventListener('click', () => goTo(current - 1));
          if (next) next.addEventListener('click', () => goTo(current + 1));
          dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
        });
      }

      let allAds = [];

      // bindActions is guarded per-button (dataset.bound) so it can be called
      // again after inserting a single new card (see pollForNewAd) without
      // double-binding buttons a previous full render() already wired up.
      function bindActions() {
        document.querySelectorAll('.btn-see-ad').forEach(btn => {
          if (btn.dataset.bound) return; btn.dataset.bound = '1';
          btn.addEventListener('click', function () {
            const handle = this.dataset.handle;
            if (handle) window.location.href = `${AD_DETAIL_BASE}?handle=${handle}`;
          });
        });

        // ── Mark as Sold ──────────────────────────────────────────────────────────
        document.querySelectorAll('.btn-mark-sold').forEach(btn => {
          if (btn.dataset.bound) return; btn.dataset.bound = '1';
          btn.addEventListener('click', function () {
            const self = this;
            customConfirm('{{ "custom.mark_ad_sold" | t }}Mark this ad as sold?', async function () {
              self.disabled = true; self.textContent = '{{ "custom.updating" | t }}...';
              const ad = allAds.find(a => a.id === self.dataset.id || a.id.endsWith('/' + self.dataset.id.split('/').pop()));
              const success = await updateAdStatus(self.dataset.id, 'sold', ad);
              if (success) { render(); } else { self.disabled = false; self.textContent = '{{ "custom.mark_as_sold" | t }}'; }
            }, { confirmLabel: '{{ "custom.yes_mark_sold" | t }}' });
          });
        });

        // ── Deactivate ────────────────────────────────────────────────────────────
        document.querySelectorAll('.btn-deactivate-ad').forEach(btn => {
          if (btn.dataset.bound) return; btn.dataset.bound = '1';
          btn.addEventListener('click', function () {
            const self = this;
            customConfirm('{{ "custom.deactivate_ad" | t }}', async function () {
              self.disabled = true;
              const ad = allAds.find(a => a.id === self.dataset.id || a.id.endsWith('/' + self.dataset.id.split('/').pop()));
              const success = await updateAdStatus(self.dataset.id, 'deactivated', ad);
              if (success) render(); else self.disabled = false;
            }, { confirmLabel: '{{ "custom.yes_deactivate" | t }}' });
          });
        });

        // ── Reactivate ────────────────────────────────────────────────────────────
        document.querySelectorAll('.btn-reactivate-ad').forEach(btn => {
          if (btn.dataset.bound) return; btn.dataset.bound = '1';
          btn.addEventListener('click', function () {
            const self = this;
            customConfirm('{{ "custom.reactivate_ad" | t }}', async function () {
              self.disabled = true;
              const ad = allAds.find(a => a.id === self.dataset.id || a.id.endsWith('/' + self.dataset.id.split('/').pop()));
              const success = await updateAdStatus(self.dataset.id, 'pending', ad);
              if (success) render(); else self.disabled = false;
            }, { confirmLabel: '{{ "custom.yes_reactivate" | t }}' });
          });
        });

        // ── Delete ────────────────────────────────────────────────────────────────
        document.querySelectorAll('.btn-delete-ad').forEach(btn => {
          if (btn.dataset.bound) return; btn.dataset.bound = '1';
          btn.addEventListener('click', function () {
            const self = this;
            customConfirm('{{ "custom.delete_confirm_heading" | t }}', async function () {
              self.disabled = true; self.textContent = '{{ "custom.deleting" | t }}...';
              const success = await deleteAd(self.dataset.id);
              if (success) {
                const card = self.closest('.ads-list_item');
                if (card) card.remove();
                const remaining = document.querySelectorAll('.ads-list_item').length;
                if (remaining === 0) {
                  document.getElementById('my-adverts-list').style.display = 'none';
                  document.getElementById('my-adverts-empty').style.display = 'block';
                }
              } else { self.disabled = false; self.textContent = '{{ "custom.delete" | t }}'; }
            }, { confirmLabel: '{{ "custom.Yes_delete" | t }}', danger: true });
          });
        });

        // ── Edit ──────────────────────────────────────────────────────────────────
        document.querySelectorAll('.btn-edit-ad').forEach(btn => {
          if (btn.dataset.bound) return; btn.dataset.bound = '1';
          btn.addEventListener('click', function () {
            const adId = this.dataset.id;
            const card = this.closest('.ads-list_item');
            if (!card) return;
            const ad = allAds.find(a => a.id === adId || a.id.endsWith(adId) || a.id === card.dataset.adId);
            if (!ad) return;
            openEditAdPopup(ad);
          });
        });
      }

      // Handedness is not stored on the ad — pulled from the linked product's
      // custom.lateralidad metafield via the Storefront GraphQL API, same token
      // used elsewhere in this theme (add-ad-popup.liquid, my-armorer.liquid).
      // NOTE: the AJAX product.js endpoint does NOT support a `?metafields=`
      // param — that was a mistaken assumption in an earlier version of this
      // code and always returned nothing; GraphQL is the only way to read a
      // product metafield from the storefront.
      const STOREFRONT_API   = 'https://gunloupe.myshopify.com/api/2024-01/graphql.json';
      const STOREFRONT_TOKEN = 'cef86b403fa3eef900f70170cec5acb8';
      const handednessCache = {};

      async function fetchHandednessMap(handles) {
        const map = {};
        const CHUNK_SIZE = 20; // keep query cost/complexity reasonable per request
        for (let i = 0; i < handles.length; i += CHUNK_SIZE) {
          const chunk  = handles.slice(i, i + CHUNK_SIZE);
          const fields = chunk.map((h, idx) =>
            `p${idx}: product(handle: ${JSON.stringify(h)}) { handle metafield(namespace: "custom", key: "lateralidad") { value } }`
          ).join(' ');
          try {
            const res = await fetch(STOREFRONT_API, {
              method:  'POST',
              headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': STOREFRONT_TOKEN },
              body:    JSON.stringify({ query: `{ ${fields} }` })
            });
            if (!res.ok) continue;
            const data = await res.json();
            if (data.errors) continue;
            Object.keys(data.data || {}).forEach(key => {
              const p = data.data[key];
              if (p && p.handle) map[p.handle] = (p.metafield && p.metafield.value) || '';
            });
          } catch (e) { /* leave this chunk's handles unmapped — treated as empty below */ }
        }
        return map;
      }

      async function attachHandedness(ads) {
        const handles = [...new Set(ads.filter(ad => !ad.firearm_handedness).map(ad => ad.product_handle).filter(Boolean))]
          .filter(h => !(h in handednessCache));
        if (handles.length) {
          const map = await fetchHandednessMap(handles);
          handles.forEach(h => { handednessCache[h] = map[h] || ''; });
        }
        // Ads created after the handedness dropdown shipped already carry
        // the seller's own explicit choice — don't clobber it with the
        // product's live default. Only fill it in for older ads that don't
        // have a stored value.
        ads.forEach(ad => { if (!ad.firearm_handedness) ad.firearm_handedness = handednessCache[ad.product_handle] || ''; });
      }

      // ── Sort (client-side — mirrors section.classifieds.liquid's clf-sort) ──────
      // Cards are already rendered by render(); sorting just reorders the existing
      // DOM nodes (appendChild on an existing child moves it) rather than
      // re-fetching or re-rendering, so filter visibility/state stays untouched.
      let myAdsSortMode = 'newest';
      function applyMyAdsSort() {
        const listEl = document.getElementById('my-adverts-list');
        if (!listEl || !allAds || !allAds.length) return;
        // Ad ordering uses the numeric part of the metaobject gid, not createdAt.
        // The API's `createdAt` is really the metaobject's updatedAt (Shopify
        // exposes no createdAt for metaobjects), so it means "last modified" —
        // incrementing a view counter or editing an ad re-dated it and pushed it
        // to the top. Metaobject IDs increase with creation, so they give true
        // newest-first order.
        function adOrder(ad) {
          var n = parseInt(String((ad && ad.id) || '').split('/').pop(), 10);
          return isNaN(n) ? 0 : n;
        }
        const sorted = allAds.slice().sort(function (a, b) {
          const priceA = parseFloat(a.price) || 0;
          const priceB = parseFloat(b.price) || 0;
          const dateA  = adOrder(a);
          const dateB  = adOrder(b);
          switch (myAdsSortMode) {
            case 'oldest':     return dateA - dateB;
            case 'price_asc':  return priceA - priceB;
            case 'price_desc': return priceB - priceA;
            case 'newest':
            default:           return dateB - dateA;
          }
        });
        const cards = Array.from(listEl.querySelectorAll('.ads-list_item'));
        sorted.forEach(function (ad) {
          const card = cards.find(c => c.dataset.adId === ad.id);
          if (card) listEl.appendChild(card);
        });
      }
      const sortSelect = document.getElementById('myads-sort');
      if (sortSelect) {
        sortSelect.addEventListener('change', function () {
          myAdsSortMode = this.value;
          applyMyAdsSort();
        });
      }

      async function render() {
        const loadingEl = document.getElementById('my-adverts-loading');
        const emptyEl   = document.getElementById('my-adverts-empty');
        const listEl    = document.getElementById('my-adverts-list');
        loadingEl.style.display = 'block'; emptyEl.style.display = 'none';
        listEl.style.display = 'none'; listEl.innerHTML = '';
        const toolbar = document.getElementById('my-ads-toolbar');
        if (toolbar) toolbar.style.display = 'none';
        const ads = await fetchAds();
        allAds = ads;
        await attachHandedness(allAds);
        loadingEl.style.display = 'none';
        if (!ads || ads.length === 0) { emptyEl.style.display = 'block'; return; }
        ads.forEach(ad => listEl.insertAdjacentHTML('beforeend', renderAdCard(ad)));
        // Fills the barrel chips' inches in once the metaobject fetch lands;
        // they already read fine in cm, so nothing waits on it.
        window.GunloupeAdMeta.loadBarrelInches();
        listEl.style.display = 'flex';
        applyMyAdsSort();
        initSliders();
        bindActions();

        // Show filters only when more than 1 ad
        if (toolbar) toolbar.style.display = ads.length > 0 ? '' : 'none';
        if (typeof updatePrices === 'function') updatePrices();
        if (window.GunloupeAdPopup) window.GunloupeAdPopup.bindButtons();
      }

      // ── My Ads filters (client-side, consistent with section.classifieds.liquid) ──
      (function () {
        const I18N   = window.GLI18n || { t: v => v, canonical: v => v, locale: () => 'es' };
        const AdMeta = window.GunloupeAdMeta;

        const _clfLabels = {
          status:       '{{ 'custom.status' | t }}',
          type:    '{{ 'custom.type' | t }}',
          subtype: '{{ 'custom.subtype' | t }}',
          caliber: '{{ 'custom.caliber' | t }}',
          handedness:   '{{ 'custom.handedness' | t }}',
          brand:   '{{ 'custom.brand' | t }}',
          model:   '{{ 'custom.model' | t }}',
          gunshop: '{{ 'custom.gun_shop' | t }}',
          city:         '{{ 'custom.city' | t }}',
          availability: '{{ 'custom.availability' | t }}'
        };

        // type/subtype/handedness can be stored in either language (legacy/product
        // data); status is always the raw Spanish literal (see STATUS_LABELS) and
        // availability is a locale-agnostic key (see AVAILABILITY_LABELS), so
        // neither needs GLI18n canonicalization.
        const TRANSLATABLE = { type: true, subtype: true, handedness: true };
        const isTranslatable = key => !!TRANSLATABLE[key];

        const FILTER_KEYS = ['status', 'type', 'subtype', 'caliber', 'handedness', 'brand', 'model', 'gunshop', 'city', 'availability'];
        // Keys tucked behind the "More filters" toggle (elements with .clf-extra).
        const EXTRA_FILTER_KEYS = ['model', 'gunshop', 'city', 'availability'];

        const MYADS_FIELD = {
          type: 'firearm_type', subtype: 'firearm_subtype', brand: 'firearm_brand',
          model: 'firearm_model', caliber: 'firearm_caliber', city: 'city',
          availability: 'firearm_availability', status: 'firearm_status',
          handedness: 'firearm_handedness'
        };

        function fieldValue(ad, key) {
          if (key === 'gunshop') return ad.seller_shop_name || ad.seller_name || '';
          return ad[MYADS_FIELD[key]];
        }

        function fieldDisplay(key, value) {
          if (!value) return '';
          if (isTranslatable(key)) return I18N.t(value);
          if (key === 'status')       return STATUS_LABELS[value] || value;
          if (key === 'availability') return AVAILABILITY_LABELS[value] || value;
          return value;
        }

        function matchesMyAdsFilter(ad, key) {
          const active = myAdsActiveFilters[key];
          if (!active) return true;
          const val = fieldValue(ad, key);
          return isTranslatable(key) ? I18N.canonical(val) === I18N.canonical(active) : val === active;
        }

        function emptyMyAdsFilters() {
          return { status: '', type: '', subtype: '', caliber: '', handedness: '', brand: '', model: '', gunshop: '', city: '', availability: '' };
        }

        let myAdsActiveFilters = emptyMyAdsFilters();

        function rebuildMyAdsFilters(ads) {
          FILTER_KEYS.forEach(function (key) {
            const el = document.querySelector(`[data-myads-filter="${key}"] .clf-dropdown-list`);
            if (!el) return;

            // Narrow the pool by every OTHER active filter so options stay
            // consistent with what's actually still selectable (AC3).
            const pool = ads.filter(ad => FILTER_KEYS.every(k => k === key || matchesMyAdsFilter(ad, k)));
            const rawValues = pool.map(ad => fieldValue(ad, key)).filter(Boolean);

            let values;
            if (isTranslatable(key)) {
              values = [...new Set(rawValues.map(v => I18N.canonical(v)))]
                .sort((a, b) => I18N.t(a).localeCompare(I18N.t(b)));
            } else {
              values = [...new Set(rawValues)].sort();
            }

            const currentVal = myAdsActiveFilters[key];
            const currentCanon = isTranslatable(key) ? I18N.canonical(currentVal) : null;

            el.innerHTML = '';

            const allLi = document.createElement('li');
            allLi.className = 'clf-option' + (!currentVal ? ' is-selected' : '');
            allLi.dataset.value = '';
            allLi.textContent = '{{ 'custom.all' | t }}';
            allLi.addEventListener('click', () => selectMyAdsFilter(key, ''));
            el.appendChild(allLi);

            values.forEach(function (v) {
              const li = document.createElement('li');
              const isSelected = isTranslatable(key) ? currentCanon === v : currentVal === v;
              li.className = 'clf-option' + (isSelected ? ' is-selected' : '');
              li.dataset.value = v;
              li.textContent = fieldDisplay(key, v);
              li.addEventListener('click', () => selectMyAdsFilter(key, v));
              el.appendChild(li);
            });

            updateMyAdsToggleLabel(key, currentVal);
          });

          updateMoreToggleLabel();
          renderActiveChips();
        }

        // Reflects active hidden filters on the "More filters" toggle itself, so
        // a selection made while expanded stays visible after collapsing again.
        function updateMoreToggleLabel() {
          if (!moreToggleBtn) return;
          const isOpen    = extraFiltersOpen;
          const hasActive = EXTRA_FILTER_KEYS.some(k => {
            const v = myAdsActiveFilters[k];
            return Array.isArray(v) ? v.length > 0 : !!v;
          });
          const textEl = moreToggleBtn.querySelector('.clf-more-text');
          if (textEl) {
            textEl.textContent = isOpen ? '{{ 'custom.hide_filters' | t }}' : '{{ 'custom.more_filters' | t }}';
          }
          moreToggleBtn.classList.toggle('clf-active', hasActive || isOpen);
        }

        // "Label: Value" rather than the bare value, so an active filter says
        // WHICH filter it belongs to, plus a one-click clear. See gl-ad-meta.
        function updateMyAdsToggleLabel(key, value) {
          const toggle    = document.querySelector(`[data-myads-filter="${key}"] .clf-dropdown-toggle`);
          const baseLabel = _clfLabels[key] || key;
          const text      = value ? `${baseLabel}: ${fieldDisplay(key, value)}` : baseLabel;
          AdMeta.paintToggle(toggle, text, !!value, key);
        }

        // Every selected value as [{key, value, display}] for the mobile rail.
        function activeFilterSummary() {
          return FILTER_KEYS
            .filter(key => !!myAdsActiveFilters[key])
            .map(key => {
              const value = myAdsActiveFilters[key];
              return { key: key, value: value, display: `${_clfLabels[key] || key}: ${fieldDisplay(key, value)}` };
            });
        }

        function renderActiveChips() {
          AdMeta.renderChipRail(document.getElementById('myads-active-chips'), activeFilterSummary());
        }

        AdMeta.bindClearHandler(function (key) { selectMyAdsFilter(key, ''); });

        function selectMyAdsFilter(key, value) {
          myAdsActiveFilters[key] = value;
          document.querySelectorAll('[data-myads-filter].open').forEach(d => d.classList.remove('open'));
          applyMyAdsFilters();
        }

        function applyMyAdsFilters() {
          if (!allAds) return;

          document.querySelectorAll('#my-adverts-list .ads-list_item').forEach(function (card) {
            const adId = card.dataset.adId;
            const ad = allAds.find(a => a.id === adId);
            if (!ad) return;
            const isMatch = FILTER_KEYS.every(key => matchesMyAdsFilter(ad, key));
            card.style.display = isMatch ? '' : 'none';
          });

          // Rebuild dropdowns based on full allAds so options don't disappear
          rebuildMyAdsFilters(allAds);
        }

        // ── "More filters" toggle — reveals City/Availability/Status/Handedness
        // (plus the row-break spacer) via the `hidden` attribute, so the shown
        // state falls back to each element's own display rules instead of
        // fighting them on CSS specificity. ──────────────────────────────────────
        const moreToggleBtn = document.getElementById('myads-more-toggle');
        const filterTabsEl  = moreToggleBtn ? moreToggleBtn.closest('.filter-tabs') : null;
        let extraFiltersOpen = false;
        if (moreToggleBtn && filterTabsEl) {
          moreToggleBtn.addEventListener('click', function () {
            document.querySelectorAll('[data-myads-filter].open').forEach(d => d.classList.remove('open'));
            extraFiltersOpen = !extraFiltersOpen;
            filterTabsEl.querySelectorAll('.clf-extra, .clf-row-break').forEach(el => { el.hidden = !extraFiltersOpen; });
            updateMoreToggleLabel();
          });
        }

        // Dropdown toggle — reuse clf-dropdown toggle pattern
        document.addEventListener('click', function (e) {
          const toggleBtn = e.target.closest('[data-myads-filter] .clf-dropdown-toggle');
          if (toggleBtn) {
            const dropdown = toggleBtn.closest('[data-myads-filter]');
            const isOpen = dropdown.classList.contains('open');
            document.querySelectorAll('[data-myads-filter].open').forEach(d => d.classList.remove('open'));
            if (!isOpen) { dropdown.classList.add('open'); dropdown.querySelector('.clf-dropdown-search')?.focus(); }
            return;
          }
          if (!e.target.closest('[data-myads-filter]')) {
            document.querySelectorAll('[data-myads-filter].open').forEach(d => d.classList.remove('open'));
          }
        });

        // Search inside filter dropdowns
        document.querySelectorAll('[data-myads-filter] .clf-dropdown-search').forEach(function (input) {
          input.addEventListener('input', function () {
            const key = this.closest('[data-myads-filter]').dataset.myadsFilter;
            const q = this.value.toLowerCase();
            const list = this.nextElementSibling;
            list.querySelectorAll('li.clf-option').forEach(function (li) {
              if (!li.dataset.value) return; // keep "All" always visible
              li.style.display = li.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
          });
        });

        // Reset — two triggers share this handler: one inline (desktop, sits with
        // the last filter row) and one outside the drawer (mobile, reachable
        // without opening it).
        document.querySelectorAll('.js-myads-reset').forEach(btn => btn.addEventListener('click', function () {
          myAdsActiveFilters = emptyMyAdsFilters();
          document.querySelectorAll('[data-myads-filter] .clf-dropdown-search').forEach(i => i.value = '');
          applyMyAdsFilters();
        }));

        // Hook into the existing render() — rebuild filters after ads load
        const origRender = window._myAdsRenderHook;
        // We patch allAds watcher via MutationObserver on the list
        const listEl = document.getElementById('my-adverts-list');
        if (listEl) {
          const observer = new MutationObserver(function () {
            if (allAds && allAds.length) {
              rebuildMyAdsFilters(allAds);
            }
          });
          observer.observe(listEl, { childList: true });
        }
      })();

      // ── New-ad skeleton (create flow handoff from add-ad-popup.liquid) ─────────
      // add-ad-popup.liquid stores the newly-created ad's id here right before
      // redirecting to this page, so we can show it immediately instead of
      // waiting for a fixed delay and hoping Shopify's backend has caught up.
      function insertAdSkeleton(imgSrc) {
        const listEl  = document.getElementById('my-adverts-list');
        const emptyEl = document.getElementById('my-adverts-empty');
        if (!listEl) return null;
        emptyEl.style.display = 'none';
        listEl.style.display  = 'flex';
        const el = document.createElement('div');
        el.className = 'ads-list_item is-skeleton';
        el.innerHTML = `
          <div class="ad-card_component">
            <div class="ad-card_logo-wrap"><div class="gun-card__media-wrapper"><div class="gun-card__media" style="position:relative;">
              <div class="ad-skel-badge"><span class="spin"></span>{{ "custom.creating" | t }}...</div>
              ${imgSrc ? `<img src="${imgSrc}" alt="" style="opacity:.6;width:100%;height:100%;object-fit:cover;">` : ''}
            </div></div></div>
            <div class="ad-card_component-data" style="padding:16px;display:flex;flex-direction:column;gap:10px;">
              <div class="ad-skel-line" style="height:18px;width:60%;"></div>
              <div class="ad-skel-line" style="height:12px;width:85%;"></div>
              <div class="ad-skel-line" style="height:12px;width:70%;"></div>
            </div>
          </div>`;
        listEl.insertBefore(el, listEl.firstChild);
        el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return el;
      }

      // Polls fetchAds() for the confirmed new ad, then swaps the skeleton for
      // that one real card in place — no full-list rebuild, so there's no
      // "list hides, spinner, list reappears" flash for everything else
      // already on screen. Falls back to the page's normal full render() if
      // confirmation doesn't arrive in the expected window, which is never
      // worse than the previous fixed-delay-then-redirect behavior.
      async function pollForNewAd(targetId, skeletonEl) {
        const maxAttempts = 20, interval = 1000;
        const targetBare = String(targetId).split('/').pop();
        for (let i = 0; i < maxAttempts; i++) {
          // First attempt fires immediately. Shopify has almost always made
          // the ad readable by the time this page has finished loading, so
          // sleeping before the first fetch added a guaranteed second of
          // waiting to the case that actually happens.
          if (i) await new Promise(r => setTimeout(r, interval));
          try {
            const ads = await fetchAds();
            const foundAd = ads.find(a => (a.id || '').split('/').pop() === targetBare);
            if (foundAd) {
              allAds = ads;
              // Defensive: if a full render() already drew a card for this ad,
              // don't add a second one — just drop the skeleton.
              const alreadyInDom = Array.from(
                document.querySelectorAll('#my-adverts-list .ads-list_item')
              ).some(c => c.dataset.adId === foundAd.id);
              if (alreadyInDom) {
                if (skeletonEl && skeletonEl.parentNode) skeletonEl.remove();
                return;
              }

              // Swap the skeleton for the confirmed card, in place. This
              // branch was missing: the loop found the ad, failed the
              // alreadyInDom test it can never pass (the poll only starts
              // when the card ISN'T on screen), then kept polling until the
              // attempt limit ran out — so every ad creation sat on the
              // skeleton for the full window before the fallback render()
              // finally drew it.
              await attachHandedness([foundAd]);
              const listEl = document.getElementById('my-adverts-list');
              if (skeletonEl && skeletonEl.parentNode) {
                skeletonEl.insertAdjacentHTML('beforebegin', renderAdCard(foundAd));
                skeletonEl.remove();
              } else if (listEl) {
                listEl.insertAdjacentHTML('afterbegin', renderAdCard(foundAd));
              } else {
                return;
              }
              if (listEl) listEl.style.display = 'flex';
              const emptyEl = document.getElementById('my-adverts-empty');
              if (emptyEl) emptyEl.style.display = 'none';
              const toolbar = document.getElementById('my-ads-toolbar');
              if (toolbar) toolbar.style.display = '';
              // Same wiring render() does, minus the full-list rebuild.
              // initSliders/bindActions are guarded per-element, so the cards
              // already on screen aren't double-bound.
              applyMyAdsSort();
              initSliders();
              bindActions();
              if (typeof updatePrices === 'function') updatePrices();
              if (window.GunloupeAdPopup) window.GunloupeAdPopup.bindButtons();
              return;
            }
          } catch (e) {}
        }
        // Confirmation didn't arrive in the expected window — fall back to a
        // normal full render(), same safety net used everywhere else.
        if (skeletonEl) skeletonEl.remove();
        await render();
      }

      // Exposed so add-ad-popup.liquid can show a just-created ad inline when
      // the "sell a firearm" popup was opened from this same page (the
      // #sell-firearm-btn flow) — avoids navigating to this exact page we're
      // already on, which otherwise shows as a jarring full-page reload.
      window.GunloupeMyAds = {
        showNewAd: function (adId, imgSrc) {
          if (!adId) return;
          var skeletonEl = insertAdSkeleton(imgSrc);
          pollForNewAd(adId, skeletonEl);
        }
      };

      document.addEventListener('DOMContentLoaded', async function () {
        let pending = null;
        try {
          const raw = sessionStorage.getItem('gl_pending_new_ad');
          if (raw) {
            sessionStorage.removeItem('gl_pending_new_ad');
            const parsed = JSON.parse(raw);
            if (parsed && parsed.id && (Date.now() - (parsed.ts || 0) < 120000)) pending = parsed;
          }
        } catch (e) {}

        await render();

        if (pending) {
          // render() above fetches ALL ads, and the create endpoint writes the
          // ad synchronously before redirecting here — so it's usually already
          // in that list and render() has drawn it. Firing skeleton+poll anyway
          // adds a SECOND card for the same ad (the poll finds it and inserts at
          // the top). Only skeleton+poll when render() didn't already show it,
          // i.e. the backend genuinely hadn't caught up yet.
          const pendingBare = pending.id.split('/').pop();
          const alreadyShown = allAds.some(a => (a.id || '').split('/').pop() === pendingBare);
          if (!alreadyShown) {
            const skeletonEl = insertAdSkeleton(pending.image);
            pollForNewAd(pending.id, skeletonEl);
          }
        }
      });

      document.addEventListener('DOMContentLoaded', function () {
        var purchaseDateInput = document.getElementById('edit-ad-purchase-date');
        if (purchaseDateInput && window.GunloupeDatePicker) {
          window.GunloupeDatePicker.attach(purchaseDateInput, {
            maxDate: 'today',
            labels: {
              set: {{ 'custom.date_picker_set' | t | json }},
              cancel: {{ 'custom.date_picker_cancel' | t | json }},
              clear: {{ 'custom.date_picker_clear' | t | json }}
            }
          });
        }
      });
    })();

    (function () {
    function bindSellFirearmBtn() {
      var btn = document.getElementById('sell-firearm-btn');
      if (!btn || btn.dataset.adOpenBound) return;
      btn.dataset.adOpenBound = '1';
      btn.addEventListener('click', function () {
        if (window.GunloupeAdPopup && window.GunloupeAdPopup.openSelection) {
          window.GunloupeAdPopup.openSelection();
        }
      });
    }

    // Bind immediately + after DOM ready (popup snippet may load after)
    bindSellFirearmBtn();
    document.addEventListener('DOMContentLoaded', bindSellFirearmBtn);
  })();

  </script>
{% endif %}

{% schema %}
{
  "name": "My Adverts",
  "settings": [
    { "type": "header", "content": "Layout Settings" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 100, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 100, "step": 4, "default": 40 }
  ],
  "presets": [{ "name": "My Adverts" }]
}

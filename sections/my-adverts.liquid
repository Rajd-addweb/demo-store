  {% render 'gl-ad-meta' %}
  <script>
    var STATUS_LABELS = {
      'Nuevo':      '{{ "custom.new" | t }}',
      'Semi-nuevo': '{{ "custom.nearly_new" | t }}',
      'Usado':      '{{ "custom.used" | t }}',
      'Desactivado':'{{ "custom.deactivated" | t }}'
    };
    var AVAILABILITY_LABELS = {
      'in_stock':'{{ "custom.availability_in_stock" | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" }}',
      'wholesaler':'{{ "custom.availability_wholesaler" | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" }}',
      'on_demand':'{{ "custom.availability_on_demand" | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" }}'
    };

    window.GL_LOCALE = {{ request.locale.iso_code | json }};
    // Locale-aware canonicalization for firearm type/subtype/handedness — mirrors
    // section.classifieds.liquid's verified GLI18n (same source of truth). Ad data
    // may be stored in EITHER language, so values are normalised to a canonical
    // (English) key first, then rendered in the active locale.
    window.GLI18n = window.GLI18n || (function () {
      {% render 'gl-ads-value-translations' %}

      var ES_TO_EN = {};
      Object.keys(EN_TO_ES).forEach(function (en) {
        var es = EN_TO_ES[en];
        if (!(es in ES_TO_EN)) ES_TO_EN[es] = en;
      });

      function locale() {
        var l = (window.GL_LOCALE || '').toLowerCase();
        return l === 'en' ? 'en' : 'es';
      }

      function canonical(value) {
        if (value == null) return '';
        var v = String(value).trim();
        if (EN_TO_ES.hasOwnProperty(v)) return v;
        if (ES_TO_EN.hasOwnProperty(v)) return ES_TO_EN[v];
        return v;
      }

      function t(value, loc) {
        var target = loc || locale();
        var canon  = canonical(value);
        if (target === 'en') return canon;
        return EN_TO_ES.hasOwnProperty(canon) ? EN_TO_ES[canon] : canon;
      }

      return { t: t, canonical: canonical, locale: locale };
    })();

    function validatePhone(value) {
      const raw = (value || '').trim();
      if (!raw) return { valid: true, error: null };

      if (!/^[\d\s\-().]+$/.test(raw)) return { valid: false, error: '{{ "custom.phone_contain_validation" | t }}' };
      const digitsOnly = raw.replace(/\D/g, '');
      if (digitsOnly.length < 7)  return { valid: false, error: '{{ "custom.phone_short_validation" | t }}' };
    if (digitsOnly.length > 15) return { valid: false, error: '{{ "custom.phone_max_validation" | t }}' };
    if (/^(\d)\1+$/.test(digitsOnly)) return { valid: false, error: '{{ "custom.phone_number_validation" | t }}' };
      return { valid: true, error: null };
    }

    (function () {
      const BACKEND_URL = 'https://collaboration-assumes-shed-smoke.trycloudflare.com';
      const CUSTOMER_ID = '{{ customer.id }}';

      const R = window.GunloupeRoutes || {};
      const AD_DETAIL_BASE = R.adDetail || '/pages/ad-detail';
      const MY_ARMORER_URL = R.myArmorer || '/pages/mi-armero';

      // ── Custom confirm popup ───────────────────────────────────────────────────
      // opts: { danger: bool, confirmLabel: string }
      // confirmLabel drives the confirm button text — each action passes its own.
      const confirmOverlay  = document.getElementById('customConfirmOverlay');
      const confirmMessage  = document.getElementById('customConfirmMessage');
      const confirmYesBtn   = document.getElementById('customConfirmYes');
      const confirmNoBtn    = document.getElementById('customConfirmCancel');
      const confirmCloseBtn = document.getElementById('customConfirmClose');

      let _confirmCallback = null;

      function customConfirm(message, onConfirm, opts) {
        opts = opts || {};
        confirmMessage.textContent  = message;
        confirmYesBtn.textContent   = opts.confirmLabel || 'Yes';
        confirmYesBtn.classList.toggle('is-danger', !!opts.danger);
        _confirmCallback = onConfirm;
        confirmOverlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function closeConfirm() {
        confirmOverlay.style.display = 'none';
        document.body.style.overflow = '';
        _confirmCallback = null;
      }

      confirmYesBtn.addEventListener('click', function () {
        const cb = _confirmCallback;
        closeConfirm();
        if (cb) cb();
      });
      confirmNoBtn.addEventListener('click', closeConfirm);
      confirmCloseBtn.addEventListener('click', closeConfirm);
      confirmOverlay.addEventListener('click', function (e) {
        if (e.target === confirmOverlay) closeConfirm();
      });

      // ── Edit popup state ───────────────────────────────────────────────────────
      let editAd = null, editKeepImages = [], editNewImages = [], editGunStatus = '', editAvailability = '', editHandedness = '';

      const editOverlay   = document.getElementById('edit-ad-overlay');
      const editErrorEl   = document.getElementById('edit-ad-form-error');
      const editLoaderEl  = document.getElementById('edit-ad-loader');
      const editSubmitBtn = document.getElementById('edit-ad-submit');
      const editSubmitTxt = document.getElementById('edit-ad-submit-text');
      const editSubmitLdr = document.getElementById('edit-ad-submit-loading');

      function openEditAdPopup(ad) {
        editAd = ad;
        editErrorEl.style.display = 'none';

        document.getElementById('edit-ad-type').value    = ad.firearm_type    || '';
        document.getElementById('edit-ad-subtype').value = ad.firearm_subtype || '';
        document.getElementById('edit-ad-brand').value   = ad.firearm_brand   || '';
        document.getElementById('edit-ad-model').value   = ad.firearm_model   || '';
        document.getElementById('edit-ad-caliber').value = ad.firearm_caliber || '';

        const parts = [ad.firearm_type, ad.firearm_subtype, ad.firearm_brand, ad.firearm_model, ad.firearm_caliber, ad.firearm_barrel].filter(Boolean);
        document.getElementById('edit-ad-details-field').value = parts.join(' / ');

        document.getElementById('edit-ad-personalized-name').value = ad.firearm_personalized_name || '';
        document.getElementById('edit-ad-city').value              = ad.city                       || '';
        // Editing "follows the toggle": show the ad's stored price
        // converted from its own currency into whatever is currently
        // toggled, so the number in the field matches what will be
        // submitted if the seller doesn't touch it.
        if (ad.price) {
          var editSourceCurrency = ad.currency || 'EUR';
          var editViewCurrency   = localStorage.getItem('currency') || 'EUR';
          var editRate           = (typeof EUR_TO_USD !== 'undefined' && EUR_TO_USD) ? EUR_TO_USD : parseFloat(localStorage.getItem('eur_to_usd') || '1.08');
          var editAmountInEur    = editSourceCurrency === 'USD' ? parseFloat(ad.price) / editRate : parseFloat(ad.price);
          document.getElementById('edit-ad-price').value = editViewCurrency === 'USD' ? Math.round(editAmountInEur * editRate) : Math.round(editAmountInEur);
        } else {
          document.getElementById('edit-ad-price').value = '';
        }
        document.getElementById('edit-ad-description').value       = ad.description                || '';
        document.getElementById('edit-ad-purchase-date').value     = ad.firearm_purchase_date      || '';
        document.getElementById('edit-ad-phone').value             = ad.seller_phone               || '';

        editGunStatus = ad.firearm_status || '';
        const statusBtn = document.getElementById('edit-ad-status-btn');
        statusBtn.textContent = STATUS_LABELS[editGunStatus] || editGunStatus || statusBtn.dataset.default;
        document.querySelectorAll('input[name="edit_gun_status"]').forEach(r => { r.checked = (r.value === editGunStatus); });

        editAvailability = ad.firearm_availability || '';
        const availBtn = document.getElementById('edit-ad-availability-btn');
        availBtn.textContent = AVAILABILITY_LABELS[editAvailability] || editAvailability || availBtn.dataset.default;
        document.querySelectorAll('input[name="edit_availability"]').forEach(r => { r.checked = (r.value === editAvailability); });

        editHandedness = ad.firearm_handedness || '';
        const handBtn = document.getElementById('edit-ad-handedness-btn');
        handBtn.textContent = editHandedness ? window.GLI18n.t(editHandedness) : handBtn.dataset.default;
        document.querySelectorAll('input[name="edit_handedness"]').forEach(r => { r.checked = (r.value === editHandedness); });
        // Handedness describes the physical firearm, same as brand/model/
        // caliber above — once it has a value it shouldn't drift between
        // edits, so show it as the exact same plain readonly field as
        // those instead of the interactive dropdown. Ads created before
        // this field existed have no stored value yet, so leave those on
        // the dropdown — otherwise there'd be no way to ever set one.
        const handDropdown2  = document.getElementById('edit-handedness-dropdown');
        const handDisplayEl  = document.getElementById('edit-ad-handedness-display-wrapper');
        const handDisplayIn  = document.getElementById('edit-ad-handedness-display');
        if (editHandedness) {
          handDropdown2.style.display = 'none';
          handDisplayEl.style.display = '';
          handDisplayIn.value = window.GLI18n.t(editHandedness);
        } else {
          handDropdown2.style.display = '';
          handDisplayEl.style.display = 'none';
          handDisplayIn.value = '';
        }

        let customImages = [];
        try {
          const parsed = JSON.parse(ad.ad_images || '[]');
          if (Array.isArray(parsed)) customImages = parsed.filter(u => u && u.startsWith('http'));
        } catch (e) {}

        editKeepImages = [...customImages];
        editNewImages  = [];

        const preview = document.getElementById('edit-image-preview');
        preview.innerHTML = '';
        if (customImages.length > 0) {
          customImages.forEach((url, i) => preview.appendChild(buildThumb(url, i, 'existing')));
        }

        editOverlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function buildThumb(src, idx, type) {
        const wrapper = document.createElement('div');
        wrapper.style.cssText = 'position:relative;border:1px solid #ddd;border-radius:8px;overflow:hidden;';
        const img = document.createElement('img');
        img.src = src;
        img.style.cssText = 'width:70px;height:50px;object-fit:cover;display:block;';
        const removeBtn = document.createElement('span');
        removeBtn.className = 'remove-img';
        removeBtn.textContent = '×';
        removeBtn.addEventListener('click', function () {
          if (type === 'existing') { editKeepImages[idx] = null; }
          else { editNewImages = editNewImages.filter(i => i !== src); }
          wrapper.remove();
        });
        wrapper.appendChild(img);
        wrapper.appendChild(removeBtn);
        return wrapper;
      }

      function closeEditPopup() {
        editOverlay.style.display = 'none';
        document.body.style.overflow = '';
        editAd = null; editKeepImages = []; editNewImages = []; editGunStatus = ''; editAvailability = ''; editHandedness = '';
        editErrorEl.style.display = 'none';
        document.getElementById('edit-image-preview').innerHTML = '';
        document.querySelectorAll('input[name="edit_gun_status"]').forEach(r => r.checked = false);
        document.querySelectorAll('input[name="edit_availability"]').forEach(r => r.checked = false);
        document.querySelectorAll('input[name="edit_handedness"]').forEach(r => r.checked = false);
        const statusBtn = document.getElementById('edit-ad-status-btn');
        statusBtn.textContent = statusBtn.dataset.default;
        const availBtn2 = document.getElementById('edit-ad-availability-btn');
        if (availBtn2) availBtn2.textContent = availBtn2.dataset.default;
        const handBtn2 = document.getElementById('edit-ad-handedness-btn');
        if (handBtn2) handBtn2.textContent = handBtn2.dataset.default;
        const dropdown = document.getElementById('edit-status-dropdown');
        if (dropdown) { dropdown.classList.remove('open'); const m = dropdown.querySelector('.dropdown-menu'); if (m) m.style.display = 'none'; }
        const availDropdown = document.getElementById('edit-availability-dropdown');
        if (availDropdown) { availDropdown.classList.remove('open'); const m2 = availDropdown.querySelector('.dropdown-menu'); if (m2) m2.style.display = 'none'; }
        const handDropdown = document.getElementById('edit-handedness-dropdown');
        if (handDropdown) { handDropdown.classList.remove('open'); handDropdown.style.display = ''; const m3 = handDropdown.querySelector('.dropdown-menu'); if (m3) m3.style.display = 'none'; }
        const handDisplayWrap = document.getElementById('edit-ad-handedness-display-wrapper');
        if (handDisplayWrap) handDisplayWrap.style.display = 'none';
        const handDisplayIn = document.getElementById('edit-ad-handedness-display');
        if (handDisplayIn) handDisplayIn.value = '';
      }

      document.getElementById('edit-ad-close').addEventListener('click', closeEditPopup);
      document.getElementById('edit-ad-cancel').addEventListener('click', closeEditPopup);
      editOverlay.addEventListener('click', function (e) { if (e.target === editOverlay) closeEditPopup(); });

      document.getElementById('edit-ad-status-btn').addEventListener('click', function () {
        const dropdown = this.closest('.custom-dropdown');
        const menu = this.nextElementSibling;
        const isOpen = dropdown.classList.contains('open');
        document.querySelectorAll('#edit-ad-overlay .custom-dropdown').forEach(d => { d.classList.remove('open'); d.querySelector('.dropdown-menu').style.display = 'none'; });
        if (!isOpen) { dropdown.classList.add('open'); menu.style.display = 'block'; }
      });

      document.querySelectorAll('input[name="edit_gun_status"]').forEach(radio => {
        radio.addEventListener('change', function () {
          editGunStatus = this.value;
          document.getElementById('edit-ad-status-btn').textContent = STATUS_LABELS[this.value] || this.value;
          const dropdown = this.closest('.custom-dropdown');
          dropdown.classList.remove('open');
          dropdown.querySelector('.dropdown-menu').style.display = 'none';
        });
      });

      document.getElementById('edit-ad-availability-btn').addEventListener('click', function () {
        const dropdown = this.closest('.custom-dropdown');
        const menu = this.nextElementSibling;
        const isOpen = dropdown.classList.contains('open');
        document.querySelectorAll('#edit-ad-overlay .custom-dropdown').forEach(d => { d.classList.remove('open'); d.querySelector('.dropdown-menu').style.display = 'none'; });
        if (!isOpen) { dropdown.classList.add('open'); menu.style.display = 'block'; }
      });

      document.querySelectorAll('input[name="edit_availability"]').forEach(radio => {
        radio.addEventListener('change', function () {
          editAvailability = this.value;
          document.getElementById('edit-ad-availability-btn').textContent = AVAILABILITY_LABELS[this.value] || this.value;
          const dropdown = this.closest('.custom-dropdown');
          dropdown.classList.remove('open');
          dropdown.querySelector('.dropdown-menu').style.display = 'none';
        });
      });

      document.getElementById('edit-ad-handedness-btn').addEventListener('click', function () {
        const dropdown = this.closest('.custom-dropdown');
        const menu = this.nextElementSibling;
        const isOpen = dropdown.classList.contains('open');
        document.querySelectorAll('#edit-ad-overlay .custom-dropdown').forEach(d => { d.classList.remove('open'); d.querySelector('.dropdown-menu').style.display = 'none'; });
        if (!isOpen) { dropdown.classList.add('open'); menu.style.display = 'block'; }
      });

      document.querySelectorAll('input[name="edit_handedness"]').forEach(radio => {
        radio.addEventListener('change', function () {
          editHandedness = this.value;
          document.getElementById('edit-ad-handedness-btn').textContent = window.GLI18n.t(this.value);
          const dropdown = this.closest('.custom-dropdown');
          dropdown.classList.remove('open');
          dropdown.querySelector('.dropdown-menu').style.display = 'none';
        });
      });

      document.getElementById('edit-images-input').addEventListener('change', function() {
        const errorEl = document.getElementById('edit-ad-form-error');
        [...this.files].forEach(file => {
          const reader = new FileReader();
          reader.onload = e => {
            const base64 = e.target.result;
            // ── Validate minimum 300×300 before accepting ──────────────
            const checker = new Image();
            checker.onload = function() {
              if (checker.naturalWidth < 300) {
                if (errorEl) { errorEl.textContent = '{{ "custom.image_requirement | t " }} 300×300px.'; errorEl.style.display = 'block'; }
                return;
              }
              if (errorEl) errorEl.style.display = 'none';
              editNewImages.push(base64);  // ← was newImages (undefined)
              const preview = document.getElementById('edit-image-preview');
              const wrapper = document.createElement('div');
              wrapper.style.cssText = 'position:relative;border:1px solid #ddd;border-radius:8px;overflow:hidden;';
              const img = document.createElement('img');
              img.src = base64;
              img.style.cssText = 'width:70px;height:50px;object-fit:cover;display:block;';
              const removeBtn = document.createElement('span');
              removeBtn.className = 'remove-img';
              removeBtn.textContent = '×';
              removeBtn.addEventListener('click', () => {
                editNewImages = editNewImages.filter(i => i !== base64);  // ← was newImages
                wrapper.remove();
              });
              wrapper.appendChild(img);
              wrapper.appendChild(removeBtn);
              preview.appendChild(wrapper);
            };
            checker.src = base64;
          };
          reader.readAsDataURL(file);
        });
        this.value = '';
      });

      document.getElementById('edit-ad-submit').addEventListener('click', async function () {
        editErrorEl.style.display = 'none';
        editErrorEl.textContent = '';

        const city  = document.getElementById('edit-ad-city').value.trim();
        const price = document.getElementById('edit-ad-price').value.trim();
        const phone = document.getElementById('edit-ad-phone').value.trim();

        const errors = [];
        if (!city)          errors.push('{{ "custom.city_required" | t }}.');
        if (!price)         errors.push('{{ "custom.price_required" | t }}.');
        if (!editGunStatus) errors.push('{{ "custom.firearm_status_required" | t }}.');
        if (!editAvailability) errors.push('{{ "custom.select_availability" | t }}.');
        const phoneCheck = validatePhone(phone);
        if (!phoneCheck.valid) errors.push(phoneCheck.error);

        if (errors.length > 0) {
          editErrorEl.innerHTML = errors.join('<br>');
          editErrorEl.style.display = 'block';
          return;
        }
        editLoaderEl.style.display = 'flex';
        document.querySelector('#edit-ad-overlay .ad-popup').style.overflow = 'hidden';
        editSubmitBtn.disabled = true;
        editSubmitTxt.style.display = 'none';
        editSubmitLdr.style.display = 'inline';
        const payload = {
          city, price, currency: localStorage.getItem('currency') || 'EUR', seller_phone: phone, firearm_status: editGunStatus,
          firearm_availability: editAvailability,
          firearm_handedness: editHandedness,
          firearm_purchase_date: document.getElementById('edit-ad-purchase-date').value,
          description: document.getElementById('edit-ad-description').value,
          firearm_personalized_name: document.getElementById('edit-ad-personalized-name').value,
          existing_images: JSON.stringify(editKeepImages.filter(Boolean)),
          images: editNewImages,
        };
        try {
          const res = await fetch(`${BACKEND_URL}/my-adverts/${encodeURIComponent(editAd.id)}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.success) {
            editLoaderEl.style.display = 'none';  // ← ADD THIS
            document.querySelector('#edit-ad-overlay .ad-popup').style.overflow = '';  // ← ADD THIS
            editSubmitBtn.disabled = false;  // ← ADD THIS
            editSubmitTxt.style.display = 'inline';  // ← ADD THIS
            editSubmitLdr.style.display = 'none';  // ← ADD THIS
            closeEditPopup();
            render();
          }
          else {
            editLoaderEl.style.display = 'none';
            document.querySelector('#edit-ad-overlay .ad-popup').style.overflow = '';
            editSubmitBtn.disabled = false;
            editSubmitTxt.style.display = 'inline'; editSubmitLdr.style.display = 'none';
            editErrorEl.textContent = '{{ "custom.error_saving" | t }}'; editErrorEl.style.display = 'block';
          }
        } catch (e) {
          editLoaderEl.style.display = 'none';
          document.querySelector('#edit-ad-overlay .ad-popup').style.overflow = '';
          editSubmitBtn.disabled = false;
          editSubmitTxt.style.display = 'inline'; editSubmitLdr.style.display = 'none';
          editErrorEl.textContent = '{{ "custom.server_error" | t }}'; editErrorEl.style.display = 'block';
        }
      });

      // ── Fetch ads ──────────────────────────────────────────────────────────────
      async function fetchAds() {
        try {
          const res = await fetch(`${BACKEND_URL}/my-adverts/customer/${CUSTOMER_ID}`);
          const data = await res.json();
          if (!data.success) return [];
          return data.ads || [];
        } catch (e) { console.error('Fetch ads error:', e); return []; }
      }

      async function deleteAd(id) {
        try {
          const res = await fetch(`${BACKEND_URL}/my-adverts/${encodeURIComponent(id)}`, { method: 'DELETE' });
          const data = await res.json();
          return data.success;
        } catch (e) { console.error('Delete ad error:', e); return false; }
      }

      async function updateAdStatus(id, adStatus, ad) {
        try {
          const res = await fetch(`${BACKEND_URL}/my-adverts/${encodeURIComponent(id)}`, {
            method: 'PUT', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isAdminUpdate: true, adStatus }),
          });
          const data = await res.json();
          if (data.success && ad) {
            const actionMap = { sold: 'sold', deactivated: 'deactivated', pending: 'reactivated' };
            const action = actionMap[adStatus];
            if (action) {
              fetch(`${BACKEND_URL}/notify-admin`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action, adId: ad.id, customerId: CUSTOMER_ID, firearmBrand: ad.firearm_brand, firearmModel: ad.firearm_model, sellerName: ad.seller_name, sellerEmail: ad.seller_email, price: ad.price, currency: ad.currency || 'EUR', city: ad.city }),
              }).catch(() => {});
            }
          }
          return data.success;
        } catch (e) { console.error('Update status error:', e); return false; }
      }

      function formatDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      }

      function getRejectedCountdown(createdAt) {
        const deadline = new Date(new Date(createdAt).getTime() + 21 * 24 * 60 * 60 * 1000);
        const diff = deadline - new Date();
        if (diff <= 0) return 'Expired';
        return `${Math.floor(diff / 86400000)}d ${Math.floor((diff % 86400000) / 3600000)}h left to edit`;
      }

      function parseImages(adImages, productImage) {
        let images = [];
        if (adImages) { try { images = JSON.parse(adImages); } catch { images = []; } }
        if (!images.length && productImage) images = [productImage];
        if (!images.length) images = ['https://cdn.shopify.com/s/files/1/0977/9986/4694/files/product-placeholder.svg'];
        return images;
      }

      function renderSlider(images, adId) {
        if (images.length === 1) return `<img src="${images[0]}" alt="Ad image" class="ad-single-image" loading="lazy">`;
        const slides = images.map(img => `<div class="gun-slide"><img src="${img}" alt="Ad image" loading="lazy"></div>`).join('');
        return `<div class="gun-slider" data-slider data-ad-id="${adId}"><div class="gun-slider-track">${slides}</div><button class="gun-prev" type="button">‹</button><button class="gun-next" type="button">›</button>${images.length > 1 ? `<div class="gun-dots">${images.map((_, i) => `<span class="gun-dot${i === 0 ? ' is-active' : ''}"></span>`).join('')}</div>` : ''}</div>`;
      }

      function statusBadge(status) {
        const map = { deleted: '{{ "custom.deleted" | t }}', pending: '{{ "custom.pending_approval" | t }}', published: '{{ "custom.published" | t }}', deactivated: '{{ "custom.deactivated" | t }}', archived: '{{ "custom.archived" | t }}', sold: '{{ "custom.sold" | t }}', rejected: '{{ "custom.rejected" | t }}' };
        return map[status] || status;
      }

      // First-paint price text (currency-aware); the global updatePrices()
      // sweep re-confirms/corrects it on the next tick and on toggle clicks.
      function formatAdPrice(ad) {
        if (!ad.price || ad.price == '0') return 'N/A';
        const sourceCurrency = ad.currency || 'EUR';
        const viewCurrency   = localStorage.getItem('currency') || 'EUR';
        const rate           = (typeof EUR_TO_USD !== 'undefined' && EUR_TO_USD) ? EUR_TO_USD : parseFloat(localStorage.getItem('eur_to_usd') || '1.08');
        const amountInEur    = sourceCurrency === 'USD' ? parseFloat(ad.price) / rate : parseFloat(ad.price);
        return viewCurrency === 'USD' ? '$' + Math.round(amountInEur * rate) : Math.round(amountInEur) + '€';
      }

      function renderButtons(ad) {
        const id = ad.id, status = ad.ad_status, handle = id ? id.split('/').pop() : ad.handle;
        const seeAdBtn        = `<button class="button button-secondary is-small btn-see-ad" data-handle="${handle}">{{ "custom.see_ad" | t }}</button>`;
        const markSoldBtn     = `<button class="button outline orange is-small btn-mark-sold" data-id="${id}">{{ "custom.mark_as_sold" | t }}</button>`;
        const soldDisabledBtn = `<button class="button outline orange is-small" disabled style="opacity:0.5;cursor:not-allowed;">{{ "custom.sold" | t }}</button>`;
        const editBtn         = `<button class="btn-link underline color-primary is-small btn-edit-ad" data-id="${id}">{{ "custom.edit" | t }}</button>`;
        const deleteBtn       = `<button class="btn-link underline color-orange is-small btn-delete-ad" data-id="${id}">{{ "custom.delete" | t }}</button>`;
        const deactivateBtn   = `<button class="btn-link underline color-primary is-small btn-deactivate-ad" data-id="${id}">{{ "custom.deactivate" | t }}</button>`;
        const reactivateBtn   = `<button class="btn-link underline color-primary is-small btn-reactivate-ad" data-id="${id}" data-prev-status="${status}">{{ "custom.reactivate" | t }}</button>`;
        let buttons = '';
        switch (status) {
          case 'pending':     buttons = `${seeAdBtn}<div class="ad-card_button-list">${editBtn}${deleteBtn}</div>`; break;
          case 'published':   buttons = `${seeAdBtn}${markSoldBtn}<div class="ad-card_button-list">${editBtn}${deleteBtn}${deactivateBtn}</div>`; break;
          case 'deactivated': buttons = `${seeAdBtn}${markSoldBtn}<div class="ad-card_button-list">${editBtn}${deleteBtn}${reactivateBtn}</div>`; break;
          case 'sold':        buttons = `${seeAdBtn}${soldDisabledBtn}<div class="ad-card_button-list">${deleteBtn}</div>`; break;
          case 'deleted':     buttons = `<div class="ad-card_button-list">${deleteBtn}</div>`; break;
          case 'archived':    buttons = `${seeAdBtn}<div class="ad-card_button-list">${reactivateBtn}${deleteBtn}</div>`; break;
          case 'rejected':    buttons = `${seeAdBtn}<div class="ad-card_button-list">${editBtn}${deleteBtn}</div>`; break;
          default:            buttons = seeAdBtn;
        }
        return buttons;
      }

      function renderAdCard(ad) {
        const images = parseImages(ad.ad_images, ad.product_image);
        const status = ad.ad_status || 'pending';
        const isDeleted = status === 'deleted';
        const isDisabled = ['deactivated', 'archived', 'sold', 'rejected', 'deleted'].includes(status);
        const adId = ad.id.split('/').pop();
        const itemClasses = [
          'ads-list_item',
          isDisabled ? 'disabled' : '',
          status === 'sold' ? 'sold' : '',
          isDeleted ? '' : '',
          status === 'rejected' ? 'ad-rejected' : ''   // ← ADD THIS
        ].filter(Boolean).join(' ');
        const armorerWarning = isDeleted 
          ? `<div class="ad-not-in-armorer-banner">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="#e67e22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {{ 'custom.firearm_removed_notice' | t }}
            </div>` 
          : '';

        // ── Rejection note banner — shown when ad is rejected AND admin_note exists ──
        const rejectionNote = (status === 'rejected' && ad.admin_note)
          ? `<div class="ad-rejection-note-banner">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" stroke="#FF383C" stroke-width="2"/>
                <path d="M12 8v4M12 16h.01" stroke="#FF383C" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span><strong>{{ 'custom.rejection_reason' | t }}:</strong> ${ad.admin_note}</span>
            </div>`
          : '';
        return `
        <div class="${itemClasses}" data-ad-id="${ad.id}">
          ${rejectionNote} 
          <div class="ad-card_component">
            <div class="ad-card_logo-wrap"><div class="gun-card__media-wrapper"><div class="gun-card__media">${renderSlider(images, adId)}</div></div></div>
            <div class="ad-card_component-data">
              <div class="ad-card_component-data-top">
                <div class="ad-card_title">
                  ${ad.firearm_personalized_name ? `<div class="ad-card_nickname text-size-tiny">${ad.firearm_personalized_name}</div>` : ''}
                  ${ad.ad_id ? `<div class="ad-card__ad-id">ID: <strong>${ad.ad_id}</strong></div>` : ''}
                  ${(() => {
                    // Same shape as Clasificados: barrel length and handedness
                    // come out of the title/subtitle text into their own
                    // labelled chips on one meta row. See gl-ad-meta.liquid.
                    const AdMeta = window.GunloupeAdMeta;
                    const t = window.GLI18n ? window.GLI18n.t : (v => v || '');
                    const parts        = AdMeta.splitModelBarrel(ad.firearm_model);
                    const titleLine    = [parts.model, ad.firearm_caliber].filter(Boolean).join(' | ');
                    const subtitleLine = [t(ad.firearm_type), t(ad.firearm_subtype)].filter(Boolean).join(' / ');
                    const subtitleEl   = (ad.product_handle && !ad.product_handle.startsWith('custom-'))
                      ? `<a href="${window.Shopify.routes.root}products/${ad.product_handle}" class="ad-card_product-link text-size-small" >${subtitleLine}</a>`
                      : `<span class="ad-card_product-link text-size-small">${subtitleLine}</span>`;
                    return `<div class="ad-card_title-text">${titleLine || '—'}</div>
                  <div class="ad-card_meta-row">
                    ${subtitleEl}
                    ${AdMeta.barrelChipHtml(parts.barrelCm)}
                    ${AdMeta.handednessChipHtml(ad.firearm_handedness)}
                  </div>`;
                  })()}
                </div>
                <div class="ad-card_stat"><div class="product-table_header-cell text-size-small">{{ 'custom.city' | t }}</div><div class="product-table_spec-text">${ad.city || '—'}</div></div>
                <div class="ad-card_stat"><div class="product-table_header-cell text-size-small hide-tablet">{{ 'custom.price' | t }}</div><div class="product-table_spec-text price" data-price="${ad.price || 0}" data-currency="${ad.currency || 'EUR'}">${formatAdPrice(ad)}</div></div>
                <div class="ad-card_stat"><div class="product-table_header-cell text-size-small hide-tablet">{{ 'custom.availability' | t }}</div><div class="product-table_spec-text">${AVAILABILITY_LABELS[ad.firearm_availability] || ad.firearm_availability || '—'}</div></div>
                <div class="ad-card_stat"><div class="product-table_header-cell text-size-small">{{ 'custom.status' | t }}</div><div style="display:flex;align-items:center;gap:8px;"><span>${statusBadge(status)}</span></div></div>
              </div>
              <div class="ad-card_component-data-bottom">

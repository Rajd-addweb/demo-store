{{ 'customer-profile.css' | asset_url | stylesheet_tag: preload: true }}

<style>
  /* Field-level validation error state */
  .profile-input--error {
    border-color: #dc2626 !important;
    box-shadow: 0 0 0 1px #dc2626 !important;
  }
  .profile-input--error::placeholder {
    color: #fca5a5;
  }
  .profile-avatar-circle.profile-input--error {
    box-shadow: 0 0 0 3px #fee2e2, 0 0 0 5px #dc2626 !important;
    border-radius: 50%;
  }

  /* Age validation error message */
  .profile-input__error-msg {
    font-size: 12px;
    color: #dc2626;
    margin-top: 4px;
    display: none;
  }
  .profile-input__error-msg.show {
    display: block;
  }
</style>

{% render 'gunloupe-routes' %}

{% unless customer %}
  <script>window.location.href = '{{ routes.account_login_url }}';</script>
{% endunless %}

{%- assign addr = customer.default_address -%}
{%- assign current_picture = customer.metafields.custom.profile_picture.value | default: '' -%}

<div class="profile-page-wrapper">
  <div class="profile-page-weapon-header bg-light-gray">
    {%- comment -%} h2, not h1: layout/theme.liquid already renders the page's
       single h1. This heading was tagged h1 while carrying h2 styling classes,
       so the page ended up with two h1s. Tag only — appearance is unchanged.
    {%- endcomment -%}
    <h2 class="profile-greeting heading-style-h2">
      {{ page.title }}
    </h2>
  </div>

  <div class="container">
    <div class="profile-page" id="profile-edit-Page">

      <div class="profile-card">

        <div id="profileSaveMsg" class="profile-save-msg" style="display:none;" role="alert" aria-live="assertive" tabindex="-1"></div>

        {%- comment -%} PERSONAL INFORMATION {%- endcomment -%}
        {% assign user_type = customer.metafields.custom.user_type.value %}
        <div class="profile-section">
          <div class="profile-section__title">
            {% if user_type == 'business' %}
              {{ 'customer.account.business_information' | t: default: 'BUSINESS INFORMATION' }}
            {% else %}
              {{ 'customer.account.personal_info' | t: default: 'PERSONAL INFORMATION' }}
            {% endif %}
          </div>

          <div class="personal-info-wrapper">
            <div class="profile-avatar-upload-wrap">
              <div class="profile-avatar-circle" id="avatarCircle">
                <div id="avatarPreviewPlaceholder"
                  class="profile-avatar-circle__placeholder"
                  style="{% if current_picture != blank %}display:none;{% else %}display:flex;{% endif %}">
                  {% render "icon-profile" %}
                </div>
                <img
                  id="avatarPreviewImg"
                  class="profile-avatar-circle__img"
                  src="{{ current_picture }}"
                  alt="{{ customer.first_name }}"
                  style="{% if current_picture != blank %}display:block;{% else %}display:none;{% endif %}"
                >
                <label for="profilePicInput" class="profile-avatar-circle__overlay" aria-label="{% if user_type == 'business' %}{{ 'customer.account.change_logo' | t: default: 'Change logo' }}{% else %}Change photo{% endif %}">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/>
                    <circle cx="12" cy="13" r="4"/>
                  </svg>
                </label>
                <input type="file" id="profilePicInput" accept="image/*" style="display:none;">
                <button
                  type="button"
                  id="avatarRemoveBtn"
                  class="profile-avatar-circle__remove"
                  aria-label="Remove photo"
                  style="{% if current_picture != blank %}display:flex;{% else %}display:none;{% endif %}"
                >
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                    <path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
              {% if user_type == 'business' %}
                <span style="font-size:0.75rem;color:#295A31A6;margin-top:6px;display:block;text-align:center;">
                  *{{ 'customer.account.logo_requirement' | t: default: 'Logo required. Min 300×300px' }}
                </span>
              {% endif %}
            </div>

            <div class="personal-info-inner">
              {% if user_type == 'business' %}
                {{- '<!-- Business: single Shop Name field -->' -}}
                <div class="input-wrapper">
                  <label class="form-label" for="editShopName">
                    {{ 'customer.account.shop_name' | t: default: 'Shop Name' }} *
                  </label>
                  <input class="profile-input" type="text" id="editShopName" name="shopName"
                    value="{{ customer.metafields.custom.shop_name.value | default: '' }}"
                    autocomplete="organization" placeholder="{{ 'customer.account.shop_name' | t: default: 'Shop Name' }}">
                </div>
              {% else %}
                {{- '<!-- Private: first + last + alias -->' -}}
                <div class="profile-form-row profile-form-row--2col">
                  <div class="input-wrapper">
                    <label class="form-label" for="editFirstName">
                      {{ 'customer.account.name' | t: default: 'Name' }}
                    </label>
                    <input class="profile-input" type="text" id="editFirstName" name="firstName"
                      value="{{ customer.first_name }}" autocomplete="given-name">
                  </div>
                  <div class="input-wrapper">
                    <label class="form-label" for="editLastName">
                      {{ 'customer.account.last_name' | t: default: 'Last name' }}
                    </label>
                    <input class="profile-input" type="text" id="editLastName" name="lastName"
                      value="{{ customer.last_name }}" autocomplete="family-name">
                  </div>
                </div>
                <!-- <div class="input-wrapper">
                  <label class="form-label" for="editAlias">
                    {{ 'customer.account.alias' | t: default: 'Alias' }}
                  </label>
                  <input class="profile-input" type="text" id="editAlias" name="alias"
                    value="{{ customer.metafields.custom.alias | default: '' }}"
                    autocomplete="off">
                </div>
                {%- comment -%} ALIAS DISPLAY PREFERENCE — private users only {%- endcomment -%}
                {%- assign saved_disp_pref = customer.metafields.custom.name_display_preference.value | default: 'full_name' -%}
                <div class="input-wrapper" id="aliasDisplayPrefWrap">
                  <div class="profile-check text-size-small" style="margin-top:-8px;">
                    <input type="checkbox" id="editDisplayAlias" name="displayAlias"
                      {% if saved_disp_pref == 'alias' %}checked{% endif %}>
                    <label for="editDisplayAlias">
                      {{ 'custom.display_alias_on_ads' | t }}
                    </label>
                  </div>
                </div> -->
                {%- comment -%} DATE OF BIRTH & GENDER {%- endcomment -%}
                <div class="profile-form-row profile-form-row--2col">
                  <div class="input-wrapper">
                    <label class="form-label" for="editDateOfBirth">
                        {{ 'custom.date_of_birth' | t }}
                    </label>
                    <input
                      class="profile-input"
                      type="text"
                      readonly
                      inputmode="none"
                      autocomplete="off"
                      id="editDateOfBirth"
                      name="dateOfBirth"
                      value="{{ customer.metafields.custom.date_of_birth.value | default: '' }}"
                      data-date-picker-set="{{ 'custom.date_picker_set' | t }}"
                      data-date-picker-cancel="{{ 'custom.date_picker_cancel' | t }}"
                      data-date-picker-clear="{{ 'custom.date_picker_clear' | t }}"
                    >
                    <span class="profile-input__error-msg" id="dobErrorMsg"></span>
                  </div>

                  <div class="input-wrapper">
                    <label class="form-label" for="editGender">
                        {{ 'custom.gender' | t }}
                    </label>
                    <select class="profile-input" id="editGender" name="gender">
                      <option value="">
                        {{ 'custom.gender_select_placeholder' | t }}
                      </option>
                      <option value="male" {% if customer.metafields.custom.gender.value == 'male' %}selected{% endif %}>
                        {{ 'custom.gender_male' | t }}
                      </option>
                      <option value="female" {% if customer.metafields.custom.gender.value == 'female' %}selected{% endif %}>
                        {{ 'custom.gender_female' | t }}
                      </option>
                      <option value="other" {% if customer.metafields.custom.gender.value == 'other' %}selected{% endif %}>
                        {{ 'custom.gender_other' | t }}
                      </option>
                      <option value="prefer_not_to_say" {% if customer.metafields.custom.gender.value == 'prefer_not_to_say' %}selected{% endif %}>
                        {{ 'custom.gender_prefer_not_to_say' | t }}
                      </option>
                    </select>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        </div>

        {%- comment -%} CONTACTS — email read-only {%- endcomment -%}
        <div class="profile-section">
          <div class="profile-section__title">
            {{ 'customer.account.contacts' | t: default: 'Contact' }}
          </div>
          <div class="personal-info-inner">
            <div class="input-wrapper">
              <label class="form-label">
                {{ 'customer.account.email-address' | t: default: 'E-mail address' }}
              </label>
              <input class="profile-input profile-input--readonly" type="email"
                value="{{ customer.email }}" disabled autocomplete="email">
            </div>
            <div class="input-wrapper">
              <label class="form-label" for="editPhone">
                {{ 'customer.account.phone' | t: default: 'Phone' }}{% if user_type == 'business' %} *{% endif %}
              </label>
              <input class="profile-input" type="tel" id="editPhone" name="phone"
                value="{{ customer.metafields.custom.phone }}" autocomplete="tel"
                placeholder="Ex 999918888">
            </div>
          </div>
        </div>

        {%- comment -%} ADDRESS {%- endcomment -%}
        <div class="profile-section">
          <div class="profile-section__title">
            {% if user_type == 'business' %}
              {{ 'customer.account.shop_address' | t: default: 'SHOP ADDRESS' }}
            {% else %}
              {{ 'customer.account.address' | t: default: 'ADDRESS' }}
            {% endif %}
          </div>
          <div class="personal-info-inner">
            <div class="input-wrapper">
              <label class="form-label" for="editAddress1">
                {{ 'customer.account.address1' | t: default: 'Address 1' }}{% if user_type == 'business' %} *{% endif %}
              </label>
              <input class="profile-input" type="text" id="editAddress1" name="address1"
                value="{{ addr.address1 }}" autocomplete="address-line1">
            </div>
            <div class="input-wrapper">
              <label class="form-label" for="editAddress2">
                {{ 'customer.account.address2' | t: default: 'Address 2' }}
              </label>
              <input class="profile-input" type="text" id="editAddress2" name="address2"
                value="{{ addr.address2 }}" autocomplete="address-line2">
            </div>
            <div class="profile-form-row profile-form-row--3col">
              <div class="input-wrapper">
                <label class="form-label" for="editZip">
                  {{ 'customer.account.zip' | t: default: 'Zip Code' }}{% if user_type == 'business' %} *{% endif %}
                </label>
                <input class="profile-input" type="text" id="editZip" name="zip"
                  value="{{ addr.zip }}" autocomplete="postal-code">
              </div>
              <div class="input-wrapper">
                <label class="form-label" for="editCity">
                  {{ 'custom.city' | t: default: 'City' }}{% if user_type == 'business' %} *{% endif %}
                </label>
                <input class="profile-input" type="text" id="editCity" name="city"
                  value="{{ addr.city }}" autocomplete="address-level2">
              </div>
              <div class="input-wrapper">
                <label class="form-label" for="editCountry">
                  {{ 'customer.account.country' | t: default: 'Country' }}{% if user_type == 'business' %} *{% endif %}
                </label>
                <select class="profile-input" id="editCountry" name="country" autocomplete="country">
                  <option value="">— {{ 'customer.account.country' | t: default: 'Country' }} —</option>
                  {%- for c in localization.available_countries -%}
                    {%- if c.iso_code == 'ES' -%}
                      <option value="{{ c.name }}" data-pinned="true" data-iso="ES">{{ c.name }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                  <option value="" disabled>──────────</option>
                  {{ all_country_option_tags }}
                </select>
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} PREFERENCES {%- endcomment -%}
        <div class="profile-edit-card--slim">
          <div class="profile-check">
            <input type="checkbox" id="editMarketing" name="acceptsMarketing">
            <label for="editMarketing">
              {{ 'customer.account.marketing' | t: default: 'Subscribe to marketing updates' }}
            </label>
          </div>
          <div class="profile-check">
            <input type="checkbox" id="editAlerts" name="receiveAlerts">
            <label for="editAlerts">
              {{ 'customer.account.alerts' | t: default: 'Receive Alerts for Favorites' }}
            </label>
          </div>
        </div>

        {%- comment -%} ACTION BUTTONS {%- endcomment -%}
        <div class="profile-edit-actions">
          <button class="button bg-color-orange profile-btn--save" id="saveProfileBtn">
            <span class="profile-btn__label">
              {{ 'customer.account.save_changes' | t: default: 'Guardar cambios' }}
            </span>
            <span class="profile-btn__spinner" style="display:none;">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="spin">
                <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="2"
                  stroke-dasharray="32" stroke-dashoffset="12"/>
              </svg>
            </span>
          </button>

          <a href="{{ pages['perfil'].url | default: '/pages/perfil' }}"
            class="profile-cancel-link js-profile-cancel-link"
            id="cancelProfileEdit">
            {{ 'customer.account.cancel' | t: default: 'Regresar sin guardar los cambios' }}
          </a>
        </div>

        {%- comment -%} Hidden fields for JS {%- endcomment -%}
        <input type="hidden" id="profileAddressId" value="{{ customer.default_address.id }}">
        <input type="hidden" id="profileCurrentPicture" value="{{ current_picture }}">
        <input type="hidden" id="profileUserType" value="{{ user_type }}">
        <input type="hidden" id="profileCountryCode" value="{{ addr.country_code | default: '' }}">
        <input type="hidden" id="profileDateOfBirth" value="{{ customer.metafields.custom.date_of_birth.value | default: '' }}">
        <input type="hidden" id="profileGender" value="{{ customer.metafields.custom.gender.value | default: '' }}">

      </div>
    </div>
  </div>
</div>

<script>
    // AGE RESTRICTION CONFIG
    // Change this number to update the minimum age requirement globally
    // Currently set to 13+ years old
  const MINIMUM_AGE_REQUIRED = 0;

  window.__profileConfig = {
    customerId : {{ customer.id | json }},
    userType   : {{ user_type | json }},
    apiBase    : 'https://shopify-gunloupe.addwebprojects.com',
    returnUrl  : (function(){
      var ut = {{ user_type | json }};
      var prefix = (window.GunloupeRoutes && window.GunloupeRoutes.prefix) || ''; // '' for ES, '/en' for EN
      if (ut === 'business') {
        return (window.GunloupeRoutes && window.GunloupeRoutes.myAdverts)
          ? window.GunloupeRoutes.myAdverts
          : (prefix + '/pages/anuncios');   // ES-slug fallback, still locale-prefixed
      } else {
        return prefix + '/'; // homepage, locale-aware (/ for ES, /en/ for EN)
      }
    })(),

    // Field labels for the mandatory-field validation banner — resolved to
    // the current page's language via | t, sourced from the same locale
    // JSON files a content manager can edit in Shopify Admin.
    fieldLabels: {
      shopName: {{ 'customer.account.shop_name' | t | json }},
      phone:    {{ 'customer.account.phone' | t | json }},
      address:  {{ 'customer.account.address1' | t | json }},
      zip:      {{ 'customer.account.zip' | t | json }},
      city:     {{ 'custom.city' | t | json }},
      country:  {{ 'customer.account.country' | t | json }},
      logo:     {{ 'custom.logo' | t | json }}
    },

    messages: {
      requiredFieldsPrefix:   {{ 'custom.profile_required_fields_prefix' | t | json }},
      genericError:           {{ 'custom.profile_generic_error' | t | json }},
      savedMsg:               {{ 'custom.profile_saved_msg' | t | json }},
      imageTooBig:            {{ 'custom.profile_image_too_big' | t | json }},
      customerNotIdentified:  {{ 'custom.profile_customer_not_identified' | t | json }},
      phoneInvalid:           {{ 'custom.profile_phone_invalid' | t | json }},
      phoneRequired:          {{ 'custom.profile_phone_required' | t | json }},
      phoneInvalidChars:      {{ 'custom.profile_phone_invalid_chars' | t | json }},
      invalidDate:            {{ 'custom.profile_invalid_date' | t | json }},
      dobFuture:              {{ 'custom.profile_dob_future' | t | json }}
    },

    locale: '{{ request.locale.iso_code | default: "en" }}',

    countryNameToCode: {
      {%- for c in localization.available_countries -%}
        {{ c.name | json }}: {{ c.iso_code | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  };

  // Update cancel link to locale-aware route
  (function () {
    var cancel = document.querySelector('.js-profile-cancel-link');
    if (cancel && window.GunloupeRoutes && window.GunloupeRoutes.profile) {
      cancel.href = window.GunloupeRoutes.profile;
      }
  })();

  // Country pre-selection logic
  (function () {
    var sel = document.getElementById('editCountry');
    if (!sel) return;

    var savedCode = document.getElementById('profileCountryCode');
    var isoCode = savedCode ? savedCode.value : '';

    var map = (window.__profileConfig && window.__profileConfig.countryNameToCode) || {};
    var codeToName = {};
    Object.keys(map).forEach(function(name) { codeToName[map[name]] = name; });

    var target = isoCode ? (codeToName[isoCode] || '') : '';
    var fallback = {{ addr.country | default: "" | json }};
    if (!target) target = fallback;
    if (!target) return;

    for (var i = 0; i < sel.options.length; i++) {
      if (sel.options[i].value === target && sel.options[i].dataset.pinned === 'true') {
        sel.selectedIndex = i;
        return;
      }
    }

    for (var j = 0; j < sel.options.length; j++) {
      if (sel.options[j].value === target) {
        sel.selectedIndex = j;
        return;
      }
    }

    var targetLower = target.toLowerCase();
    for (var k = 0; k < sel.options.length; k++) {
      if (!sel.options[k].disabled && sel.options[k].value.toLowerCase() === targetLower) {
        sel.selectedIndex = k;
        return;
      }
    }

    console.warn('[Profile] Could not pre-select country. ISO:', isoCode, 'Target:', target);
  })();
  // ── Show/hide alias display preference checkbox as user types ────────────
  (function () {
    var aliasIn  = document.getElementById('editAlias');
    var prefWrap = document.getElementById('aliasDisplayPrefWrap');
    var prefBox  = document.getElementById('editDisplayAlias');
    if (!aliasIn || !prefWrap) return;

    aliasIn.addEventListener('input', function () {
      var hasAlias = this.value.trim().length > 0;
      prefWrap.style.display = hasAlias ? '' : 'none';
      if (!hasAlias && prefBox) prefBox.checked = false;
    });
  })();
</script>

<script src="{{ 'customer-profile.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% schema %}
{
  "name": "Customer Profile Edit",
  "settings": [],
  "presets": [{ "name": "Customer Profile Edit" }]
}
{% endschema %}

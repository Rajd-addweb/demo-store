{% comment %}
section.comparator.liquid — FINAL v7
Exact 42-row order per client spec (no duplicate Modalidad):
 0  Modalidad              → modalidad
 1  Marca                  → marca
 2  Modelo                 → modelo
 3  Sub-modelo             → submodelo
 4  Tipo de arma           → productType
 5  Subtipo de arma        → sub_tipo_de_arma
 6  Estado                 → inCatalogLabel
 7  Lateralidad            → lateralidad
 8  Garantía precisión     → garantia_precision
 9  Calibre                → selectedOptions[0]
10  Paso de estría         → paso_de_estria (variant)
11  Cañón intercambiable   → canon_intercambiable
12  Longitud cañón (pulg)  → computed brlInch
13  Longitud cañón (cm)    → computed brlCm
14  Acabado de cañón       → acabado_de_canon
15  Material del cañón     → material_del_canon
16  Diámetro cañón (pulg)  → diametro_canon_pulgadas
17  Diámetro cañón (cms)   → diametro_del_canon_mm
18  Cañón fluteado         → canon_fluteado
19  Rosca                  → selectedOptions[2]
20  Diámetro rosca         → diametro_rosca (variant)
21  Freno de boca          → freno_de_boca
22  Caja larga             → caja_larga
23  Tipo de culata         → tipo_de_culata
24  Material de caja       → material_caja
25  Acabado culata         → acabado_caja
26  Cargador extraíble     → cargador_extraible
27  Capacidad cargador     → capacidad_cargador (variant)
28  Tipo de disparador     → tipo_disparador
29  Tipo de gatillo        → tipo_de_gatillo
30  Gatillo ajustable      → gatillo_ajustable
31  Miras abiertas         → miras_abiertas
32  Óptica                 → optica
33  Bases                  → bases
34  Banda del cañón        → banda_canon
35  Tipo de choke          → tipo_de_choke
36  Choke                  → choke
37  Número de chokes       → numero_chokes
38  Longitud total (pulg)  → longitud_total_pulgadas (variant)
39  Longitud total (cms)   → longitud_total_cm (variant)
40  Peso (lbs)             → peso_pounds (variant)
41  Peso (kg)              → peso_kg (variant)
{% endcomment %}

<div class="comparator-section-wrap">
  <div class="container">
    {% if customer %}
    <div id="comparator-app">
      <div class="comparator-loading" id="comparator-loading">
        <div class="comparator-spinner"></div>
        <span>{{ 'custom.loading_comparision' | t }}...</span>
      </div>
      <div class="comparator-empty" id="comparator-empty" style="display:none;">
        <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
          <circle cx="28" cy="28" r="27" stroke="#295A31" stroke-width="1.5" opacity="0.4" />
          <path d="M28 18v12M28 33v2" stroke="#295A31" stroke-width="2" stroke-linecap="round" opacity="0.4" />
        </svg>
        <h3>{{ 'custom.no_firearms_to_compare' | t }}</h3>
        <p>{{ 'custom.compare_instruction2' | t }}</p>
        <a id="comparator-empty-browse-btn" href="/collections/armas" class="comparator-browse-btn">{{ 'custom.browse_catalog' | t }}</a>
      </div>
      <div id="comparator-table-wrap" style="display:none;">
        <div class="compare_list-wrapper">
          <div class="compare_list-titles">
            <div class="product-card_specs_list u-vflex-stretch-top u-gap-xxsmall">
              <!-- 0  Modalidad -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.category' | t }}</div></div>
              <!-- 1  Marca -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.brand' | t }}</div></div>
              <!-- 2  Modelo -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.model' | t }}</div></div>
              <!-- 3  Sub-modelo -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.sub_model' | t }}</div></div>
              <!-- 4  Tipo de arma -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.firearm_type' | t }}</div></div>
              <!-- 5  Subtipo de arma -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.firearm_subtype' | t }}</div></div>
              <!-- 6  Estado -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.status' | t }}</div></div>
              <!-- 7  Lateralidad -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.handedness' | t }}</div></div>
              <!-- 8  Garantía precisión -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.precision_warranty' | t }}</div></div>
              <!-- 9  Calibre -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.caliber' | t }}</div></div>
              <!-- 10 Paso de estría -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.twist_rate' | t }}</div></div>
              <!-- 11 Cañón intercambiable -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.interchangeable_barrel' | t }}</div></div>
              <!-- 12 Longitud cañón (pulgadas) -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.barrel_lengths' | t }} {{ 'custom.inches' | t }}</div></div>
              <!-- 13 Longitud cañón (cm) -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.barrel_lengths' | t }} {{ 'custom.unit_cm' | t }}</div></div>
              <!-- 14 Acabado de cañón -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.barrel_finish' | t }}</div></div>
              <!-- 15 Material del cañón -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.barrel_material' | t }}</div></div>
              <!-- 16 Diámetro cañón (pulgadas) -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.barrel_diameter' | t }} {{ 'custom.inches' | t }}</div></div>
              <!-- 17 Diámetro cañón (cms) -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.barrel_diameter' | t }} (mm)</div></div>
              <!-- 18 Cañón fluteado -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.barrel_fluted' | t }}</div></div>
              <!-- 19 Rosca -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.thread' | t }}</div></div>
              <!-- 20 Diámetro rosca -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.thread_diameter' | t }}</div></div>
              <!-- 21 Freno de boca -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.muzzle_brake' | t }}</div></div>
              <!-- 22 Caja larga -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.caja_larga' | t }}</div></div>
              <!-- 23 Tipo de culata -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.stock_type' | t }}</div></div>
              <!-- 24 Material de caja -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.stock_material' | t }}</div></div>
              <!-- 25 Acabado culata -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.stock_finish' | t }}</div></div>
              <!-- 26 Cargador extraíble -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.removable_magazine' | t }}</div></div>
              <!-- 27 Capacidad cargador -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.magazine_capacity' | t }}</div></div>
              <!-- 28 Tipo de disparador -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.trigger_type' | t }}</div></div>
              <!-- 29 Tipo de gatillo -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.trigger_type1' | t }}</div></div>
              <!-- 30 Gatillo ajustable -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.adjustable_trigger' | t }}</div></div>
              <!-- 31 Miras abiertas -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.open_sights' | t }}</div></div>
              <!-- 32 Óptica -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.optics' | t }}</div></div>
              <!-- 33 Bases -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.bases' | t }}</div></div>
              <!-- 34 Banda del cañón -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.barrel_brand' | t }}</div></div>
              <!-- 35 Tipo de choke -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.choke_type' | t }}</div></div>
              <!-- 36 Choke -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.choke' | t }}</div></div>
              <!-- 37 Número de chokes -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.choke_number' | t }}</div></div>
              <!-- 38 Longitud total (pulgadas) -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.total_length' | t }} {{ 'custom.inches' | t }}</div></div>
              <!-- 39 Longitud total (cms) -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.total_length' | t }} (cm)</div></div>
              <!-- 40 Peso (lbs) -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.weight' | t }} (pounds)</div></div>
              <!-- 41 Peso (kg) -->
              <div class="product-card_specs_item is-legend"><div class="product-card_specs_label">{{ 'custom.weight' | t }} (kg)</div></div>
            </div>
          </div>
          <div class="compare_content-wrap u-hflex-left-stretch u-hflex-nowrap u-gap-small">
            <div class="products-grid_list-wrap">
              <div class="products-grid_list" id="comparator-products-list"></div>
            </div>
          </div>
        </div>
        <div class="comparator-footer">
          <a id="comparator-footer-browse-btn" href="/collections/armas" class="comparator-browse-btn">{{ 'custom.browse_catalog' | t }}</a>
        </div>
      </div>
    </div>
    {% else %}
    <div class="comparator-login-prompt">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
        <circle cx="28" cy="28" r="27" stroke="#295A31" stroke-width="1.5" />
        <path d="M28 16a6 6 0 100 12 6 6 0 000-12zm0 14c-6.627 0-12 2.686-12 6v2h24v-2c0-3.314-5.373-6-12-6z" fill="#295A31" opacity="0.5" />
      </svg>
      <h3>{{ 'custom.signin_comparator' | t }}</h3>
      <p>{{ 'custom.login_required_firearms' | t }}</p>
      <a href="{{ routes.storefront_login_url }}" class="button is-small comparator-browse-btn">{{ 'customer.login' | t }}</a>
      <a href="{{ routes.storefront_login_url }}" class="button comparator-browse-btn is-small is-secondary">{{ 'customer.register' | t }} </a>
    </div>
    {% endif %}
  </div>
</div>


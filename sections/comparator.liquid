}{% endif %};

  window._tv = function(v) {
    if (!v || v === '—') return v;
    return (window._valMap && window._valMap[v] !== undefined) ? window._valMap[v] : v;
  };
</script>
<script>
  (function () {
    const BACKEND_URL = 'https://shopify-gunloupe.addwebprojects.com';
    const STOREFRONT_TOKEN = 'cef86b403fa3eef900f70170cec5acb8';
    const SHOP_DOMAIN = 'gunloupe.myshopify.com';
    const API_VERSION = '2024-01';
    const CUSTOMER_ID = '{{ customer.id }}';

    // ── User type ─────────────────────────────────────────────────────────────
    var IS_BUSINESS_USER = '{{ customer.metafields.custom.user_type.value }}' == 'business';
    var IS_PRIVATE_USER = '{{ customer.metafields.custom.user_type.value }}' !== 'business';

    const FIREARMS_URL = (window.GunloupeRoutes && window.GunloupeRoutes.firearmsCollection) || '/collections/armas';
    document.getElementById('comparator-empty-browse-btn')?.setAttribute('href', FIREARMS_URL);
    document.getElementById('comparator-footer-browse-btn')?.setAttribute('href', FIREARMS_URL);

    async function getComparatorItems() {
      try {
        const raw = sessionStorage.getItem('gunloupe_comparator_cache');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed.items && parsed.items.length > 0 && (Date.now() - (parsed.ts || 0)) < 300000) {
            return parsed.items;
          }
        }
      } catch {}
      if (window.GunloupeComparator && window.GunloupeComparator.getItems) {
        return window.GunloupeComparator.getItems(true);
      }
      try {
        const res = await fetch(`${BACKEND_URL}/comparator/${CUSTOMER_ID}`);
        const data = await res.json();
        return data.success ? (data.items || []) : [];
      } catch { return []; }
    }

    async function removeItem(variantId) {
      if (window.GunloupeComparator && window.GunloupeComparator.remove) {
        return window.GunloupeComparator.remove(variantId);
      }
      try {
        const items = await getComparatorItems();
        const updated = items.filter(i => i.variantId !== String(variantId));
        const res = await fetch(`${BACKEND_URL}/comparator/${CUSTOMER_ID}`, {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({items: updated}),
        });
        const data = await res.json();
        return data.success;
      } catch { return false; }
    }

    async function storefrontFetch(query, variables = {}, retries = 3) {
      for (let attempt = 0; attempt < retries; attempt++) {
        try {
          const res = await fetch(`https://${SHOP_DOMAIN}/api/${API_VERSION}/graphql.json`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': STOREFRONT_TOKEN},
            body: JSON.stringify({query, variables}),
          });
          if (res.ok) return res.json();
          if (res.status >= 400 && res.status < 500) return res.json();
        } catch (e) {
          if (attempt === retries - 1) throw e;
          await new Promise(r => setTimeout(r, 400 * Math.pow(2, attempt)));
        }
      }
    }

    async function fetchVariantFromRest(variantId, productHandle) {
      try {
        const res = await fetch(`/products/${productHandle}.json`);
        const data = await res.json();
        const product = data?.product;
        if (!product) return null;
        const variant = product.variants?.find(v => String(v.id) === String(variantId)) || product.variants?.[0];
        if (!variant) return null;
        return {
          id: `gid://shopify/ProductVariant/${variant.id}`,
          selectedOptions: [
            {name: 'Calibre', value: variant.option1 || '—'},
            {name: 'Barrel',  value: variant.option2 || ''},
            {name: 'Thread',  value: variant.option3 || ''}
          ],
          metafields: [],
          product: {
            title: product.title, handle: product.handle,
            productType: product.product_type || '—',
            featuredImage: product.image ? {url: product.image.src} : null,
            metafields: []
          }
        };
      } catch { return null; }
    }

    const FETCH_ERROR = Symbol('FETCH_ERROR');

    const GQL_QUERY = `
      query($id: ID!) {
        node(id: $id) {
          ... on ProductVariant {
            id
            selectedOptions { name value }
            metafields(identifiers: [
              { namespace: "custom", key: "peso_kg" },
              { namespace: "custom", key: "peso_pounds" },
              { namespace: "custom", key: "longitud_total_cm" },
              { namespace: "custom", key: "longitud_total_pulgadas" },
              { namespace: "custom", key: "longitud_canon_cm" },
              { namespace: "custom", key: "longitud_canon_pulgadas" },
              { namespace: "custom", key: "paso_de_estria" },
              { namespace: "custom", key: "capacidad_cargador" },
              { namespace: "custom", key: "diametro_rosca" }
            ]) { key value }
            product {
              title handle productType
              featuredImage { url altText }
              metafields(identifiers: [
                { namespace: "custom", key: "marca" },
                { namespace: "custom", key: "modelo" },
                { namespace: "custom", key: "submodelo" },
                { namespace: "custom", key: "sub_tipo_de_arma" },
                { namespace: "custom", key: "categoria_web" },
                { namespace: "custom", key: "lateralidad" },
                { namespace: "custom", key: "garantia_precision" },
                { namespace: "custom", key: "canon_intercambiable" },
                { namespace: "custom", key: "rosca" },
                { namespace: "custom", key: "canon_fluteado" },
                { namespace: "custom", key: "freno_de_boca" },
                { namespace: "custom", key: "acabado_de_canon" },
                { namespace: "custom", key: "material_del_canon" },
                { namespace: "custom", key: "diametro_del_canon_mm" },
                { namespace: "custom", key: "diametro_canon_pulgadas" },
                { namespace: "custom", key: "banda_canon" },
                { namespace: "custom", key: "tipo_de_culata" },
                { namespace: "custom", key: "material_caja" },
                { namespace: "custom", key: "caja_larga" },
                { namespace: "custom", key: "acabado_caja" },
                { namespace: "custom", key: "tipo_disparador" },
                { namespace: "custom", key: "tipo_de_gatillo" },
                { namespace: "custom", key: "gatillo_ajustable" },
                { namespace: "custom", key: "cargador_extraible" },
                { namespace: "custom", key: "choke" },
                { namespace: "custom", key: "tipo_de_choke" },
                { namespace: "custom", key: "numero_chokes" },
                { namespace: "custom", key: "miras_abiertas" },
                { namespace: "custom", key: "bases" },
                { namespace: "custom", key: "optica" },
                { namespace: "custom", key: "modalidad" }
              ]) { key value }
            }
          }
        }
      }
    `;

    async function fetchVariantData(variantId, productHandle) {
      try {
        const data = await storefrontFetch(GQL_QUERY, {id: `gid://shopify/ProductVariant/${variantId}`});
        const node = data?.data?.node;
        if (node) return node;
        if (productHandle) {
          try {
            const restRes = await fetch(`/products/${productHandle}.json`);
            const restData = await restRes.json();
            const freshVariant = restData?.product?.variants?.[0];
            if (freshVariant) {
              const freshId = String(freshVariant.id);
              const retryData = await storefrontFetch(GQL_QUERY, {id: `gid://shopify/ProductVariant/${freshId}`});
              const freshNode = retryData?.data?.node;
              if (freshNode) {
                if (window.GunloupeComparator) {
                  const currentItems = await window.GunloupeComparator.getItems(false);
                  const updated = currentItems.map(i =>
                    i.variantId === String(variantId) ? {...i, variantId: freshId} : i
                  );
                  window.GunloupeComparator.getItems.__cache = null;
                  await fetch(`${BACKEND_URL}/comparator/${CUSTOMER_ID}`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({items: updated}),
                  }).catch(() => {});
                }
                return freshNode;
              }
            }
          } catch (e) {}
          return await fetchVariantFromRest(variantId, productHandle);
        }
        return null;
      } catch (e) {
        if (productHandle) {
          const fb = await fetchVariantFromRest(variantId, productHandle);
          if (fb) return fb;
        }
        return FETCH_ERROR;
      }
    }

    function mf(fields, key) {
      if (!fields || !fields.length) return '—';
      const f = fields.find(m => m && m.key === key);
      return f?.value || '—';
    }
    function opt(opts, i) { return opts?.[i]?.value || '—'; }
    function brlIn(cm) {
      const n = parseFloat(cm); if (!n || n <= 0) return null;
      const r = n * 0.393701, d = r % 1;
      const v = d >= 0.7 ? Math.ceil(r) : n > 12 ? Math.round(r * 10) / 10 : Math.round(r * 100) / 100;
      return String(v).replace('.0', '');
    }
    function si(v, label) {
      return `<li class="product-card_specs_item"><div class="product-card_specs_label is-compare">${label || ''}</div><div class="product-card_specs_spec-text">${v || '—'}</div></li>`;
    }

    // Boolean spec fields (interchangeable barrel, removable magazine,
    // adjustable trigger) come back from Shopify in whatever raw format the
    // metafield was entered in — '1'/'0', 'true'/'false', 'si'/'no' — and
    // must render as the same localized Yes/No text section.weapon-product.liquid
    // uses on the product page itself (see #74). Unrecognized values pass
    // through unchanged rather than being guessed at.
    const YES_LABEL = {{ 'custom.gunval_yes' | t | json }};
    const NO_LABEL  = {{ 'custom.gunval_no'  | t | json }};
    function ynLabel(raw) {
      if (raw == null || raw === '—') return raw;
      const v = String(raw).trim().toLowerCase();
      if (v === '1' || v === 'true' || v === 'si' || v === 'sí' || v === 'yes') return YES_LABEL;
      if (v === '0' || v === 'false' || v === 'no') return NO_LABEL;
      return raw;
    }

    // ── L[] index = legend row number. Both must stay in sync. ────────────
    const L = [
      /* 0  Modalidad              */ {{ 'custom.status' | t | json }},
      /* 1  Marca                  */ {{ 'custom.brand' | t | json }},

      /* 37 Número de chokes       */ {{ 'custom.choke_number' | t | json }},
      /* 38 Longitud total (pulg)  */ {{ 'custom.total_length' | t | json }} + ' ' + {{ 'custom.inches' | t | json }},
      /* 39 Longitud total (cms)   */ {{ 'custom.total_length' | t | json }} + ' (cm)',
      /* 40 Peso (lbs)             */ {{ 'custom.weight' | t | json }} + ' (lbs)',
      /* 41 Peso (kg)              */ {{ 'custom.weight' | t | json }} + ' (kg)',
    ];

    async function render() {
      const loadingEl    = document.getElementById('comparator-loading');
      const emptyEl      = document.getElementById('comparator-empty');
      const tableWrap    = document.getElementById('comparator-table-wrap');
      const productsList = document.getElementById('comparator-products-list');

      loadingEl.style.display  = 'flex';
      emptyEl.style.display    = 'none';
      tableWrap.style.display  = 'none';
      productsList.innerHTML   = '';

      const items = await getComparatorItems();
      loadingEl.style.display  = 'none';

      if (!items || !items.length) { emptyEl.style.display = 'flex'; return; }

      const variants  = await Promise.all(items.map(item => fetchVariantData(item.variantId, item.productHandle)));
      const valid     = variants.filter(v => v && v !== FETCH_ERROR);
      const netErrors = variants.some(v => v === FETCH_ERROR);

      if (!netErrors && valid.length < variants.length && valid.length > 0) {
        const validIds = valid.map(v => v.id.split('/').pop());
        const cleaned  = items.filter(item => validIds.includes(String(item.variantId)));
        fetch(`${BACKEND_URL}/comparator/${CUSTOMER_ID}`, {
          method: 'POST', headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({items: cleaned}),
        }).catch(() => {});
      }

      if (!valid.length) { emptyEl.style.display = 'flex'; return; }

      valid.forEach(v => {
        const p      = v.product;
        const numId  = v.id.split('/').pop();
        const imgUrl = p.featuredImage?.url || '';

        // ── Data variables ────────────────────────────────────────────────
        const modality = window._tv(mf(p.metafields, 'modalidad'));       // L[0]
        const brand    = mf(p.metafields, 'marca');                        // L[1]
        const model    = mf(p.metafields, 'modelo');                       // L[2]
        const submodel = mf(p.metafields, 'submodelo');                    // L[3]
        // Model to use for the Sell button below (kept separate from `model`,
        // which stays as-is for the spec rows above). Was tried as
        // `${model} ${submodel}` first, assuming submodel was just a
        // trailing word — wrong, and produced duplicated text like
        // "PREMIER PREMIER ELEVATE". Checked the actual metafield data:
        // submodelo is consistently the FULL descriptive model name already
        // (e.g. modelo "828 U", submodelo "828 U Black" — matches the real
        // product title minus brand), never a bare suffix, so it should be
        // preferred outright rather than joined with modelo. mf() returns
        // '—' for a missing field, so that placeholder must be excluded.
        const sellModel = submodel !== '—' ? submodel : (model !== '—' ? model : '—');
        const typW     = window._tv(p.productType || '—');                 // L[4]
        const subType  = window._tv(mf(p.metafields, 'sub_tipo_de_arma'));// L[5]
        const inCatalogLabel = (window._cmpLabels && window._cmpLabels.inCatalog) || 'In catalog'; // L[6]
        const handness = window._tv(mf(p.metafields, 'lateralidad'));      // L[7]
        const precision = mf(p.metafields, 'garantia_precision');          // L[8]
        const caliber  = opt(v.selectedOptions, 0);                        // L[9]
        const twist    = mf(v.metafields, 'paso_de_estria');               // L[10]
        const intercBrl = ynLabel(mf(p.metafields, 'canon_intercambiable')); // L[11]
        const cmOpt    = v.selectedOptions?.find(o => o.value?.includes('cm'));
        const cmRaw    = cmOpt?.value?.replace('cm', '').trim();
        const brlCm    = cmRaw || '—';
        const brlCmFull = (cmOpt?.value || '').replace(/\s+/g, '');
        const brlInch  = cmRaw ? (brlIn(cmRaw) || '—') : '—';             // L[12]
        // brlCm                                                            // L[13]
        const brlFin      = window._tv(mf(p.metafields, 'acabado_de_canon'));    // L[14]
        const brlMat      = window._tv(mf(p.metafields, 'material_del_canon'));  // L[15]
        const diaCanonPulg = mf(p.metafields, 'diametro_canon_pulgadas');         // L[16]
        const diaCanonMm   = mf(p.metafields, 'diametro_del_canon_mm');           // L[17]
        const fluted      = window._tv(mf(p.metafields, 'canon_fluteado'));       // L[18]
        const thread      = opt(v.selectedOptions, 2);                             // L[19]
        const diaRosca    = mf(v.metafields, 'diametro_rosca');                   // L[20]
        const mthBrk      = window._tv(mf(p.metafields, 'freno_de_boca'));        // L[21]
        const cajaLarga   = mf(p.metafields, 'caja_larga');                       // L[22]
        const stType      = window._tv(mf(p.metafields, 'tipo_de_culata'));        // L[23]
        const stMat       = window._tv(mf(p.metafields, 'material_caja'));         // L[24]
        const stFin       = window._tv(mf(p.metafields, 'acabado_caja'));          // L[25]
        const cargadorExtr = ynLabel(mf(p.metafields, 'cargador_extraible'));     // L[26]
        const magCap      = mf(v.metafields, 'capacidad_cargador');               // L[27]
        const tipoDisparador = mf(p.metafields, 'tipo_disparador');               // L[28]
        const tipoGatillo = mf(p.metafields, 'tipo_de_gatillo');                  // L[29]
        const gatilloAjust = ynLabel(mf(p.metafields, 'gatillo_ajustable'));      // L[30]
        const sights      = mf(p.metafields, 'miras_abiertas');                   // L[31]
        const optics      = mf(p.metafields, 'optica');                           // L[32]
        const bases       = mf(p.metafields, 'bases');                            // L[33]
        const bandaCanon  = mf(p.metafields, 'banda_canon');                      // L[34]
        const tipoChoke   = mf(p.metafields, 'tipo_de_choke');                    // L[35]
        const choke       = mf(p.metafields, 'choke');                            // L[36]
        const numChokes   = mf(p.metafields, 'numero_chokes');                    // L[37]
        const totLenPulg  = mf(v.metafields, 'longitud_total_pulgadas');          // L[38]
        const totLen      = mf(v.metafields, 'longitud_total_cm');                // L[39]
        const lbs         = mf(v.metafields, 'peso_pounds');                      // L[40]
        const kg          = mf(v.metafields, 'peso_kg');                          // L[41]

        // also needed for button data attrs
        const category = window._tv(mf(p.metafields, 'categoria_web'));

        productsList.insertAdjacentHTML('beforeend', `
          <div w-el="product-card_item" class="products-grid_item is-compare">

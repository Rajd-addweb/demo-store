      /* 15 Material del cañón     */ {{ 'custom.barrel_material' | t | json }},
      /* 16 Diámetro cañón (pulg)  */ {{ 'custom.barrel_diameter' | t | json }} + ' ' + {{ 'custom.inches' | t | json }},
      /* 17 Diámetro cañón (cms)   */ {{ 'custom.barrel_diameter' | t | json }} + ' (mm)',
      /* 18 Cañón fluteado         */ {{ 'custom.barrel_fluted' | t | json }},
      /* 19 Rosca                  */ {{ 'custom.thread' | t | json }},
      /* 20 Diámetro rosca         */ {{ 'custom.thread_diameter' | t | json }},
      /* 21 Freno de boca          */ {{ 'custom.muzzle_brake' | t | json }},
      /* 22 Caja larga             */ {{ 'custom.caja_larga' | t | json }},
      /* 23 Tipo de culata         */ {{ 'custom.stock_type' | t | json }},
      /* 24 Material de caja       */ {{ 'custom.stock_material' | t | json }},
      /* 25 Acabado culata         */ {{ 'custom.stock_finish' | t | json }},
      /* 26 Cargador extraíble     */ {{ 'custom.removable_magazine' | t | json }},

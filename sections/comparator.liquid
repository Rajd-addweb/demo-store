              </div>
              <div class="product-card_details-wrap">
                <h3 class="product-card_heading heading-style-h4 color-primary" style="min-height:4.2rem;">
                  <a class="color-primary" href="${window.Shopify.routes.root}products/${p.handle}">${p.title}</a>
                </h3>
                <div class="product-card_specs-wrap u-vflex-stretch-top u-gap-xxsmall">
                  <div class="product-card_specs_list u-vflex-stretch-top u-gap-xxsmall">
                    ${si(modality,        L[0])}
                    ${si(brand,           L[1])}
                    ${si(model,           L[2])}
                    ${si(submodel,        L[3])}
                    ${si(typW,            L[4])}
                    ${si(subType,         L[5])}
                    ${si(inCatalogLabel,  L[6])}
                    ${si(handness,        L[7])}
                    ${si(precision,       L[8])}
                    ${si(caliber,         L[9])}
                    ${si(twist,           L[10])}
                    ${si(intercBrl,       L[11])}
                    ${si(brlInch,         L[12])}
                    ${si(brlCm,           L[13])}
                    ${si(brlFin,          L[14])}
                    ${si(brlMat,          L[15])}
                    ${si(diaCanonPulg,    L[16])}
                    ${si(diaCanonMm,      L[17])}
                    ${si(fluted,          L[18])}
                    ${si(thread,          L[19])}
                    ${si(diaRosca,        L[20])}
                    ${si(mthBrk,          L[21])}
                    ${si(cajaLarga,       L[22])}
                    ${si(stType,          L[23])}
                    ${si(stMat,           L[24])}
                    ${si(stFin,           L[25])}
                    ${si(cargadorExtr,    L[26])}
                    ${si(magCap,          L[27])}
                    ${si(tipoDisparador,  L[28])}
                    ${si(tipoGatillo,     L[29])}
                    ${si(gatilloAjust,    L[30])}
                    ${si(sights,          L[31])}
                    ${si(optics,          L[32])}
                    ${si(bases,           L[33])}
                    ${si(bandaCanon,      L[34])}
                    ${si(tipoChoke,       L[35])}
                    ${si(choke,           L[36])}
                    ${si(numChokes,       L[37])}
                    ${si(totLenPulg,      L[38])}
                    ${si(totLen,          L[39])}
                    ${si(lbs,             L[40])}
                    ${si(kg,              L[41])}
                  </div>
                </div>
                <div class="product-card_button-wrap u-vflex-stretch-top u-gap-xsmall">
                  <a class="button is-brand" href="${window.Shopify.routes.root}products/${p.handle}">{{ 'custom.more_info_buy' | t }}</a>
                  <div class="flex">
                    <button class="button button-secondary flex is-small"
                      data-fav-handle="${p.handle}"
                      data-fav-title="${p.title} // ${caliber} // ${brlCm}cm (${brlInch}in)"
                      data-fav-product-title="${p.title} // ${caliber} // ${brlCm}cm (${brlInch}in)"
                      data-fav-image="${imgUrl}" data-fav-price=""
                      data-fav-type="${typW}" data-fav-subtype="${subType}"
                      data-fav-category="${category}" data-fav-status="${inCatalogLabel}">
                      <div class="product-card_icon icon-1x1-small w-embed">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="100%" height="100%"><g fill="none"><path d="M8.96173 18.9111L9.42605 18.3221L8.96173 18.9111ZM12 5.50088L11.4596 6.02098C11.601 6.16787 11.7961 6.25088 12 6.25088C12.2039 6.25088 12.399 6.16787 12.5404 6.02098L12 5.50088ZM15.0383 18.9111L15.5026 19.5001L15.0383 18.9111ZM9.42605 18.3221C7.91039 17.1273 6.25307 15.9605 4.93829 14.48C3.64922 13.0285 2.75 11.3347 2.75 9.13734H1.25C1.25 11.8029 2.3605 13.8363 3.81672 15.476C5.24722 17.0868 7.07077 18.3755 8.49742 19.5001L9.42605 18.3221ZM2.75 9.13734C2.75 6.98647 3.96537 5.18277 5.62436 4.42444C7.23607 3.68772 9.40166 3.88282 11.4596 6.02098L12.5404 4.98078C10.0985 2.44377 7.26409 2.02563 5.00076 3.0602C2.78471 4.07317 1.25 6.42527 1.25 9.13734H2.75ZM8.49742 19.5001C9.00965 19.9039 9.55954 20.3345 10.1168 20.6602C10.6739 20.9857 11.3096 21.2502 12 21.2502V19.7502C11.6904 19.7502 11.3261 19.6295 10.8736 19.3651C10.4213 19.1008 9.95208 18.7368 9.42605 18.3221L8.49742 19.5001ZM15.5026 19.5001C16.9292 18.3755 18.7528 17.0868 20.1833 15.476C21.6395 13.8363 22.75 11.8029 22.75 9.13734H21.25C21.25 11.3347 20.3508 13.0285 19.0617 14.48C17.7469 15.9605 16.0896 17.1273 14.574 18.3221L15.5026 19.5001ZM22.75 9.13734C22.75 6.42527 21.2153 4.07317 18.9992 3.0602C16.7359 2.02563 13.9015 2.44377 11.4596 4.98078L12.5404 6.02098C14.5983 3.88282 16.7639 3.68772 18.3756 4.42444C20.0346 5.18277 21.25 6.98647 21.25 9.13734H22.75ZM14.574 18.3221C14.0479 18.7368 13.5787 19.1008 13.1264 19.3651C12.6739 19.6295 12.3096 19.7502 12 19.7502V21.2502C12.6904 21.2502 13.3261 20.9857 13.8832 20.6602C14.4405 20.3345 14.9903 19.9039 15.5026 19.5001L14.574 18.3221Z" fill="currentColor"></path></g></svg>
                      </div>
                      <span data-fav-text="add">{{ 'custom.add_to_favorites' | t }}</span>
                      <span data-fav-text="remove" style="display:none;">{{ 'custom.remove_from_favorites' | t }}</span>
                    </button>
                    <button class="button button-secondary flex is-small js-remove-compare" data-variant-id="${numId}">
                      <div class="product-card_icon with-stroke">
                        <svg width="24" height="24" viewBox="0 0 16 16" fill="none"><path d="M7.875 1.96875H7.21875C4.74387 1.96875 3.50644 1.96875 2.73759 2.73759C1.96875 3.50644 1.96875 4.74387 1.96875 7.21875V8.53125C1.96875 11.0061 1.96875 12.2436 2.73759 13.0124C3.50644 13.7812 4.74387 13.7812 7.21875 13.7812H7.875" stroke="#295A31" stroke-width="0.984375"/><path d="M7.21875 1.96875H9.84375C11.6999 1.96875 12.628 1.96875 13.2046 2.54538C13.7812 3.12202 13.7812 4.05009 13.7812 5.90625V9.84375C13.7812 11.6999 13.7812 12.628 13.2046 13.2046C12.628 13.7812 11.6999 13.7812 9.84375 13.7812H7.21875" stroke="#295A31" stroke-width="0.984375" stroke-linecap="round" stroke-dasharray="1.64 1.97"/><path d="M7.875 1.3125V14.4375" stroke="#295A31" stroke-width="0.984375" stroke-linecap="round"/></svg>
                      </div>
                      {{ 'custom.remove_from_comparison' | t }}
                    </button>
                  </div>
                  ${!IS_PRIVATE_USER ? `
                  <button class="button button-secondary is-small open-ad-popup"
                    data-sell-handle="${p.handle}" data-sell-type="${typW}"
                    data-sell-subtype="${subType}" data-sell-brand="${brand}"
                    data-sell-model="${sellModel}" data-sell-caliber="${caliber}"
                    data-sell-barrel="${brlCmFull}" data-sell-image="${imgUrl}"
                    data-sell-source="comparator">
                    <div class="product-card_icon icon-1x1-small w-embed">
                      <svg width="24" height="24" viewBox="0 0 16 16" fill="none"><g clip-path="url(#c1)"><path d="M15.6187 4.92189C15.6187 3.87189 14.3719 3.08439 12.6984 3.08439C12.6 3.08439 12.4687 3.08439 12.3375 3.1172L12.3047 2.62501C12.2719 2.29689 12.0094 2.0672 11.7141 2.03439L7.05469 1.57501C6.85781 1.57501 6.66094 1.64064 6.52969 1.77189L0.360938 7.94064C0.0984375 8.20314 0.0984375 8.59689 0.360938 8.85939L5.44688 13.9453C5.57812 14.0766 5.74219 14.1422 5.90625 14.1422C6.07031 14.1422 6.23438 14.0766 6.36562 13.9781L12.5672 7.80939C12.6984 7.67814 12.7969 7.48126 12.7641 7.28439L12.6984 6.72657C14.3719 6.72657 15.5859 5.93907 15.6187 4.92189ZM5.90625 12.6L1.70625 8.43283L7.21875 2.92032L11.0578 3.28126L11.2219 5.05314C11.1234 4.98751 11.0578 4.92189 11.0578 4.88907C11.0578 4.52814 10.7625 4.23282 10.4016 4.23282C10.0406 4.23282 9.74531 4.52814 9.74531 4.88907C9.74531 5.64376 10.4016 6.2672 11.3531 6.56251L11.4187 7.08751L5.90625 12.6ZM12.6984 5.44689C12.6656 5.44689 12.6328 5.44689 12.5672 5.44689L12.4688 4.36407H12.6984C13.7484 4.36407 14.3063 4.75782 14.3391 4.88907C14.3063 5.02032 13.7484 5.44689 12.6984 5.44689Z" fill="#295A31"/></g><defs><clipPath id="c1"><rect width="15.75" height="15.75" fill="white"/></clipPath></defs></svg>
                    </div>
                    {{ 'custom.sell_firearm' | t }}
                  </button>
                  ` : ''}
                </div>
              </div>
            </div>
          </div>
        `);

        if (valid.length === 1) {
          productsList.insertAdjacentHTML('beforeend', `
            <div class="products-grid_item is-compare is-add-more-card">
              <a href="{{ routes.collections_url }}/firearms" class="product-grid_add-btn_component">
                <div class="product-grid_add-btn_layout">
                  <div class="product-grid_add-btn_icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" role="img">
                      <g fill="none">
                        <circle cx="12" cy="12" r="10" stroke="#295a31" stroke-width="1.5"></circle>
                        <path d="M15 12L12 12M12 12L9 12M12 12L12 9M12 12L12 15" stroke="#295a31" stroke-width="1.5" stroke-linecap="round"></path>
                      </g>
                    </svg>
                  </div>
                  <div class="product-grid_add-btn_label color-primary">{{ 'custom.add_weapon' | t }}</div>
                </div>
              </a>
            </div>
          `);
        }
      });

      tableWrap.style.display = 'block';

      document.querySelectorAll('.js-remove-compare').forEach(btn => {
        btn.addEventListener('click', async function () {
          this.disabled = true; this.textContent = '{{ 'custom.removing' | t }}...';
          await removeItem(this.dataset.variantId);
          render();
        });
      });

      if (window.GunloupeAdPopup) window.GunloupeAdPopup.bindButtons();
      setTimeout(() => {
        if (window.GunloupeFavorites) { window.GunloupeFavorites.sync(); window.GunloupeFavorites.bindButtons(); }
      }, 300);
    }

    function initWhenReady() {
      if (window.GunloupeComparator && window.GunloupeComparator.getItems) {
        render();
      } else {
        initWhenReady._attempts = (initWhenReady._attempts || 0) + 1;
        if (initWhenReady._attempts < 40) {
          setTimeout(initWhenReady, 50);
        } else {
          render();
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWhenReady);
    } else {
      initWhenReady();
    }

  })();
</script>
{% endif %}

<style>
  .comparator-section-wrap{padding:40px 0 80px}
  .comparator-loading{display:flex;flex-direction:column;align-items:center;gap:16px;padding:80px 20px;color:#888;font-size:.95rem}
  .comparator-spinner{width:36px;height:36px;border:3px solid #e8ede9;border-top-color:var(--color-foreground);border-radius:50%;animation:cmpSpin .7s linear infinite}
  @keyframes cmpSpin{to{transform:rotate(360deg)}}
  .comparator-empty,.comparator-login-prompt{display:flex;flex-direction:column;align-items:center;gap:16px;padding:80px 20px;text-align:center}
  .comparator-empty h3,.comparator-login-prompt h3{font-size:1.2rem;font-weight:600;color:#1a1a1a;margin:0}
  .comparator-empty p,.comparator-login-prompt p{color:#777;font-size:.9rem;max-width:360px;line-height:1.6;margin:0}
  .comparator-browse-btn{display:inline-flex;align-items:center;gap:8px;background:var(--color-foreground);color:#fff;border:none;border-radius:6px;padding:12px 28px;text-decoration:none;cursor:pointer;transition:background .2s;margin-top:8px;width:100%;max-width:512px;text-align:center;justify-content:center}
  .comparator-browse-btn:hover{background:#1e4325;color:#fff}
  .comparator-browse-btn.is-secondary{background:transparent;color:var(--color-foreground);border:1px solid var(--color-foreground)}
  .comparator-browse-btn.is-secondary:hover{background:#f0f7f1}
  .product-card_button-wrap{display:flex;flex-direction:column;gap:8px}
  .comparator-footer{padding:40px 0;text-align:center;border-top:1px solid #e8ede9;margin-top:40px}
  @media(max-width:768px){.compare_list-titles{width:120px}.product-card_specs_item.is-legend{padding:8px;min-height:40px}.products-grid_item.is-compare{min-width:200px}.product-card_specs_item{min-height:40px;padding:8px}.product-card_specs_spec-text{font-size:.78rem}}
</style>

{% schema %}
{
  "name": "Comparator",
  "settings": [
    { "type": "header", "content": "Layout Settings" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "min": 0, "max": 100, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "min": 0, "max": 100, "step": 4, "default": 40 },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Comparator" }]
}
{% endschema %}

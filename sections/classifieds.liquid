{% comment %}
section.classifieds.liquid
──────────────────────────────────────────────────────────────────────────────
Public classifieds listing page.
- Loads all published ads from backend /my-adverts/all
- Search, Filters (Type, Action/Sub-Type, Brand, Model, Caliber, Gun Shop), Sort
- Sold ads: greyed out with SOLD badge, NOT clickable
- Hidden: deactivated, archived, rejected, deleted
- "Sell another Firearm" → redirects to My Armorer
- Locale-aware URLs via GunloupeRoutes
- Pagination: 9 per page, stays on current page after filter/sort
{% endcomment %}

{%- comment -%}
FIX: Inject Liquid-translated filter label strings into JS before the script runs.
This ensures dropdown labels render correctly in both EN (/en) and ES (default).
Update the translation keys below to match your actual locales/en.default.json keys.

NOTE: `gunshop` label added for the new "Gun Shop" / "Armería" filter.
Add `custom.gun_shop` to your locale files: EN "Gun Shop", ES "Armería".
{%- endcomment -%}
<script>
  window._clfLabels = {
    status:       {{ 'custom.status'       | t | json }},
    type:    {{ 'custom.type'    | t | json }},
    subtype: {{ 'custom.subtype' | t | json }},
    caliber: {{ 'custom.caliber' | t | json }},
    handedness:   {{ 'custom.handedness'   | t | json }},
    brand:   {{ 'custom.brand'   | t | json }},
    model:   {{ 'custom.model'   | t | json }},
    gunshop: {{ 'custom.gun_shop' | t | json }},
    city:         {{ 'custom.city'         | t | json }},
    availability: {{ 'custom.availability' | t | json }}
  };
</script>

<script>
  window._availabilityLabels = {
    in_stock:   {{ 'custom.availability_in_stock'   | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" | json }},
    wholesaler: {{ 'custom.availability_wholesaler' | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" | json }},
    on_demand:  {{ 'custom.availability_on_demand'  | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" | json }}
  };
</script>
<script>
  window._statusLabels = {
    new:         {{ 'custom.new'         | t | json }},
    nearly_new:  {{ 'custom.nearly_new'  | t | json }},
    used:        {{ 'custom.used'        | t | json }},
    deactivated: {{ 'custom.deactivated' | t | json }}
  };
</script>

<section id="section-classifieds" class="section-classifieds"
    style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;">

    <div class="classifieds-heading-wrapper">
        {%- comment -%} h2, not h1: layout/theme.liquid already renders the page's
           single h1. This heading was tagged h1 while carrying h2 styling classes,
           so the page ended up with two h1s. Tag only — appearance is unchanged.
        {%- endcomment -%}
        <h2 class="classifieds-heading h2">{{ 'custom.classifieds' | t }}</h2>
        <div class="home-product-search-wrapper">
            <div class="form_field-wrapper">
                <div class="form_field-input-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 512 512" fill="none"
                        preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                        <g clip-path="url(#clip0_4162_4606)">
                            <path
                                d="M416 208C416 253.9 401.1 296.3 376 330.7L502.6 457.4C515.1 469.9 515.1 490.2 502.6 502.7C490.1 515.2 469.8 515.2 457.3 502.7L330.7 376C296.3 401.2 253.9 416 208 416C93.1 416 0 322.9 0 208C0 93.1 93.1 0 208 0C322.9 0 416 93.1 416 208ZM208 352C226.91 352 245.636 348.275 263.106 341.039C280.577 333.802 296.452 323.195 309.823 309.823C323.195 296.452 333.802 280.577 341.039 263.106C348.275 245.636 352 226.91 352 208C352 189.09 348.275 170.364 341.039 152.894C333.802 135.423 323.195 119.548 309.823 106.177C296.452 92.805 280.577 82.198 263.106 74.9613C245.636 67.7247 226.91 64 208 64C189.09 64 170.364 67.7247 152.894 74.9613C135.423 82.198 119.548 92.805 106.177 106.177C92.805 119.548 82.198 135.423 74.9613 152.894C67.7247 170.364 64 189.09 64 208C64 226.91 67.7247 245.636 74.9613 263.106C82.198 280.577 92.805 296.452 106.177 309.823C119.548 323.195 135.423 333.802 152.894 341.039C170.364 348.275 189.09 352 208 352Z"
                                fill="currentColor"></path>
                        </g>
                    </svg>
                </div>
                <input type="text" id="classifieds-search" class="home-product-search__input classifieds-search-input"
                    value="{{ request.params.q }}" placeholder=" ">
                <label class="form_label">{{ 'custom.search_adverts' | t }}...</label>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- SELL CTA -->

        {% assign user_type = customer.metafields.custom.user_type.value %}

        {% if user_type == 'business' %}
            <div style="margin-bottom:32px;">
                <a href="#" class="product-grid_add-btn_component" id="clf-sell-btn">
                    <div class="product-grid_add-btn_layout u-vflex-center-center u-gap-medium">
                        <div class="product-grid_add-btn_icon icon-1x1-large w-embed">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" width="100%" height="100%">
                            <g fill="none">
                                <circle cx="12" cy="12" r="10" stroke="#295A31" stroke-width="1.5"></circle>
                                <path d="M15 12L12 12M12 12L9 12M12 12L12 9M12 12L12 15" stroke="#295A31" stroke-width="1.5" stroke-linecap="round"></path>
                            </g>
                            </svg>
                        </div>
                        <div class="product-grid_add-btn_label text-style-allcaps color-primary">
                            {{ 'custom.sell_another_firearm' | t }}
                        </div>
                    </div>
                </a>
            </div>
        {% endif %}

        <!-- FILTERS + SORT -->
        <div class="classifieds-toolbar">
            <div class="classifieds-filters">
                <span class="classifieds-filter-label">{{ 'custom.filter_by' | t }}:
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <mask id="mask0_1316_13996" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="18" height="18">
                        <rect width="18" height="18" fill="#D9D9D9"/>
                        </mask>
                        <g mask="url(#mask0_1316_13996)">
                        <path d="M7.22222 14V12.3333H10.7778V14H7.22222ZM3.66667 9.83333V8.16667H14.3333V9.83333H3.66667ZM1 5.66667V4H17V5.66667H1Z" fill="#295A31"/>
                        </g>
                    </svg>
                </span>
                <div class="filter-tabs">
                    <div class="close-btn">
                        <button id="closeDrawer2">
                            {% render 'icon-close' %}
                        </button>
                    </div>
                    <div class="clf-dropdown" data-filter="status">
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.status' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <div class="clf-dropdown" data-filter="type">
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.type' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <div class="clf-dropdown" data-filter="subtype">
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.subtype' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <div class="clf-dropdown" data-filter="caliber">
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.caliber' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <div class="clf-dropdown" data-filter="handedness">
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.handedness' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <div class="clf-dropdown" data-filter="brand">
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.brand' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <button type="button" id="clf-more-toggle" class="clf-dropdown-toggle clf-more-toggle">
                        <span class="clf-more-text">{{ 'custom.more_filters' | t }}</span>
                        {% render 'icon-arrowdown' %}
                    </button>

                    <!-- Forces Model/Gunshop/City/Availability onto their own line when
                         revealed, WITHOUT blocking Reset/Apply from trailing on that same
                         line — a wrapping element with flex-basis:100% would also push its
                         own trailing siblings to a new row, which a plain break spacer avoids. -->
                    <span class="clf-row-break" aria-hidden="true" hidden></span>

                    <div class="clf-dropdown clf-extra" data-filter="model" hidden>
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.model' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <!-- Gun Shop / Armería filter (generic seller-name dropdown) -->
                    <div class="clf-dropdown clf-extra" data-filter="gunshop" hidden>
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.gun_shop' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <div class="clf-dropdown clf-extra" data-filter="city" hidden>
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.city' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <div class="clf-dropdown clf-extra" data-filter="availability" hidden>
                        <button type="button" class="clf-dropdown-toggle">
                            {{ 'custom.availability' | t }}
                            {% render 'icon-arrowdown' %}
                        </button>
                        <div class="clf-dropdown-menu">
                            <input type="text" class="clf-dropdown-search" placeholder="{{ 'accessibility.search' | t }}...">
                            <ul class="clf-dropdown-list"></ul>
                        </div>
                    </div>

                    <!-- Desktop: trails whichever row is currently visible (row 1 when
                         collapsed, row 2 once expanded) since it's a plain flow sibling. -->
                    <button type="button" class="btn-link color-primary clf-reset-btn clf-reset-inline js-clf-reset">
                        {{ 'custom.reset_all' | t }}
                    </button>

                    <button type="button" id="clf-apply" class="button is-brand is-small bg-color-orange clf-apply-btn">
                        {{ 'actions.apply' | t }}
                    </button>
                </div>
            </div>

            <div class="classifieds-sort">
                <span class="clf-sort-label">{{ "custom.sort_by" | t }}</span>
                <select id="clf-sort" class="clf-sort-select">
                    <option value="newest">{{ "custom.date_" | t }} ({{ "custom.newest" | t }})</option>
                    <option value="oldest">{{ "custom.date_" | t }} ({{ "custom.oldest" | t }})</option>
                    <option value="price_asc">{{ "custom.price" | t }} ({{ "custom.Bajo_Alto" | t }})</option>
                    <option value="price_desc">{{ "custom.price" | t }} ({{ "custom.Alto_bajo" | t }})</option>
                </select>
            </div>
        </div>

        <!-- ACTIVE FILTER CHIPS
             Mobile only: the filter toggles themselves carry the "Label: Value"
             text on desktop, but on mobile they live inside a drawer, so once it
             closes there is nothing on screen saying which filters are on. -->
        <div class="clf-active-chips" id="clf-active-chips" hidden></div>

        <!-- RESULTS COUNT -->
        <div class="classifieds-results-count" id="clf-count" style="display:none;"></div>

        <!-- LOADING -->
        <div class="classifieds-loading" id="clf-loading">
            <div class="comparator-spinner"></div>
            <span>{{ "custom.loading" | t }}...</span>
        </div>

        <!-- EMPTY -->
        <div class="classifieds-empty" id="clf-empty" style="display:none;">
            <svg width="48" height="48" viewBox="0 0 56 56" fill="none">
                <circle cx="28" cy="28" r="27" stroke="#295A31" stroke-width="1.5" opacity="0.4" />
                <path d="M28 18v12M28 33v2" stroke="#295A31" stroke-width="2" stroke-linecap="round" opacity="0.4" />
            </svg>
            <p>{{ 'custom.no_adverts_found' | t }}.</p>
        </div>

        <!-- ADS LIST -->
        <div class="ads-list_list" id="clf-list" style="display:none;"></div>

        <!-- PAGINATION -->
        <div class="clf-pagination" id="clf-pagination" style="display:none;">
            <button class="clf-page-btn" id="clf-prev-page">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15 18 9 12 15 6" />
                </svg>
            </button>
            <div class="clf-page-numbers" id="clf-page-numbers"></div>
            <button class="clf-page-btn" id="clf-next-page">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6" />
                </svg>
            </button>
        </div>
    </div>
</section>

<script>window.GL_LOCALE = {{ request.locale.iso_code | json }};</script>
{% render 'gl-ad-meta' %}
<script>
  // Locale-aware value translation for firearm type / subtype (mirrors the
  // homepage search section's verified valueMap — same source of truth).
  // Ad data may be stored in EITHER language, so we normalise to a canonical
  // (English) key first, then render in the active locale. Storage language
  // is therefore irrelevant. Add pairs here to translate more fields later.
  window.GLI18n = window.GLI18n || (function () {
    {% render 'gl-ads-value-translations' %}

    var ES_TO_EN = {};
    Object.keys(EN_TO_ES).forEach(function (en) {
      var es = EN_TO_ES[en];
      if (!(es in ES_TO_EN)) ES_TO_EN[es] = en; // first wins; identical dups are harmless
    });

    function locale() {
      var l = (window.GL_LOCALE || '').toLowerCase();
      return l === 'en' ? 'en' : 'es'; // Spanish is the default
    }

    // Any stored value (EN or ES) → its English canonical form.
    function canonical(value) {
      if (value == null) return '';
      var v = String(value).trim();
      if (EN_TO_ES.hasOwnProperty(v)) return v;          // already English
      if (ES_TO_EN.hasOwnProperty(v)) return ES_TO_EN[v]; // Spanish → English
      return v;                                          // unknown → pass through
    }

    // Translate a stored value into the active (or given) locale.
    function t(value, loc) {
      var target = loc || locale();
      var canon  = canonical(value);
      if (target === 'en') return canon;
      return EN_TO_ES.hasOwnProperty(canon) ? EN_TO_ES[canon] : canon;
    }

    return { t: t, canonical: canonical, locale: locale };
  })();
</script>
<script>
    (function () {
        'use strict';
        const I18N = window.GLI18n || { t: v => v, canonical: v => v, locale: () => 'es' };
        // `status` and `handedness` are stored as a single canonical Spanish literal
        // regardless of storefront locale (see add-ad-popup.liquid), but still need
        // GLI18n to render translated in the active locale.
        const TRANSLATABLE = { type: true, subtype: true, status: true, handedness: true };
        const isTranslatable = key => !!TRANSLATABLE[key];

        // Full ordered list of filter keys shared by the options-builder and the
        // apply pipeline, so both always stay in sync.
        const FILTER_KEYS = ['status', 'type', 'subtype', 'caliber', 'handedness', 'brand', 'model', 'gunshop', 'city', 'availability'];
        // Keys tucked behind the "More filters" toggle (elements with .clf-extra).
        const EXTRA_FILTER_KEYS = ['model', 'gunshop', 'city', 'availability'];

        const BACKEND_URL = 'https://shopify-gunloupe.addwebprojects.com';
        const PER_PAGE    = 9;

        const COLLECTION_URL = {% if request.locale.iso_code == 'en' %}'/en/collections/firearms'{% else %}'/collections/armas'{% endif %};
        const PARAM_TO_KEY = {
            'filter.p.product_type': 'type',
            'filter.p.m.custom.sub_tipo_de_arma': 'subtype',
            'filter.p.m.custom.marca': 'brand',
            'filter.p.m.custom.modelo': 'model',
            'filter.v.option.calibre': 'caliber',
            'filter.v.option.Calibre': 'caliber',
            'filter.v.option.caliber': 'caliber',
        };

        // NOTE: `gunshop`, `city`, `availability`, `status` and `handedness` are NOT
        // Shopify catalogue filters — they are derived purely from the loaded ads
        // (and, for `handedness`, from a live per-product metafield fetch). They stay
        // empty here; see rebuildFilterOptions / sellerNameOf / attachHandedness.
        let catalogueOptions = {status: [], type: [], subtype: [], caliber: [], handedness: [], brand: [], model: [], gunshop: [], city: [], availability: []};

        async function fetchCatalogueFilters() {
            try {
                const res  = await fetch(COLLECTION_URL);
                const html = await res.text();
                const doc  = new DOMParser().parseFromString(html, 'text/html');
                doc.querySelectorAll('.filter-group').forEach(group => {
                    const firstInput = group.querySelector('li input[type="checkbox"]');
                    if (!firstInput) return;
                    const key = PARAM_TO_KEY[firstInput.name];
                    if (!key) return;
                    const values = Array.from(group.querySelectorAll('li input[type="checkbox"]'))
                        .filter(i => !i.disabled).map(i => i.value).filter(Boolean);
                    if (values.length) catalogueOptions[key] = values;
                });
            } catch (e) { console.warn('Could not fetch catalogue filters:', e); }
            rebuildFilterOptions();
        }

        const R              = window.GunloupeRoutes || {};
        const AD_DETAIL_BASE = R.adDetail  || '/pages/detalle-anuncio';
        const MY_ARMORER_URL = R.myAdverts || '/pages/anuncios';

        const sellBtn = document.getElementById('clf-sell-btn');
        if (sellBtn) sellBtn.href = MY_ARMORER_URL;
 
        // ── State ──────────────────────────────────────────────────────────────────
        // MULTI-SELECT: `gunshop` holds an ARRAY of selected shop names (choose one
        // or more sellers). All other filters remain single-select strings. To make
        // another filter multi-select later, just add it to MULTI_SELECT and give it
        // an array default in emptyFilters().
        const MULTI_SELECT = { gunshop: true };
        const isMulti = key => !!MULTI_SELECT[key];

        function emptyFilters() {
            return { status: '', type: '', subtype: '', caliber: '', handedness: '', brand: '', model: '', gunshop: [], city: '', availability: '' };
        }
        // Clone so array-valued filters are never shared by reference between the
        // active/pending copies.
        function cloneFilters(f) {
            const out = {};
            Object.keys(f).forEach(k => { out[k] = Array.isArray(f[k]) ? f[k].slice() : f[k]; });
            return out;
        }

        let allAds        = [];
        let filtered      = [];
        let currentPage   = 1;
        let activeFilters = emptyFilters();
        let pendingFilters= emptyFilters();
        let searchTerm    = '';
        let sortMode      = 'newest';

        // ── Field resolution ───────────────────────────────────────────────────────
        // Standard firearm fields map 1:1 to ad properties. The "gunshop" filter is
        // special: its value is the seller's shop name.
        //
        // Going forward, only business/gun-shop users can post ads, and shop name is
        // a mandatory profile field (a seller cannot proceed without it), so
        // `seller_shop_name` is the canonical identity for this filter — no
        // seller_type gating and no email/personal-name fallback are required.
        // `seller_name` is kept only as a soft guard for any legacy ad created before
        // the profile requirement; it (and this fallback) can be dropped once the
        // data migration is complete. An ad with no shop name simply won't appear as
        // a filterable seller rather than leaking an email prefix.
        const AD_FIELD = {
            type:    'firearm_type',
            subtype: 'firearm_subtype',
            brand:   'firearm_brand',
            model:   'firearm_model',
            caliber: 'firearm_caliber',
            city:         'city',
            availability: 'firearm_availability',
            status:       'firearm_status',
            // Not part of the ad payload — populated at runtime from each ad's
            // linked product metafield (custom.lateralidad). See attachHandedness.
            handedness:   'firearm_handedness'
        };

        // Display text for a filter option/value: translated via GLI18n for
        // bilingual-storage fields, via the availability label map for
        // availability (locale-agnostic keys), plain otherwise.
        function fieldDisplay(filterKey, value) {
            if (!value) return '';
            if (isTranslatable(filterKey)) return I18N.t(value);
            if (filterKey === 'availability') return (window._availabilityLabels && window._availabilityLabels[value]) || value;
            return value;
        }

        const AdMeta = window.GunloupeAdMeta;

        function sellerNameOf(ad) {
            if (!ad) return '';
            return ad.seller_shop_name || ad.seller_name || '';
        }

        function adFieldValue(ad, key) {
            return key === 'gunshop' ? sellerNameOf(ad) : ad[AD_FIELD[key]];
        }

        // Does an ad satisfy the currently-active value(s) for one filter key?
        // Single-select: exact match (empty = no constraint).
        // Multi-select : value is one of the selected array (empty array = no constraint).
        function matchesFilter(ad, key) {
            const active = activeFilters[key];
            const val    = adFieldValue(ad, key);
            if (isTranslatable(key)) {
                const cv = I18N.canonical(val); // compare canonically so EN/ES both match
                if (Array.isArray(active)) return active.length === 0 || active.some(a => I18N.canonical(a) === cv);
                return !active || I18N.canonical(active) === cv;
            }
            if (Array.isArray(active)) return active.length === 0 || active.includes(val);
            return !active || val === active;
        }

        // ── Format price (currency aware — mirrors ad-detail) ──────────────────────
        function formatPrice(val, adCurrency) {
            if (!val) return 'N/A';
            const num = parseFloat(String(val).replace(/[^0-9.]/g, ''));
            if (isNaN(num) || num === 0) return 'N/A';
            const sourceCurrency = adCurrency || 'EUR';
            const currency = localStorage.getItem('currency') || 'EUR';
            const rate = parseFloat(localStorage.getItem('eur_to_usd') || '1.08');
            const numInEur = sourceCurrency === 'USD' ? num / rate : num;
            if (currency === 'USD') return '$' + Math.round(numInEur * rate);
            return numInEur.toLocaleString('en-US', { minimumFractionDigits: 0 }) + '€';
        }

        // ── Parse images ───────────────────────────────────────────────────────────
        function parseImages(ad) {
            let images = [];
            if (ad.ad_images) {
                try {
                    const parsed = JSON.parse(ad.ad_images);
                    if (Array.isArray(parsed)) images = parsed.filter(u => u && u.startsWith('http'));
                } catch (e) {}
            }
            if (!images.length && ad.product_image && ad.product_image.startsWith('http')) images = [ad.product_image];
            if (!images.length) images = ['https://cdn.shopify.com/s/files/1/0977/9986/4694/files/product-placeholder.svg'];
            return images;
        }

        function renderSlider(images, adId) {
            if (!images.length) return `<img src="https://cdn.shopify.com/s/files/1/0977/9986/4694/files/product-placeholder.svg" class="ad-single-image" loading="lazy">`;
            if (images.length === 1) return `<img src="${images[0]}" alt="Ad image" class="ad-single-image" loading="lazy">`;
            const slides = images.map(img => `<div class="gun-slide"><img src="${img}" alt="Ad image" loading="lazy"></div>`).join('');
            const dots   = images.map((_, i) => `<span class="gun-dot${i === 0 ? ' is-active' : ''}"></span>`).join('');
            return `<div class="gun-slider" data-slider data-ad-id="${adId}"><div class="gun-slider-track">${slides}</div><button class="gun-prev" type="button">‹</button><button class="gun-next" type="button">›</button><div class="gun-dots">${dots}</div></div>`;
        }

        function initSliders() {
            document.querySelectorAll('#clf-list .gun-slider[data-slider]').forEach(slider => {
                const track  = slider.querySelector('.gun-slider-track');
                const slides = slider.querySelectorAll('.gun-slide');
                const dots   = slider.querySelectorAll('.gun-dot');
                const prev   = slider.querySelector('.gun-prev');
                const next   = slider.querySelector('.gun-next');
                if (!track || slides.length <= 1) return;
                let current = 0;
                function goTo(idx) {
                    current = (idx + slides.length) % slides.length;
                    track.style.transform = `translateX(-${current * 100}%)`;
                    dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
                }
                if (prev) prev.addEventListener('click', () => goTo(current - 1));
                if (next) next.addEventListener('click', () => goTo(current + 1));
                dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
            });
        }

        function renderCard(ad) {
            const images       = parseImages(ad);
            const isSold       = ad.ad_status === 'sold';
            const adNumericId  = String(ad.id || '').split('/').pop();
            // Title is "Model | Caliber"; barrel length and handedness are no
            // longer folded into the title/subtitle text — each gets its own
            // labelled chip on the meta row below so the numbers are readable.
            const modelParts   = AdMeta.splitModelBarrel(ad.firearm_model);
            const titleLine    = [modelParts.model, ad.firearm_caliber].filter(Boolean).join(' | ');
            const subtitleLine = [I18N.t(ad.firearm_type), I18N.t(ad.firearm_subtype)].filter(Boolean).join(' / ');

            const barrelChip = AdMeta.barrelChipHtml(modelParts.barrelCm);
            const handChip   = AdMeta.handednessChipHtml(ad.firearm_handedness);
            let sellerDisplay;
            if (ad.seller_type === 'business') {
                sellerDisplay = ad.seller_shop_name || (ad.seller_email ? ad.seller_email.split('@')[0] : '—');
            } else {
                sellerDisplay = ad.seller_name || (ad.seller_email ? ad.seller_email.split('@')[0] : '—');
            }
            const sellerTypeLabel = ad.seller_type === 'business' ? '{{ 'custom.login_business' | t }}' : '{{ 'custom.login_private' | t }}';
            const sellerTypeBadge = `<span class="ad-seller-type-badge ad-seller-type-badge--${ad.seller_type || 'private'}">${sellerTypeLabel}</span>`
            const seeAdBtn     = isSold
                ? `<button class="button button-secondary is-small" disabled style="opacity:0.5;cursor:not-allowed;">{{ 'custom.sold' | t }}</button>`
                : `<button class="button button-secondary is-small clf-see-ad" data-handle="${adNumericId}">{{ 'custom.see_ad' | t }}</button>`;

            return `
            <div class="ads-list_item clf-card${isSold ? ' clf-sold' : ''}" data-ad-id="${ad.id}">
              <div class="ad-card_component">
                <div class="ad-card_logo-wrap" style="position:relative;">
                  <div class="gun-card__media-wrapper">
                    <div class="gun-card__media${images.length <= 1 ? ' single' : ''}">${renderSlider(images, adNumericId)}</div>
                  </div>
                  ${isSold ? `<div class="clf-sold-overlay"><span class="clf-sold-badge">{{ 'custom.sold' | t }}</span></div>` : ''}
                </div>
                <div class="ad-card_component-data">
                  <div class="ad-card_component-data-top">
                    <div class="ad-card_title">
                      ${ad.firearm_personalized_name ? `<div class="ad-card_nickname text-size-tiny">${ad.firearm_personalized_name}</div>` : ''}
                      <div class="ad-card_title-text">${titleLine || '—'}</div>
                      <div class="ad-card_meta-row">
                        ${(ad.product_handle && !ad.product_handle.startsWith('custom-'))
                          ? `<a href="${window.Shopify.routes.root}products/${ad.product_handle}" class="ad-card_product-link text-size-small">${subtitleLine}</a>`
                          : `<span class="ad-card_product-link text-size-small">${subtitleLine}</span>`}
                        ${barrelChip}
                        ${handChip}
                      </div>
                      <div class="user-type-wrapper">
                        <span class="ad-card_useralias text-size-tiny">${sellerDisplay}</span>
                      </div>
                    </div>
                    <div class="ad-card_stat">
                      <div class="product-table_header-cell text-size-small">{{ 'custom.city' | t }}</div>
                      <div class="product-table_spec-text">${ad.city || '—'}</div>
                    </div>
                    <div class="ad-card_stat">
                      <div class="product-table_header-cell text-size-small">{{ 'custom.price' | t }}</div>
                      <div class="product-table_spec-text price" data-price="${ad.price || 0}" data-currency="${ad.currency || 'EUR'}">${formatPrice(ad.price, ad.currency)}</div>
                    </div>
                    <div class="ad-card_stat">
                      <div class="product-table_header-cell text-size-small">{{ 'custom.availability' | t }}</div>
                      <div class="product-table_spec-text">${(window._availabilityLabels && window._availabilityLabels[ad.firearm_availability]) || ad.firearm_availability || '—'}</div>
                    </div>
                    <div class="ad-card_stat">
                      <div class="product-table_header-cell text-size-small">{{ 'custom.status' | t }}</div>
                      <div class="product-table_spec-text">${I18N.t(ad.firearm_status) || '—'}</div>
                    </div>
                  </div>
                </div>
                <div class="ad-card_button-wrap">${seeAdBtn}</div>
              </div>
            </div>`;
        }

        // ── Render current page ────────────────────────────────────────────────────
        function renderPage(preservePage) {
            const listEl  = document.getElementById('clf-list');
            const emptyEl = document.getElementById('clf-empty');
            const countEl = document.getElementById('clf-count');
            const paginEl = document.getElementById('clf-pagination');

            listEl.innerHTML = '';

            if (!filtered.length) {
                listEl.style.display  = 'none';
                emptyEl.style.display = 'flex';
                countEl.style.display = 'none';
                paginEl.style.display = 'none';
                return;
            }

            emptyEl.style.display = 'none';
            listEl.style.display  = 'flex';
            countEl.style.display = 'block';

            const totalPages = Math.ceil(filtered.length / PER_PAGE);

            if (!preservePage) {
                currentPage = 1;
            } else {
                currentPage = Math.max(1, Math.min(currentPage, totalPages));
            }

            const start   = (currentPage - 1) * PER_PAGE;
            const pageAds = filtered.slice(start, start + PER_PAGE);

            const countText = `${filtered.length} {{ 'custom.ads' | t }}${filtered.length !== 1 ? 's' : ''} {{ 'custom.found' | t }}`;
            const summary   = activeFilterSummary();
            countEl.textContent = summary.length
                ? `${countText} \u00B7 ${summary.map(i => i.value_display).join(' \u00B7 ')}`
                : countText;

            pageAds.forEach(ad => listEl.insertAdjacentHTML('beforeend', renderCard(ad)));

            initSliders();

            listEl.querySelectorAll('.clf-see-ad').forEach(btn => {
                btn.addEventListener('click', function () {
                    const handle = this.dataset.handle;
                    if (handle) window.location.href = `${AD_DETAIL_BASE}?handle=${handle}`;
                });
            });

            if (totalPages > 1) {
                paginEl.style.display = 'flex';
                renderPagination(totalPages);
            } else {
                paginEl.style.display = 'none';
            }

            if (typeof updatePrices === 'function') updatePrices();
        }

        // ── Pagination UI ──────────────────────────────────────────────────────────
        function renderPagination(totalPages) {
            const nums    = document.getElementById('clf-page-numbers');
            const prevBtn = document.getElementById('clf-prev-page');
            const nextBtn = document.getElementById('clf-next-page');
            nums.innerHTML   = '';
            prevBtn.disabled = currentPage === 1;
            nextBtn.disabled = currentPage === totalPages;

            buildPageRange(currentPage, totalPages).forEach(p => {
                if (p === '...') {
                    const dots = document.createElement('span');
                    dots.className   = 'clf-page-dots';
                    dots.textContent = '...';
                    nums.appendChild(dots);
                } else {
                    const btn = document.createElement('button');
                    btn.className   = 'clf-page-num' + (p === currentPage ? ' active' : '');
                    btn.textContent = p;
                    btn.addEventListener('click', () => {
                        currentPage = p;
                        renderPage(true);
                        window.scrollTo({top: 0, behavior: 'smooth'});
                    });
                    nums.appendChild(btn);
                }
            });
        }

        function buildPageRange(current, total) {
            if (total <= 7) return Array.from({length: total}, (_, i) => i + 1);
            const pages = [1];
            if (current > 3) pages.push('...');
            for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) pages.push(i);
            if (current < total - 2) pages.push('...');
            pages.push(total);
            return pages;
        }

        document.getElementById('clf-prev-page').addEventListener('click', () => {
            if (currentPage > 1) { currentPage--; renderPage(true); window.scrollTo({top: 0, behavior: 'smooth'}); }
        });
        document.getElementById('clf-next-page').addEventListener('click', () => {
            const total = Math.ceil(filtered.length / PER_PAGE);
            if (currentPage < total) { currentPage++; renderPage(true); window.scrollTo({top: 0, behavior: 'smooth'}); }
        });

        // ── Apply search + filters + sort ──────────────────────────────────────────
        function applyAll(preservePage) {
            let result = allAds.slice();

            if (searchTerm) {
                const q = searchTerm.toLowerCase();
                result  = result.filter(ad =>
                    [ad.firearm_brand, ad.firearm_model, ad.firearm_caliber,
                     ad.firearm_type, ad.firearm_subtype,
                     I18N.t(ad.firearm_type, 'es'), I18N.t(ad.firearm_type, 'en'),
                     I18N.t(ad.firearm_subtype, 'es'), I18N.t(ad.firearm_subtype, 'en'),
                     ad.city, ad.seller_shop_name, ad.seller_name,
                     ad.firearm_personalized_name, ad.description]
                    .some(v => v && v.toLowerCase().includes(q))
                );
            }

            FILTER_KEYS.forEach(key => { result = result.filter(ad => matchesFilter(ad, key)); });

            // Ad ordering uses the numeric part of the metaobject gid, not createdAt.
            // The API's `createdAt` is really the metaobject's updatedAt (Shopify
            // exposes no createdAt for metaobjects), so it means "last modified" —
            // incrementing a view counter or editing an ad re-dated it and pushed it
            // to the top. Metaobject IDs increase with creation, so they give true
            // newest-first order.
            function adOrder(ad) {
              var n = parseInt(String((ad && ad.id) || '').split('/').pop(), 10);
              return isNaN(n) ? 0 : n;
            }
            result.sort((a, b) => {
                if (a.ad_status === 'sold' && b.ad_status !== 'sold') return 1;
                if (b.ad_status === 'sold' && a.ad_status !== 'sold') return -1;
                const priceA = parseFloat(a.price) || 0;
                const priceB = parseFloat(b.price) || 0;
                const dateA  = adOrder(a);
                const dateB  = adOrder(b);
                switch (sortMode) {
                    case 'oldest':     return dateA - dateB;
                    case 'price_asc':  return priceA - priceB;
                    case 'price_desc': return priceB - priceA;
                    case 'newest':
                    default:           return dateB - dateA;
                }
            });

            filtered = result;
            renderPage(preservePage);
            rebuildFilterOptions();
            renderActiveChips();
        }

        // ── Filter options ─────────────────────────────────────────────────────────
        function rebuildFilterOptions() {
            const filterKeys = FILTER_KEYS;

            filterKeys.forEach(filterKey => {
                const el = document.querySelector(`[data-filter="${filterKey}"] .clf-dropdown-list`);
                if (!el) return;

                const translatable = isTranslatable(filterKey);

                const pool = allAds.filter(ad => {
                    if (ad.ad_status !== 'published' && ad.ad_status !== 'sold') return false;
                    return filterKeys.every(k => (k === filterKey) ? true : matchesFilter(ad, k));
                });

                const rawPoolValues = pool.map(ad => adFieldValue(ad, filterKey)).filter(Boolean);

                // Options as {value, display}. For translatable fields the stored
                // `value` is the canonical (EN) key, so EN- and ES-stored ads
                // collapse into ONE option that is displayed in the active locale.
                let options, availSet;
                if (translatable) {
                    availSet = new Set(rawPoolValues.map(v => I18N.canonical(v)));
                    const seen = new Set(), ordered = [];
                    (catalogueOptions[filterKey] || []).forEach(v => {
                        const c = I18N.canonical(v);
                        if (availSet.has(c) && !seen.has(c)) { seen.add(c); ordered.push(c); }
                    });
                    const extras = [];
                    availSet.forEach(c => { if (!seen.has(c)) extras.push(c); });
                    extras.sort((a, b) => I18N.t(a).localeCompare(I18N.t(b)));
                    options = ordered.concat(extras).map(c => ({ value: c, display: I18N.t(c) }));
                } else {
                    const poolValues = new Set(rawPoolValues);
                    availSet = poolValues;
                    const catalogueOrder = catalogueOptions[filterKey] || [];
                    options = [
                        ...catalogueOrder.filter(v => poolValues.has(v)),
                        ...[...poolValues].filter(v => !catalogueOrder.includes(v)).sort(),
                    ].map(v => ({ value: v, display: fieldDisplay(filterKey, v) }));
                }

                const multi        = isMulti(filterKey);
                const active       = activeFilters[filterKey];
                const activeCanon  = (translatable && !multi) ? I18N.canonical(active) : null;
                const selectedSet  = multi ? new Set(active) : null;
                const noneSelected = multi ? active.length === 0 : !active;
                const searchInput  = el.previousElementSibling;
                const searchQ      = (searchInput?.value || '').toLowerCase();

                el.innerHTML = '';

                const allLi = document.createElement('li');
                allLi.className     = 'clf-option' + (noneSelected ? ' is-selected' : '');
                allLi.dataset.value = '';
                allLi.textContent   = '{{ 'custom.all' | t }}';
                allLi.addEventListener('click', () => selectFilter(filterKey, ''));
                el.appendChild(allLi);

                options
                    .filter(o => !searchQ || o.display.toLowerCase().includes(searchQ))
                    .forEach(o => {
                        const li         = document.createElement('li');
                        const isSelected = multi ? selectedSet.has(o.value)
                                                 : (translatable ? activeCanon === o.value : active === o.value);
                        const isAvail    = availSet.has(o.value);
                        li.className     = 'clf-option'
                            + (multi ? ' clf-multi' : '')
                            + (isSelected ? ' is-selected' : '')
                            + (isAvail ? '' : ' clf-unavailable');
                        li.dataset.value = o.value;

                        if (multi) {
                            const box = document.createElement('span');
                            box.className = 'clf-check';
                            const label = document.createElement('span');
                            label.className   = 'clf-option-label';
                            label.textContent = o.display;
                            li.appendChild(box);
                            li.appendChild(label);
                        } else {
                            li.textContent = o.display;
                        }

                        if (isAvail) li.addEventListener('click', () => selectFilter(filterKey, o.value));
                        el.appendChild(li);
                    });

                updateToggleLabel(filterKey);
            });

            updateMoreToggleLabel();
        }

        // Every selected value as {key, label, value, display, value_display} —
        // one entry per value, so a multi-select yields one removable chip each.
        function activeFilterSummary() {
            const labels = window._clfLabels || {};
            const out    = [];
            FILTER_KEYS.forEach(key => {
                const active = activeFilters[key];
                const base   = labels[key] || key;
                const values = Array.isArray(active) ? active : (active ? [active] : []);
                values.forEach(value => {
                    const shown = fieldDisplay(key, value);
                    out.push({ key: key, label: base, value: value, value_display: shown, display: base + ': ' + shown });
                });
            });
            return out;
        }

        // Clearing one chip: for a multi-select that means dropping just that
        // value (selectFilter toggles it off), otherwise clearing the whole key.
        AdMeta.bindClearHandler(function (key, value) {
            if (isMulti(key) && value) selectFilter(key, value);
            else                       selectFilter(key, '');
        });

        function renderActiveChips() {
            AdMeta.renderChipRail(document.getElementById('clf-active-chips'), activeFilterSummary());
        }

        // Reflects active hidden filters on the "More filters" toggle itself, so
        // a selection made while expanded stays visible after collapsing again.
        function updateMoreToggleLabel() {
            if (!moreToggleBtn) return;
            const isOpen   = extraFiltersOpen;
            const hasActive = EXTRA_FILTER_KEYS.some(k => {
                const v = activeFilters[k];
                return Array.isArray(v) ? v.length > 0 : !!v;
            });
            const textEl = moreToggleBtn.querySelector('.clf-more-text');
            if (textEl) {
                textEl.textContent = isOpen ? '{{ 'custom.hide_filters' | t }}' : '{{ 'custom.more_filters' | t }}';
            }
            moreToggleBtn.classList.toggle('clf-active', hasActive || isOpen);
        }

        function selectFilter(filterKey, value) {
            if (isMulti(filterKey)) {
                // Empty value = "All" → clear the whole multi-select.
                if (value === '') {
                    activeFilters[filterKey]  = [];
                    pendingFilters[filterKey] = [];
                } else {
                    const arr = activeFilters[filterKey].slice();
                    const idx = arr.indexOf(value);
                    if (idx === -1) arr.push(value); else arr.splice(idx, 1);
                    activeFilters[filterKey]  = arr;
                    pendingFilters[filterKey] = arr.slice();
                }
                // Keep the dropdown OPEN so the user can pick several in a row.
                applyAll(true);
                return;
            }

            // Single-select (unchanged): pick one value and close the dropdown.
            pendingFilters[filterKey] = value;
            activeFilters[filterKey]  = value;
            document.querySelectorAll('.clf-dropdown.open').forEach(d => d.classList.remove('open'));
            applyAll(true);
        }

        // ── FIX: updateToggleLabel uses window._clfLabels (Liquid-translated) ──────
        // Previously this used hardcoded English: {type:'Type', subtype:'Subtype'...}
        // which always showed English regardless of locale.
        // Now it reads from window._clfLabels which is populated at the top of the
        // file via: window._clfLabels = { type: {{ 'custom.type' | t | json }}, ... }
        // Shopify renders those Liquid tags server-side in the correct locale.
        function updateToggleLabel(filterKey) {
            const labels   = window._clfLabels || {};
            const toggle   = document.querySelector(`[data-filter="${filterKey}"] .clf-dropdown-toggle`);
            if (!toggle) return;
            const baseLabel = labels[filterKey] || filterKey;
            const active    = activeFilters[filterKey];

            let text, isActive;
            if (isMulti(filterKey)) {
                // 0 → base label · 1 → that shop's name · many → "Gun Shop (N)"
                if (active.length === 0)      text = baseLabel;
                else if (active.length === 1) text = `${baseLabel}: ${active[0]}`;
                else                          text = `${baseLabel} (${active.length})`;
                isActive = active.length > 0;
            } else {
                text     = active ? `${baseLabel}: ${fieldDisplay(filterKey, active)}` : baseLabel;
                isActive = !!active;
            }

            AdMeta.paintToggle(toggle, text, isActive, filterKey);
        }

        // ── "More filters" toggle — reveals City/Availability/Status/Handedness
        // (plus the row-break spacer) via the `hidden` attribute, so the shown
        // state falls back to each element's own display rules instead of
        // fighting them on CSS specificity. ──────────────────────────────────────
        const moreToggleBtn = document.getElementById('clf-more-toggle');
        const filterTabsEl  = moreToggleBtn ? moreToggleBtn.closest('.filter-tabs') : null;
        let extraFiltersOpen = false;
        if (moreToggleBtn && filterTabsEl) {
            moreToggleBtn.addEventListener('click', function () {
                document.querySelectorAll('.clf-dropdown.open').forEach(d => d.classList.remove('open'));
                extraFiltersOpen = !extraFiltersOpen;
                filterTabsEl.querySelectorAll('.clf-extra, .clf-row-break').forEach(el => { el.hidden = !extraFiltersOpen; });
                updateMoreToggleLabel();
            });
        }

        // ── Dropdown toggle ────────────────────────────────────────────────────────
        document.addEventListener('click', function (e) {
            const toggleBtn = e.target.closest('.clf-dropdown-toggle');
            if (toggleBtn && toggleBtn.id !== 'clf-more-toggle') {
                const dropdown = toggleBtn.closest('.clf-dropdown');
                if (!dropdown) return;
                const isOpen   = dropdown.classList.contains('open');
                document.querySelectorAll('.clf-dropdown.open').forEach(d => d.classList.remove('open'));
                if (!isOpen) { dropdown.classList.add('open'); dropdown.querySelector('.clf-dropdown-search')?.focus(); }
                return;
            }
            if (!e.target.closest('.clf-dropdown') && !e.target.closest('#clf-more-toggle')) {
                document.querySelectorAll('.clf-dropdown.open').forEach(d => d.classList.remove('open'));
            }
        });

        document.querySelectorAll('.clf-dropdown-search').forEach(input => {
            input.addEventListener('input', () => rebuildFilterOptions());
        });

        // ── Search ─────────────────────────────────────────────────────────────────
        let searchDebounce;
        document.getElementById('classifieds-search').addEventListener('input', function () {
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(() => {
                searchTerm = this.value.trim();
                applyAll(false);
            }, 300);
        });

        // ── Apply button ───────────────────────────────────────────────────────────
        document.getElementById('clf-apply').addEventListener('click', function () {
            activeFilters = cloneFilters(pendingFilters);
            applyAll(true);
        });

        // ── Reset ──────────────────────────────────────────────────────────────────
        // One trigger: inline with the last filter row on desktop, pinned to the
        // bottom of the filter drawer on mobile.
        document.querySelectorAll('.js-clf-reset').forEach(btn => btn.addEventListener('click', function () {
            activeFilters  = emptyFilters();
            pendingFilters = emptyFilters();
            searchTerm     = '';
            document.getElementById('classifieds-search').value = '';
            document.querySelectorAll('.clf-dropdown-search').forEach(i => i.value = '');
            document.getElementById('clf-sort').value = 'newest';
            sortMode = 'newest';
            applyAll(false);
        }));

        // ── Sort ───────────────────────────────────────────────────────────────────
        document.getElementById('clf-sort').addEventListener('change', function () {
            sortMode = this.value;
            applyAll(true);
        });

        // ── Handedness (not stored on the ad — pulled from the linked product's
        // custom.lateralidad metafield via the Storefront GraphQL API, same token
        // used elsewhere in this theme, e.g. add-ad-popup.liquid/my-armorer.liquid).
        // NOTE: the AJAX product.js endpoint does NOT support a `?metafields=`
        // param — that was a mistaken assumption in an earlier version of this
        // code and always returned nothing; GraphQL is the only way to read a
        // product metafield from the storefront. ──────────────────────────────────
        const STOREFRONT_API   = 'https://gunloupe.myshopify.com/api/2024-01/graphql.json';
        const STOREFRONT_TOKEN = 'cef86b403fa3eef900f70170cec5acb8';
        const handednessCache = {};

        async function fetchHandednessMap(handles) {
            const map = {};
            const CHUNK_SIZE = 20; // keep query cost/complexity reasonable per request
            for (let i = 0; i < handles.length; i += CHUNK_SIZE) {
                const chunk  = handles.slice(i, i + CHUNK_SIZE);
                const fields = chunk.map((h, idx) =>
                    `p${idx}: product(handle: ${JSON.stringify(h)}) { handle metafield(namespace: "custom", key: "lateralidad") { value } }`
                ).join(' ');
                try {
                    const res = await fetch(STOREFRONT_API, {
                        method:  'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': STOREFRONT_TOKEN },
                        body:    JSON.stringify({ query: `{ ${fields} }` })
                    });
                    if (!res.ok) continue;
                    const data = await res.json();
                    if (data.errors) continue;
                    Object.keys(data.data || {}).forEach(key => {
                        const p = data.data[key];
                        if (p && p.handle) map[p.handle] = (p.metafield && p.metafield.value) || '';
                    });
                } catch (e) { /* leave this chunk's handles unmapped — treated as empty below */ }
            }
            return map;
        }

        async function attachHandedness(ads) {
            const handles = [...new Set(ads.filter(ad => !ad.firearm_handedness).map(ad => ad.product_handle).filter(Boolean))]
                .filter(h => !(h in handednessCache));
            if (handles.length) {
                const map = await fetchHandednessMap(handles);
                handles.forEach(h => { handednessCache[h] = map[h] || ''; });
            }
            // Ads created after the handedness dropdown shipped already carry
            // the seller's own explicit choice — don't clobber it with the
            // product's live default. Only fill it in for older ads that
            // don't have a stored value.
            ads.forEach(ad => { if (!ad.firearm_handedness) ad.firearm_handedness = handednessCache[ad.product_handle] || ''; });
        }

        // ── Fetch ads ──────────────────────────────────────────────────────────────
        async function fetchAds() {
            try {
                const res  = await fetch(`${BACKEND_URL}/my-adverts/all`);
                const data = await res.json();
                allAds = (data.ads || []).filter(ad => ad.ad_status === 'published' || ad.ad_status === 'sold');
                await attachHandedness(allAds);
                document.getElementById('clf-loading').style.display = 'none';
                applyAll(false);
            } catch (e) {
                document.getElementById('clf-loading').style.display = 'none';
                document.getElementById('clf-empty').style.display   = 'flex';
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            fetchCatalogueFilters();
            fetchAds();
            // Enriches the barrel chips with curated inches once it lands; the
            // chips already read fine in cm, so nothing waits on this.
            AdMeta.loadBarrelInches();
        });

        // ── Silent background refresh every 30s ───────────────────────────────
        // Keeps newly-published/sold ads visible for anyone already browsing
        // this page, without requiring a manual reload. Mirrors the same
        // pattern already used on the admin ads console (Consola de Anuncios).
        setInterval(async function () {
            // Don't disrupt someone with a filter dropdown open right now.
            if (document.querySelector('.clf-dropdown.open')) return;
            try {
                const res      = await fetch(`${BACKEND_URL}/my-adverts/all`);
                const data     = await res.json();
                const freshAds = (data.ads || []).filter(ad => ad.ad_status === 'published' || ad.ad_status === 'sold');
                if (freshAds.length !== allAds.length) {
                    allAds = freshAds;
                    applyAll(true);
                }
            } catch (e) {
                // Silent fail — background refresh, no user-facing error.
            }
        }, 30000);
    })();
</script>


      async function prefill(d) {
        if (d.tipo) {
          sf.tipo=d.tipo; armSetLabel('tipo',d.tipo); armSetEnabled('subtipo',true);
          var r=document.querySelector('#popup [data-filter="tipo"] input[value="'+d.tipo+'"]'); if(r)r.checked=true;
          await armFetchSubtypes();
        }
        if (d.subtipo) {
          sf.subtipo=d.subtipo; armSetLabel('subtipo',d.subtipo); armSetEnabled('marca',true);
          var r=document.querySelector('#popup [data-filter="subtipo"] input[value="'+d.subtipo+'"]'); if(r)r.checked=true;
        }
        if (d.marca) {
          sf.marca=d.marca; armSetLabel('marca',d.marca);
          await loadBrands();
          var r=document.querySelector('#popup #arm-marca-list li[data-brand="'+d.marca+'"] input'); if(r)r.checked=true;
          var cb = await getCatalogueBrands();
          armBrandIsCatalogue = cb.has(d.marca);
          armSetEnabled('modelo', true);
          if (!armBrandIsCatalogue) { unlockCaliber(); armSetEnabled('calibre', true); }
        }
        if (d.modelo) {
          sf.modelo = d.productTitle || d.modelo;
          var lbl = d.barrel ? d.modelo+' // '+d.barrel : d.modelo;
          armSetLabel('modelo', lbl);
          if (searchInput) searchInput.value = lbl;
          searchInputPrevValue = lbl;
          if (d.productHandle) {
            selectedProduct = {title:d.productTitle||d.modelo,handle:d.productHandle,url:d.productUrl||'',image:d.productImage||'',barrel:d.barrel||''};
          }
        }
        if (d.calibre) {
          sf.calibre = d.calibre;
          await loadCalibers();
          var ri = document.querySelector('#arm-calibre-list input[value="'+d.calibre+'"]');
          if (ri) { ri.checked=true; armSetEnabled('calibre',true); }
          armSetLabel('calibre', d.calibre);
          if (d.productHandle) { lockCaliber(d.calibre); }
        }
      }

      function closePopup() { popup.style.display='none'; resetForm(); }

      function resetForm() {
        editingId=null; sf={tipo:'',subtipo:'',marca:'',modelo:'',calibre:''};
        selectedProduct=null; allProducts=[]; uploadedImages=[]; existingImages=[];
        armBrandIsCatalogue=false;

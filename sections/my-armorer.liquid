      // ── Storefront API helpers ────────────────────────────────────────────────
      async function fetchAllMetaobjects(type) {
        var results = [], cursor = null, hasMore = true, attempts = 0;
        while (hasMore && attempts < 10) {
          attempts++;
          var after = cursor ? (', after: "' + cursor + '"') : '';
          var q = '{metaobjects(type:"' + type + '",first:250' + after + '){pageInfo{hasNextPage endCursor}edges{node{fields{key value}}}}}';
          try {
            var r = await fetch(STOREFRONT_API, {
              method:'POST',
              headers:{'Content-Type':'application/json','X-Shopify-Storefront-Access-Token':STOREFRONT_TOKEN},
              body:JSON.stringify({query:q})
            });
            if (!r.ok) break;
            var d = await r.json();
            if (d.errors) break;
            var mo = d && d.data && d.data.metaobjects; if (!mo) break;
            hasMore = mo.pageInfo && mo.pageInfo.hasNextPage;
            cursor = mo.pageInfo && mo.pageInfo.endCursor;
            (mo.edges || []).forEach(function(e) {
              var f = (e.node.fields || []).find(function(x){return x.key==='name';});
              if (f && f.value) results.push(f.value);
            });
          } catch(err) { break; }
        }
        return results;
      }

      function renderBrandList(brands) {
        var ul = document.getElementById('arm-marca-list'); if (!ul) return;
        if (!brands.length) { ul.innerHTML = '<li style="padding:8px 12px;color:#999;">' + {{ 'custom.no_brands_found' | t | json }} + '</li>'; return; }
        ul.innerHTML = brands.map(function(n) {
          var s = n.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
          return '<li data-brand="'+s+'"><label><input type="radio" name="arm-marca" value="'+s+'"><span>'+s+'</span></label></li>';
        }).join('');
      }

      function renderCaliberList(calibers) {
        var ul = document.getElementById('arm-calibre-list'); if (!ul) return;
        if (!calibers.length) { ul.innerHTML = '<li style="padding:8px 12px;color:#999;">' + {{ 'custom.no_calibers_found' | t | json }} + '</li>'; return; }
        var cs = document.getElementById('arm-caliber-search'); if(cs) cs.style.display = '';
        ul.innerHTML = calibers.map(function(n) {
          var s = n.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
          return '<li data-caliber="'+s+'"><label><input type="radio" name="arm-calibre" value="'+s+'"><span>'+s+'</span></label></li>';
        }).join('');
      }

      function renderCaliberListDirect(cals) {
        var ul = document.getElementById('arm-calibre-list'); if (!ul) return;
        var cs = document.getElementById('arm-caliber-search'); if(cs) cs.style.display = 'none';
        ul.innerHTML = cals.map(function(n) {
          var s = n.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
          return '<li data-caliber="'+s+'"><label><input type="radio" name="arm-calibre" value="'+s+'"><span>'+s+'</span></label></li>';
        }).join('');
      }

      async function loadBrands() {
        if (_brandsCache) { renderBrandList(_brandsCache); return _brandsCache; }
        if (_brandsLoading) return;
        _brandsLoading = true;
        var ul = document.getElementById('arm-marca-list');
        if (ul) ul.innerHTML = '<li style="padding:8px 12px;opacity:0.5;">Loading brands...</li>';
        var brands = await fetchAllMetaobjects('all_brands');
        brands.sort(function(a,b){return a.localeCompare(b);});
        _brandsCache = brands; _brandsLoading = false;
        renderBrandList(brands);
        return brands;
      }

      async function loadCalibers() {
        if (_calibersCache) { renderCaliberList(_calibersCache); return _calibersCache; }
        if (_calibersLoading) return;
        _calibersLoading = true;
        var ul = document.getElementById('arm-calibre-list');
        if (ul) ul.innerHTML = '<li style="padding:8px 12px;opacity:0.5;">Loading calibers...</li>';
        var calibers = await fetchAllMetaobjects('all_calibers');
        _calibersCache = calibers; _calibersLoading = false;
        renderCaliberList(calibers);
        return calibers;
      }

      async function getCatalogueBrands() {
        if (_catalogueBrandsCache) return _catalogueBrandsCache;
        // Use the SAME source as loadBrands() (all_brands metaobject via Storefront API)
        // instead of scraping the collection page's checkbox filters. The two sources
        // can disagree on exact string formatting even for the same real brand, which
        // broke armBrandIsCatalogue checks for results coming from quick search.
        var brands = _brandsCache || await loadBrands();
        _catalogueBrandsCache = new Set(brands);
        return _catalogueBrandsCache;
      }

      // ── Caliber lock/unlock ───────────────────────────────────────────────────
      function lockCaliber(caliberValue) {
        var cw = document.getElementById('arm-calibre-wrapper'); if (!cw) return;
        cw.classList.add('disabled');
        cw.classList.remove('open');
        var menu = cw.querySelector('.add-firearm-dropdown-menu'); if (menu) menu.style.display = 'none';
        sf.calibre = caliberValue;
        armSetLabel('calibre', caliberValue);
      }

      function unlockCaliber() {
        var cw = document.getElementById('arm-calibre-wrapper'); if (!cw) return;
        cw.classList.remove('disabled');
        var tb = cw.querySelector('.filter-toggle'); if (tb) tb.disabled = false;
        cw.querySelectorAll('input').forEach(function(i){i.disabled=false;});
        var s = cw.querySelector('.filter-search'); if (s) s.disabled = false;
      }

      // ── Helpers ───────────────────────────────────────────────────────────────
      function parseFilters(doc) {
        var result = {tipo:[],subtipo:[],marca:[],modelo:[],calibre:[]};
        doc.querySelectorAll('.filter-group').forEach(function(group) {
          var firstInput = group.querySelector('li input[type="checkbox"]'); if (!firstInput) return;
          var key = PARAM_TO_KEY[firstInput.name]; if (!key) return;
          var values = Array.from(group.querySelectorAll('li input[type="checkbox"]')).filter(function(i){return !i.disabled;}).map(function(i){return i.value;}).filter(Boolean);
          if (values.length) result[key] = values;
        });
        return result;
      }

      function armSetEnabled(key, enabled) {
        var g = document.querySelector('#popup [data-filter="'+key+'"]'); if (!g) return;
        g.classList.toggle('disabled', !enabled);
        g.querySelectorAll('input').forEach(function(i){i.disabled=!enabled;});
        var s = g.querySelector('.filter-search'); if (s) s.disabled = !enabled;
        var tb = g.querySelector('.filter-toggle'); if (tb) tb.disabled = !enabled;
      }

      function armSetLabel(key, value) {
        if (key === 'status') { var el = document.getElementById('statusLabel'); if (el) el.textContent = STATUS_LABELS[value] || value; return; }
        var el = document.getElementById('arm-'+key+'-label'); if (el) el.textContent = value;
      }

      // Shows/hides a skeleton overlay directly on top of a dropdown's closed button,
      // hiding its current text entirely so no English-then-Spanish flash is visible
      // while quick search resolves the locale-correct value in the background.
      function armShowDropdownSkeleton(key) {
        var dd = document.querySelector('#popup [data-filter="'+key+'"]'); if (!dd) return;
        var btn = dd.querySelector('.filter-toggle'); if (!btn) return;
        if (btn.querySelector('.arm-dropdown-skeleton-overlay')) return; // already showing
        var overlay = document.createElement('div');
        overlay.className = 'arm-dropdown-skeleton-overlay';
        overlay.innerHTML = '<div class="arm-dropdown-skeleton-overlay__line"></div>';
        btn.style.position = 'relative';
        btn.appendChild(overlay);
      }

      function armHideDropdownSkeleton(key) {
        var dd = document.querySelector('#popup [data-filter="'+key+'"]'); if (!dd) return;
        var overlay = dd.querySelector('.arm-dropdown-skeleton-overlay');
        if (overlay) overlay.remove();
      }

      function armFilterList(listId, dataAttr, q) {
        q = (q||'').toLowerCase();
        document.querySelectorAll('#'+listId+' li[data-'+dataAttr+']').forEach(function(li){
          li.style.display = (!q || (li.dataset[dataAttr]||'').toLowerCase().includes(q)) ? '' : 'none';
        });
      }

      function armOpenDropdown(dd) {
        if (dd.id === 'arm-calibre-wrapper' && dd.classList.contains('disabled')) return;
        dd.classList.add('open');
        var menu = dd.querySelector('.add-firearm-dropdown-menu');
        if (menu) menu.style.display = dd.querySelector('.arm-scrollable-menu') ? 'flex' : 'block';
      }

      function armCloseDropdown(dd) {
        dd.classList.remove('open');
        var menu = dd.querySelector('.add-firearm-dropdown-menu'); if (menu) menu.style.display = 'none';
      }

      function makeUseBtn(label, onClickFn) {
        var btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'arm-use-btn';
        btn.innerHTML = '&#10003; ' + (window._armorerLabels.useLabel || 'Use') + ' <strong>"' + label + '"</strong>';
        btn.addEventListener('click', onClickFn);
        return btn;
      }

      // ── Type/Subtype filter fetch ──────────────────────────────────────────────
      async function armLoadTypeFilters() {
        var ul = document.getElementById('arm-tipo-list');
        if (ul) ul.innerHTML = '<li class="filter-skeleton"><div class="filter-skeleton__line"></div></li>';
        try {
          var r = await fetch(_FC);
          var parsed = parseFilters(new DOMParser().parseFromString(await r.text(),'text/html'));
          if (ul) ul.innerHTML = (parsed.tipo||[]).map(function(v){return '<li><label><input type="radio" name="arm-tipo" value="'+v+'"><span>'+v+'</span></label></li>';}).join('');
        } catch(e){}
      }

      async function armFetchSubtypes() {
        var myGen = ++armFilterFetchGen;
        var ul = document.getElementById('arm-subtipo-list');
        if (ul) ul.innerHTML = '<li class="filter-skeleton"><div class="filter-skeleton__line"></div></li>';
        try {
          var p = new URLSearchParams(); if (sf.tipo) p.append('filter.p.product_type', sf.tipo);
          var r = await fetch(_FC + '?' + p.toString());
          var parsed = parseFilters(new DOMParser().parseFromString(await r.text(),'text/html'));
          if (myGen !== armFilterFetchGen) return;
          if (ul && parsed.subtipo.length) ul.innerHTML = parsed.subtipo.map(function(v){return '<li><label><input type="radio" name="arm-subtipo" value="'+v+'"><span>'+v+'</span></label></li>';}).join('');
        } catch(e){}
      }

      // ── Product fetch + smart caliber/barrel detection ────────────────────────
      function showModelSkeleton() {
        if (!resultsEl) return;
        resultsEl.innerHTML = [1,2,3].map(function(){return '<div class="model-skeleton"><div class="model-skeleton__img"></div><div class="model-skeleton__text"><div class="model-skeleton__line model-skeleton__line--wide"></div><div class="model-skeleton__line model-skeleton__line--narrow"></div></div></div>';}).join('');
      }

      function showManualHint() {
        // Genuinely non-catalogue brand — keep allowing free-text model entry.
        if (searchInput) { searchInput.removeAttribute('readonly'); searchInput.style.opacity=''; searchInput.placeholder = window._armorerLabels.searchModel; }
        if (!resultsEl) return;
        resultsEl.innerHTML = '<div style="padding:12px;font-size:.9rem;color:#666;font-style:italic;background:#f9fafb;border-radius:6px;margin:4px;">' + _armorerNonCatalogueMsg + '</div>';
      }

      function showMismatchHint() {
        var si = searchInput;
        if (si) {
          si.removeAttribute('readonly');
          si.style.opacity = '';
          si.placeholder = window._armorerLabels.searchModel;
        }
        if (!resultsEl) return;
        resultsEl.innerHTML = '<div style="padding:12px;font-size:.9rem;color:#666;font-style:italic;background:#f9fafb;border-radius:6px;margin:4px;">' + _armorerMismatchMsg + '</div>';
      }

      async function armFetchProducts() {
        if (isFetching) return; isFetching = true;
        var myGen = armProductFetchGen; // snapshot — if arm-marca changes brand before this resolves, armProductFetchGen will have moved on and this fetch's results must be discarded
        if (searchInput) { searchInput.setAttribute('readonly','readonly'); searchInput.style.opacity='0.55'; searchInput.placeholder = window._armorerLabels.loadingModels; }
        try {
          var p = new URLSearchParams();
          if (sf.tipo) p.append('filter.p.product_type', sf.tipo);
          if (sf.subtipo) p.append('filter.p.m.custom.sub_tipo_de_arma', sf.subtipo);
          if (sf.marca) p.append('filter.p.m.custom.marca', sf.marca);
          var fetchedProducts = [];
          // Walk every page of the filtered collection — a single fetch only ever returned
          // the theme's default page size (commonly 24-50 products), silently dropping any
          // models beyond that for a brand/type/subtype combination with a larger catalogue.
          // Stop once a page returns no product cards, or if a page repeats a handle/title
          // already seen (defensive: some themes redirect an out-of-range ?page=N back to
          // page 1 instead of returning empty, which would otherwise loop forever).
          var seenKeys = new Set();
          for (var page = 1; page <= 50; page++) { // 50-page ceiling as a sane upper bound, not an expected real limit
            if (myGen !== armProductFetchGen) break; // brand changed mid-pagination — stop early, results will be discarded below anyway
            var pp = new URLSearchParams(p); pp.set('page', String(page));
            var doc = new DOMParser().parseFromString(await(await fetch(_FC+'?'+pp.toString())).text(),'text/html');
            var cards = doc.querySelectorAll('.product-card,.grid-product,.card-wrapper');
            if (!cards.length) break;
            var sawNew = false;
            cards.forEach(function(item){
              var te = item.querySelector('.product-card__title') || item.querySelector('h3');
              var title = te && te.textContent && te.textContent.trim();
              var image = item.querySelector('img') && item.querySelector('img').src;
              var link = item.querySelector('a') && item.querySelector('a').href;
              if (!title) return;
              var key = link || title;
              if (seenKeys.has(key)) return; // already collected — guards against a repeated page
              seenKeys.add(key); sawNew = true;
              fetchedProducts.push({title:title,image:image,link:link});
            });
            if (!sawNew) break; // this page added nothing new — we've looped back or run out
          }
          if (myGen === armProductFetchGen) allProducts = fetchedProducts;
        } catch(e){}
        isFetching = false;
        if (myGen !== armProductFetchGen) return; // brand changed mid-fetch — a non-catalogue brand's showManualHint() (or a newer fetch) already owns the UI now, don't stomp it
        armProductFetchDone = true; // confirmed (empty or not) for this brand — typing must never re-trigger another fetch from here on
        if (searchInput) { searchInput.removeAttribute('readonly'); searchInput.style.opacity=''; searchInput.placeholder = window._armorerLabels.searchModel; }
        var q = (searchInput && searchInput.value || '').trim().toLowerCase();
        armRenderModelResults(q ? allProducts.filter(function(p){return p.title.toLowerCase().includes(q);}) : allProducts, true);
      }

      function armExtractHandle(url) { if(!url)return null; var p=url.split('/products/'); return p[1]?p[1].split('?')[0]:null; }

      function armRenderModelResults(products, isFinal) {
        if (!resultsEl) return;
        var typed = (searchInput && searchInput.value || '').trim();
        resultsEl.innerHTML = '';

        if (!products.length) {
          // True mismatch: brand is confirmed catalogue, fetch is confirmed done,
          // and the WHOLE combo (not just what was typed) has zero products.
          if (armBrandIsCatalogue && armProductFetchDone && allProducts.length === 0) {
            showMismatchHint();
            return;
          }
          if (!typed) {
            if (isFinal) {
              showManualHint();
            } else if (armBrandIsCatalogue && !armProductFetchDone) {
              var le=document.createElement('div');le.style.cssText='padding:8px 12px;opacity:0.5;font-size:.9rem;';le.textContent=window._armorerLabels.loadingModels+'...';resultsEl.appendChild(le);armFetchProducts();
            } else if (armBrandIsCatalogue && armProductFetchDone) {
              showManualHint();
            }
            return;
          }
          // Catalogue brand, some products exist for this combo, but none match
          // what was typed — allow a custom entry as an override (unchanged behavior).
          resultsEl.appendChild(makeUseBtn(typed, function(){armSelectCustomModel(typed);}));
          return;
        }
        var sid = Date.now(); resultsEl.dataset.sessionId = String(sid);
        products.forEach(function(p) {
          var handle = p.handle || armExtractHandle(p.link);
          if (!handle) { armAppendModelRow(p, handle, null, [], sid); return; }
          fetch('/products/'+handle+'.json').then(function(r){return r.json();}).then(function(jd){
            if (String(resultsEl.dataset.sessionId) !== String(sid)) return;
            var prod = jd && jd.product; if (!prod) { armAppendModelRow(p, handle, null, [], sid); return; }
            var img = (prod.image && prod.image.src) || p.image || null;

            var CALIBER_RE = /^[\d\.]+\s*[x\/\-]\s*[\d\.]+|^\d+\s*mm|\d+\s*(mm|cal|mag|nato|win|rem|spl|acp|luger|para|wmr|lr|short|long|\+p|s&w|sw)|^\.[\d]+/i;
            var BARREL_RE  = /^\d[\d\.]*\s*cm$/i;
            var opt1vals=[], opt2vals=[], opt3vals=[];
            (prod.variants||[]).forEach(function(v){
              if(v.option1&&v.option1.trim())opt1vals.push(v.option1.trim());
              if(v.option2&&v.option2.trim())opt2vals.push(v.option2.trim());
              if(v.option3&&v.option3.trim())opt3vals.push(v.option3.trim());
            });
            function slotIsCaliber(vals){return vals.some(function(v){return CALIBER_RE.test(v)&&!BARREL_RE.test(v);});}
            function slotIsBarrel(vals){return vals.some(function(v){return BARREL_RE.test(v);});}
            var calSlot=null;
            if(slotIsCaliber(opt1vals))calSlot='option1';
            else if(slotIsCaliber(opt2vals))calSlot='option2';
            else if(slotIsCaliber(opt3vals))calSlot='option3';
            var barSlot=null;
            if(slotIsBarrel(opt1vals))barSlot='option1';
            else if(slotIsBarrel(opt2vals))barSlot='option2';
            else if(slotIsBarrel(opt3vals))barSlot='option3';
            var sc=new Set(), cals=[];
            if(calSlot){ (prod.variants||[]).forEach(function(v){var c=(v[calSlot]||'').trim();if(c&&!sc.has(c)){sc.add(c);cals.push(c);}}); }
            if(!cals.length){ (prod.variants||[]).forEach(function(v){var c=(v.option1||'').trim();if(c&&c!=='Default Title'&&!sc.has(c)){sc.add(c);cals.push(c);}}); }
            var sb=new Set(), rows=[];
            if(barSlot){ (prod.variants||[]).forEach(function(v){var b=(v[barSlot]||'').trim();if(!sb.has(b)){sb.add(b);rows.push(b);}}); }

            var px = Object.assign({}, p, {image:img, calibres:cals});
            if (!rows.length || (rows.length===1 && !rows[0])) armAppendModelRow(px, handle, null, cals, sid);
            else rows.forEach(function(b){armAppendModelRow(px, handle, b||null, cals, sid);});
          }).catch(function(){armAppendModelRow(p, handle, null, [], sid);});
        });
        // Custom-entry "Use" option only makes sense when nothing in the catalogue
        // matched what was typed — once real products are showing, this is a plain
        // filtered dropdown over the known model list, same as every other brand.
      }

      function armAppendModelRow(p, handle, barrel, cals, sid) {
        if (!resultsEl || String(resultsEl.dataset.sessionId) !== String(sid)) return;
        var el = document.createElement('div'); el.className = 'model-item';
        el.innerHTML = '<div class="model-img-wrapper"><img src="'+(p.image||'https://via.placeholder.com/50')+'" alt="'+(p.title||'')+'"></div><div style="display:flex;align-items:center;width:100%;gap:8px;"><span>'+(p.title||'')+'</span>'+(barrel?'<span style="margin-left:auto;white-space:nowrap;">'+barrel+'</span>':'')+'</div>';
        el.addEventListener('click', function(){
          var display = barrel ? p.title+' // '+barrel : p.title;
          selectedProduct = {title:p.title, handle:handle, url:p.link||'/products/'+handle, image:p.image||null, barrel:barrel||''};
          sf.modelo = p.title;
          if (searchInput) searchInput.value = display;
          searchInputPrevValue = display;
          armSetLabel('modelo', display);
          resultsEl.innerHTML = '';
          var dd = document.querySelector('#popup [data-filter="modelo"]'); if (dd) armCloseDropdown(dd);

          var calsList = cals || p.calibres || [];
          if (calsList.length === 1) {
            renderCaliberListDirect(calsList);
            var ri = document.querySelector('#arm-calibre-list input[value="'+calsList[0].replace(/"/g,'&quot;')+'"]');
            if (ri) ri.checked = true;
            lockCaliber(calsList[0]);
            armSetEnabled('calibre', false);
          } else if (calsList.length > 1) {
            renderCaliberListDirect(calsList);
            unlockCaliber();
            sf.calibre = '';
            armSetLabel('calibre', window._armorerLabels.calibre);
            armSetEnabled('calibre', true);
          } else {
            var cs = document.getElementById('arm-caliber-search'); if (cs) cs.style.display = '';
            unlockCaliber();
            sf.calibre = '';
            armSetLabel('calibre', window._armorerLabels.calibre);
            loadCalibers();
            armSetEnabled('calibre', true);
          }
        });
        resultsEl.appendChild(el);
      }

      function armSelectCustomModel(typed) {
        selectedProduct = null; sf.modelo = typed; sf.calibre = '';
        armSetLabel('modelo', typed);
        if (searchInput) searchInput.value = typed;
        searchInputPrevValue = typed;
        if (resultsEl) resultsEl.innerHTML = '';
        var dd = document.querySelector('#popup [data-filter="modelo"]'); if (dd) armCloseDropdown(dd);
        armSetLabel('calibre', window._armorerLabels.calibre);
        document.querySelectorAll('#arm-calibre-list input[type="radio"]').forEach(function(r){r.checked=false;});
        var cs = document.getElementById('arm-caliber-search'); if (cs) cs.style.display = '';
        document.querySelectorAll('#arm-calibre-list li[data-caliber]').forEach(function(li){li.style.display='';});
        unlockCaliber();
        armSetEnabled('calibre', true);
      }

      // ── Quick search (AC1–AC5): keyword search via Storefront API, ─────────────
      // combined (AND) with whatever Type/Subtype/Brand dropdowns are already set.
      var qsInput = document.getElementById('arm-quick-search');
      var qsResultsEl = document.getElementById('arm-quick-search-results');
      var qsDebounceTimer = null;
      var qsRequestGen = 0;
      var qsCache = {}; // simple per-keyword cache within this popup session

      function qsBuildSearchQuery(keyword) {
        // IMPORTANT: do not add a server-side product_type:"..." filter here.
        // sf.tipo may hold a locale-translated value (e.g. "Escopeta") set after a
        // previous quick-search pick, but the Storefront API's product_type field
        // is only ever in its original (English) language — filtering by the
        // Spanish value server-side silently returns zero matches. Type/Subtype/
        // Brand are all applied client-side instead (see qsFilterByDropdowns).
        return keyword;
      }

      async function qsSearchStorefront(keyword) {
        var query = qsBuildSearchQuery(keyword);
        var items = [], cursor = null, hasMore = true, attempts = 0;
        // @inContext(language: ...) makes productType (a native Shopify field) come back
        // already localized to the storefront's active language, instead of always being
        // the shop's default/primary language (confirmed: without @inContext, the Storefront
        // API uses the primary market regardless of what locale the page itself is on — this
        // was the root cause of Type showing English on a Spanish-locale visit). Metafields
        // (marca, subtipo) are NOT included here on purpose: metafield translation via
        // @inContext is documented as unreliable even when a translation exists, so Subtype
        // keeps using the existing scrape-based qsFindLocaleValue fallback instead.
        var qsLang = {% if request.locale.iso_code == 'en' %}'EN'{% else %}'ES'{% endif %};
        while (hasMore && attempts < 20) { // 20 pages * 250 = up to 5000 matches, effectively unlimited for this catalogue
          attempts++;
          var after = cursor ? (', after: ' + JSON.stringify(cursor)) : '';
          var gql = 'query QuickSearch @inContext(language: ' + qsLang + ') { search(query: ' + JSON.stringify(query) + ', first: 250' + after + ', types: [PRODUCT]) { pageInfo { hasNextPage endCursor } edges { node { ... on Product { title productType handle featuredImage { url } marcaField: metafield(namespace: "custom", key: "marca") { value } subtipoField: metafield(namespace: "custom", key: "sub_tipo_de_arma") { value } } } } } }';
          try {
            var r = await fetch(STOREFRONT_API, {
              method: 'POST',
              headers: {'Content-Type':'application/json','X-Shopify-Storefront-Access-Token':STOREFRONT_TOKEN},
              body: JSON.stringify({query: gql})
            });
            if (!r.ok) { console.log('[DEBUG qsearch] HTTP not ok', r.status, 'lang=', qsLang); break; }
            var d = await r.json();
            if (d.errors) { console.log('[DEBUG qsearch] GraphQL errors', JSON.stringify(d.errors), 'lang=', qsLang); break; }
            var s = d.data && d.data.search; if (!s) { console.log('[DEBUG qsearch] no search field in response', JSON.stringify(d), 'lang=', qsLang); break; }
            console.log('[DEBUG qsearch] page', attempts, 'lang=', qsLang, 'edges=', (s.edges||[]).length);
            hasMore = s.pageInfo && s.pageInfo.hasNextPage;
            cursor = s.pageInfo && s.pageInfo.endCursor;
            (s.edges || []).forEach(function(e){
              var n = e.node;
              items.push({
                title: n.title, marca: n.marcaField && n.marcaField.value || '', productType: n.productType,
                handle: n.handle, image: n.featuredImage && n.featuredImage.url,
                subtipo: n.subtipoField && n.subtipoField.value || ''
              });
            });
          } catch(err) { console.log('[DEBUG qsearch] threw', err && err.message, 'lang=', qsLang); break; }
        }
        console.log('[DEBUG qsearch] total items before filters=', items.length);
        return items;
      }

      // Apply Brand filter client-side if already selected. Type/Subtype are NOT
      // filtered here on purpose: once a value comes from a dropdown or a previous
      // quick-search pick, it may be the translated (Spanish) text, while this
      // search's results always carry the original (English) value — filtering by
      // a mismatched language would silently return zero results.
      function qsFilterByDropdowns(items) {
        if (!sf.marca) return items;
        return items.filter(function(it){ return it.marca === sf.marca; });
      }

      function qsShowLoading() {
        if (!qsResultsEl) return;
        qsResultsEl.style.display = 'block';
        qsResultsEl.innerHTML = '<div class="arm-qs-loading"><div class="arm-qs-spinner"></div>' + window._armorerLabels.loadingModels + '...</div>';
      }

      function qsShowNoResults(typed) {
        if (!qsResultsEl) return;
        qsResultsEl.style.display = 'block';
        qsResultsEl.innerHTML = '';
        var msg = document.createElement('div');
        msg.className = 'arm-qs-no-results';
        msg.textContent = window._armorerLabels.noResults || 'No results found';
        qsResultsEl.appendChild(msg);
        // No manual/custom-model entry here by design — global search only
        // matches existing catalogue products. Custom models are entered via
        // the normal Type → Subtype → Brand → Model flow below.
      }

      function qsHideResults() {
        if (!qsResultsEl) return;
        qsResultsEl.style.display = 'none';
        qsResultsEl.innerHTML = '';
      }

      // Render a quick-search result row; clicking it applies caliber/barrel detection
      // exactly like the existing Model dropdown rows, AND back-fills Type/Subtype/Brand.
      function qsRenderResults(items, typed, gen) {
        if (qsRequestGen !== gen || !qsResultsEl) return;
        qsResultsEl.style.display = 'block';
        qsResultsEl.innerHTML = '';
        if (!items.length) { qsShowNoResults(typed); return; }

        items.forEach(function(it){
          fetch('/products/'+it.handle+'.json').then(function(r){return r.json();}).then(function(jd){
            if (qsRequestGen !== gen) return;
            var prod = jd && jd.product;
            qsAppendRow(it, prod, gen);
          }).catch(function(){ qsAppendRow(it, null, gen); });
        });
      }

      function qsAppendRow(it, prod, gen) {
        if (qsRequestGen !== gen || !qsResultsEl) return;

        var CALIBER_RE = /^[\d\.]+\s*[x\/\-]\s*[\d\.]+|^\d+\s*mm|\d+\s*(mm|cal|mag|nato|win|rem|spl|acp|luger|para|wmr|lr|short|long|\+p|s&w|sw)|^\.[\d]+/i;
        var BARREL_RE  = /^\d[\d\.]*\s*cm$/i;
        var cals = [], rows = [];

        if (prod && prod.variants) {
          var opt1vals=[], opt2vals=[], opt3vals=[];
          prod.variants.forEach(function(v){
            if(v.option1&&v.option1.trim())opt1vals.push(v.option1.trim());
            if(v.option2&&v.option2.trim())opt2vals.push(v.option2.trim());
            if(v.option3&&v.option3.trim())opt3vals.push(v.option3.trim());
          });
          function slotIsCaliber(vals){return vals.some(function(v){return CALIBER_RE.test(v)&&!BARREL_RE.test(v);});}
          function slotIsBarrel(vals){return vals.some(function(v){return BARREL_RE.test(v);});}
          var calSlot=null;
          if(slotIsCaliber(opt1vals))calSlot='option1';
          else if(slotIsCaliber(opt2vals))calSlot='option2';
          else if(slotIsCaliber(opt3vals))calSlot='option3';
          var barSlot=null;
          if(slotIsBarrel(opt1vals))barSlot='option1';
          else if(slotIsBarrel(opt2vals))barSlot='option2';
          else if(slotIsBarrel(opt3vals))barSlot='option3';
          var sc=new Set();
          if(calSlot){ prod.variants.forEach(function(v){var c=(v[calSlot]||'').trim();if(c&&!sc.has(c)){sc.add(c);cals.push(c);}}); }
          if(!cals.length){ prod.variants.forEach(function(v){var c=(v.option1||'').trim();if(c&&c!=='Default Title'&&!sc.has(c)){sc.add(c);cals.push(c);}}); }
          var sb=new Set();
          if(barSlot){ prod.variants.forEach(function(v){var b=(v[barSlot]||'').trim();if(!sb.has(b)){sb.add(b);rows.push(b);}}); }
        }

        var img = (prod && prod.image && prod.image.src) || it.image || 'https://via.placeholder.com/50';
        // Same row-per-barrel-length expansion as the normal Model dropdown
        // (armAppendModelRow) — a product with multiple barrel lengths becomes
        // one clickable row per length, with the length shown on the right.
        if (!rows.length || (rows.length===1 && !rows[0])) {
          qsAppendModelRow(it, img, null, cals, gen);
        } else {
          rows.forEach(function(b){ qsAppendModelRow(it, img, b||null, cals, gen); });
        }
      }

      function qsAppendModelRow(it, img, barrel, cals, gen) {
        if (qsRequestGen !== gen || !qsResultsEl) return;
        var el = document.createElement('div'); el.className = 'model-item';
        el.innerHTML = '<div class="model-img-wrapper"><img src="'+img+'" alt="'+(it.title||'')+'"></div><div style="display:flex;align-items:center;width:100%;gap:8px;"><div style="display:flex;flex-direction:column;flex:1;"><span>'+(it.title||'')+'</span><span style="font-size:.78rem;color:#888;">'+(it.marca||'')+'</span></div>'+(barrel?'<span style="white-space:nowrap;">'+barrel+'</span>':'')+'</div>';
        el.addEventListener('click', function(){ qsSelectResult(it, cals, barrel); });
        qsResultsEl.appendChild(el);
      }

      // AC1/AC3: selecting a quick-search result back-fills Type/Subtype/Brand/Model
      // and applies the same caliber lock logic used everywhere else in the popup.
      // Finds the locale-correct (e.g. Spanish) label for a given filter dimension
      // by checking which already-known value's filtered collection page contains
      // this product handle. Uses the SAME scraping mechanism as armFetchProducts,
      // so it's guaranteed reliable rather than parsing unverified page structure.
      async function qsFindLocaleValue(paramName, candidateValues, productHandle) {
        var checks = candidateValues.map(async function(v){
          try {
            var p = new URLSearchParams(); p.append(paramName, v);
            var doc = new DOMParser().parseFromString(await (await fetch(_FC + '?' + p.toString())).text(), 'text/html');
            var found = Array.from(doc.querySelectorAll('a[href*="/products/"]')).some(function(a){
              return a.href.indexOf('/products/' + productHandle) !== -1;
            });
            return found ? v : null;
          } catch(e) { return null; }
        });
        var results = await Promise.all(checks);
        return results.find(function(v){ return v !== null; }) || null;
      }

      async function qsResolveTypeSubtype(it) {
        armShowDropdownSkeleton('tipo');
        await armLoadTypeFilters();

        // it.productType is already localized at the source (see qsSearchStorefront's
        // @inContext directive) — no need to scrape-and-match against the collection
        // page for Type anymore. This removes a whole batch of extra network requests
        // from the selection path, which was also contributing to quick-search feeling
        // slow when picking a result.
        var finalTipo = it.productType || '';
        if (!finalTipo) { armSetLabel('tipo', window._armorerLabels.tipo); armHideDropdownSkeleton('tipo'); return; }

        sf.tipo = finalTipo; armSetLabel('tipo', finalTipo);
        var tr = document.querySelector('#popup [data-filter="tipo"] input[value="'+finalTipo.replace(/"/g,'&quot;')+'"]');
        if (tr) tr.checked = true;
        armSetEnabled('subtipo', true);
        armHideDropdownSkeleton('tipo');

        armShowDropdownSkeleton('subtipo');
        await armFetchSubtypes();

        // Subtype is a custom metafield, not a native field, so @inContext localization
        // isn't reliable for it (documented Shopify limitation even when a translation
        // exists) — try the cheap, already-fetched it.subtipo value first, and only pay
        // for the scrape-based qsFindLocaleValue lookup if that came back empty.
        var finalSubtipo = it.subtipo || '';
        if (!finalSubtipo) {
          var subtipoList = Array.from(document.querySelectorAll('#arm-subtipo-list input[type="radio"]')).map(function(r){ return r.value; });
          finalSubtipo = subtipoList.length ? (await qsFindLocaleValue('filter.p.m.custom.sub_tipo_de_arma', subtipoList, it.handle)) || '' : '';
        }
        if (finalSubtipo) {
          sf.subtipo = finalSubtipo; armSetLabel('subtipo', finalSubtipo);
          var sr = document.querySelector('#popup [data-filter="subtipo"] input[value="'+finalSubtipo.replace(/"/g,'&quot;')+'"]');
          if (sr) sr.checked = true;
        } else {
          armSetLabel('subtipo', window._armorerLabels.subtipo);
        }
        armHideDropdownSkeleton('subtipo');
      }

      async function qsResolveBrand(it) {
        if (!it.marca) return;
        armShowDropdownSkeleton('marca');
        sf.marca = it.marca;
        await loadBrands();
        var br = document.querySelector('#popup #arm-marca-list li[data-brand="'+it.marca.replace(/"/g,'&quot;')+'"] input');
        if (br) br.checked = true;
        var cb = await getCatalogueBrands();
        armBrandIsCatalogue = cb.has(it.marca);
        armSetLabel('marca', it.marca);
        armHideDropdownSkeleton('marca');
      }

      async function qsSelectResult(it, cals, barrel) {
        qsHideResults();
        if (qsInput) qsInput.value = '';
        armShowDropdownSkeleton('modelo');

        // Model has zero dependency on Type/Subtype/Brand resolution — it.title/handle/image
        // are already known synchronously from the click — so set it immediately rather than
        // waiting on anything below. This also makes the popup feel responsive right away.
        var qsLocalePrefix = {% if request.locale.iso_code == 'en' %}'/en'{% else %}''{% endif %};
        // IMPORTANT: must be an absolute URL, not a relative path — Shopify's url-type
        // product_url field rejects a bare "/products/handle" path with no scheme.
        // window.location.origin (NOT a hardcoded domain) gives the correct domain whether
        // the customer is on gunloupe.com, gunloupe.myshopify.com, or a staging domain. The
        // locale prefix (qsLocalePrefix) is a SEPARATE concern from the domain — this store
        // puts "/en/" in front of English-locale paths (see _FC above), so product URLs need
        // the same prefix or an English-locale save would point at a URL missing "/en/".
        selectedProduct = {title: it.title, handle: it.handle, url: window.location.origin+qsLocalePrefix+'/products/'+it.handle, image: it.image||null, barrel:barrel||''};
        sf.modelo = it.title;
        // Show the barrel length alongside the model, exactly like picking from the
        // normal Model dropdown (e.g. "Beretta 686 SILVER PIGEON I // 71cm").
        var qsDisplay = barrel ? it.title+' // '+barrel : it.title;
        if (searchInput) searchInput.value = qsDisplay;
        searchInputPrevValue = qsDisplay;
        armSetLabel('modelo', qsDisplay);
        armHideDropdownSkeleton('modelo');
        armSetEnabled('modelo', true);

        // Apply caliber logic immediately too — also has no dependency on Type/Subtype/Brand.
        if (cals && cals.length === 1) {
          renderCaliberListDirect(cals);
          var ri = document.querySelector('#arm-calibre-list input[value="'+cals[0].replace(/"/g,'&quot;')+'"]');
          if (ri) ri.checked = true;
          lockCaliber(cals[0]);
          armSetEnabled('calibre', false);
        } else if (cals && cals.length > 1) {
          renderCaliberListDirect(cals);
          unlockCaliber(); sf.calibre = '';
          armSetLabel('calibre', window._armorerLabels.calibre);
          armSetEnabled('calibre', true);
        } else {
          unlockCaliber(); sf.calibre = '';
          armSetLabel('calibre', window._armorerLabels.calibre);
          loadCalibers();
          armSetEnabled('calibre', true);
        }

        // Type/Subtype and Brand each unlock their own dropdown as soon as THEY individually
        // finish, instead of the whole UI waiting on Promise.all for the slower of the two
        // (usually Brand, since loadBrands() can require several sequential paginated
        // fetches on a cold cache). Still run concurrently — just no longer gated together.
        qsResolveTypeSubtype(it).then(function(){ armSetEnabled('subtipo', true); });
        qsResolveBrand(it).then(function(){ armSetEnabled('marca', true); });
      }

      // AC2: fire search at 2+ characters, debounced ~300ms to stay within the
      // 2-second performance target (AC5) without hammering the API on every keystroke.
      if (qsInput) {
        qsInput.addEventListener('input', function(){
          var typed = this.value.trim();
          clearTimeout(qsDebounceTimer);
          if (typed.length < 2) { qsHideResults(); return; }
          qsShowLoading();
          var myGen = ++qsRequestGen;
          qsDebounceTimer = setTimeout(async function(){
            var cacheKey = typed.toLowerCase()+'|'+sf.tipo+'|'+sf.marca+'|'+sf.subtipo;
            var items;
            if (qsCache[cacheKey]) { items = qsCache[cacheKey]; }
            else {
              items = await qsSearchStorefront(typed);
              console.log('[DEBUG qsearch] after qsSearchStorefront:', items.length, 'sf.marca=', JSON.stringify(sf.marca));
              items = qsFilterByDropdowns(items);
              console.log('[DEBUG qsearch] after qsFilterByDropdowns:', items.length);
              // Client-side relevance filter...
              var lq = typed.toLowerCase();
              items = items.filter(function(it){
                return (it.title || '').toLowerCase().includes(lq) ||
                       (it.marca || '').toLowerCase().includes(lq);
              });
              console.log('[DEBUG qsearch] after relevance filter:', items.length, 'lq=', JSON.stringify(lq));
              qsCache[cacheKey] = items;
            }
            if (myGen !== qsRequestGen) { console.log('[DEBUG qsearch] superseded by newer keystroke, discarding'); return; }
            qsRenderResults(items, typed, myGen);
          }, 300);
        });
        qsInput.addEventListener('click', function(e){ e.stopPropagation(); });
      }

      // ── Dropdown open/close ───────────────────────────────────────────────────
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('#popup .filter-toggle');
        if (!btn) {
          if (!e.target.closest('#popup .add-firearm-custom-dropdown.open')) {
            document.querySelectorAll('#popup .add-firearm-custom-dropdown.open').forEach(function(d){armCloseDropdown(d);});
          }
          return;
        }
        var dd = btn.closest('.add-firearm-custom-dropdown');
        if (!dd || dd.classList.contains('disabled')) return;
        var wasOpen = dd.classList.contains('open');
        document.querySelectorAll('#popup .add-firearm-custom-dropdown.open').forEach(function(d){if(d!==dd)armCloseDropdown(d);});
        if (!wasOpen) {
          armOpenDropdown(dd);
          var filter = dd.dataset.filter;
          if (filter === 'marca') loadBrands();
          if (filter === 'calibre' && !selectedProduct) loadCalibers();
          if (filter === 'modelo' && armBrandIsCatalogue && !allProducts.length && !isFetching && !armProductFetchDone) { showModelSkeleton(); armFetchProducts(); }
          if (filter === 'modelo' && armBrandIsCatalogue && !allProducts.length && armProductFetchDone) { showMismatchHint(); }
        } else { armCloseDropdown(dd); }
      });

      // ── Radio change ──────────────────────────────────────────────────────────
      document.addEventListener('change', function(e) {
        if (e.target.matches('#popup [data-filter="tipo"] input[type="radio"]') ||
            e.target.matches('#popup [data-filter="subtipo"] input[type="radio"]') ||
            e.target.matches('#popup [data-filter="marca"] input[type="radio"]') ||
            e.target.matches('#popup [data-filter="calibre"] input[type="radio"]')) {

          var name = e.target.name, value = e.target.value;
          document.querySelectorAll('#popup .add-firearm-custom-dropdown.open').forEach(function(d){armCloseDropdown(d);});

          if (name === 'arm-tipo') {
            sf = {tipo:value,subtipo:'',marca:'',modelo:'',calibre:''};
            selectedProduct = null; allProducts = [];
            armSetLabel('tipo', value);
            ['subtipo','marca','modelo','calibre'].forEach(function(k){armSetLabel(k,window._armorerLabels[k]||k);});
            ['subtipo','marca','modelo','calibre'].forEach(function(k){armSetEnabled(k,false);});
            unlockCaliber(); armSetEnabled('calibre', false);
            var cs = document.getElementById('arm-caliber-search'); if(cs)cs.style.display='';
            if (searchInput) searchInput.value = ''; if (resultsEl) resultsEl.innerHTML = '';
            armSetEnabled('subtipo', true); armFetchSubtypes();

          } else if (name === 'arm-subtipo') {
            sf.subtipo=value; sf.marca=sf.modelo=sf.calibre='';
            selectedProduct=null; allProducts=[];
            armSetLabel('subtipo', value);
            ['marca','modelo','calibre'].forEach(function(k){armSetLabel(k,window._armorerLabels[k]||k);});
            ['marca','modelo','calibre'].forEach(function(k){armSetEnabled(k,false);});
            unlockCaliber(); armSetEnabled('calibre', false);
            if (searchInput) searchInput.value = ''; if (resultsEl) resultsEl.innerHTML = '';
            armSetEnabled('marca', true);

          } else if (name === 'arm-marca') {
            sf.marca=value; sf.modelo=sf.calibre='';
            selectedProduct=null; allProducts=[];
            armProductFetchGen++; // invalidate any in-flight armFetchProducts from the previous brand
            armProductFetchDone = false; // a new brand means we haven't fetched/confirmed its product list yet
            armSetLabel('marca', value);
            ['modelo','calibre'].forEach(function(k){armSetLabel(k,window._armorerLabels[k]||k);});
            ['modelo','calibre'].forEach(function(k){armSetEnabled(k,false);});
            unlockCaliber(); armSetEnabled('calibre', false);
            if (searchInput) searchInput.value = ''; if (resultsEl) resultsEl.innerHTML = '';
            getCatalogueBrands().then(function(cb){
              armBrandIsCatalogue = cb.has(value);
              armSetEnabled('modelo', true);
              if (!armBrandIsCatalogue) { unlockCaliber(); armSetEnabled('calibre', true); showManualHint(); }
            });

          } else if (name === 'arm-calibre') {
            sf.calibre = value; armSetLabel('calibre', value);
          }
        }

        if (e.target.name === 'status') {
          armSetLabel('status', e.target.value);
          setTimeout(function(){ var d = document.querySelector('#popup [data-filter="status"].open'); if (d) armCloseDropdown(d); }, 120);
        }
      });

      // ── Model search input ────────────────────────────────────────────────────
      if (searchInput) {
        var searchInputClearedForEdit = false; // true once the field has been cleared for this edit session

        searchInput.addEventListener('focus', function(){
          searchInputPrevValue = this.value;
          searchInputClearedForEdit = false;
        });

        searchInput.addEventListener('keydown', function(){
          // Clear the old value on the first keystroke of a fresh edit, not on every keystroke
          if (!searchInputClearedForEdit && this.value === searchInputPrevValue && searchInputPrevValue) {
            this.value = '';
            searchInputClearedForEdit = true;
          }
        });

        searchInput.addEventListener('blur', function(){
          // If the user clicked away without typing anything new and without picking
          // a fresh result, restore whatever was selected before.
          setTimeout(function(){
            if (searchInput.value.trim() === '' && searchInputPrevValue) {
              searchInput.value = searchInputPrevValue;
              if (resultsEl) resultsEl.innerHTML = '';
            }
          }, 150); // small delay so a click on a result row registers first
        });

        searchInput.addEventListener('input', function(){
          var typed = this.value.trim(); if (!resultsEl) return;
          if (!armBrandIsCatalogue) {
            resultsEl.innerHTML = '';
            if (typed) resultsEl.appendChild(makeUseBtn(typed, function(){armSelectCustomModel(typed);}));
            return;
          }
          // Catalogue brand: still let the user type a custom model at any time —
          // being a recognised brand doesn't mean every model under it exists in
          // the store's product list. Previously a fetch-in-progress (isFetching)
          // silently swallowed every keystroke until the fetch resolved, which made
          // typing feel broken/unresponsive while the loading skeleton was showing.
          if (isFetching) {
            if (typed) { resultsEl.innerHTML = ''; resultsEl.appendChild(makeUseBtn(typed, function(){armSelectCustomModel(typed);})); }
            return;
          }
          var q = typed.toLowerCase();
          if (allProducts.length) {
            // Real catalogue brand with a known product list: typing here is pure
            // filtering against that list, exactly like every other catalogue brand's
            // Model dropdown — no "Use" button. armRenderModelResults already appends
            // one itself when isFinal+typed+zero matches (i.e. nothing in the list
            // matches what was typed), which is the only case it's actually needed.
            armRenderModelResults(q ? allProducts.filter(function(p){return p.title.toLowerCase().includes(q);}) : allProducts, true);
          } else if (armProductFetchDone) {
            resultsEl.innerHTML = '';
            if (typed) {
              resultsEl.appendChild(makeUseBtn(typed, function(){armSelectCustomModel(typed);}));
            } else {
              showMismatchHint();
            }
          } else if (typed) {
            // First time we've seen this brand's product list — offer the typed value
            // immediately while the one-time fetch runs in the background.
            resultsEl.innerHTML = '';
            resultsEl.appendChild(makeUseBtn(typed, function(){armSelectCustomModel(typed);}));
            armFetchProducts();
          } else { showModelSkeleton(); armFetchProducts(); }
        });
        searchInput.addEventListener('click', function(e){e.stopPropagation();});
      }

      var bsi = document.getElementById('arm-brand-search');
      if (bsi) { bsi.addEventListener('input',function(){armFilterList('arm-marca-list','brand',this.value);}); bsi.addEventListener('click',function(e){e.stopPropagation();}); }
      var csi = document.getElementById('arm-caliber-search');
      if (csi) { csi.addEventListener('input',function(){armFilterList('arm-calibre-list','caliber',this.value);}); csi.addEventListener('click',function(e){e.stopPropagation();}); }

      // ── Open / Close / Reset popup ────────────────────────────────────────────
      function openAdd() {
        resetForm(); editingId = null;
        popupTitle.textContent = '{{ 'custom.add_firearm' | t }}';
        saveBtn.textContent = '{{ 'custom.add_firearm' | t }}';
        popup.style.display = 'flex';
        armLoadTypeFilters();
        getCatalogueBrands();
      }

      function openEdit(btn) {
        resetForm(); editingId = btn.dataset.id;
        popupTitle.textContent = '{{ 'custom.edit_firearm' | t }}';
        saveBtn.textContent = '{{ 'custom.update_firearm' | t }}';
        document.getElementById('customName').value = btn.dataset.customGunName || '';
        document.getElementById('purchaseDate').value = btn.dataset.purchaseDate || '';

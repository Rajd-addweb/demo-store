            var w=document.createElement('div'),img=document.createElement('img'); img.src=url;
            var rb=document.createElement('span'); rb.className='remove-img'; rb.textContent='×';
            rb.addEventListener('click',function(){existingImages=existingImages.filter(function(u2){return u2!==url;});w.remove();});
            w.appendChild(img); w.appendChild(rb); imagePreviewEl.appendChild(w);
          });
        } catch(e){ existingImages=[]; }
        popup._editData = {tipo:btn.dataset.type,subtipo:btn.dataset.subtype,marca:btn.dataset.brand,modelo:btn.dataset.model,calibre:btn.dataset.caliber,barrel:btn.dataset.barrelLength||'',productTitle:btn.dataset.productTitle,productHandle:btn.dataset.productHandle,productUrl:btn.dataset.productUrl,productImage:btn.dataset.productImage};
        popup.style.display = 'flex';

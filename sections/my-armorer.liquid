      // ── Bind open/close buttons ───────────────────────────────────────────────
      var openBtn=document.getElementById('openPopupBtn');
      var closeBtn=document.getElementById('closePopupBtn');
      var cancelBtn=document.getElementById('cancelFirearm');
      if (openBtn) openBtn.addEventListener('click', openAdd);
      if (closeBtn) closeBtn.addEventListener('click', closePopup);
      if (cancelBtn) cancelBtn.addEventListener('click', closePopup);
      popup.addEventListener('click', function(e){if(e.target===popup)closePopup();});
      var form=document.getElementById('armoryForm'); if(form)form.addEventListener('submit',function(e){e.preventDefault();e.stopPropagation();return false;});

      // ── Sliders ───────────────────────────────────────────────────────────────
      // Scoped so it can be re-run on just a newly-inserted card (see swapInNewCard)
      // without re-binding (and double-firing) listeners on cards already on the page.
      function initArmorerSliders(root){
        (root||document).querySelectorAll('[data-slider]').forEach(function(slider){
          if(slider.dataset.sliderBound)return; slider.dataset.sliderBound='1';
          var track=slider.querySelector('.armorer-slider_track'),slides=slider.querySelectorAll('.armorer-slider_slide'),dots=slider.querySelectorAll('.armorer-slider_dot');
          var prev=slider.querySelector('.armorer-slider_btn--prev'),next=slider.querySelector('.armorer-slider_btn--next');
          var cur=0;
          function go(i){cur=(i+slides.length)%slides.length;track.style.transform='translateX(-'+cur*100+'%)';dots.forEach(function(d,j){d.classList.toggle('is-active',j===cur);});}
          if(prev)prev.addEventListener('click',function(){go(cur-1);});
          if(next)next.addEventListener('click',function(){go(cur+1);});
          dots.forEach(function(d,i){d.addEventListener('click',function(){go(i);});});
        });
      }
      initArmorerSliders();

      // ── Validation ────────────────────────────────────────────────────────────
      function validate() {
        var errors=[]; document.querySelectorAll('.field-error').forEach(function(el){el.classList.remove('field-error');});
        var checks=[
          [!sf.tipo,    '{{ 'custom.select_firearm_type' | t }}',  '#popup [data-filter="tipo"]'],
          [!sf.subtipo, '{{ 'custom.select_subtype_error' | t }}', '#popup [data-filter="subtipo"]'],
          [!sf.marca,   window._armorerLabels.selectBrand,          '#popup [data-filter="marca"]'],
          [!(selectedProduct?.title||sf.modelo||(searchInput&&searchInput.value.trim())), '{{ 'custom.select_or_enter_model' | t }}', '#popup [data-filter="modelo"]'],
          [!sf.calibre, '{{ 'custom.select_calibre' | t }}',       '#popup [data-filter="calibre"]'],
          [!document.querySelector('[name="status"]:checked')?.value, '{{ 'custom.select_status_error' | t }}', '#popup [data-filter="status"]']
        ];
        checks.forEach(function(c){if(c[0]){errors.push(c[1]);var el=document.querySelector(c[2]);if(el&&!el.classList.contains('disabled'))el.classList.add('field-error');}});
        // Image upload is optional in every case now — a new upload, a kept
        // existing image when editing, a catalogue product's own image, or
        // (if none of those exist, e.g. a custom/manually-typed model with
        // no upload) the placeholder shown on the card. Nothing to validate.
        return errors;
      }

      function showErrors(errors) {
        var box=document.getElementById('armoryValidationErrors');
        var content=document.getElementById('armoryErrorContent');
        if(!box||!content)return;
        if(!errors.length){box.style.display='none';content.innerHTML='';return;}
        content.innerHTML='<strong>{{ 'custom.Please_fix_the_following' | t }}</strong><ul>'+errors.map(function(e){return'<li>'+e+'</li>';}).join('')+'</ul>';
        box.style.display='block'; box.scrollIntoView({behavior:'smooth',block:'nearest'});
      }

      // ── Image upload ──────────────────────────────────────────────────────────
      document.getElementById('gunImages')?.addEventListener('change',function(){
        var imageErrorEl=document.getElementById('armorer-image-error');
        if(!imageErrorEl){
          imageErrorEl=document.createElement('div');imageErrorEl.id='armorer-image-error';
          imageErrorEl.style.cssText='display:none;color:#c0392b;font-size:0.88rem;margin-top:6px;padding:8px 12px;background:#fef0f0;border-radius:8px;';
          var preview=document.getElementById('imagePreview');
          if(preview&&preview.parentNode)preview.parentNode.insertBefore(imageErrorEl,preview);
        }
        Array.from(this.files).forEach(function(file){
          var reader=new FileReader();
          reader.onload=function(e){
            var b64=e.target.result; var checker=new Image();
            checker.onload=function(){
              if(checker.naturalWidth<300){imageErrorEl.textContent='Min image size 300×300px.';imageErrorEl.style.display='block';return;}
              imageErrorEl.style.display='none'; uploadedImages.push(b64);
              var w=document.createElement('div'),img=document.createElement('img');img.src=b64;
              var rb=document.createElement('span');rb.className='remove-img';rb.textContent='×';
              rb.addEventListener('click',function(){uploadedImages=uploadedImages.filter(function(u){return u!==b64;});w.remove();});
              w.appendChild(img);w.appendChild(rb);imagePreviewEl.appendChild(w);
            };checker.src=b64;
          };reader.readAsDataURL(file);
        });this.value='';
      });

      // ── Save (AC1 + AC3 + AC5 fixes applied) ─────────────────────────────────
      saveBtn?.addEventListener('click', async function(){
        var errors=validate(); if(errors.length){showErrors(errors);return;} showErrors([]);
        var finalModel=selectedProduct?.title||sf.modelo||(searchInput&&searchInput.value)||'';
        var payload={
          customer_id:CUSTOMER_ID,
          customer_name:'{{ customer.first_name | escape }} {{ customer.last_name | escape }}',
          customer_email:'{{ customer.email | escape }}',
          theme_id:'{{ theme.id }}',
          type:sf.tipo, subtype:sf.subtipo, brand:sf.marca,
          model:finalModel, caliber:sf.calibre,
          barrel_length:selectedProduct?selectedProduct.barrel||'':'',
          custom_name:document.getElementById('customName')?.value,
          condition:document.querySelector('[name="status"]:checked')?.value,
          purchase_date:document.getElementById('purchaseDate')?.value,
          product_id:selectedProduct?extractVariantId(selectedProduct.url):undefined,
          product_title:selectedProduct?.title, product_handle:selectedProduct?.handle,
          product_url:selectedProduct?.url, product_image:selectedProduct?.image,
          images:uploadedImages, existing_images:existingImages
        };
        var isEdit=!!editingId;

        showSavingOverlay(isEdit?'{{ 'custom.update_firearm' | t }}...':'{{ 'custom.add_firearm' | t }}...');

        try {
          var url=isEdit?BACKEND_URL+'/my-armorer/'+encodeURIComponent(editingId):BACKEND_URL+'/my-armorer';
          var resp = await fetch(url,{method:isEdit?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
          var data = await resp.json();

          if(data.success){
            var overlay=document.getElementById('armorer-saving-overlay');if(overlay)overlay.remove();
            closePopup();
            var savedId=data.id||data.data?.id||null;
            if(isEdit){
              // Editing an existing, already-visible card — unchanged: brief
              // full-screen wait, then confirm-and-reload as before.
              showSavingOverlay('{{ 'custom.update_firearm' | t }}...');
              await pollUntilSaved(CUSTOMER_ID,savedId,editingId);
            } else {
              // New entry: show it immediately as a skeleton instead of blocking
              // the whole page, then swap it for the real card once confirmed.
              var skeletonImg=(uploadedImages&&uploadedImages[0])||(selectedProduct&&selectedProduct.image)||'';
              var skeletonEl=insertArmorerSkeleton(skeletonImg);
              await pollAndSwapNewCard(CUSTOMER_ID,savedId,skeletonEl);
            }
          } else {
            var overlay=document.getElementById('armorer-saving-overlay');if(overlay)overlay.remove();
            var apiMessage = data.message || data.error || null;
            var fallback = isEdit ? '{{ 'custom.error_update_firearm' | t }}' : '{{ 'custom.error_saving_firearm' | t }}';
            showInlineError(apiMessage || fallback);
          }
        } catch(e){
          var overlay=document.getElementById('armorer-saving-overlay');if(overlay)overlay.remove();
          showInlineError('{{ 'custom.server_error' | t }}');
        }
      });

      function showSavingOverlay(msg){
        var existing=document.getElementById('armorer-saving-overlay');if(existing)existing.remove();
        var overlay=document.createElement('div');overlay.id='armorer-saving-overlay';
        overlay.style.cssText='position:fixed;inset:0;background:rgba(255,255,255,0.93);z-index:999999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;';
        overlay.innerHTML='<div style="width:56px;height:56px;border:4px solid #e0e0e0;border-top-color:var(--color-foreground);border-radius:50%;animation:armory-spin .8s linear infinite;"></div><div style="font-size:1.1rem;font-weight:600;color:var(--color-foreground);">'+(msg||'Saving...')+'</div><div style="font-size:0.88rem;color:#6b7280;max-width:260px;text-align:center;">{{ 'custom.please_wait' | t }}</div>';
        document.body.appendChild(overlay);
      }

      // ── New-entry skeleton (create flow only — edits keep the existing overlay) ──
      function insertArmorerSkeleton(imgSrc){
        var list=document.getElementById('armorer-collection-list');
        var addBtn=document.getElementById('openPopupBtn');
        if(!list||!addBtn)return null;
        var el=document.createElement('div');
        el.className='products-grid_item is-skeleton';
        el.innerHTML=
          '<div class="product-card_component">'+
            '<div class="product-card_thumb-wrap" style="position:relative;">'+
              '<div class="armorer-skeleton-badge"><span class="spin"></span>{{ "custom.add_firearm" | t }}...</div>'+
              (imgSrc?'<img src="'+imgSrc+'" class="product-card_thumb-image layer" alt="" style="opacity:.6;">':'')+
            '</div>'+
            '<div class="product-card_details-wrap" style="padding:16px;display:flex;flex-direction:column;gap:10px;">'+
              '<div class="armorer-skel-line" style="height:18px;width:65%;"></div>'+
              '<div class="armorer-skel-line" style="height:12px;width:90%;"></div>'+
              '<div class="armorer-skel-line" style="height:12px;width:75%;"></div>'+
              '<div class="armorer-skel-line" style="height:12px;width:50%;"></div>'+
            '</div>'+
          '</div>';
        list.insertBefore(el,addBtn);
        el.scrollIntoView({behavior:'smooth',block:'nearest'});
        return el;
      }

      // Polls for the newly-created entry the same way pollUntilSaved does, but
      // swaps the skeleton for the real server-rendered card in place instead of
      // reloading the page. Falls back to the proven full-reload behavior if the
      // id is missing or confirmation doesn't arrive in time, so the outcome is
      // never worse than before — just faster and less disruptive in the common case.
      async function pollAndSwapNewCard(customerId,savedId,skeletonEl){
        var rawTargetId=savedId||null;
        var targetId=rawTargetId?String(rawTargetId).split('/').pop():null;
        if(!targetId){
          if(skeletonEl)skeletonEl.remove();
          await pollUntilSaved(customerId,savedId,null);
          return;
        }
        var maxAttempts=27,interval=1200;
        for(var i=0;i<maxAttempts;i++){
          await new Promise(function(r){setTimeout(r,interval);});
          try{
            var res=await fetch(window.location.pathname+'?_cb='+Date.now(),{cache:'no-store',headers:{'Cache-Control':'no-cache','Pragma':'no-cache'}});
            var doc=new DOMParser().parseFromString(await res.text(),'text/html');
            var freshNode=doc.querySelector('[data-metaobject-id="'+targetId+'"]');
            if(freshNode){
              var imported=document.importNode(freshNode,true);
              if(skeletonEl&&skeletonEl.parentNode){skeletonEl.replaceWith(imported);}
              else{var list=document.getElementById('armorer-collection-list'),addBtn=document.getElementById('openPopupBtn');if(list&&addBtn)list.insertBefore(imported,addBtn);}
              initArmorerSliders(imported);
              loadArmorerPrices();
              return;
            }
          }catch(e){}
        }
        // Confirmation didn't arrive in the expected window — fall back to the
        // same guaranteed-correct behavior used everywhere else in this flow.
        location.href=location.pathname+'?nc='+Date.now();
      }

      async function pollUntilSaved(customerId,savedId,editedMetaobjectId){
        var maxAttempts=27,interval=1200; // ~32s total — gives Shopify's metaobject store more
        // time to propagate the new/updated entry before falling back to an unconditional reload.
        var currentCount=document.querySelectorAll('#armorer-collection-list .products-grid_item').length;
        var msgEl=document.querySelector('#armorer-saving-overlay div:nth-child(3)');
        // The backend's create response already gives us the new entry's metaobject id
        // (savedId) — use it directly when available instead of the fuzzier count/diff
        // heuristics below, which can produce false negatives (e.g. if an entry was
        // also removed elsewhere at the same time, the count comparison alone can miss
        // a real new entry because the totals happen to land back where they started).
        // IMPORTANT: savedId comes back from Shopify's GraphQL API as a full GID
        // (gid://shopify/Metaobject/123...), but data-metaobject-id in the rendered
        // page is the bare numeric id (item.system.id renders as just the number —
        // confirmed by how normaliseToGid handles it elsewhere in this codebase).
        // Extract just the numeric part so the comparison below actually matches.
        var rawTargetId = editedMetaobjectId || savedId || null;
        var targetId = rawTargetId ? String(rawTargetId).split('/').pop() : null;
        for(var i=0;i<maxAttempts;i++){
          await new Promise(function(r){setTimeout(r,interval);});
          // After a while, let the user know this is taking longer than usual rather than
          // appearing frozen — purely informational, polling continues unchanged underneath.
          if (i === 8 && msgEl) msgEl.textContent = '{{ "custom.please_wait" | t }}';
          try{
            var res=await fetch(window.location.pathname+'?_cb='+Date.now(),{cache:'no-store',headers:{'Cache-Control':'no-cache','Pragma':'no-cache'}});
            var doc=new DOMParser().parseFromString(await res.text(),'text/html');

            if (targetId) {
              // Direct, unambiguous check: does this exact entry now exist on a
              // freshly fetched copy of the page? Works for both create and edit.
              if (doc.querySelector('[data-metaobject-id="'+targetId+'"]')) { location.href=location.pathname+'?nc='+Date.now(); return; }
            } else if(editedMetaobjectId){
              // Fallback for the (rare) edit case where no id was resolved.
              if(i>=1){location.href=location.pathname+'?nc='+Date.now();return;}
            } else {
              // Fallback for the (rare) create case where the backend didn't return an id.
              var freshCount=doc.querySelectorAll('#armorer-collection-list .products-grid_item').length;
              if(freshCount>currentCount){location.href=location.pathname+'?nc='+Date.now();return;}
              var existingIds=new Set(Array.from(document.querySelectorAll('[data-metaobject-id]')).map(function(el){return el.dataset.metaobjectId;}));
              var hasNew=false;
              doc.querySelectorAll('[data-metaobject-id]').forEach(function(el){if(!existingIds.has(el.dataset.metaobjectId))hasNew=true;});
              if(hasNew){location.href=location.pathname+'?nc='+Date.now();return;}
            }
          }catch(e){}
        }
        location.href=location.pathname+'?nc='+Date.now();
      }

      async function pollUntilDeleted(metaobjectId){
        var maxAttempts=20,interval=1200;
        for(var i=0;i<maxAttempts;i++){
          await new Promise(function(r){setTimeout(r,interval);});
          try{
            var doc=new DOMParser().parseFromString(await(await fetch(window.location.pathname+'?_cb='+Date.now(),{cache:'no-store',headers:{'Cache-Control':'no-cache','Pragma':'no-cache'}})).text(),'text/html');
            if(!doc.querySelector('[data-metaobject-id="'+metaobjectId+'"]')){location.href=location.pathname+'?nc='+Date.now();return;}
          }catch(e){}
        }
        location.href=location.pathname+'?nc='+Date.now();
      }

      // ── Delete (AC3 fix applied) ───────────────────────────────────────────────
      document.addEventListener('click',function(e){
        var eb=e.target.closest('.js-edit-firearm'); if(eb){openEdit(eb);return;}
        var db=e.target.closest('.js-delete-firearm');
        if(db){
          pendingDeleteId=db.dataset.id;
          pendingDeleteCard=db.closest('.products-grid_item');
          hideDeleteError();
          deleteOverlay.style.display='flex';
        }
      });

      function closeDelete(){
        deleteOverlay.style.display='none';pendingDeleteId=null;pendingDeleteCard=null;
        hideDeleteError();
        if(deleteConfirm){deleteConfirm.disabled=false;deleteConfirm.textContent=window._armorerLabels.yesDelete;}
      }
      document.getElementById('deleteConfirmCancel')?.addEventListener('click',closeDelete);
      document.getElementById('deleteConfirmClose')?.addEventListener('click',closeDelete);
      deleteOverlay?.addEventListener('click',function(e){if(e.target===deleteOverlay)closeDelete();});

      deleteConfirm?.addEventListener('click',async function(){
        if(!pendingDeleteId)return;
        hideDeleteError();
        this.disabled=true;this.textContent='{{ 'custom.deleting' | t }}...';
        var idToDelete=pendingDeleteId;
        try{
          var data=await(await fetch(BACKEND_URL+'/my-armorer/'+encodeURIComponent(idToDelete),{method:'DELETE'})).json();
          if(data.success){
            if(pendingDeleteCard){pendingDeleteCard.style.transition='opacity .3s,transform .3s';pendingDeleteCard.style.opacity='0';pendingDeleteCard.style.transform='scale(.95)';}
            closeDelete();showSavingOverlay('{{ 'custom.deleting' | t }}...');
            await pollUntilDeleted(idToDelete);
          } else {
            this.disabled=false;this.textContent=window._armorerLabels.yesDelete;
            var apiMessage = data.message || data.error || 'Error deleting firearm.';
            showDeleteError(apiMessage);
          }
        }catch(e){
          this.disabled=false;this.textContent=window._armorerLabels.yesDelete;
          showDeleteError('{{ 'custom.server_error' | t }}');
        }
      });

      function extractVariantId(url){
        if(!url)return'';
        try{return new URL(url.startsWith('http')?url:'https://placeholder.com'+url).searchParams.get('variant')||'';}catch(e){return'';}
      }

      // ── Prices ────────────────────────────────────────────────────────────────
      async function loadArmorerPrices(){
        var priceEls=document.querySelectorAll('#armorer-collection-list .is-price.price');
        if(!priceEls.length)return;
        var handleCache={};
        var fetchPromises=Array.from(priceEls).map(async function(el){
          if(el.dataset.customModel==='true'){el.dataset.price='0';el.textContent='N/A';return;}
          var handle=el.dataset.handle,caliber=el.dataset.caliber||'',barrel=el.dataset.barrel||'';
          if(!handle){el.dataset.price='0';el.textContent='N/A';return;}
          try{
            if(!handleCache[handle])handleCache[handle]=fetch('/products/'+handle+'.json').then(function(r){return r.json();});
            var data=await handleCache[handle];
            var variants=(data&&data.product&&data.product.variants)||[];
            var match=variants.find(function(v){return(!caliber||v.option1===caliber)&&(!barrel||v.option2===barrel);})||variants.find(function(v){return v.option1===caliber;})||variants[0];
            if(match){var eurPrice=parseFloat(match.price);if(eurPrice>0){el.dataset.price=eurPrice.toFixed(0);el.textContent=Math.round(eurPrice)+'€';}else{el.dataset.price='0';el.textContent='N/A';}}
            else{el.dataset.price='0';el.textContent='N/A';}
          }catch(e){el.dataset.price='0';el.textContent='N/A';}
        });
        await Promise.all(fetchPromises);
        if(typeof updatePrices==='function')updatePrices();
      }

      document.addEventListener('DOMContentLoaded',function(){
        loadArmorerPrices();

        var purchaseDateInput = document.getElementById('purchaseDate');
        if (purchaseDateInput && window.GunloupeDatePicker) {
          window.GunloupeDatePicker.attach(purchaseDateInput, {
            maxDate: 'today',
            labels: {
              set: {{ 'custom.date_picker_set' | t | json }},
              cancel: {{ 'custom.date_picker_cancel' | t | json }},
              clear: {{ 'custom.date_picker_clear' | t | json }}
            }
          });
        }
      });

    })();
  </script>

  <!-- Compare button resolver (unchanged from v4/v5) -->
  <script>
    (function(){
      async function resolveAll(){
        var btns=document.querySelectorAll('[data-compare-btn][data-compare-variant*="--"]');
        for(var btn of btns){
          var parts=btn.dataset.compareVariant.split('--'),handle=parts[0],caliber=parts[1]||'',barrel=parts[2]||'';
          if(!handle)continue;
          try{
            var variants=(await(await fetch('/products/'+handle+'.json')).json())?.product?.variants||[];
            var m=variants.find(function(v){return(!caliber||v.option1===caliber)&&(!barrel||v.option2===barrel);})||variants.find(function(v){return v.option1===caliber;})||variants[0];
            if(m)btn.dataset.compareVariant=String(m.id);
          }catch(e){}
        }
        if(window.GunloupeComparator){await window.GunloupeComparator.sync();window.GunloupeComparator.bindButtons();}
      }

      document.addEventListener('click',async function(e){
        var btn=e.target.closest('[data-compare-btn]');
        if(!btn||!btn.dataset.compareVariant?.includes('--'))return;
        e.stopImmediatePropagation();e.preventDefault();
        var parts=btn.dataset.compareVariant.split('--'),handle=parts[0],caliber=parts[1]||'',barrel=parts[2]||'';
        if(!handle)return;btn.disabled=true;
        try{
          var variants=(await(await fetch('/products/'+handle+'.json')).json())?.product?.variants||[];
          var m=variants.find(function(v){return(!caliber||v.option1===caliber)&&(!barrel||v.option2===barrel);})||variants.find(function(v){return v.option1===caliber;})||variants[0];
          if(!m){btn.disabled=false;return;}
          var vid=String(m.id);btn.dataset.compareVariant=vid;
          if(window.GunloupeComparator){
            var items=await window.GunloupeComparator.getItems();
            if(items.find(function(i){return i.variantId===vid;}))await window.GunloupeComparator.remove(vid);
            else await window.GunloupeComparator.add(vid,handle);
            await window.GunloupeComparator.sync();
          }
        }catch(err){console.error('Armorer compare error:',err);}
        btn.disabled=false;
      },true);

      if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',resolveAll);
      else resolveAll();
    })();
  </script>

  {% endif %}
{% endunless %}


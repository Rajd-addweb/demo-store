        var defaults={tipo:window._armorerLabels.tipo,subtipo:window._armorerLabels.subtipo,marca:window._armorerLabels.marca,modelo:window._armorerLabels.modelo,calibre:window._armorerLabels.calibre};
        Object.entries(defaults).forEach(function(e){armSetLabel(e[0],e[1]);});

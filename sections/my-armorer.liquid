  <script>window.GL_LOCALE = {{ request.locale.iso_code | json }};</script>
  <script>
    // Same locale-aware value translation classifieds.liquid uses for
    // firearm type/subtype (canonicalise to English, then render in the
    // active locale — storage language is irrelevant either way).
    window.GLI18n = window.GLI18n || (function () {
      {% render 'gl-ads-value-translations' %}

      var ES_TO_EN = {};
      Object.keys(EN_TO_ES).forEach(function (en) {
        var es = EN_TO_ES[en];
        if (!(es in ES_TO_EN)) ES_TO_EN[es] = en;
      });
      // My Gun Safe stores this one without the hyphen ("Semi nuevo") while the
      // ad system stores it with one ("Semi-nuevo") — accept both as the same
      // canonical "Nearly New" rather than leaving My Gun Safe's spelling untranslated.
      ES_TO_EN['Semi nuevo'] = 'Nearly New';

      function locale() {
        var l = (window.GL_LOCALE || '').toLowerCase();
        return l === 'en' ? 'en' : 'es';
      }

      function canonical(value) {
        if (value == null) return '';
        var v = String(value).trim();
        if (EN_TO_ES.hasOwnProperty(v)) return v;
        if (ES_TO_EN.hasOwnProperty(v)) return ES_TO_EN[v];
        return v;
      }

      function t(value, loc) {
        var target = loc || locale();
        var canon  = canonical(value);
        if (target === 'en') return canon;
        return EN_TO_ES.hasOwnProperty(canon) ? EN_TO_ES[canon] : canon;
      }

      return { t: t, canonical: canonical, locale: locale };
    })();

    // Applies GLI18n translation to every rendered card field marked with
    // gl-i18n-value (type/subtype/status). Accepts an optional root so any
    // future code that inserts a card without a full page reload can
    // re-run this for just that new card. Safe to call repeatedly.
    function applyGlI18n(root) {
      (root || document).querySelectorAll('.gl-i18n-value').forEach(function (el) {
        var raw = el.textContent.trim();
        if (!raw) return;
        el.textContent = window.GLI18n.t(raw);
      });
    }
    document.addEventListener('DOMContentLoaded', function () { applyGlI18n(); });
  </script>

  <script>

{% if blog.articles_count > 1 %}
<div class="related-blogs section-{{ section.id }}">

  <div class="container">
    <h2 class="related-heading">
      {{ section.settings.heading }}
    </h2>

    <div class="resource-list resource-list--grid">

      {% assign count = 0 %}

      {% for related in blog.articles %}

        {% if related.handle != article.handle %}

        <div class="resource-list__item">

          <div class="featured-blog-posts-card spacing-style border-style">

            <a class="featured-blog-posts-card__link" href="{{ related.url }}">
              <span class="visually-hidden">{{ related.title }}</span>
            </a>

            <div class="featured-blog-posts-card__inner">

              <!-- IMAGE -->
              <div class="blog-image-wrapper">

                {% if related.tags.size > 0 %}
                <div class="blog-card__tags">
                  <span class="blog-tag">
                    {{ related.tags.first }}
                  </span>
                </div>
                {% endif %}

                {% if related.image %}
                <div class="image-block resource-image featured-blog-posts-card__image">
                  {{ related.image 
                    | image_url: width: 1200 
                    | image_tag: 
                        loading: 'lazy',
                        class: 'image-block__image',
                        sizes: '(min-width: 750px) 25vw, 100vw'
                  }}
                </div>
                {% endif %}

              </div>

              <!-- CONTENT -->
              <div class="featured-blog-posts-card__content layout-panel-flex--column">

                <h4>{{ related.title }}</h4>

                <div class="blog-post-card__content-text">
                  {{ related.excerpt 
                    | default: related.content 
                    | strip_html 
                    | truncate: 160 }}
                </div>

                <a href="{{ related.url }}" class="button button-secondary text-block">
                  {{ 'custom.read_article' | t }}
                </a>

              </div>

            </div>

          </div>

        </div>

        {% assign count = count | plus: 1 %}
        {% if count == section.settings.posts_to_show %}
          {% break %}
        {% endif %}

        {% endif %}

      {% endfor %}

    </div>
  </div>
</div>
{% endif %}


{% schema %}
{
  "name": "Related Blogs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Articles"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Posts to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Related Blogs"
    }
  ]
}
{% endschema %}
<script>
(function() {
  // ============================================================
  // CONTACT FORM (EN) TRANSLATION — NOT Shopify's translation system
  // ------------------------------------------------------------
  // This form is rendered by the "Powerful Contact Form Builder" app
  // (free tier), which has no built-in multi-language support. The
  // form's actual text (labels, placeholder, submit button, success/
  // thank-you message) is set in Spanish inside that app's own admin
  // settings — it is NOT in this theme and NOT in es.json/en.default.json.
  //
  // Because of that, this script does exact-string find/replace on the
  // rendered form's DOM to fake an English version: it looks for the
  // literal Spanish text below and swaps it for the English text next
  // to it. It does not translate a *concept* — it translates the exact
  // characters currently entered in the form builder app.
  //
  // WHAT THIS MEANS IN PRACTICE: if the Spanish text is ever edited in
  // the Powerful Contact Form Builder app's settings — a single label,
  // the placeholder, the submit button, or the success message — the
  // key below stops matching, and the English site will silently keep
  // showing the OLD Spanish text (no error, no warning). Whoever edits
  // that app's content must also update the matching key/value pair
  // here, using the exact new Spanish text as the key.
  // ============================================================
  const locale = Shopify.locale || document.documentElement.lang || 'es';
  if (!locale.startsWith('en')) return;

  const fieldTranslations = {
    'Nombre': 'Name',
    'Correo': 'Email',
    'Teléfono': 'Phone',
    'Mensaje': 'Message',
    'Aceptar ': 'Accept ',
    'política de privacidad': 'privacy policy',
    'Aceptar política de privacidad': 'Accept privacy policy',  // ← comma was missing here
    'Enviar': 'Send'
  };

  const messageTranslations = {
    '¡Gracias por ponerte en contacto!': 'Thanks for getting in touch!',
    'Gracias por tu mensaje. Nos pondremos en contacto contigo a la mayor brevedad.': 'Thank you for your message. We will get in touch with you as soon as possible.',
    '¡Qué tengas un gran día!': 'Have a great day!'
  };

  function translateTextNodes(el) {
    el.childNodes.forEach(node => {
      if (node.nodeType === Node.TEXT_NODE) {
        const raw = node.textContent;        // ← don't trim, keep the space
        const trimmed = raw.trim();
        // Try exact raw match first, then trimmed
        if (fieldTranslations[raw]) {
          node.textContent = fieldTranslations[raw];
        } else if (fieldTranslations[trimmed]) {
          node.textContent = raw.replace(trimmed, fieldTranslations[trimmed]);
        }
      } else if (node.nodeType === Node.ELEMENT_NODE && node.tagName !== 'A') {
        translateTextNodes(node);
      } else if (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'A') {
        const linkText = node.textContent.trim();
        if (fieldTranslations[linkText]) node.textContent = fieldTranslations[linkText];
      }
    });
  }

  function translateForm(form) {
    // Translate all label spans — simple or complex HTML
    form.querySelectorAll('span.label-content').forEach(el => {
      const plainText = el.textContent.trim().replace(/\s+/g, ' ');
      if (el.children.length === 0) {
        if (fieldTranslations[plainText]) el.textContent = fieldTranslations[plainText];
      } else {
        translateTextNodes(el);
      }
    });

    // Translate placeholders
    form.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(el => {
      const ph = el.getAttribute('placeholder');
      if (fieldTranslations[ph]) el.setAttribute('placeholder', fieldTranslations[ph]);
    });

    // Translate submit button
    const submitBtn = form.querySelector('button.submit, button[type="submit"]');
    if (submitBtn && submitBtn.textContent.includes('Enviar')) {
      submitBtn.innerHTML = '<span class="spinner"></span>Send';
    }

    // Translate success message if visible
    const container = form.closest('.globo-form-id-140791') || form.parentElement;
    if (container) {
      const successMsg = container.querySelector('.message.success:not(.hidden)');
      if (successMsg?.offsetParent !== null) {
        const title = successMsg.querySelector('.gfb__content-title');
        if (title) {
          for (let es in messageTranslations) {
            if (title.textContent.includes(es)) title.textContent = messageTranslations[es];
          }
        }
        successMsg.querySelectorAll('.content p').forEach(p => {
          for (let es in messageTranslations) {
            if (p.textContent.includes(es)) p.textContent = messageTranslations[es];
          }
        });
      }
    }
  }

  const observer = new MutationObserver(() => {
    const form = document.querySelector('form[data-id="140791"]');
    if (form) translateForm(form);
  });

  observer.observe(document.body, {
    subtree: true,
    childList: true,
    characterData: true
  });

  const existing = document.querySelector('form[data-id="140791"]');
  if (existing) translateForm(existing);
})();
</script>


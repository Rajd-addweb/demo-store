  <script>
    var BACKEND_URL = 'https://shopify-gunloupe.addwebprojects.com';
    // Seed from the last successfully-fetched rate (cached below) rather
    // than always starting from a fixed constant — if today's refresh is
    // slow or fails, this is still far closer to correct than a rate that
    // was hardcoded once and never updated.
    var EUR_TO_USD = parseFloat(localStorage.getItem('eur_to_usd')) || 1.08;

    // ── Cookie helpers ───────────────────────────────────────────────────
    function setCookie(name, value, days) {
      const expires = new Date();
      expires.setTime(expires.getTime() + days * 24 * 60 * 60 * 1000);
      document.cookie = name + '=' + value + ';expires=' + expires.toUTCString() + ';path=/;SameSite=Lax';
    }

    function getCookie(name) {
      const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      return match ? match[2] : null;
    }

    // ── Exchange rate ────────────────────────────────────────────────────
    // Fetched from our own backend (cached + refreshed daily server-side
    // via cron), not directly from the third-party API — avoids per-visitor
    // browser CORS/ad-blocker/network flakiness.
    async function fetchExchangeRate() {
      try {
        const res = await fetch(BACKEND_URL + '/exchange-rate');
        const data = await res.json();
        EUR_TO_USD = (data && data.rate) || EUR_TO_USD;
        localStorage.setItem('eur_to_usd', EUR_TO_USD);
        updatePrices();
      } catch (err) {
        console.error('Exchange rate fetch failed, using fallback.', err);
      }
    }

    function setCurrency(currency) {
      localStorage.setItem('currency', currency);
      setCookie('gl_currency', currency, 365);
      updatePrices();
      updateActiveState(currency);
      const settingPopup = document.getElementById('settingsPopup');
      if (settingPopup) settingPopup.classList.add('hidden');
    }

    function updatePrices() {
      const currency = localStorage.getItem('currency') || 'EUR';

      document.querySelectorAll('.price').forEach((el) => {
        const basePrice = parseFloat(el.dataset.price);

        if (!basePrice || basePrice === 0) {
          el.innerText = 'N/A';
          return;
        }

        // Ads carry their own entry currency via data-currency; anything
        // without one (catalog/variant prices, favorites) is always EUR.
        const sourceCurrency = el.dataset.currency || 'EUR';
        const amountInEur = sourceCurrency === 'USD' ? basePrice / EUR_TO_USD : basePrice;

        if (currency === 'USD') {
          el.innerText = '$' + Math.round(amountInEur * EUR_TO_USD);
        } else {
          el.innerText = Math.round(amountInEur) + '€';
        }
      });

      // Ad price inputs show the currency inline in their placeholder
      // (e.g. "Precio (EUR) *"), kept in sync with the toggle here.
      document.querySelectorAll('.gl-price-input').forEach((el) => {
        const base = el.dataset.labelBase || '';
        el.placeholder = base + ' (' + currency + ') *';
      });
    }

    function getRawEurPrice(price) {
      if (!price || price === '0' || price === '0.0') return '0';
      const num = parseFloat(price);
      if (isNaN(num) || num === 0) return '0';
      return num > 1000 ? (num / 100).toFixed(0) : num.toFixed(0);
    }

    function updateActiveState(activeCurrency) {
      document.querySelectorAll('.currency-btn').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.currency === activeCurrency);
      });
    }

    document.addEventListener('click', function (e) {
      if (e.target.classList.contains('currency-btn')) {
        setCurrency(e.target.dataset.currency);
      }
    });

    function cmToIn(cm) {
      return Math.round((cm / 2.54) * 10) / 10;
    }

    function kgToLbs(kg) {
      return Math.round((kg * 2.20462) * 100) / 100;
    }

    function shouldConvertText(text) {
      const trimmed = text.trim();
      if (trimmed.includes('/') || trimmed.includes('(')) return false;
      return /^\d+(\.\d+)?\s*(cm|kg)$/i.test(trimmed);
    }

    function applyMeasures(mode) {
      document.querySelectorAll('.measure-val').forEach(function (el) {
        const original = el.dataset.original;
        if (!original) return;

        if (mode === 'imperial') {
          const cmMatch = original.match(/^(\d+(\.\d+)?)\s*cm$/i);
          if (cmMatch) { el.textContent = cmToIn(parseFloat(cmMatch[1])) + 'in'; return; }
          const kgMatch = original.match(/^(\d+(\.\d+)?)\s*kg$/i);
          if (kgMatch) { el.textContent = kgToLbs(parseFloat(kgMatch[1])) + 'lbs'; return; }
        } else {
          el.textContent = original;
        }
      });
    }

    function tagMeasureElements() {
      const selectors = [
        '.product-card_specs_spec-text',
        '.product-table_spec-text',
        '.spec-value',
        'td',
        '.filter-item span',
        '.gl-filters .filter-item span'
      ];

      selectors.forEach(function (sel) {
        document.querySelectorAll(sel).forEach(function (el) {
          if (el.querySelector('.measure-val')) return;
          if (el.children.length > 0) return;

          const text = el.textContent.trim();
          if (!shouldConvertText(text)) return;

          el.innerHTML = '<span class="measure-val" data-original="' + text + '">' + text + '</span>';
        });
      });
    }

    function setMeasures(mode) {
      localStorage.setItem('measures', mode);
      setCookie('gl_measures', mode, 365);

      document.querySelectorAll('.measures-btn').forEach(function (btn) {
        btn.classList.toggle('active', btn.dataset.measures === mode);
      });

      tagMeasureElements();
      applyMeasures(mode);
    }

    function initMeasures() {
      const cookieMeasures = getCookie('gl_measures');
      const saved = cookieMeasures || localStorage.getItem('measures') || 'metric';

      localStorage.setItem('measures', saved);
      setCookie('gl_measures', saved, 365);

      document.querySelectorAll('.measures-btn').forEach(function (btn) {
        btn.classList.toggle('active', btn.dataset.measures === saved);
      });

      tagMeasureElements();
      if (saved === 'imperial') {
        applyMeasures('imperial');
      }
    }

    document.addEventListener('click', function (e) {
      const btn = e.target.closest('.measures-btn');
      if (!btn) return;
      setMeasures(btn.dataset.measures);
    });

    window.GunloupeRetag = function () {
      const saved = localStorage.getItem('measures') || 'metric';
      tagMeasureElements();
      if (saved === 'imperial') applyMeasures('imperial');
      // Newly-inserted cards (infinite scroll, search results, sort)
      // arrive with raw server-rendered EUR prices — re-apply the
      // selected currency + the zero-price → N/A rule to them too.
      // Every call site that injects product cards already calls
      // GunloupeRetag(), so this is the single place needed to fix it.
      updatePrices();
    };

    document.addEventListener('DOMContentLoaded', function () {
      const cookieCurrency = getCookie('gl_currency');
      const savedCurrency = cookieCurrency || localStorage.getItem('currency') || 'EUR';

      localStorage.setItem('currency', savedCurrency);
      setCookie('gl_currency', savedCurrency, 365);

      updateActiveState(savedCurrency);
      setTimeout(() => {updatePrices();}, 100);
      document.body.setAttribute('data-currency', savedCurrency);
      fetchExchangeRate();
      initMeasures();
    });

    (function () {
      const url = new URL(window.location.href);
      if (url.searchParams.has('country')) {
        url.searchParams.delete('country');
        window.history.replaceState({}, document.title, url.pathname + (url.search || ''));
      }
    })();
  </script>


<div class="custom-header">
  <div class="container">
    <div class="custom-header-wrapper" {% if customer %} style="grid-template-columns: minmax(14%, 6rem) 40%;"{% endif %}>
      <!-- Logo -->
      <a href="{{ request.locale.root_url }}" class="logo">
        {{ settings.logo | image_url: width: 180 | image_tag: width: 180, height: 60 }}
      </a>

      <!-- Nav -->
      <nav class="nav desktop-only flex gap-6">
        {% for link in linklists['main-menu'].links %}
          <a href="{{ link.url }}" class="{% if link.active %}active{% endif %}">
            {% case link.handle %}
              {% when 'firearms' %}
                {% render 'icon-firearm' %}
              {% when 'armas' %}
                {% render 'icon-firearm' %}

              {% when 'classifieds' %}
                {% render 'icon-classified' %}
              {% when 'clasificados' %}
                {% render 'icon-classified' %}

              {% when 'blog' %}
                {% render 'icon-blog' %}

              {% when 'help' %}
                {% render 'icon-help' %}
              {% when 'ayuda' %}
                {% render 'icon-help' %}

              {% when 'about-us' %}
                {% render 'icon-aboutus' %}
              {% when 'quienes-somos' %}
                {% render 'icon-aboutus' %}
            {% endcase %}
            <span>{{ link.title }}</span>
          </a>
        {% endfor %}
      </nav>

      <!-- Right -->
      <div class="nav-right flex items-center gap-4">
        <div class="header-search-only">
          <div class="home-product-search-wrapper">
            <div class="form_field-wrapper">
              <div class="form_field-input-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 512 512" fill="none"
                  preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                  <g clip-path="url(#clip0_4162_4606)">
                    <path
                      d="M416 208C416 253.9 401.1 296.3 376 330.7L502.6 457.4C515.1 469.9 515.1 490.2 502.6 502.7C490.1 515.2 469.8 515.2 457.3 502.7L330.7 376C296.3 401.2 253.9 416 208 416C93.1 416 0 322.9 0 208C0 93.1 93.1 0 208 0C322.9 0 416 93.1 416 208ZM208 352C226.91 352 245.636 348.275 263.106 341.039C280.577 333.802 296.452 323.195 309.823 309.823C323.195 296.452 333.802 280.577 341.039 263.106C348.275 245.636 352 226.91 352 208C352 189.09 348.275 170.364 341.039 152.894C333.802 135.423 323.195 119.548 309.823 106.177C296.452 92.805 280.577 82.198 263.106 74.9613C245.636 67.7247 226.91 64 208 64C189.09 64 170.364 67.7247 152.894 74.9613C135.423 82.198 119.548 92.805 106.177 106.177C92.805 119.548 82.198 135.423 74.9613 152.894C67.7247 170.364 64 189.09 64 208C64 226.91 67.7247 245.636 74.9613 263.106C82.198 280.577 92.805 296.452 106.177 309.823C119.548 323.195 135.423 333.802 152.894 341.039C170.364 348.275 189.09 352 208 352Z"
                      fill="currentColor"></path>
                  </g>
                </svg>
              </div>
              
              <form action="{% if request.locale.iso_code == 'en' %}/en/collections/firearms{% else %}/collections/armas{% endif %}" method="get" class="mobile-search-form home-product-search__input">
                <input 
                  type="text" 
                  name="q" 
                  placeholder=" " 
                  required
                />
                <label class="form_label avsd">{{ 'content.search' | t }}</label>

                <button class="header-search-btn" type="submit">
                  <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 512 512" fill="none"
                    preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                    <g clip-path="url(#clip0_4162_4606)">
                      <path
                        d="M416 208C416 253.9 401.1 296.3 376 330.7L502.6 457.4C515.1 469.9 515.1 490.2 502.6 502.7C490.1 515.2 469.8 515.2 457.3 502.7L330.7 376C296.3 401.2 253.9 416 208 416C93.1 416 0 322.9 0 208C0 93.1 93.1 0 208 0C322.9 0 416 93.1 416 208ZM208 352C226.91 352 245.636 348.275 263.106 341.039C280.577 333.802 296.452 323.195 309.823 309.823C323.195 296.452 333.802 280.577 341.039 263.106C348.275 245.636 352 226.91 352 208C352 189.09 348.275 170.364 341.039 152.894C333.802 135.423 323.195 119.548 309.823 106.177C296.452 92.805 280.577 82.198 263.106 74.9613C245.636 67.7247 226.91 64 208 64C189.09 64 170.364 67.7247 152.894 74.9613C135.423 82.198 119.548 92.805 106.177 106.177C92.805 119.548 82.198 135.423 74.9613 152.894C67.7247 170.364 64 189.09 64 208C64 226.91 67.7247 245.636 74.9613 263.106C82.198 280.577 92.805 296.452 106.177 309.823C119.548 323.195 135.423 333.802 152.894 341.039C170.364 348.275 189.09 352 208 352Z"
                        fill="currentColor"></path>
                    </g>
                  </svg>
                </button>
              </form>
            </div>
          </div>
        </div>
        {% if customer %}
          <!-- User -->
          <div class="user-wrap relative">
            <button id="userToggle" class="user-btn">
              {% if customer.metafields.custom.profile_picture.value != blank %}
              <img
                src="{{ customer.metafields.custom.profile_picture.value }}"
                alt="{{ customer.first_name }}"
                class="user-avatar-img"
                width="32"
                height="32"
                style="width: 32px; height: 32px; border: 1px solid var(--color-foreground); border-radius: 50%; object-fit: cover;"
              >
            {% else %}
              {% render "icon-profile" %}
            {% endif %}
            {% assign user_type = customer.metafields.custom.user_type.value %}
            {% if user_type == 'business' %}
              <div class="user-btn-name">{{ customer.metafields.custom.shop_name.value | default: customer.email | split: '@' | first }}</div>
            {% elsif customer.first_name != blank or customer.last_name != blank %}
              <div class="user-btn-name">{{ customer.first_name }}</div>
            {% else %}
              <div class="user-btn-name">{{ customer.email | split: '@' | first }}</div>
            {% endif %}
              {% render 'icon-arrowdown' %}
            </button>

            {% render 'header-user-popup' %}
          </div>

        {% else %}
          <!-- Plain login button — no dropdown needed -->
          <div class="login-wrap">
            <a href="{{ routes.storefront_login_url }}" class="button bg-color-orange is-small login-entry-btn">
              {{ 'customer.login' | t }}
            </a>
          </div>
        {% endif %}

        <!-- Settings -->
        <div class="setting-wrapper relative">
          <button id="settingsToggle" class="icon-btn">
            {% render 'icon-setting' %}
          </button>
          {% render 'header-settings-popup' %}
        </div>
        <div class="mobile-only hamburger">
          {% render 'icon-hamburger' %}
        </div>
      </div>
    </div>
  </div>
</div>


<style>
/* ============================================================
   LOGIN ENTRY POINT — Private / Business Dropdown
   Add this to your theme.css or the header section styles
   ============================================================ */
 
.login-wrap {
  position: relative;
  display: inline-block;
}
 
/* The dropdown panel */
.login-type-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  background: var(--color-background, #fff);
  border: 1px solid var(--color-border, #e5e5e5);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  min-width: 200px;
  z-index: 9999;
  overflow: hidden;
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
 
/* Each option button */
.login-type-option {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  padding: 10px 14px;
  background: transparent;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  text-align: left;
  width: 100%;
  transition: background 0.15s ease;
}
 
.login-type-option:hover {
  background: var(--color-background-secondary, #f5f5f5);
}
 
.login-type-icon {
  font-size: 1.1rem;
  margin-bottom: 2px;
}
 
.login-type-label {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--color-foreground, #1a1a1a);
  line-height: 1.2;
}
 
.login-type-desc {
  font-size: 0.75rem;
  color: var(--color-foreground-secondary, #888);
  line-height: 1.2;
}
 
/* Mobile: make dropdown full-width friendly */
@media (max-width: 768px) {
  .login-type-dropdown {
    right: auto;
    left: 0;
    min-width: 180px;
  }
}
 
</style>

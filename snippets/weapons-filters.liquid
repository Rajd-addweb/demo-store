  /* SKELETON LOADER — shown while Storefront API fetches real min/max */
  .peso-skeleton {
    padding: 15px 0;
  }

  .peso-skeleton-track {
    height: 6px;
    border-radius: 3px;
    margin-bottom: 15px;
    background: linear-gradient(90deg, #e0e0e0 25%, #ececec 37%, #e0e0e0 63%);
    background-size: 400% 100%;
    animation: peso-shimmer 1.4s ease infinite;
  }

  .peso-skeleton-labels {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 10px;
  }

  .peso-skeleton-pill {
    display: inline-block;
    width: 40px;
    height: 14px;
    border-radius: 7px;
    background: linear-gradient(90deg, #e0e0e0 25%, #ececec 37%, #e0e0e0 63%);
    background-size: 400% 100%;
    animation: peso-shimmer 1.4s ease infinite;
  }

  @keyframes peso-shimmer {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
  }
</style>

<script>
(function() {
  'use strict';
  
  const MEASUREMENT_KEY = 'gunloupe_measurement_unit';
  const getStoredUnit = () => localStorage.getItem(MEASUREMENT_KEY) || 'metric';
  const setStoredUnit = (unit) => localStorage.setItem(MEASUREMENT_KEY, unit);
  
  // Measurement toggle
  const toggleMeasurement = (unit) => {
    const kgSlider = document.querySelector('[data-filter-peso-kg-slider]');
    const lbsSlider = document.querySelector('[data-filter-peso-pounds-slider]');
    
    if (kgSlider && lbsSlider) {
      if (unit === 'metric') {
        kgSlider.style.display = 'block';
        lbsSlider.style.display = 'none';
      } else if (unit === 'imperial') {
        kgSlider.style.display = 'none';
        lbsSlider.style.display = 'block';
      }
    }
  };
  
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-measures]');
    if (!btn) return;
    
    const unit = btn.getAttribute('data-measures');
    if (unit === 'metric' || unit === 'imperial') {
      setStoredUnit(unit);
      toggleMeasurement(unit);
      
      document.querySelectorAll('[data-measures]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }
  });
  
  setTimeout(() => toggleMeasurement(getStoredUnit()), 100);

  // Toggle open/close for peso dropdowns (mirrors data-toggle-price behavior)
  document.addEventListener('click', function (e) {
    var toggleBtn = e.target.closest('.filter-group[data-filter-peso-kg-slider] [data-toggle-filter], .filter-group[data-filter-peso-pounds-slider] [data-toggle-filter]');
    if (!toggleBtn) return;
    var panel = toggleBtn.parentElement.querySelector('[data-peso-content]');
    if (!panel) return;
    var isOpen = panel.style.display !== 'none';
    panel.style.display = isOpen ? 'none' : 'block';
    toggleBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Range slider handler - REAL-TIME FILTERING ON DRAG
  const initRangeSlider = async (widget) => {
    if (!widget) return;
    
    const minInput = widget.querySelector('[data-range-min]');
    const maxInput = widget.querySelector('[data-range-max]');
    const displayMin = widget.querySelector('[data-peso-min-display]');
    const displayMax = widget.querySelector('[data-peso-max-display]');
    const progress = widget.querySelector('[data-slider-progress]');
    const paramName = widget.getAttribute('data-param-name');
    const filterGroup = widget.closest('.filter-group');
    const button = filterGroup.querySelector('.filter-toggle');
    const label = button.querySelector('[data-peso-label]');
    const contentPanel = filterGroup.querySelector('[data-peso-content]');
    const pesoType = filterGroup.getAttribute('data-peso-type'); // 'kg' or 'pounds'
    const skeleton = contentPanel ? contentPanel.querySelector('[data-peso-skeleton]') : null;

    const urlParams = new URLSearchParams(window.location.search);
    const activeUrlValues = urlParams.getAll(paramName).map(v => parseFloat(v)).filter(v => !isNaN(v));
    const hasActive = activeUrlValues.length > 0;

    let allValues = Array.from(document.querySelectorAll(`input[name="${paramName}"]`))
      .map(inp => parseFloat(inp.value))
      .filter(v => !isNaN(v))
      .sort((a, b) => a - b);

    // If native values are missing, fall back to the widget's own data attrs
    if (!allValues.length) {
      const dMin = parseFloat(widget.getAttribute('data-min'));
      const dMax = parseFloat(widget.getAttribute('data-max'));
      if (!isNaN(dMin) && !isNaN(dMax)) allValues = [dMin, dMax];
    }

    let realMin = allValues[0];
    let realMax = allValues[allValues.length - 1];

    // The Liquid-rendered data-min/data-max are scoped to whatever OTHER
    // filters are currently active (e.g. Modalidad/Tipo/Sub-tipo), so they
    // can be much narrower than the true collection-wide range. Widen the
    // fallback bounds to at least cover the actually-selected values —
    // otherwise setting maxInput.max below the real selected value clamps
    // maxInput.value down to that narrow max the instant it's assigned
    // below (native <input type="range"> behavior), and the slider ends up
    // showing/selecting the wrong (narrowed) max until the async Storefront
    // API fetch corrects it moments later.
    if (hasActive) {
      realMin = Math.min(realMin, ...activeUrlValues);
      realMax = Math.max(realMax, ...activeUrlValues);
    }

    // Re-apply the true min/max discovered from the Storefront API
    // (the Liquid-rendered min/max was capped by Shopify's 100-value filter limit)
    minInput.min = realMin;
    minInput.max = realMax;
    maxInput.min = realMin;
    maxInput.max = realMax;

    if (hasActive) {
        minInput.value = Math.min(...activeUrlValues);
        maxInput.value = Math.max(...activeUrlValues);
    } else {
        minInput.value = realMin;
        maxInput.value = realMax;
    }

    // Wire up the "Reset" link — build its href by stripping every instance
    // of this filter's param from the current URL (equivalent to Shopify's
    // native filter.url_to_remove, but computed client-side so it works
    // regardless of whether Shopify's Liquid object recognized the value).
    const resetWrapper = contentPanel ? contentPanel.querySelector('[data-peso-reset]') : null;
    const resetLink = contentPanel ? contentPanel.querySelector('[data-peso-reset-link]') : null;
    if (resetWrapper && resetLink) {
      if (hasActive) {
        resetWrapper.style.display = 'block';
        const removeUrl = new URL(window.location.href);
        const remaining = [];
        urlParams.forEach((v, k) => { if (k !== paramName) remaining.push([k, v]); });
        removeUrl.search = new URLSearchParams(remaining).toString();
        resetLink.href = removeUrl.toString();
      } else {
        resetWrapper.style.display = 'none';
      }
    }
    
    const updateDisplay = (showLabel) => {
      const min = parseFloat(minInput.value);
      const max = parseFloat(maxInput.value);

      // These sit at the fixed ends of the track, like axis labels — they
      // represent the slider's real min/max (e.g. 0.6 - 108.5) and must
      // stay put no matter what's selected. The current selection is
      // shown separately, in the label above and the active-filter chip.
      displayMin.textContent = parseFloat(minInput.min).toFixed(1);
      displayMax.textContent = parseFloat(maxInput.max).toFixed(1);

      if (label) {
        if (showLabel) {
          label.textContent = min.toFixed(1) + ' - ' + max.toFixed(1);
          label.style.display = '';
        } else {
          label.style.display = 'none';
        }
      }
      // Toggle the same class the other filters use so the floating
      // title shrinks/moves up and makes room for the value line below
      // it — without this the title paints over the range label.
      filterGroup.classList.toggle('withSelectedValue', showLabel);

      const minVal = parseFloat(minInput.min);
      const maxVal = parseFloat(minInput.max);
      const minPercent = ((min - minVal) / (maxVal - minVal)) * 100;
      const maxPercent = ((max - minVal) / (maxVal - minVal)) * 100;
      
      progress.style.left = minPercent + '%';
      progress.style.right = (100 - maxPercent) + '%';
    };

    const applyFilter = () => {
      const min = parseFloat(minInput.value);
      const max = parseFloat(maxInput.value);
      
      const params = new URLSearchParams(window.location.search);
      
      // Remove existing params
      let keysToDelete = [];
      for (let key of params.keys()) {
        if (key === paramName) keysToDelete.push(key);
      }
      keysToDelete.forEach(key => params.delete(key));
      
      // Add values in range
      const valuesInRange = allValues.filter(v => v >= min && v <= max);
      valuesInRange.forEach(val => {
        params.append(paramName, val);
      });
      
      window.location.href = window.location.pathname + '?' + params.toString();
    };

    minInput.addEventListener('input', () => {
      if (parseFloat(minInput.value) > parseFloat(maxInput.value)) {
        minInput.value = maxInput.value;
      }
      updateDisplay(true);
    });

    maxInput.addEventListener('input', () => {
      if (parseFloat(maxInput.value) < parseFloat(minInput.value)) {
        maxInput.value = minInput.value;
      }
      updateDisplay(true);
    });

    minInput.addEventListener('change', applyFilter);
    maxInput.addEventListener('change', applyFilter);

    updateDisplay(hasActive);

    window.pesoValuesPromise.then(allData => {
      const apiValues = pesoType === 'kg' ? allData.kg : allData.lbs;
      if (!apiValues || !apiValues.length) return;
      allValues = apiValues;
      realMin = apiValues[0];
      realMax = apiValues[apiValues.length - 1];
      if (hasActive) {
        realMin = Math.min(realMin, ...activeUrlValues);
        realMax = Math.max(realMax, ...activeUrlValues);
      }
      minInput.min = realMin; minInput.max = realMax;
      maxInput.min = realMin; maxInput.max = realMax;
      // Swap skeleton out, real slider in — done all at once so nothing "jumps"
      if (skeleton) skeleton.style.display = 'none';
      widget.style.display = 'block';
      if (hasActive) {
        minInput.value = Math.min(...activeUrlValues);
        maxInput.value = Math.max(...activeUrlValues);
      } else {
        minInput.value = realMin;
        maxInput.value = realMax;
      }
      updateDisplay(hasActive);
    }).catch(() => {});

    // ---- Fix overlapping thumbs: raise whichever thumb is nearer the press,
    // so grabbing the max thumb never drags the min thumb (and vice-versa).
    const inputsWrap = widget.querySelector('.range-inputs-wrap');
    if (inputsWrap) {
      inputsWrap.addEventListener('pointerdown', (e) => {
        const rect = inputsWrap.getBoundingClientRect();
        const lo = parseFloat(minInput.min), hi = parseFloat(minInput.max);
        const pressVal = lo + ((e.clientX - rect.left) / rect.width) * (hi - lo);
        const distMin = Math.abs(pressVal - parseFloat(minInput.value));
        const distMax = Math.abs(pressVal - parseFloat(maxInput.value));
        if (distMax <= distMin) { maxInput.style.zIndex = 5; minInput.style.zIndex = 4; }
        else { minInput.style.zIndex = 5; maxInput.style.zIndex = 4; }
      });
    }
  };

  // Initialize all range sliders (async — waits on Storefront API data)
  document.querySelectorAll('[data-peso-range-widget]').forEach(w => initRangeSlider(w));
})();
</script>

<script>
  window.GunloupeConfig = {
    currencySymbol: {{ localization.country.currency.symbol | json }},
    currencyDecimals: 2
  };
</script>

<script>
  (function () {
    'use strict';

    var SYMBOL = (window.GunloupeConfig || {}).currencySymbol || '€';

    function centsToParam(cents) {
      var euros = cents / 100;
      var fixed = euros.toFixed(2);
      var parts = fixed.split('.');
      parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      return parts.join(',');
    }

    function formatPriceDisplay(cents) {
      return centsToParam(cents) + SYMBOL;
    }

    function updatePriceVisuals(widget) {
      var rMin = widget.querySelector('[data-range-min]');
      var rMax = widget.querySelector('[data-range-max]');
      var prog = widget.querySelector('[data-slider-progress]');
      var dMin = widget.querySelector('[data-price-min-display]');
      var dMax = widget.querySelector('[data-price-max-display]');
      var absMax = parseInt(widget.dataset.max, 10);
      var lo = parseInt(rMin.value, 10);
      var hi = parseInt(rMax.value, 10);

      prog.style.left = (lo / absMax) * 100 + '%';
      prog.style.right = ((absMax - hi) / absMax) * 100 + '%';
      if (dMin) dMin.textContent = formatPriceDisplay(lo);
      if (dMax) dMax.textContent = formatPriceDisplay(hi);

      var isDefault = lo <= 0 && hi >= absMax;
      var group = widget.closest('.filter-group');
      if (group) group.classList.toggle('withSelectedValue', !isDefault);

      var priceGroup = widget.closest('[data-price-filter]');
      var label = priceGroup && priceGroup.querySelector('[data-price-label]');
      if (label) {
        label.style.display = isDefault ? 'none' : '';
        if (!isDefault) label.textContent = formatPriceDisplay(lo) + ' – ' + formatPriceDisplay(hi);
      }
    }

    function applyPriceFilter(widget) {
      var rMin = widget.querySelector('[data-range-min]');
      var rMax = widget.querySelector('[data-range-max]');
      var absMax = parseInt(widget.dataset.max, 10);
      var lo = parseInt(rMin.value, 10);
      var hi = parseInt(rMax.value, 10);
      if (lo > hi) { lo = hi; rMin.value = lo; }

      var params = new URLSearchParams(window.location.search);
      params.delete('filter.v.price.gte');
      params.delete('filter.v.price.lte');
      if (!(lo <= 0 && hi >= absMax)) {
        params.set('filter.v.price.gte', centsToParam(lo));
        params.set('filter.v.price.lte', centsToParam(hi));
      }
      window.location.href = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
    }

    function initPriceSlider(widget) {
      if (widget._ready) return;
      widget._ready = true;
      var rMin = widget.querySelector('[data-range-min]');
      var rMax = widget.querySelector('[data-range-max]');
      if (widget.dataset.currentMin) rMin.value = widget.dataset.currentMin;
      if (widget.dataset.currentMax) rMax.value = widget.dataset.currentMax;
      updatePriceVisuals(widget);

      var dragging = false;
      widget.querySelector('.range-inputs-wrap').addEventListener('pointerdown', function () {
        dragging = true;
        var group = widget.closest('.filter-group');
        if (group) group.classList.add('withSelectedValue');
      });
      rMin.addEventListener('input', function () {
        if (parseInt(rMin.value) > parseInt(rMax.value)) rMin.value = rMax.value;
        updatePriceVisuals(widget);
      });
      rMax.addEventListener('input', function () {
        if (parseInt(rMax.value) < parseInt(rMin.value)) rMax.value = rMin.value;
        updatePriceVisuals(widget);
      });
      window.addEventListener('pointerup', function () {
        if (!dragging) return;
        dragging = false;
        setTimeout(function () { applyPriceFilter(widget); }, 0);
      });
    }

    if (!document._gunloupeToggles) {
      document._gunloupeToggles = true;
      document.addEventListener('click', function (e) {
        var tp = e.target.closest('[data-toggle-price]');
        if (tp) {
          var panel = tp.nextElementSibling;
          if (panel && panel.hasAttribute('data-price-content')) {
            var open = panel.style.display !== 'none';
            panel.style.display = open ? 'none' : 'block';
            tp.setAttribute('aria-expanded', String(!open));
            if (!open) {
              var w = panel.querySelector('[data-price-range-widget]');
              if (w) initPriceSlider(w);
            }
          }
          return;
        }
      });
    }

    function boot() {
      document.querySelectorAll('[data-price-range-widget]').forEach(function (w) {
        var panel = w.closest('[data-price-content]');
        if (!panel || panel.style.display !== 'none') initPriceSlider(w);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    window.GunloupeFilters = window.GunloupeFilters || {};
    window.GunloupeFilters.init = boot;
  })();
</script>

{%- comment -%}
  TEMPORARY (this sprint) companion to the Peso "show as a normal filter"
  change above. Before that change, only one of Peso (kg) / Peso (pounds)
  ever appeared, toggled by the metric/imperial switch in the account menu
  — that old logic lived inside the (now bypassed) slider script earlier in
  this file and only knows about the slider's own [data-filter-peso-*-slider]
  markup, so it no longer finds anything to toggle. This restores the same
  single-choice behavior for the plain filter-group version instead, via the
  [data-gl-peso-unit] marker added above. Reads the SAME localStorage/cookie
  key ('measures' / 'gl_measures') the site-wide Idioma/Medidas/Moneda popup
  already writes to (see layout/theme.liquid), so it stays in sync with it.
  Safe to delete this whole block once the slider (and its own toggle) comes
  back next sprint — at that point neither Peso filter-group will carry
  data-gl-peso-unit any more, so this script simply has nothing to do.
{%- endcomment -%}
<script>
(function () {
  'use strict';

  function getCookie(name) {
    var match = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
    return match ? decodeURIComponent(match.pop()) : null;
  }

  function currentMeasureUnit() {
    return getCookie('gl_measures') || localStorage.getItem('measures') || 'metric';
  }

  function applyPesoUnitVisibility() {
    var unit = currentMeasureUnit();
    document.querySelectorAll('[data-gl-peso-unit="kg"]').forEach(function (el) {
      el.style.display = unit === 'metric' ? '' : 'none';
    });
    document.querySelectorAll('[data-gl-peso-unit="pounds"]').forEach(function (el) {
      el.style.display = unit === 'imperial' ? '' : 'none';
    });
  }

  applyPesoUnitVisibility();
  document.addEventListener('DOMContentLoaded', applyPesoUnitVisibility);

  // The Idioma/Medidas/Moneda popup's buttons carry data-measures and don't
  // reload the page — react live so switching units updates this instantly.
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-measures]')) {
      setTimeout(applyPesoUnitVisibility, 0);
    }
  });
})();
</script>

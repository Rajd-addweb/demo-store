<!-- PESO RANGE SLIDER WITH STOREFRONT API + REAL-TIME FILTERING -->
<script>
(function() {
  'use strict';
  
  const STOREFRONT_TOKEN = 'cef86b403fa3eef900f70170cec5acb8';
  const SHOP_DOMAIN = 'gunloupe.myshopify.com';
  const API_VERSION = '2024-01';
  
  // Get collection handle from URL
  const collectionHandle = window.location.pathname.split('/')[2];
  
  console.log('Fetching all peso values for collection:', collectionHandle);
  
  async function fetchAllPesoValues() {
    try {
      const pesoKgValues = new Set();
      const pesoLbsValues = new Set();
      let hasNextPage = true;
      let cursor = null;
      
      while (hasNextPage) {
        let query;
        if (cursor) {
          query = `
            query {
              collection(handle: "${collectionHandle}") {
                products(first: 250, after: "${cursor}") {
                  pageInfo {
                    hasNextPage
                    endCursor
                  }
                  edges {
                    node {
                      id
                      variants(first: 100) {
                        edges {
                          node {
                            id
                            metafield(namespace: "custom", key: "peso_kg") {
                              value
                            }
                            metafield2: metafield(namespace: "custom", key: "peso_pounds") {
                              value
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          `;
        } else {
          query = `
            query {
              collection(handle: "${collectionHandle}") {
                products(first: 250) {
                  pageInfo {
                    hasNextPage
                    endCursor
                  }
                  edges {
                    node {
                      id
                      variants(first: 100) {
                        edges {
                          node {
                            id
                            metafield(namespace: "custom", key: "peso_kg") {
                              value
                            }
                            metafield2: metafield(namespace: "custom", key: "peso_pounds") {
                              value
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          `;
        }
        
        const response = await fetch(
          `https://${SHOP_DOMAIN}/api/${API_VERSION}/graphql.json`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Shopify-Storefront-Access-Token': STOREFRONT_TOKEN,
            },
            body: JSON.stringify({ query }),
          }
        );
        
        const data = await response.json();
        
        if (data.errors) {
          console.error('GraphQL Error:', data.errors);
          break;
        }
        
        data.data.collection.products.edges.forEach(productEdge => {
          const product = productEdge.node;
          product.variants.edges.forEach(variantEdge => {
            const variant = variantEdge.node;
            
            if (variant.metafield && variant.metafield.value) {
              pesoKgValues.add(variant.metafield.value);
            }
            if (variant.metafield2 && variant.metafield2.value) {
              pesoLbsValues.add(variant.metafield2.value);
            }
          });
        });
        
        hasNextPage = data.data.collection.products.pageInfo.hasNextPage;
        cursor = data.data.collection.products.pageInfo.endCursor;
        
        await new Promise(resolve => setTimeout(resolve, 300));
      }
      
      const sortedKg = Array.from(pesoKgValues).map(v => parseFloat(v)).sort((a, b) => a - b);
      const sortedLbs = Array.from(pesoLbsValues).map(v => parseFloat(v)).sort((a, b) => a - b);
      
      console.log('All peso kg values:', sortedKg);
      console.log('All peso lbs values:', sortedLbs);
      
      return { kg: sortedKg, lbs: sortedLbs };
    } catch (error) {
      console.error('Fetch error:', error);
      return { kg: [], lbs: [] };
    }
  }
  
  window.pesoValuesPromise = fetchAllPesoValues();
})();
</script>
{%- endcomment -%}

<div class="gl-filters">
  {% for filter in collection.filters %}

    {%- assign has_search = false -%}
    {%- assign is_peso_kg_filter = false -%}
    {%- assign is_peso_pounds_filter = false -%}
    {%- if filter.values.size > 0 -%}
      {%- assign first_param = filter.values[0].param_name | downcase -%}
      {%- if first_param contains 'peso_kg' -%}
        {%- assign is_peso_kg_filter = true -%}
      {%- elsif first_param contains 'peso_pound' or first_param contains 'peso_lbs' -%}
        {%- assign is_peso_pounds_filter = true -%}
      {%- elsif first_param contains 'marca'
          or first_param contains 'modelo'
          or first_param contains 'calibr'
          or first_param contains 'sub_tipo'
          or first_param contains 'modalidad'
          or first_param contains 'tipo_de_culata'
          or first_param contains 'longitud' -%}
        {%- assign has_search = true -%}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      TEMPORARY — THIS SPRINT ONLY: client asked to pull the custom Peso
      (weight) range SLIDER for now, but the filter itself should still
      appear — just rendered like any other filter (plain checkbox list),
      not hidden entirely. Forcing these back to false here (after they were
      just detected above) makes it fall through the elsif chain to the
      generic "else" branch at the bottom of this loop, same as Rosca/
      Cargador extraible/etc. To restore the slider next sprint: delete
      the two "assign ... = false" lines below (and the data-gl-peso-unit
      attribute a few lines down, whose JS toggle becomes redundant once the
      slider's own metric/imperial toggle takes over again) — nothing else
      changed, the kg/lbs slider markup below and the fetchAllPesoValues()
      script above are untouched. `is_actual_peso_kg`/`is_actual_peso_pounds`
      keep track of which one this really is, since the metric/imperial
      switch in the account menu should still show only one at a time even
      in this plain-list form (see the script further down).
    {%- endcomment -%}
    {%- assign is_actual_peso_kg = is_peso_kg_filter -%}
    {%- assign is_actual_peso_pounds = is_peso_pounds_filter -%}
    {%- assign is_peso_kg_filter = false -%}
    {%- assign is_peso_pounds_filter = false -%}

    <div
      class="filter-group {% if has_search %}filter-group--search{% endif %} {% if filter.active_values.size > 0 %}withSelectedValue{% endif %}"
      {% if filter.type == 'price_range' %}data-price-filter{% endif %}
      {% if is_actual_peso_kg %}data-gl-peso-unit="kg"{% endif %}
      {% if is_actual_peso_pounds %}data-gl-peso-unit="pounds"{% endif %}
    >

      {% if filter.type == 'price_range' %}
        {%- assign range_max = filter.range_max | round -%}
        {%- assign price_min = filter.min_value.value | default: 0 | round -%}
        {%- assign price_max = filter.max_value.value | default: range_max | round -%}
        {%- assign price_active = false -%}
        {%- if filter.min_value.value or filter.max_value.value -%}{%- assign price_active = true -%}{%- endif -%}

        <button
          type="button"
          class="filter-toggle price-filter-toggle"
          data-toggle-price
          aria-expanded="{% if price_active %}true{% else %}false{% endif %}"
        >
          <span class="filter-title"><span>{{ filter.label }}</span></span>
          <span class="price-label-display" data-price-label style="{% unless price_active %}display:none;{% endunless %}">
            {%- if price_active -%}
              {{ price_min | divided_by: 100.0 | ceil | prepend: localization.country.currency.symbol }}–
              {{- price_max | divided_by: 100.0 | ceil | prepend: localization.country.currency.symbol }}
            {%- endif -%}
          </span>
          <span class="filter-arrow">{% render 'icon-arrow-down-border' %}</span>
        </button>

        <div class="filter-content" data-price-content style="{% if price_active %}display:block;{% else %}display:none;{% endif %}">
          <div
            class="range-slider"
            data-price-range-widget
            data-min="0"
            data-max="{{ range_max }}"
            data-current-min="{{ price_min }}"
            data-current-max="{{ price_max }}"
          >
            <div class="slider-track">
              <div class="slider-progress" data-slider-progress></div>
            </div>
            <div class="range-inputs-wrap">
              <input type="range" class="range-min" data-range-min min="0" max="{{ range_max }}" value="{{ price_min }}" step="1" aria-label="Minimum price">
              <input type="range" class="range-max" data-range-max min="0" max="{{ range_max }}" value="{{ price_max }}" step="1" aria-label="Maximum price">
            </div>
            <div class="range-values-display">
              <span data-price-min-display></span>
              <span data-price-max-display></span>
            </div>
          </div>
          
          {% if price_active %}
            <div class="filter-reset">
              <a class="button button-secondary text-block" href="{{ filter.url_to_remove }}"></a>
            </div>
          {% endif %}
        </div>

      {%- elsif is_peso_kg_filter -%}
        <!-- PESO KG RANGE SLIDER (METRIC) -->
        <div class="filter-group {% if filter.active_values.size > 0 %}withSelectedValue{% endif %}" data-filter-peso-kg-slider data-peso-type="kg">
          {%- assign kg_values_sorted = filter.values | map: 'value' | sort -%}
          {%- assign kg_min_val = kg_values_sorted[0] | plus: 0.0 -%}
          {%- assign kg_max_val = kg_values_sorted[-1] | plus: 0.0 -%}
          {%- assign current_min = '' -%}
          {%- assign current_max = '' -%}
          {%- if filter.active_values.size > 0 -%}
            {%- assign active_sorted_kg = filter.active_values | map: 'value' | sort -%}
            {%- assign current_min = active_sorted_kg[0] | plus: 0.0 -%}
            {%- assign current_max = active_sorted_kg[-1] | plus: 0.0 -%}
          {%- endif -%}

          <button
            type="button"
            class="filter-toggle"
            data-toggle-filter
            aria-expanded="{% if filter.active_values.size > 0 %}true{% else %}false{% endif %}"
          >
            <span class="filter-title">
              <span>{{ filter.label }}</span>
            </span>
            <span class="filter-selected-values peso-range-label" data-peso-label style="display: none;"></span>
            <span class="filter-arrow">{% render 'icon-arrow-down-border' %}</span>
          </button>

          <div class="filter-content" data-peso-content style="display: none;" data-has-active="{% if current_min != '' %}true{% else %}false{% endif %}">
            <div class="peso-skeleton" data-peso-skeleton>
              <div class="peso-skeleton-track"></div>
              <div class="peso-skeleton-labels">
                <span class="peso-skeleton-pill"></span>
                <span class="peso-skeleton-pill"></span>
              </div>
            </div>
            <div class="range-slider" data-peso-range-widget data-param-name="{{ filter.values[0].param_name }}" data-min="{{ kg_min_val }}" data-max="{{ kg_max_val }}" data-current-min="{{ current_min }}" data-current-max="{{ current_max }}" style="display: none;">
              <div class="slider-track">
                <div class="slider-progress" data-slider-progress></div>
              </div>
              <div class="range-inputs-wrap">
                <input type="range" class="range-min" data-range-min min="{{ kg_min_val }}" max="{{ kg_max_val }}" value="{{ current_min | default: kg_min_val }}" step="0.01" aria-label="Minimum weight">
                <input type="range" class="range-max" data-range-max min="{{ kg_min_val }}" max="{{ kg_max_val }}" value="{{ current_max | default: kg_max_val }}" step="0.01" aria-label="Maximum weight">
              </div>
              <div class="range-values-display">
                <span data-peso-min-display>{{ current_min | default: kg_min_val | round: 1 }}</span>
                <span> - </span>
                <span data-peso-max-display>{{ current_max | default: kg_max_val | round: 1 }}</span>
              </div>
            </div>
            <div class="filter-reset" data-peso-reset style="display: none;">
              <a class="button button-secondary text-block" href="#" data-peso-reset-link>{{ 'actions.reset' | t }}</a>
            </div>
          </div>
        </div>

      {%- elsif is_peso_pounds_filter -%}
        <!-- PESO POUNDS RANGE SLIDER (IMPERIAL) - HIDDEN BY DEFAULT -->
        <div class="filter-group {% if filter.active_values.size > 0 %}withSelectedValue{% endif %}" data-filter-peso-pounds-slider data-peso-type="pounds" style="display: none;">
          {%- assign lbs_values_sorted = filter.values | map: 'value' | sort -%}
          {%- assign lbs_min_val = lbs_values_sorted[0] | plus: 0.0 -%}
          {%- assign lbs_max_val = lbs_values_sorted[-1] | plus: 0.0 -%}
          {%- assign current_min_lbs = '' -%}
          {%- assign current_max_lbs = '' -%}
          {%- if filter.active_values.size > 0 -%}
            {%- assign active_sorted_lbs = filter.active_values | map: 'value' | sort -%}
            {%- assign current_min_lbs = active_sorted_lbs[0] | plus: 0.0 -%}
            {%- assign current_max_lbs = active_sorted_lbs[-1] | plus: 0.0 -%}
          {%- endif -%}

          <button
            type="button"
            class="filter-toggle"
            data-toggle-filter
            aria-expanded="{% if filter.active_values.size > 0 %}true{% else %}false{% endif %}"
          >
            <span class="filter-title">
              <span>{{ filter.label }}</span>
            </span>
            <span class="filter-selected-values peso-range-label" data-peso-label style="display: none;"></span>
            <span class="filter-arrow">{% render 'icon-arrow-down-border' %}</span>
          </button>

          <div class="filter-content" data-peso-content style="display: none;" data-has-active="{% if current_min_lbs != '' %}true{% else %}false{% endif %}">
            <div class="peso-skeleton" data-peso-skeleton>
              <div class="peso-skeleton-track"></div>
              <div class="peso-skeleton-labels">
                <span class="peso-skeleton-pill"></span>
                <span class="peso-skeleton-pill"></span>
              </div>
            </div>
            <div class="range-slider" data-peso-range-widget data-param-name="{{ filter.values[0].param_name }}" data-min="{{ lbs_min_val }}" data-max="{{ lbs_max_val }}" data-current-min="{{ current_min_lbs }}" data-current-max="{{ current_max_lbs }}" style="display: none;">
              <div class="slider-track">
                <div class="slider-progress" data-slider-progress></div>
              </div>
              <div class="range-inputs-wrap">
                <input type="range" class="range-min" data-range-min min="{{ lbs_min_val }}" max="{{ lbs_max_val }}" value="{{ current_min_lbs | default: lbs_min_val }}" step="0.01" aria-label="Minimum weight">
                <input type="range" class="range-max" data-range-max min="{{ lbs_min_val }}" max="{{ lbs_max_val }}" value="{{ current_max_lbs | default: lbs_max_val }}" step="0.01" aria-label="Maximum weight">
              </div>
              <div class="range-values-display">
                <span data-peso-min-display>{{ current_min_lbs | default: lbs_min_val | round: 1 }}</span>
                <span> - </span>
                <span data-peso-max-display>{{ current_max_lbs | default: lbs_max_val | round: 1 }}</span>
                <span> lbs</span>
              </div>
            </div>
            <div class="filter-reset" data-peso-reset style="display: none;">
              <a class="button button-secondary text-block" href="#" data-peso-reset-link>{{ 'actions.reset' | t }}</a>
            </div>
          </div>
        </div>

      {%- elsif has_search -%}
        <div class="filter-header home-product-search-wrapper">
          <div class="form_field-wrapper">
            <div class="form_field-input-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 512 512" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
                <g clip-path="url(#clip0_4162_4606)">
                  <path d="M416 208C416 253.9 401.1 296.3 376 330.7L502.6 457.4C515.1 469.9 515.1 490.2 502.6 502.7C490.1 515.2 469.8 515.2 457.3 502.7L330.7 376C296.3 401.2 253.9 416 208 416C93.1 416 0 322.9 0 208C0 93.1 93.1 0 208 0C322.9 0 416 93.1 416 208ZM208 352C226.91 352 245.636 348.275 263.106 341.039C280.577 333.802 296.452 323.195 309.823 309.823C323.195 296.452 333.802 280.577 341.039 263.106C348.275 245.636 352 226.91 352 208C352 189.09 348.275 170.364 341.039 152.894C333.802 135.423 323.195 119.548 309.823 106.177C296.452 92.805 280.577 82.198 263.106 74.9613C245.636 67.7247 226.91 64 208 64C189.09 64 170.364 67.7247 152.894 74.9613C135.423 82.198 119.548 92.805 106.177 106.177C92.805 119.548 82.198 135.423 74.9613 152.894C67.7247 170.364 64 189.09 64 208C64 226.91 67.7247 245.636 74.9613 263.106C82.198 280.577 92.805 296.452 106.177 309.823C119.548 323.195 135.423 333.802 152.894 341.039C170.364 348.275 189.09 352 208 352Z" fill="currentColor"/>
                </g>
              </svg>
            </div>
            <input type="text" class="filter-search" placeholder=" ">
            <label class="form_label filter-title">
              <span>{{ filter.label }}</span>
              {% if filter.active_values.size > 0 %}({{ filter.active_values.size }}){% endif %}
            </label>
            {% if filter.active_values.size > 0 %}
              <div class="filter-selected-values">
                {% for value in filter.active_values %}
                  <span class="selected-item">
                    {{- value.label -}}
                    {%- unless forloop.last %}, {% endunless -%}
                  </span>
                {% endfor %}
              </div>
            {% endif %}
            <span class="filter-arrow">{% render 'icon-arrow-down-border' %}</span>
          </div>
        </div>
        <div class="filter-content">
          <ul>
            {% for value in filter.values %}
              <li class="filter-item {% if value.active %}is-active{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}">
                <label>
                  <input
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                  >
                  <span>
                    {%- if value.param_name contains 'longitud' and value.label contains 'cm' -%}
                      {%- assign cm_num = value.label | remove: 'cm' | remove: ' ' | plus: 0.0 -%}
                      {%- if cm_num > 0 -%}
                        {%- assign inch_val = cm_num | divided_by: 2.54 | round: 1 -%}
                        {{ value.label }} ({{ inch_val }}in)
                      {%- else -%}
                        {{ value.label }}
                      {%- endif -%}
                      {%- else -%}
                        {{ value.label }}
                    {%- endif -%}
                  </span>
                </label>
              </li>
            {% endfor %}
          </ul>
          {% if filter.active_values.size > 0 %}
            <div class="filter-reset">
              <a class="button button-secondary text-block" href="{{ filter.url_to_remove }}">{{ 'actions.reset' | t }}</a>
            </div>
          {% endif %}
        </div>

      {% else %}
        <button
          type="button"
          class="filter-toggle"
          data-toggle-filter
          aria-expanded="{% if filter.active_values.size > 0 %}true{% else %}false{% endif %}"
        >
          <span class="filter-title">
            <span>{{ filter.label }}</span>
            {% if filter.active_values.size > 0 %}({{ filter.active_values.size }}){% endif %}
          </span>
          {% if filter.active_values.size > 0 %}
            <span class="filter-selected-values">
              {% for value in filter.active_values -%}
                {{- value.label }}{%- unless forloop.last %}, {% endunless -%}
              {%- endfor %}
            </span>
          {% endif %}
          <span class="filter-arrow">{% render 'icon-arrow-down-border' %}</span>
        </button>
        <div class="filter-content">
          {% case filter.type %}
            {% when 'list' %}
              <ul>
                {% for value in filter.values %}
                  <li class="filter-item {% if value.active %}is-active{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}">
                    <label>
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      >
                      <span>{{ value.label }}</span>
                    </label>
                  </li>
                {% endfor %}
              </ul>
          {% endcase %}
          {% if filter.active_values.size > 0 %}
            <div class="filter-reset">
              <a class="button button-secondary text-block" href="{{ filter.url_to_remove }}">{{ 'actions.reset' | t }}</a>
            </div>
          {% endif %}
        </div>
      {% endif %}

    </div>
  {% endfor %}

  {% assign total_active = 0 %}
  {% for filter in collection.filters %}
    {% assign total_active = total_active | plus: filter.active_values.size %}
  {% endfor %}
  <div class="filter-global-reset">
    <button type="button" id="glViewResults" class="button view-results-btn"
      data-label="{{ 'custom.view_results' | t | default: 'Ver resultados' }}">
      {{ 'custom.view_results' | t | default: 'Ver resultados' }}
    </button>
    <a href="{{ collection.url }}" class="button button-secondary text-block reset-all-btn">
       {{ 'custom.reset_all' | t }}{% if total_active > 0 %} ({{ total_active }}){% endif %}
    </a>
  </div>
</div>


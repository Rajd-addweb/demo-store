</style>

<script>
  var STATUS_LABELS = {
    'Nuevo':       '{{ "custom.new" | t }}',
    'Semi-nuevo':  '{{ "custom.nearly_new" | t }}',
    'Usado':       '{{ "custom.used" | t }}',
    'Desactivado': '{{ "custom.deactivated" | t }}'
  };

  var _adNonCatalogueMsg = {{ 'custom.armorer_non_catalogue_msg' | t | json }};

  var _adMismatchMsg = {{ 'custom.armorer_mismatch_msg' | t | json }};

  var adProductFetchGen = 0, adProductFetchDone = false;

  var AVAILABILITY_LABELS = {
    'in_stock':   '{{ "custom.availability_in_stock"   | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" }}',
    'wholesaler': '{{ "custom.availability_wholesaler" | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" }}',
    'on_demand':  '{{ "custom.availability_on_demand"  | t | replace: "&gt;", ">" | replace: "&lt;", "<" | replace: "&amp;", "&" }}'
  };

  var HANDEDNESS_LABELS = {
    'Diestro':     '{{ "custom.gunval_right_handed" | t }}',
    'Zurdo':       '{{ "custom.gunval_left_handed"  | t }}',
    'Ambidiestro': '{{ "custom.gunval_ambidextrous" | t }}'
  };

  // The raw custom.lateralidad product metafield is stored in English
  // (confirmed by the same EN→ES map section.weapons-collection.liquid
  // uses for its filter), but ads store/compare handedness by the Spanish
  // code above — normalize before matching against HANDEDNESS_LABELS.
  var HANDEDNESS_EN_TO_ES = {
    'Right-handed': 'Diestro',
    'Left-handed':  'Zurdo',
    'Ambidextrous': 'Ambidiestro'
  };
  function canonicalHandedness(raw) {
    if (!raw) return '';
    if (HANDEDNESS_LABELS.hasOwnProperty(raw)) return raw;
    return HANDEDNESS_EN_TO_ES[raw] || '';
  }

  var SKIP_ARMORER_CHECK = {{ skip_armorer_check | json }};

  var _FC = {% if request.locale.iso_code == 'en' %}'/en/collections/firearms'{% else %}'/collections/armas'{% endif %};

  var STOREFRONT_TOKEN = 'cef86b403fa3eef900f70170cec5acb8';
  var STOREFRONT_API   = 'https://gunloupe.myshopify.com/api/2024-01/graphql.json';

  var PARAM_TO_KEY = {
    'filter.p.product_type':              'tipo',
    'filter.p.m.custom.sub_tipo_de_arma': 'subtipo',
    'filter.p.m.custom.marca':            'marca',
    'filter.p.m.custom.modelo':           'modelo',
    'filter.v.option.calibre':            'calibre',
    'filter.v.option.Calibre':            'calibre',
    'filter.v.option.caliber':            'calibre'
  };

  var _adLabels = {
    tipo:          {{ 'custom.weapon_type'      | t | json }},
    subtipo:       {{ 'custom.firearm_subtype'  | t | json }},
    marca:         {{ 'custom.brand'            | t | json }},
    modelo:        {{ 'custom.model'            | t | json }},
    calibre:       {{ 'custom.caliber'          | t | json }},
    barrel:        {{ 'custom.barrel_length'    | t | json }},
    handedness:    {{ 'custom.handedness'       | t | json }} + ' *',
    searchModel:   {{ 'custom.search_model'     | t | json }},
    loadingModels: {{ 'custom.loading_products' | t | json }}
  };

  (function () {
    var BACKEND_URL     = 'https://collaboration-assumes-shed-smoke.trycloudflare.com';
    var CUSTOMER_ID     = '{{ customer.id }}';
    var IS_PRIVATE_USER = '{{ customer.metafields.custom.user_type.value }}' !== 'business';
    var _savedAlias     = {{ customer.metafields.custom.alias.value | default: '' | json }};
    var _savedDispPref  = {{ customer.metafields.custom.name_display_preference.value | default: 'full_name' | json }};
    var _chosenAlias    = _savedAlias;
    var CUSTOMER_NAME   = '{{ customer.first_name }} {{ customer.last_name }}';
    var CUSTOMER_EMAIL  = '{{ customer.email }}';
    var THEME_ID        = '{{ theme.id }}';

    // Shared ad-title formatter, rendered by theme.liquid. Guarded the same
    // way this theme guards window.GunloupeRoutes: if the snippet is ever
    // missing, fall back to passing the text through unchanged instead of
    // throwing and taking the whole ad-creation popup down with it. The
    // server normalises firearm_model on write, so the *stored* title stays
    // correct either way — only this popup's preview would show raw text.
    var AdTitle = window.GunloupeAdTitle || {
      build: function (d) {
        d = d || {};
        var m = String(d.model || '').trim();
        var b = String(d.brand || '').trim();
        if (b && m.toLowerCase().indexOf(b.toLowerCase()) !== 0) m = (b + ' ' + m).trim();
        return d.barrel ? m + ' // ' + d.barrel : m;
      },
      normaliseModel:  function (v) { return v == null ? '' : String(v).trim(); },
      normaliseBarrel: function (v) { return v == null ? '' : String(v).trim(); }
    };

    var _brandsCache = null, _calibersCache = null, _catalogueBrandsCache = null;
    var _brandsLoading = false, _calibersLoading = false;
    var _activeCaliberFilter = null;
    var _barrelsCache = null, _barrelsLoading = false;

    var currentSellData = {}, uploadedImages = [], selectedGunStatus = '', selectedAvailability = '', selectedHandedness = '';
    var adMode = 'prefilled';
    var adSf = { tipo: '', subtipo: '', marca: '', modelo: '', calibre: '', barrel: '' };
    var adSelectedProduct = null, adAllProducts = [], adIsFetching = false;
    var adBrandIsCatalogue = false, adFilterFetchGen = 0;

    var notInArmorerOverlay = document.getElementById('not-in-armorer-overlay');
    var addAdOverlay        = document.getElementById('add-ad-overlay');
    var prefillSection      = document.getElementById('ad-prefilled-section');
    var selectionSection    = document.getElementById('ad-selection-section');

    // ────────────────────────────────────────────────────────────────────────
    // Display preference (private users only)
    // ────────────────────────────────────────────────────────────────────────
    function initDisplayPref() {
      var grp = document.getElementById('ad-display-pref-group');
      if (!grp || !IS_PRIVATE_USER) return;
      grp.style.display = '';

      var hint        = document.getElementById('ad-pref-hint');
      var fnWrap      = document.getElementById('ad-pref-fullname-wrap');
      var fnRadio     = document.getElementById('ad-pref-fullname');
      var alWrap      = document.getElementById('ad-pref-alias-wrap');
      var alRadio     = document.getElementById('ad-pref-alias');
      var alInputWrap = document.getElementById('ad-alias-input-wrap');
      var alInput     = document.getElementById('ad-alias-input');

      if (_savedDispPref === 'alias') {
        // Preference already locked in profile — show only alias option (disabled)
        hint.textContent = '{{ "custom.alias_pref_hint_locked" | t: default: "Based on your profile preference, your alias will be displayed on this ad." }}';
        if (fnWrap)  fnWrap.style.display = 'none';
        if (alRadio) { alRadio.checked = true; alRadio.disabled = true; }
        if (alInputWrap) alInputWrap.style.display = '';
        if (alInput) { alInput.value = _savedAlias; alInput.disabled = true; alInput.style.background = '#f9f9f9'; }
      } else {
        // Let user choose
        hint.textContent = '{{ "custom.alias_pref_hint_choose" | t: default: "Choose how your name appears on your classified ads." }}';
        if (fnWrap)  fnWrap.style.display = '';
        if (alWrap)  alWrap.style.display = '';
        if (alRadio) alRadio.disabled = false;
        if (alInput) { alInput.disabled = false; alInput.style.background = ''; }

        // Default: alias selected (privacy-first, per design)
        if (alRadio)     alRadio.checked = true;
        if (alInputWrap) alInputWrap.style.display = '';

        if (_savedAlias) {
          // Alias already exists in profile — show it but lock it.
          // User must go to Edit Profile to change their alias.
          if (alInput) {
            alInput.value            = _savedAlias;
            alInput.disabled         = true;
            alInput.style.background = '#f9f9f9';
            alInput.style.color      = '#5E8263';
          }
        } else {
          // No alias saved yet — user can type one here for the first time
          if (alInput) {
            alInput.disabled         = false;
            alInput.style.background = '';
            alInput.style.color      = '';
          }
        }

        var onFnChange = function () {
          if (fnRadio && fnRadio.checked && alInputWrap) alInputWrap.style.display = 'none';
        };

        var onAlChange = function () {
          if (alRadio && alRadio.checked && alInputWrap) {
            alInputWrap.style.display = '';
            // Keep disabled state consistent when switching back to alias
            if (alInput && _savedAlias) {
              alInput.disabled         = true;
              alInput.style.background = '#f9f9f9';
              alInput.style.color      = '#5E8263';
            }
          }
        };

        if (fnRadio) fnRadio.addEventListener('change', onFnChange);
        if (alRadio) alRadio.addEventListener('change', onAlChange);
      }
    }

    function resetDisplayPref() {
      var grp = document.getElementById('ad-display-pref-group');
      if (grp) grp.style.display = 'none';

      var alInput = document.getElementById('ad-alias-input');
      if (alInput) { alInput.value = ''; alInput.disabled = false; }

      var fnRadio = document.getElementById('ad-pref-fullname');
      var alRadio = document.getElementById('ad-pref-alias');
      if (fnRadio) { fnRadio.checked = false; fnRadio.disabled = false; }
      if (alRadio) { alRadio.checked = false; alRadio.disabled = false; }

      var alWrap = document.getElementById('ad-pref-alias-wrap');
      if (alWrap) alWrap.style.display = '';
    }

    function getDisplayName() {
      if (!IS_PRIVATE_USER) return CUSTOMER_NAME;

      var alRadio = document.getElementById('ad-pref-alias');
      var alInput = document.getElementById('ad-alias-input');

      if (alRadio && alRadio.checked) {
        return (alInput && alInput.value.trim()) || _savedAlias || CUSTOMER_NAME;
      }
      return CUSTOMER_NAME;
    }

    async function saveAliasToProfile() {
      if (!IS_PRIVATE_USER) return;

      var alRadio = document.getElementById('ad-pref-alias');
      var alInput = document.getElementById('ad-alias-input');
      if (!alRadio || !alRadio.checked) return;

      var typedAlias = alInput ? alInput.value.trim() : '';

      // Only call backend if alias changed or preference wasn't already 'alias'
      if (!typedAlias) return;
      if (typedAlias === _savedAlias && _savedDispPref === 'alias') return;

      try {
        await fetch(BACKEND_URL + '/customer-profile/' + CUSTOMER_ID + '/alias', {
          method:  'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ alias: typedAlias, nameDisplayPreference: 'alias' })
        });
        _savedAlias    = typedAlias;
        _savedDispPref = 'alias';
      } catch (e) {
        console.warn('[DisplayPref] Could not save alias:', e);
      }
    }

    // ────────────────────────────────────────────────────────────────────────
    // Handedness enable / disable — handedness is the last link in the
    // chain after caliber, so it only becomes selectable once a caliber
    // value actually exists (either user-picked or auto-locked). Any
    // upstream change (type/subtype/brand/model) invalidates that and
    // re-locks it via unlockCaliber() below.
    // ────────────────────────────────────────────────────────────────────────
    function setHandednessEnabled(enabled) {
      // Selection-mode widget — 6th field in the cascade, same
      // add-firearm-custom-dropdown markup/mechanism as Tipo..Calibre.
      adSetEnabled('ad-handedness', enabled);

      // Prefilled-mode widget — separate markup family (matches
      // Status/Availability's custom-dropdown), always enabled once shown.
      var dd = document.getElementById('ad-handedness-wrapper-pf');
      if (dd) {
        dd.classList.toggle('disabled', !enabled);
        if (!enabled) {
          dd.classList.remove('open');
          var menu = dd.querySelector('.dropdown-menu');
          if (menu) menu.style.display = 'none';
        }
        var btn = document.getElementById('ad-handedness-btn-pf');
        if (btn) btn.disabled = !enabled;
        dd.querySelectorAll('input[name="ad_handedness_pf"]').forEach(function (i) { i.disabled = !enabled; });
      }
    }

    function clearHandednessSelection() {
      adSetLabel('handedness', _adLabels.handedness);
      document.querySelectorAll('input[name="ad-handedness"]').forEach(function (r) { r.checked = false; });

      var btn = document.getElementById('ad-handedness-btn-pf');
      if (btn) btn.textContent = btn.dataset.default;
      document.querySelectorAll('input[name="ad_handedness_pf"]').forEach(function (r) { r.checked = false; });

      selectedHandedness = '';
    }

    // ────────────────────────────────────────────────────────────────────────
    // Caliber lock / unlock — CSS class is the bulletproof mechanism
    // ────────────────────────────────────────────────────────────────────────
    function lockCaliber(caliberValue) {
      var cw = document.getElementById('ad-calibre-wrapper');
      if (!cw) return;

      cw.classList.add('ad-calibre-locked');
      cw.classList.add('disabled');

      // Close it if open
      cw.classList.remove('open');
      var menu = cw.querySelector('.add-firearm-dropdown-menu');
      if (menu) menu.style.display = 'none';

      adSf.calibre = caliberValue;
      adSetLabel('calibre', caliberValue);

      // A caliber value now exists (auto-selected) — handedness can open.
      setHandednessEnabled(true);
    }

    function unlockCaliber() {
      var cw = document.getElementById('ad-calibre-wrapper');
      if (!cw) return;

      cw.classList.remove('ad-calibre-locked');
      cw.classList.remove('disabled');

      // Re-enable toggle button
      var tb = cw.querySelector('.filter-toggle');
      if (tb) tb.disabled = false;

      cw.querySelectorAll('input').forEach(function (i) { i.disabled = false; });

      var s = cw.querySelector('.filter-search');
      if (s) s.disabled = false;

      // Caliber is no longer settled (either reset or awaiting a fresh pick)
      // — handedness depends on it, so re-lock it until caliber is chosen again.
      setHandednessEnabled(false);
      clearHandednessSelection();
    }

    // ────────────────────────────────────────────────────────────────────────
    // Update details field
    // ────────────────────────────────────────────────────────────────────────
    function updateDetailsField() {
      var ms = document.getElementById('ad-model-search');
      // Only the casing is normalised here — unlike the ad title, this field
      // lists the brand as its own segment, so the brand must not be folded
      // into the model text.
      var modelVal = AdTitle.normaliseModel(
        adSelectedProduct ? adSelectedProduct.title : (adSf.modelo || (ms && ms.value.trim()) || '')
      );
      var parts = [adSf.tipo, adSf.subtipo, adSf.marca, modelVal, adSf.calibre].filter(Boolean);

      var det = document.getElementById('ad-details');
      if (det) det.value = parts.join(' / ');
    }

    // ────────────────────────────────────────────────────────────────────────
    // Storefront API
    // ────────────────────────────────────────────────────────────────────────
    async function fetchAllMetaobjects(type) {
      var results = [], cursor = null, hasMore = true, attempts = 0;

      while (hasMore && attempts < 10) {
        attempts++;
        var after = cursor ? (', after: "' + cursor + '"') : '';
        var q = '{metaobjects(type:"' + type + '",first:250' + after + '){pageInfo{hasNextPage endCursor}edges{node{fields{key value}}}}}';

        try {
          var r = await fetch(STOREFRONT_API, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': STOREFRONT_TOKEN },
            body:    JSON.stringify({ query: q })
          });
          if (!r.ok) break;

          var d = await r.json();
          if (d.errors) break;

          var mo = d && d.data && d.data.metaobjects;
          if (!mo) break;

          hasMore = mo.pageInfo && mo.pageInfo.hasNextPage;
          cursor  = mo.pageInfo && mo.pageInfo.endCursor;

          (mo.edges || []).forEach(function (e) {
            var f = (e.node.fields || []).find(function (x) { return x.key === 'name'; });
            if (f && f.value) results.push(f.value);
          });
        } catch (err) {
          break;
        }
      }

      console.log('fetchAllMetaobjects(' + type + ') returned', results.length);
      return results;
    }

    function renderBrandList(brands) {
      var ul = document.getElementById('ad-marca-list');
      if (!ul) return;

      if (!brands.length) {
        ul.innerHTML = '<li style="padding:8px 12px;color:#999;">' + {{ 'custom.no_brands_found' | t | json }} + '</li>';
        return;
      }

      ul.innerHTML = brands.map(function (n) {
        var s = n.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        return '<li data-brand="' + s + '"><label><input type="radio" name="ad-marca" value="' + s + '"><span>' + s + '</span></label></li>';
      }).join('');
    }

    function renderCaliberList(calibers) {
      var ul = document.getElementById('ad-calibre-list');
      if (!ul) return;

      if (!calibers.length) {
        ul.innerHTML = '<li style="padding:8px 12px;color:#999;">' + {{ 'custom.no_calibers_found' | t | json }} + '</li>';
        return;
      }

      ul.innerHTML = calibers.map(function (n) {
        var s = n.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        return '<li data-caliber="' + s + '"><label><input type="radio" name="ad-calibre" value="' + s + '"><span>' + s + '</span></label></li>';
      }).join('');

      // Re-apply active filter
      if (_activeCaliberFilter && _activeCaliberFilter.length) {
        document.querySelectorAll('#ad-calibre-list li[data-caliber]').forEach(function (li) {
          li.style.display = _activeCaliberFilter.includes(li.dataset.caliber) ? '' : 'none';
        });
      }
    }

    async function loadBrands() {
      if (_brandsCache) { renderBrandList(_brandsCache); return _brandsCache; }
      if (_brandsLoading) return;

      _brandsLoading = true;

      var ul = document.getElementById('ad-marca-list');
      if (ul) ul.innerHTML = '<li style="padding:8px 12px;opacity:0.5;">Loading brands...</li>';

      var brands = await fetchAllMetaobjects('all_brands');
      brands.sort(function (a, b) { return a.localeCompare(b); });

      _brandsCache = brands;
      _brandsLoading = false;

      renderBrandList(brands);
      return brands;
    }

    async function loadCalibers() {
      if (_calibersCache) { renderCaliberList(_calibersCache); return _calibersCache; }
      if (_calibersLoading) return;

      _calibersLoading = true;

      var ul = document.getElementById('ad-calibre-list');
      if (ul) ul.innerHTML = '<li style="padding:8px 12px;opacity:0.5;">Loading calibers...</li>';

      var calibers = await fetchAllMetaobjects('all_calibers');

      _calibersCache = calibers;
      _calibersLoading = false;

      renderCaliberList(calibers);
      return calibers;
    }

    // Barrel length values don't convert cleanly between cm/in (a 46cm
    // barrel is marketed as "18in", not the mathematically exact 18.1in) —
    // both units are curated directly on the all_barrel_length metaobject
    // rather than computed, so this reads all three fields itself instead
    // of reusing fetchAllMetaobjects() (which only extracts "name").
    async function fetchBarrelLengths() {
      var results = [], cursor = null, hasMore = true, attempts = 0;

      while (hasMore && attempts < 10) {
        attempts++;
        var after = cursor ? (', after: "' + cursor + '"') : '';
        var q = '{metaobjects(type:"all_barrel_length",first:250' + after + '){pageInfo{hasNextPage endCursor}edges{node{fields{key value}}}}}';

        try {
          var r = await fetch(STOREFRONT_API, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': STOREFRONT_TOKEN },
            body:    JSON.stringify({ query: q })
          });
          if (!r.ok) break;

          var d = await r.json();
          if (d.errors) break;

          var mo = d && d.data && d.data.metaobjects;
          if (!mo) break;

          hasMore = mo.pageInfo && mo.pageInfo.hasNextPage;
          cursor  = mo.pageInfo && mo.pageInfo.endCursor;

          (mo.edges || []).forEach(function (e) {
            var fields = e.node.fields || [];
            var get = function (key) {
              var f = fields.find(function (x) { return x.key === key; });
              return f ? f.value : '';
            };
            // The metaobject's "CM" field is stored under the API key "name"
            // (not "cm") — confirmed against the live Storefront API response.
            var cm = get('name');
            if (!cm) return;
            var inches = get('inches');
            if (!inches) {
              inches = cmToIn(parseFloat(cm)) + 'in';
              console.warn('[Gunloupe] all_barrel_length entry "' + cm + '" is missing Inches — using a computed estimate.');
            }
            results.push({ cm: cm, inches: inches, sortOrder: get('sort_order') });
          });
        } catch (err) {
          break;
        }
      }

      results.sort(function (a, b) {
        var ao = parseInt(a.sortOrder, 10), bo = parseInt(b.sortOrder, 10);
        if (isNaN(ao) && isNaN(bo)) return a.cm.localeCompare(b.cm);
        if (isNaN(ao)) return 1;
        if (isNaN(bo)) return -1;
        return ao - bo;
      });

      return results;
    }

    function renderBarrelList(entries, mode) {
      var ul = document.getElementById('ad-barrel-list');
      if (!ul) return;

      if (!entries.length) {
        ul.innerHTML = '<li style="padding:8px 12px;color:#999;">' + {{ 'custom.no_barrel_lengths_found' | t | json }} + '</li>';
        return;
      }

      mode = mode || localStorage.getItem('measures') || 'metric';
      ul.innerHTML = entries.map(function (e) {
        var shown = (mode === 'imperial' ? e.inches : e.cm)
          .replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        var cmAttr = e.cm.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        var inAttr = e.inches.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        return '<li data-barrel="' + shown + '" data-cm="' + cmAttr + '" data-in="' + inAttr + '"><label><input type="radio" name="ad-barrel" value="' + cmAttr + '"><span>' + shown + '</span></label></li>';
      }).join('');
    }

    function updateBarrelLabelForMeasure(mode) {
      mode = mode || localStorage.getItem('measures') || 'metric';
      // Once a value is picked, the button shows that value (matching how
      // Caliber/Handedness display a selection) rather than the field
      // prompt — only relabel to the "Barrel Length (CM/IN)" prompt if
      // nothing's been picked yet.
      if (adSf.barrel) {
        adSetLabel('barrel', selectedBarrelDisplayValue(mode));
      } else {
        adSetLabel('barrel', _adLabels.barrel + ' (' + (mode === 'imperial' ? 'IN' : 'CM') + ')');
      }
    }

    // adSf.barrel is always the canonical cm string (see renderBarrelList) —
    // this looks up the matching cached entry to show it in whichever unit
    // is currently active.
    function selectedBarrelDisplayValue(mode) {
      mode = mode || localStorage.getItem('measures') || 'metric';
      var entry = (_barrelsCache || []).find(function (e) { return e.cm === adSf.barrel; });
      if (!entry) return adSf.barrel;
      return mode === 'imperial' ? entry.inches : entry.cm;
    }

    async function loadBarrelLengths() {
      updateBarrelLabelForMeasure();

      if (_barrelsCache) { renderBarrelList(_barrelsCache); return _barrelsCache; }
      if (_barrelsLoading) return;

      _barrelsLoading = true;

      var ul = document.getElementById('ad-barrel-list');
      if (ul) ul.innerHTML = '<li style="padding:8px 12px;opacity:0.5;">Loading barrel lengths...</li>';

      var barrels = await fetchBarrelLengths();

      _barrelsCache = barrels;
      _barrelsLoading = false;

      renderBarrelList(barrels);
      return barrels;
    }

    // Live unit toggle while the popup is open — relabels the field and
    // re-renders the already-cached list from its stored {cm, inches} pairs
    // (no re-fetch needed); the radio's submitted value stays the cm string
    // regardless (see renderBarrelList above), so this is purely cosmetic.
    // Reads the clicked button's own data-measures rather than localStorage,
    // since this fires during the bubble phase before theme.liquid's
    // document-level handler (which writes localStorage) runs.
    document.querySelectorAll('.measures-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var mode = btn.dataset.measures;
        updateBarrelLabelForMeasure(mode);
        if (_barrelsCache) renderBarrelList(_barrelsCache, mode);
      });
    });

    async function getCatalogueBrands() {
      if (_catalogueBrandsCache) return _catalogueBrandsCache;

      try {
        var r = await fetch(_FC);
        var doc = new DOMParser().parseFromString(await r.text(), 'text/html');
        var s = new Set();

        doc.querySelectorAll('.filter-group').forEach(function (g) {
          var fi = g.querySelector('li input[type="checkbox"]');
          if (!fi || fi.name !== 'filter.p.m.custom.marca') return;
          g.querySelectorAll('li input[type="checkbox"]').forEach(function (i) { if (i.value) s.add(i.value); });
        });

        _catalogueBrandsCache = s;
        return s;
      } catch (e) {
        return new Set();
      }
    }

    // ────────────────────────────────────────────────────────────────────────
    // Extract calibers from product JSON
    // FIXED: Improved CALIBER_RE regex to match "21 Sharp", "22 LR" patterns
    // Added comprehensive debug logging for troubleshooting
    // ────────────────────────────────────────────────────────────────────────
    function extractCalibersFromProduct(product) {
      if (!product || !product.variants) return [];

      // ══════════════════════════════════════════════════════════════════════
      // ✅ CORRECTED: Use proper function to test MULTIPLE patterns
      // The previous version used || which doesn't work with regex!
      // ══════════════════════════════════════════════════════════════════════
      function isCaliberValue(value) {
        // Pattern 1: Number + space + ammunition name (e.g., "21 Sharp", "22 LR")
        if (/^\d+\s+(?:sharp|short|long|lr|wmr|wsm|rem|mag|spl|nato|swift|creedmoor|norma|saum|br|ppc|acc|ack|ultra|remington|browning|weatherby|win|winc|colt|para|acp|auto|luger|parabellum|geco|fiocchi|rws|federal|hornady|speer|sierra|nosler|berger)/i.test(value)) {
          return true;
        }
        // Pattern 2: Dot notation or separator (e.g., "9.3x62", ".308")
        if (/^\.?\d+[x\/\-]\d+/i.test(value)) {
          return true;
        }
        // Pattern 3: Metric with unit (e.g., "9mm", "12mm")
        if (/^\d+(?:\.\d+)?\s*(?:mm|mag|cal|gauge|ga|bore)/i.test(value)) {
          return true;
        }
        // Pattern 4: Dot notation alone (e.g., ".308", ".270")
        if (/^\.[\d]+/i.test(value)) {
          return true;
        }
        // Pattern 5: Buckshot (e.g., "#4 buck", "00 shot")
        if (/^#\d+\s*(?:buck|shot|buckshot|pellet)/i.test(value)) {
          return true;
        }
        return false;
      }

      var BARREL_RE               = /^\d[\d\.]*\s*(?:cm|in|inches?|centim)/i;
      var CALIBER_OPTION_NAME_RE  = /calibr[eo]|ammunition|ammo|cartridge|caliber|calibre|bore/i;
      var BARREL_OPTION_NAME_RE   = /ca[ñn][oó]n|barrel|longitud|length|chamber|twist/i;

      // ──────────────────────────────────────────────────────────────────────
      // DEBUG LOGGING
      // ──────────────────────────────────────────────────────────────────────
      console.group('%c📦 EXTRACT CALIBERS: ' + (product.title || 'Unknown'), 'color:#295A31;font-weight:bold');
      console.log('Product variants:', product.variants.length);

      var options = product.options || [];
      var calSlot = null, barSlot = null;

      // ──────────────────────────────────────────────────────────────────────
      // STEP 1: Detect slots by option name
      // ──────────────────────────────────────────────────────────────────────
      console.group('%c🔎 SLOT DETECTION', 'color:#295A31');
      options.forEach(function (opt, idx) {
        var name = (typeof opt === 'string') ? opt : (opt.name || '');
        if (CALIBER_OPTION_NAME_RE.test(name)) {
          calSlot = 'option' + (idx + 1);
          console.log('%c✓ CALIBER SLOT', 'color:green', 'Option[' + idx + '] = "' + name + '" → ' + calSlot);
        }
        if (BARREL_OPTION_NAME_RE.test(name)) {
          barSlot = 'option' + (idx + 1);
          console.log('%c✓ BARREL SLOT', 'color:blue', 'Option[' + idx + '] = "' + name + '" → ' + barSlot);
        }
      });
      console.groupEnd();

      // ──────────────────────────────────────────────────────────────────────
      // STEP 2: Test variants with CORRECTED pattern matching
      // ──────────────────────────────────────────────────────────────────────
      console.group('%c🧪 PATTERN MATCHING (CORRECTED)', 'color:#295A31');
      product.variants.forEach(function (v, idx) {
        var o1 = v.option1 || '';
        var match = isCaliberValue(o1);
        console.log('Variant[' + idx + ']: "' + o1 + '" ' + (match ? '%c✓ MATCH' : '%c✗ NO MATCH'), match ? 'color:green;font-weight:bold' : 'color:red;font-weight:bold');
      });
      console.groupEnd();

      // ──────────────────────────────────────────────────────────────────────
      // STEP 3: Fallback pattern detection
      // ──────────────────────────────────────────────────────────────────────
      if (!calSlot) {
        console.group('%c⚙️  FALLBACK DETECTION', 'color:#295A31');
        var opt1vals = [], opt2vals = [], opt3vals = [];

        product.variants.forEach(function (v) {
          if (v.option1 && v.option1.trim()) opt1vals.push(v.option1.trim());
          if (v.option2 && v.option2.trim()) opt2vals.push(v.option2.trim());
          if (v.option3 && v.option3.trim()) opt3vals.push(v.option3.trim());
        });

        function slotIsCaliber(vals) {
          return vals.some(function (v) { return isCaliberValue(v) && !BARREL_RE.test(v); });
        }

        if (slotIsCaliber(opt1vals)) {
          calSlot = 'option1';
          console.log('%c✓ option1 matches caliber patterns', 'color:green');
        } else if (slotIsCaliber(opt2vals)) {
          calSlot = 'option2';
          console.log('%c✓ option2 matches caliber patterns', 'color:green');
        } else if (slotIsCaliber(opt3vals)) {
          calSlot = 'option3';
          console.log('%c✓ option3 matches caliber patterns', 'color:green');
        } else {
          console.log('%c✗ No slot matched as caliber', 'color:red');
        }
        console.groupEnd();
      }

      // ──────────────────────────────────────────────────────────────────────
      // STEP 4: Extract calibers
      // ──────────────────────────────────────────────────────────────────────
      console.group('%c📋 EXTRACTION from ' + (calSlot || 'NONE'), 'color:#295A31');
      var seen = new Set(), cals = [];

      if (calSlot) {
        product.variants.forEach(function (v, idx) {
          var c = (v[calSlot] || '').trim();
          var isDup = seen.has(c);
          var isDefault = c === 'Default Title';

          if (c && !isDefault && !isDup) {
            seen.add(c);
            cals.push(c);
            console.log('%c✓ ' + idx + ':', 'color:green', '"' + c + '" ADDED');
          } else {
            console.log('%c✗ ' + idx + ':', 'color:gray', '"' + c + '" (dup=' + isDup + ', default=' + isDefault + ')');
          }
        });
      }
      console.groupEnd();

      // ──────────────────────────────────────────────────────────────────────
      // STEP 5: Fallback to option1
      // ──────────────────────────────────────────────────────────────────────
      if (!cals.length) {
        console.group('%c🔄 FALLBACK: option1 extraction', 'color:#295A31');
        product.variants.forEach(function (v, idx) {
          var c = (v.option1 || '').trim();
          if (c && c !== 'Default Title' && !BARREL_RE.test(c) && !seen.has(c)) {
            seen.add(c);
            cals.push(c);
            console.log('%c✓ FALLBACK: ' + idx, 'color:orange', '"' + c + '"');
          }
        });
        console.groupEnd();
      }

      // ──────────────────────────────────────────────────────────────────────
      // STEP 6: Summary + warnings
      // ──────────────────────────────────────────────────────────────────────
      console.group('%c📊 RESULT', 'color:#295A31;font-weight:bold');
      console.log('Calibers found:', cals);
      console.log('Total variants:', product.variants.length);

      if (cals.length === 1 && product.variants.length > 1) {
        console.warn('%c⚠️  EXTRACTION MISMATCH!', 'color:red;font-weight:bold');
        console.warn('Only 1 caliber extracted but product has ' + product.variants.length + ' variants');
      }

      if (cals.length >= 2) {
        console.log('%c✓ SUCCESS: Multiple calibers found!', 'color:green;font-weight:bold');
      }

      console.groupEnd();
      console.groupEnd();

      return cals;
    }

    // ────────────────────────────────────────────────────────────────────────
    // Close / Reset
    // ────────────────────────────────────────────────────────────────────────
    function closeAll() {
      if (notInArmorerOverlay) notInArmorerOverlay.style.display = 'none';
      addAdOverlay.style.display = 'none';
      resetForm();
    }

    if (notInArmorerOverlay) {
      document.getElementById('not-in-armorer-close').addEventListener('click', closeAll);
      document.getElementById('not-in-armorer-cancel').addEventListener('click', closeAll);
      notInArmorerOverlay.addEventListener('click', function (e) {
        if (e.target === notInArmorerOverlay) closeAll();
      });
    }

    document.getElementById('add-ad-close').addEventListener('click', closeAll);
    document.getElementById('add-ad-cancel').addEventListener('click', closeAll);

    function resetForm() {
      ['ad-city', 'ad-price', 'ad-personalized-name', 'ad-description', 'ad-purchase-date', 'ad-seller-phone'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.value = '';
      });

      document.getElementById('ad-image-preview').innerHTML = '';

      var le = document.getElementById('add-ad-loader');
      if (le) le.style.display = 'none';

      var ap = document.querySelector('#add-ad-overlay .ad-popup');
      if (ap) ap.style.overflow = '';

      document.getElementById('ad-form-error').style.display = 'none';

      var sb = document.getElementById('ad-status-btn');
      if (sb) sb.textContent = sb.dataset.default;
      document.querySelectorAll('input[name="ad_gun_status"]').forEach(function (r) { r.checked = false; });

      var avb2 = document.getElementById('ad-availability-btn');
      if (avb2) avb2.textContent = avb2.dataset.default;
      document.querySelectorAll('input[name="ad_availability"]').forEach(function (r) { r.checked = false; });

      clearHandednessSelection();

      uploadedImages = [];
      selectedGunStatus = '';
      selectedAvailability = '';
      selectedHandedness = '';
      currentSellData = {};

      resetSelectionState();
      resetDisplayPref();
    }

    function resetSelectionState() {
      adSf = { tipo: '', subtipo: '', marca: '', modelo: '', calibre: '', barrel: '' };
      adSelectedProduct = null;
      adAllProducts = [];
      adIsFetching = false;
      adBrandIsCatalogue = false;
      _activeCaliberFilter = null;

      [
        { id: 'ad-tipo-label',       k: 'tipo' },
        { id: 'ad-subtipo-label',    k: 'subtipo' },
        { id: 'ad-marca-label',      k: 'marca' },
        { id: 'ad-modelo-label',     k: 'modelo' },
        { id: 'ad-calibre-label',    k: 'calibre' },
        { id: 'ad-barrel-label',     k: 'barrel' },
        { id: 'ad-handedness-label', k: 'handedness' }
      ].forEach(function (o) {
        var el = document.getElementById(o.id);
        if (el) el.textContent = _adLabels[o.k];
      });

      // unlockCaliber() must run BEFORE the disable loop below — it clears
      // any stale single-caliber auto-lock from a previous selection, but
      // it also re-enables the caliber toggle/inputs as a side effect. Run
      // after adSetEnabled('ad-calibre', false) and it silently undoes that
      // disable, leaving caliber (and then handedness) clickable before
      // type/subtype/brand/model have been chosen.
      unlockCaliber();

      ['ad-subtipo', 'ad-marca', 'ad-modelo', 'ad-calibre', 'ad-barrel', 'ad-handedness'].forEach(function (k) { adSetEnabled(k, false); });
      adSetEnabled('ad-tipo', true);

      var cw = document.getElementById('ad-calibre-wrapper');
      if (cw) cw.style.display = '';

      var ms = document.getElementById('ad-model-search');
      if (ms) ms.value = '';

      var mr = document.getElementById('ad-model-results');
      if (mr) mr.innerHTML = '';

      var bs = document.getElementById('ad-brand-search');
      if (bs) { bs.value = ''; adFilterList('ad-marca-list', 'brand', ''); }

      var cs = document.getElementById('ad-caliber-search');
      if (cs) { cs.style.display = ''; cs.value = ''; adFilterList('ad-calibre-list', 'caliber', ''); }

      var brs = document.getElementById('ad-barrel-search');
      if (brs) { brs.value = ''; adFilterList('ad-barrel-list', 'barrel', ''); }

      document.querySelectorAll('#ad-selection-section .add-firearm-dropdown-menu').forEach(function (m) { m.style.display = 'none'; });
      document.querySelectorAll('#ad-selection-section .add-firearm-custom-dropdown').forEach(function (d) { d.classList.remove('open'); });
      document.querySelectorAll('#ad-selection-section input[type="radio"]').forEach(function (r) { r.checked = false; });

      var det = document.getElementById('ad-details');
      if (det) det.value = '';
    }

    function showPrefillMode() {
      adMode = 'prefilled';
      prefillSection.style.display = 'block';
      selectionSection.style.display = 'none';
      initDisplayPref();
      // Everything (type/subtype/brand/model/caliber) is already prefilled
      // from the product, so there's no cascade to wait on here.
      setHandednessEnabled(true);
    }

    function showSelectionMode() {
      adMode = 'selection';
      prefillSection.style.display = 'none';
      selectionSection.style.display = 'block';
      adLoadTypeFilters();
      getCatalogueBrands();
      initDisplayPref();
    }

    function prefillForm(d) {
      document.getElementById('ad-type').value            = d.type    || '';
      document.getElementById('ad-subtype').value         = d.subtype || '';
      document.getElementById('ad-brand').value           = d.brand   || '';
      // Title text is built by the shared formatter (snippets/gl-ad-title),
      // which prepends the brand, title-cases the model and appends the
      // barrel as "// 61cm". Doing it here rather than inline is what keeps
      // this Sell-button path byte-identical to the catalogue-search path in
      // collectAdValues() below — the two used to read different fields
      // (custom.submodelo vs product.title) and produced titles that differed
      // only in casing for the same firearm. This field is read back verbatim
      // as the submitted "model" for prefilled ads.
      document.getElementById('ad-model').value           = AdTitle.build({
        brand:  d.brand,
        model:  d.model,
        barrel: d.barrel
      });
      document.getElementById('ad-caliber-display').value = d.caliber || '';
      document.getElementById('ad-caliber-prefilled').value = d.caliber || '';

      prefillHandedness(d.handle);

      // Brand stays its own segment here, so only the model's casing and the
      // barrel's unit are normalised — see updateDetailsField() for the
      // catalogue-search equivalent of this same line.
      var parts = [
        d.type,
        d.subtype,
        d.brand,
        AdTitle.normaliseModel(d.model),
        d.caliber,
        AdTitle.normaliseBarrel(d.barrel)
      ].filter(Boolean);
      document.getElementById('ad-details').value = parts.join(' // ');

      // Prefill Status + Purchase date from the firearm's existing My Armorer data,
      // since the user already entered these when adding it — no need to ask again.
      if (d.status) {
        // My Armorer stores "Semi nuevo" (space); this popup's radios use "Semi-nuevo"
        // (hyphen) — normalize so the matching radio is found correctly either way.
        var normalizedStatus = d.status === 'Semi nuevo' ? 'Semi-nuevo' : d.status;
        var statusRadio = document.querySelector('input[name="ad_gun_status"][value="' + normalizedStatus + '"]');
        if (statusRadio) {
          statusRadio.checked = true;
          selectedGunStatus = normalizedStatus;
          var sb = document.getElementById('ad-status-btn');
          if (sb) sb.textContent = STATUS_LABELS[normalizedStatus] || normalizedStatus;
        }
      }

      if (d.purchaseDate) {
        var pd = document.getElementById('ad-purchase-date');
        if (pd) pd.value = d.purchaseDate;
      }
    }

    function parseAdFilters(doc) {
      var result = { tipo: [], subtipo: [], marca: [], modelo: [], calibre: [] };

      doc.querySelectorAll('.filter-group').forEach(function (g) {
        var fi = g.querySelector('li input[type="checkbox"]');
        if (!fi) return;

        var key = PARAM_TO_KEY[fi.name];
        if (!key) return;

        var vals = Array.from(g.querySelectorAll('li input[type="checkbox"]'))
          .filter(function (i) { return !i.disabled; })
          .map(function (i) { return i.value; })
          .filter(Boolean);

        if (vals.length) result[key] = vals;
      });

      return result;
    }

    function adSetEnabled(key, enabled) {
      var g = document.querySelector('[data-filter="' + key + '"]');
      if (!g) return;

      g.classList.toggle('disabled', !enabled);
      g.querySelectorAll('input').forEach(function (i) { i.disabled = !enabled; });

      var s = g.querySelector('.filter-search');
      if (s) s.disabled = !enabled;

      var tb = g.querySelector('.filter-toggle');
      if (tb) tb.disabled = !enabled;

      // Fields like barrel length only ever apply to the manual-entry flow —
      // rather than sitting greyed out for the whole catalogue flow, hide
      // them entirely until something actually enables them.
      if (g.dataset.hideDisabled) g.style.display = enabled ? '' : 'none';
    }

    function adSetLabel(key, value) {
      var el = document.getElementById('ad-' + key + '-label');
      if (el) el.textContent = value;
    }

    function adOpenDropdown(dd) {
      // Never open a locked caliber
      if (dd.id === 'ad-calibre-wrapper' && dd.classList.contains('ad-calibre-locked')) return;

      dd.classList.add('open');

      var menu = dd.querySelector('.add-firearm-dropdown-menu');
      if (menu) menu.style.display = dd.querySelector('.ad-scrollable-menu') ? 'flex' : 'block';
    }

    function adCloseDropdown(dd) {
      dd.classList.remove('open');

      var menu = dd.querySelector('.add-firearm-dropdown-menu');
      if (menu) menu.style.display = 'none';
    }

    function adFilterList(listId, dataAttr, q) {
      q = (q || '').toLowerCase();

      document.querySelectorAll('#' + listId + ' li[data-' + dataAttr + ']').forEach(function (li) {
        li.style.display = (!q || (li.dataset[dataAttr] || '').toLowerCase().includes(q)) ? '' : 'none';
      });
    }

    async function adLoadTypeFilters() {
      var ul = document.getElementById('ad-tipo-list');
      if (ul) ul.innerHTML = '<li class="filter-skeleton"><div class="filter-skeleton__line"></div></li>';

      try {
        var r = await fetch(_FC);
        var parsed = parseAdFilters(new DOMParser().parseFromString(await r.text(), 'text/html'));
        if (ul) {
          ul.innerHTML = (parsed.tipo || []).map(function (v) {
            return '<li><label><input type="radio" name="ad-tipo" value="' + v + '"><span>' + v + '</span></label></li>';
          }).join('');
        }
      } catch (e) {}
    }

    async function adFetchSubtypes() {
      var myGen = ++adFilterFetchGen;

      var ul = document.getElementById('ad-subtipo-list');
      if (ul) ul.innerHTML = '<li class="filter-skeleton"><div class="filter-skeleton__line"></div></li>';

      try {
        var p = new URLSearchParams();
        if (adSf.tipo) p.append('filter.p.product_type', adSf.tipo);

        var r = await fetch(_FC + '?' + p.toString());
        var parsed = parseAdFilters(new DOMParser().parseFromString(await r.text(), 'text/html'));

        if (myGen !== adFilterFetchGen) return;

        if (ul && parsed.subtipo.length) {
          ul.innerHTML = parsed.subtipo.map(function (v) {
            return '<li><label><input type="radio" name="ad-subtipo" value="' + v + '"><span>' + v + '</span></label></li>';
          }).join('');
        }
      } catch (e) {}
    }

    function adShowModelSkeleton() {
      var r = document.getElementById('ad-model-results');
      if (!r) return;

      r.innerHTML = [1, 2, 3].map(function () {
        return '<div class="model-skeleton"><div class="model-skeleton__img"></div><div class="model-skeleton__text"><div class="model-skeleton__line model-skeleton__line--wide"></div><div class="model-skeleton__line model-skeleton__line--narrow"></div></div></div>';
      }).join('');
    }

    function adShowManualHint() {
      if (document.getElementById('ad-model-search')) {
        var si = document.getElementById('ad-model-search');
        si.removeAttribute('readonly'); si.style.opacity = ''; si.placeholder = _adLabels.searchModel;
      }
      var r = document.getElementById('ad-model-results');
      if (!r) return;
      r.innerHTML = '<div style="padding:12px;font-size:.9rem;color:#666;font-style:italic;background:#f9fafb;border-radius:6px;margin:4px;">' + _adNonCatalogueMsg + '</div>';
    }

    function adShowMismatchHint() {
      var si = document.getElementById('ad-model-search');
      if (si) {
        si.removeAttribute('readonly');
        si.style.opacity = '';
        si.placeholder = _adLabels.searchModel;
      }
      var r = document.getElementById('ad-model-results');
      if (!r) return;
      r.innerHTML = '<div style="padding:12px;font-size:.9rem;color:#666;font-style:italic;background:#f9fafb;border-radius:6px;margin:4px;">' + _adMismatchMsg + '</div>';
    }

    async function adFetchProducts() {
      if (adIsFetching) return;
      adIsFetching = true;
      var myGen = adProductFetchGen;

      var si = document.getElementById('ad-model-search');
      if (si) { si.setAttribute('readonly', 'readonly'); si.style.opacity = '0.55'; si.placeholder = _adLabels.loadingModels; }

      try {
        var p = new URLSearchParams();
        if (adSf.tipo) p.append('filter.p.product_type', adSf.tipo);
        if (adSf.subtipo) p.append('filter.p.m.custom.sub_tipo_de_arma', adSf.subtipo);
        if (adSf.marca) p.append('filter.p.m.custom.marca', adSf.marca);

        var fetchedProducts = [];
        var seenKeys = new Set();
        for (var page = 1; page <= 50; page++) {
          if (myGen !== adProductFetchGen) break; // brand changed mid-pagination — discard
          var pp = new URLSearchParams(p); pp.set('page', String(page));
          var doc = new DOMParser().parseFromString(await (await fetch(_FC + '?' + pp.toString())).text(), 'text/html');
          var cards = doc.querySelectorAll('.product-card,.grid-product,.card-wrapper');
          if (!cards.length) break;
          var sawNew = false;
          cards.forEach(function (item) {
            var te = item.querySelector('.product-card__title') || item.querySelector('h3');
            var title = te && te.textContent && te.textContent.trim();
            var image = item.querySelector('img') && item.querySelector('img').src;
            var link = item.querySelector('a') && item.querySelector('a').href;
            if (!title) return;
            var key = link || title;
            if (seenKeys.has(key)) return;
            seenKeys.add(key); sawNew = true;
            fetchedProducts.push({ title: title, image: image, link: link });
          });
          if (!sawNew) break;
        }
        if (myGen === adProductFetchGen) adAllProducts = fetchedProducts;
      } catch (e) {}

      adIsFetching = false;
      if (myGen !== adProductFetchGen) return; // superseded by a newer brand selection
      adProductFetchDone = true;

      if (si) { si.removeAttribute('readonly'); si.style.opacity = ''; si.placeholder = _adLabels.searchModel; }
      var q = (si && si.value || '').trim().toLowerCase();
      adRenderModelResults(q ? adAllProducts.filter(function (p) { return p.title.toLowerCase().includes(q); }) : adAllProducts, true);
    }

    function adExtractHandle(url) {
      if (!url) return null;
      var p = url.split('/products/');
      return p[1] ? p[1].split('?')[0] : null;
    }

    function makeUseBtn(label, onClickFn) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'ad-use-btn';
      btn.innerHTML = '&#10003; Use <strong>"' + label + '"</strong>';
      btn.addEventListener('click', onClickFn);
      return btn;
    }

    function adRenderModelResults(products, isFinal) {
      var re = document.getElementById('ad-model-results');
      if (!re) return;

      var typed = (document.getElementById('ad-model-search') && document.getElementById('ad-model-search').value || '').trim();
      re.innerHTML = '';

      if (!products.length) {
        // True mismatch: catalogue brand confirmed, fetch confirmed done, and the
        // whole combo — not just the typed filter — has zero products.
        if (adBrandIsCatalogue && adProductFetchDone && adAllProducts.length === 0) {
          adShowMismatchHint();
          return;
        }
        if (!typed) {
          if (adBrandIsCatalogue && !adProductFetchDone) {
            var le = document.createElement('div');
            le.style.cssText = 'padding:8px 12px;opacity:0.5;font-size:.9rem;';
            le.textContent = _adLabels.loadingModels + '...';
            re.appendChild(le);
            adFetchProducts();
          }
          return;
        }
        // Catalogue brand, some products exist for this combo, but none match
        // what was typed — allow a custom entry as an override (unchanged).
        re.appendChild(makeUseBtn(typed, function () { adSelectCustomModel(typed); }));
        return;
      }

      var sid = Date.now();
      re.dataset.sessionId = String(sid);

      products.forEach(function (p) {
        var handle = p.handle || adExtractHandle(p.link);
        if (!handle) { adAppendModelRow(p, handle, null, [], sid); return; }

        fetch('/products/' + handle + '.json?t=' + Date.now())
          .then(function (r) { return r.json(); })
          .then(function (jd) {
            if (String(re.dataset.sessionId) !== String(sid)) return;

            var prod = jd && jd.product;
            if (!prod) { adAppendModelRow(p, handle, null, [], sid); return; }

            var img = (prod.image && prod.image.src) || p.image || null;

            // Smart barrel slot detection — mirrors section.my-armorer.liquid
            var BARREL_RE_AD = /^\d[\d\.]*\s*cm$/i;
            var aopt1vals = [], aopt2vals = [], aopt3vals = [];

            (prod.variants || []).forEach(function (v) {
              if (v.option1 && v.option1.trim()) aopt1vals.push(v.option1.trim());
              if (v.option2 && v.option2.trim()) aopt2vals.push(v.option2.trim());
              if (v.option3 && v.option3.trim()) aopt3vals.push(v.option3.trim());
            });

            function adSlotIsBarrel(vals) {
              return vals.some(function (v) { return BARREL_RE_AD.test(v); });
            }

            var barSlot = null;
            if (adSlotIsBarrel(aopt1vals))      barSlot = 'option1';
            else if (adSlotIsBarrel(aopt2vals)) barSlot = 'option2';
            else if (adSlotIsBarrel(aopt3vals)) barSlot = 'option3';

            var sb = new Set(), rows = [];
            if (barSlot) {
              (prod.variants || []).forEach(function (v) {
                var b = (v[barSlot] || '').trim();
                if (!sb.has(b)) { sb.add(b); rows.push(b); }
              });
            }

            // Find the caliber slot once for this product (shared across all barrel rows)
            var calSlotForProduct = (function () {
              var CALIBER_OPTION_NAME_RE = /calibr[eo]|ammunition|ammo|cartridge|caliber|calibre|bore/i;
              var opts = prod.options || [];
              var slot = null;
              opts.forEach(function (opt, idx) {
                var name = (typeof opt === 'string') ? opt : (opt.name || '');
                if (CALIBER_OPTION_NAME_RE.test(name)) slot = 'option' + (idx + 1);
              });
              return slot;
            })();

            // Build caliber list SCOPED to a specific barrel value — only variants
            // matching that barrel are considered, so 66cm shows only its own caliber(s)
            function calsForBarrel(barrelVal) {
              var seen = new Set(), out = [];
              (prod.variants || []).forEach(function (v) {
                if (barSlot && barrelVal !== null) {
                  var b = (v[barSlot] || '').trim();
                  if (b !== barrelVal) return; // skip variants that don't match this barrel
                }
                var c = calSlotForProduct ? (v[calSlotForProduct] || '').trim() : (v.option1 || '').trim();
                if (c && c !== 'Default Title' && !seen.has(c)) { seen.add(c); out.push(c); }
              });
              return out;
            }

            var px = Object.assign({}, p, { image: img });

            if (!rows.length || (rows.length === 1 && !rows[0])) {
              var calsAll = calsForBarrel(null); // no barrel distinction — use whole product
              adAppendModelRow(px, handle, null, calsAll, sid);
            } else {
              rows.forEach(function (b) {
                var calsForThisBarrel = calsForBarrel(b);
                adAppendModelRow(px, handle, b || null, calsForThisBarrel, sid);
              });
            }
          })
          .catch(function () { adAppendModelRow(p, handle, null, [], sid); });
      });

      if (typed) {
        setTimeout(function () {
          if (String(re.dataset.sessionId) !== String(sid)) return;
          var cfw = document.createElement('div');
          cfw.style.cssText = 'border-top:1px solid #eee;padding-top:4px;margin-top:4px;';
          cfw.appendChild(makeUseBtn(typed, function () { adSelectCustomModel(typed); }));
          re.appendChild(cfw);
        }, 300);
      }
    }

    function adAppendModelRow(p, handle, barrel, cals, sid) {
      var re = document.getElementById('ad-model-results');
      if (!re || String(re.dataset.sessionId) !== String(sid)) return;

      var el = document.createElement('div');
      el.className = 'model-item';
      el.innerHTML =
        '<div class="model-img-wrapper"><img src="' + (p.image || 'https://via.placeholder.com/50') + '" alt="' + (p.title || '') + '"></div>' +
        '<div style="display:flex;align-items:center;width:100%;gap:8px;"><span>' + (p.title || '') + '</span>' +
        (barrel ? '<span style="margin-left:auto;white-space:nowrap;">' + barrel + '</span>' : '') +
        '</div>';

      el.addEventListener('click', function () {
        var display = barrel ? p.title + ' // ' + barrel : p.title;
        adSelectedProduct = { title: p.title, handle: handle, url: p.link || '/products/' + handle, image: p.image || null, barrel: barrel || '' };
        adSf.modelo = p.title;
        document.getElementById('ad-model-search').value = display;
        adSetLabel('modelo', display);
        re.innerHTML = '';
        prefillHandedness(handle);

        var dd = document.querySelector('[data-filter="ad-modelo"]');
        if (dd) adCloseDropdown(dd);

        // ── Caliber logic — mirrors section.my-armorer.liquid exactly ──────
        var calsList = cals || p.calibres || [];
        _activeCaliberFilter = null;

        console.group('%c⚙️  CALIBER LOCKING DECISION', 'color:#FF6B35;font-weight:bold');
        console.log('Calibers:', calsList);
        console.log('Barrel:', barrel);
        console.log('Caliber count:', calsList.length);

        if (calsList.length === 1 && !barrel) {
          // Single caliber AND no barrel length — auto-select and lock (not user-changeable).
          // If a barrel is present, the product likely has multiple calibers not all detected — don't lock.
          console.log('%c→ LOCK (1 caliber, no barrel)', 'color:red;font-weight:bold', calsList[0]);

          var ul = document.getElementById('ad-calibre-list');
          if (ul) {
            var s = calsList[0].replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
            ul.innerHTML = '<li data-caliber="' + s + '"><label><input type="radio" name="ad-calibre" value="' + s + '"><span>' + s + '</span></label></li>';
            var ri = ul.querySelector('input[type="radio"]');
            if (ri) ri.checked = true;
          }

          lockCaliber(calsList[0]);
        } else if (calsList.length >= 1) {
          // Multiple calibers — populate the list with only this product's calibers, no search
          console.log('%c→ UNLOCK (' + calsList.length + ' calibers' + (barrel ? ' + barrel' : '') + ')', 'color:green;font-weight:bold');

          var ul = document.getElementById('ad-calibre-list');
          if (ul) {
            ul.innerHTML = calsList.map(function (n) {
              var s = n.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
              return '<li data-caliber="' + s + '"><label><input type="radio" name="ad-calibre" value="' + s + '"><span>' + s + '</span></label></li>';
            }).join('');
          }

          // Hide search — only 2-3 product calibers, no need to filter
          var cs = document.getElementById('ad-caliber-search');
          if (cs) cs.style.display = 'none';

          _activeCaliberFilter = calsList;
          unlockCaliber();
          adSf.calibre = '';
          adSetLabel('calibre', _adLabels.calibre);
          adSetEnabled('ad-calibre', true);
        } else {
          // No caliber data — unlock and show the full all_calibers list with search
          console.log('%c→ NO DATA: Showing full list', 'color:orange;font-weight:bold');

          var cs = document.getElementById('ad-caliber-search');
          if (cs) cs.style.display = ''; // restore search for full list

          unlockCaliber();
          adSf.calibre = '';
          adSetLabel('calibre', _adLabels.calibre);
          adSetEnabled('ad-calibre', true);
        }

        console.groupEnd();

        updateDetailsField();
      });

      re.appendChild(el);
    }

    function adSelectCustomModel(typed) {
      adSelectedProduct = null;
      adSf.modelo = typed;
      adSf.calibre = '';
      adSf.barrel = '';
      adSetLabel('modelo', typed);


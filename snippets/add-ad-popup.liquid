    // Handedness is stored at the product level in Shopify, not per-variant,
    // so a catalogue product's own custom.lateralidad metafield is only a
    // starting suggestion — pre-select it once we know which product, but
    // let the seller change it (their physical firearm may differ). Called
    // from both prefilled mode (prefillForm) and catalogue-model selection
    // in selection mode (adAppendModelRow), so it sets whichever of the two
    // widgets is present for the given value.
    function prefillHandedness(handle) {
      if (!handle) return;
      fetch(STOREFRONT_API, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'X-Shopify-Storefront-Access-Token': STOREFRONT_TOKEN },
        body:    JSON.stringify({
          query: `{ product(handle: ${JSON.stringify(handle)}) { metafield(namespace: "custom", key: "lateralidad") { value } } }`
        })
      })
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (data) {
          var raw   = data && data.data && data.data.product && data.data.product.metafield && data.data.product.metafield.value;
          var value = canonicalHandedness(raw);
          if (!value) return;

          var pfRadio = document.querySelector('input[name="ad_handedness_pf"][value="' + value + '"]');
          if (pfRadio) {
            pfRadio.checked = true;
            var btn = document.getElementById('ad-handedness-btn-pf');
            if (btn) btn.textContent = HANDEDNESS_LABELS[value];
          }

          var selRadio = document.querySelector('input[name="ad-handedness"][value="' + value + '"]');
          if (selRadio) {
            selRadio.checked = true;
            adSetLabel('handedness', HANDEDNESS_LABELS[value]);
          }

          selectedHandedness = value;
        })
        .catch(function () { /* leave unselected — seller picks manually */ });
    }

    // ────────────────────────────────────────────────────────────────────────
    // Image upload
    // ────────────────────────────────────────────────────────────────────────
    document.getElementById('ad-image-upload').addEventListener('change', function () {
      var ee = document.getElementById('ad-form-error');

      Array.from(this.files).forEach(function (file) {
        var reader = new FileReader();
        reader.onload = function (ev) {
          var b64 = ev.target.result;
          var checker = new Image();
          checker.onload = function () {
            if (checker.naturalWidth < 300) {
              if (ee) { ee.textContent = 'Min image size 300x300px.'; ee.style.display = 'block'; }
              return;
            }
            if (ee) ee.style.display = 'none';
            uploadedImages.push(b64);

            var preview = document.getElementById('ad-image-preview');
            var wrapper = document.createElement('div');
            var img = document.createElement('img');
            img.src = b64;

            var rb = document.createElement('span');
            rb.className = 'remove-img';
            rb.textContent = 'x';
            rb.addEventListener('click', function () {
              uploadedImages = uploadedImages.filter(function (u) { return u !== b64; });
              wrapper.remove();
            });

            wrapper.appendChild(img);
            wrapper.appendChild(rb);
            preview.appendChild(wrapper);
          };
          checker.src = b64;
        };
        reader.readAsDataURL(file);
      });

      this.value = '';
    });

    // ────────────────────────────────────────────────────────────────────────
    // Collect + validate
    // ────────────────────────────────────────────────────────────────────────
    function collectAdValues() {
      if (adMode === 'prefilled') {
        return {
          handle:  currentSellData.handle || '',
          type:    document.getElementById('ad-type').value,
          subtype: document.getElementById('ad-subtype').value,
          brand:   document.getElementById('ad-brand').value,
          model:   document.getElementById('ad-model').value,
          caliber: document.getElementById('ad-caliber-prefilled').value,
          barrel:  AdTitle.normaliseBarrel(currentSellData.barrel),
          image:   currentSellData.image || ''
        };
      }

      var ms = document.getElementById('ad-model-search');
      // Built by the same shared formatter prefillForm() uses, so an ad
      // created by searching the catalogue here and an ad created from a
      // "sell" button that already knew the product come out with an
      // identical title. Before this they diverged: this path used
      // product.title ("Beretta 686 SILVER PIGEON I SPORTING") while the
      // sell-button path used custom.submodelo ("686 Silver Pigeon I
      // Sporting"), and neither field is consistently cased in the catalogue
      // feed, so the casing had to be normalised rather than sourced.
      // adSf.barrel is the bare canonical cm number (see renderBarrelList) —
      // the formatter appends the "cm" suffix at display/submission time, so
      // the lookup against _barrelsCache elsewhere keeps working.
      var modeloVal = adSf.modelo || (ms && ms.value.trim()) || '';
      var modelVal = AdTitle.build(
        adSelectedProduct
          ? { brand: adSf.marca, model: adSelectedProduct.title, barrel: adSelectedProduct.barrel }
          : { brand: adSf.marca, model: modeloVal, barrel: adSf.barrel }
      );

      return {
        handle:  adSelectedProduct ? (adExtractHandle(adSelectedProduct.url) || '') : '',
        type:    adSf.tipo,
        subtype: adSf.subtipo,
        brand:   adSf.marca,
        model:   modelVal,
        caliber: adSf.calibre,
        // Normalised through the same helper so "62" and "62 cm" can't reach
        // firearm_details as two different-looking values.
        barrel:  AdTitle.normaliseBarrel(
                   adSelectedProduct ? adSelectedProduct.barrel : adSf.barrel
                 ),
        image:   adSelectedProduct ? (adSelectedProduct.image || '') : ''
      };
    }

    function validateForm() {
      var errors = [], vals = collectAdValues();

      if (adMode === 'selection') {
        if (!vals.type)    errors.push('{{ "custom.select_firearm_type" | t }}');
        if (!vals.subtype) errors.push('{{ "custom.select_subtype_error" | t }}');
        if (!vals.brand)   errors.push('{{ "custom.select_brand" | t }}');
        if (!vals.model)   errors.push('{{ "custom.select_or_enter_model" | t }}');
        if (!vals.caliber) errors.push('{{ "custom.select_calibre" | t }}');
        // Unlike the image check below, this one *does* wait for model too —
        // it shouldn't pile onto "please select or enter a model" while the
        // user hasn't typed a custom model yet.
        if (!adBrandIsCatalogue && vals.model && !vals.barrel) errors.push('{{ "custom.select_barrel_length" | t }}');
      }

      var c = document.getElementById('ad-city');
      if (!c || !c.value.trim()) errors.push('{{ "custom.city_required" | t }}.');

      var p = document.getElementById('ad-price');
      if (!p || !p.value.trim()) errors.push('{{ "custom.price_required" | t }}.');

      // Image upload is optional when a catalog product was selected (its
      // product image is used) but mandatory once a non-catalogue brand is
      // picked — there's no catalog picture to fall back to, only the
      // generic placeholder. Gated on brand being filled (rather than also
      // requiring model) so it fires as soon as the brand puts the user on
      // the custom route, not only after model is filled in too — but
      // still doesn't pile onto the "please select a brand" error when the
      // form is simply empty (vals.brand is '' then).
      if (adMode === 'selection' && vals.brand && !adSelectedProduct && !uploadedImages.length) {
        errors.push('{{ "custom.image_required" | t }}');
      }

      if (!selectedGunStatus)       errors.push('{{ "custom.firearm_status_required" | t }}');
      if (!selectedAvailability)    errors.push('{{ "custom.select_availability" | t }}');
      if (!selectedHandedness)      errors.push('{{ "custom.select_handedness" | t }}');

      var phoneEl = document.getElementById('ad-seller-phone');
      if (phoneEl && phoneEl.value.trim()) {
        var digits = phoneEl.value.trim().replace(/\D/g, '');
        if (digits.length < 7) errors.push('Phone number is too short (min 7 digits)');
      }

      return errors;
    }

    // ────────────────────────────────────────────────────────────────────────
    // Submit
    // ────────────────────────────────────────────────────────────────────────
    document.getElementById('add-ad-submit').addEventListener('click', async function () {
      var errorEl = document.getElementById('ad-form-error');
      errorEl.style.display = 'none';
      errorEl.innerHTML = '';

      var errors = validateForm();
      if (errors.length) {
        errorEl.innerHTML = errors.length === 1
          ? errors[0]
          : '<ul style="margin:0;padding-left:18px;">' + errors.map(function (e) { return '<li>' + e + '</li>'; }).join('') + '</ul>';
        errorEl.style.display = 'block';
        return;
      }

      var vals = collectAdValues();
      var det = adMode === 'prefilled'
        ? document.getElementById('ad-details').value
        : [vals.type, vals.subtype, vals.brand, vals.model, vals.caliber, vals.barrel].filter(Boolean).join(' / ');

      var submitBtn = document.getElementById('add-ad-submit');
      var submitTxt = document.getElementById('add-ad-submit-text');
      var loaderEl  = document.getElementById('add-ad-loader');
      var loaderMsg = document.getElementById('add-ad-loader-msg');
      var popupEl   = document.querySelector('#add-ad-overlay .ad-popup');

      submitBtn.disabled      = true;
      submitTxt.style.display = 'none';
      loaderEl.style.display  = 'flex';
      popupEl.style.overflow  = 'hidden';
      popupEl.scrollTop       = 0;

      var msgs = [
        '{{ "custom.creating" | t }}...',
        '{{ "custom.uploading_images" | t }}...',
        '{{ "custom.almost_there" | t }}...',
        '{{ "custom.finalizing" | t }}...'
      ];
      var msgIndex = 0;
      var loaderInterval = setInterval(function () {
        msgIndex++;
        if (msgIndex < msgs.length) loaderMsg.textContent = msgs[msgIndex];
      }, 5000);


    // This runs before the ad fetch so the profile is updated even if the
    // user entered a new alias here for the first time.
    saveAliasToProfile().catch(function () {});

      var payload = {
        customerId:              CUSTOMER_ID,
        productHandle:           vals.handle || ('custom-' + (vals.brand || 'brand').toLowerCase().replace(/[^a-z0-9]/g, '-') + '-' + Date.now()),
        productUrl:              vals.handle ? 'https://gunloupe.myshopify.com/products/' + vals.handle : '',
        productImage:            vals.image || '',
        firearmType:             vals.type,
        firearmSubtype:          vals.subtype,
        firearmBrand:            vals.brand,
        firearmModel:            vals.model,
        firearmCaliber:          vals.caliber,
        firearmBarrel:           vals.barrel,
        firearmDetails:          det,
        firearmPersonalizedName: document.getElementById('ad-personalized-name').value.trim(),
        city:                    document.getElementById('ad-city').value.trim(),
        price:                   document.getElementById('ad-price').value.trim(),
        currency:                localStorage.getItem('currency') || 'EUR',
        description:             document.getElementById('ad-description').value.trim(),
        images:                  uploadedImages,
        firearmStatus:           selectedGunStatus,
        firearmHandedness:       selectedHandedness,
        firearmAvailability:     selectedAvailability,
        firearmPurchaseDate:     document.getElementById('ad-purchase-date').value,
        sellerName:              getDisplayName(),
        sellerEmail:             CUSTOMER_EMAIL,
        sellerPhone:             document.getElementById('ad-seller-phone').value.trim(),
        themeId:                 THEME_ID
      };

      try {
        var response = await fetch(BACKEND_URL + '/my-adverts', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify(payload)
        });

        var data = await response.json();
        clearInterval(loaderInterval);

        if (data.success) {
          // Hide loader and close popup
          loaderEl.style.display = 'none';
          popupEl.style.overflow = '';
          closeAll();

          // Show success toast
          var toast = document.createElement('div');
          toast.style.cssText = [
            'position:fixed',
            'bottom:24px',
            'left:50%',
            'transform:translateX(-50%)',
            'background:#295A31',
            'color:#fff',
            'padding:14px 24px',
            'border-radius:10px',
            'font-size:.95rem',
            'z-index:99999'
          ].join(';');
          toast.textContent = '{{ "custom.ad_submitted_success" | t }}';
          document.body.appendChild(toast);

          var newAdId  = data.id || (data.data && data.data.id) || (data.ad && data.ad.id) || null;
          var newAdImg = (payload.images && payload.images[0]) || payload.productImage || '';

          if (window.GunloupeMyAds && window.GunloupeMyAds.showNewAd) {
            // Already on the My Ads page (opened via #sell-firearm-btn) — show
            // the new ad right where we are instead of navigating to the exact
            // page we're already on, which otherwise reads as a full-page reload.
            window.GunloupeMyAds.showNewAd(newAdId, newAdImg);
            setTimeout(function () { toast.remove(); }, 2500);
          } else {
            // Opened from elsewhere (product page, My Gun Safe, Classifieds, etc.)
            // — hand off to My Ads via sessionStorage: it shows this ad as a
            // skeleton immediately and polls for the confirmed entry, instead
            // of us guessing a fixed delay is long enough here before redirecting.
            try {
              if (newAdId) {
                sessionStorage.setItem('gl_pending_new_ad', JSON.stringify({
                  id: newAdId,
                  image: newAdImg,
                  ts: Date.now()
                }));
              }
            } catch (e) {}

            // Redirect straight away. My Ads shows this ad as a skeleton the
            // moment it loads (see gl_pending_new_ad above), so the seller
            // gets their confirmation there — the 2.5s pause this replaces
            // was waiting the seller could see no reason for.
            toast.remove();
            window.location.href =
              (window.GunloupeRoutes || {}).myAdverts ||
              '{{ pages["anuncios"].url }}';
          }

        } else {
          errorEl.textContent   = '{{ "custom.ad_create_failed" | t }}';
          errorEl.style.display = 'block';
        }

      } catch (err) {
        errorEl.textContent   = '{{ "custom.error_generic" | t }}';
        errorEl.style.display = 'block';
      }

      // ── Always restore button state ────────────────────────────────────────
      clearInterval(loaderInterval);
      loaderEl.style.display  = 'none';
      popupEl.style.overflow  = '';
      submitBtn.disabled      = false;
      submitTxt.style.display = 'inline';
    });

    // ────────────────────────────────────────────────────────────────────────
    // Sell button handling
    // ────────────────────────────────────────────────────────────────────────
    async function handleSellClick(btn) {
      var sd = {
        handle:       btn.dataset.sellHandle       || '',
        type:         btn.dataset.sellType         || '',
        subtype:      btn.dataset.sellSubtype      || '',
        brand:        btn.dataset.sellBrand        || '',
        model:        btn.dataset.sellModel        || '',
        caliber:      btn.dataset.sellCaliber      || '',
        barrel:       btn.dataset.sellBarrel       || '',
        image:        btn.dataset.sellImage        || '',
        status:       btn.dataset.sellStatus       || '',
        purchaseDate: btn.dataset.sellPurchaseDate || '',
        source:       btn.dataset.sellSource       || ''
      };

      if (!sd.handle || !sd.brand || !sd.model) {
        currentSellData = {};
        resetSelectionState();
        showSelectionMode();
        addAdOverlay.style.display = 'flex';
        return;
      }

      var ot = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span>{{ "custom.checking" | t }}...</span>';

      try {
        if (sd.source === 'my-armorer' || SKIP_ARMORER_CHECK) {
          currentSellData = sd;
          prefillForm(sd);
          showPrefillMode();
          addAdOverlay.style.display = 'flex';
        } else {
          var r = await fetch(BACKEND_URL + '/my-adverts/check-armorer', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ customerId: CUSTOMER_ID, productHandle: sd.handle, caliber: sd.caliber || '', barrel: sd.barrel || '' })
          });
          var d = await r.json();
          if (d.inArmorer) {
            currentSellData = sd;
            prefillForm(sd);
            showPrefillMode();
            addAdOverlay.style.display = 'flex';
          } else {
            if (notInArmorerOverlay) notInArmorerOverlay.style.display = 'flex';
          }
        }
      } catch (e) {
        currentSellData = sd;
        prefillForm(sd);
        showPrefillMode();
        addAdOverlay.style.display = 'flex';
      }

      btn.disabled = false;
      btn.innerHTML = ot;
    }

    function bindSellButtons() {
      document.querySelectorAll('.open-ad-popup').forEach(function (btn) {
        if (btn.dataset.adPopupBound) return;
        btn.dataset.adPopupBound = '1';
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          handleSellClick(this);
        }, true);
      });
    }

    window.GunloupeAdPopup = {
      bindButtons: bindSellButtons,
      openWithPrefill: function (sd) {
        resetForm();
        currentSellData = sd;
        prefillForm(sd);
        showPrefillMode();
        addAdOverlay.style.display = 'flex';
      },
      openSelection: function () {
        resetForm();
        resetSelectionState();
        showSelectionMode();
        addAdOverlay.style.display = 'flex';
      }
    };

    bindSellButtons();

    // gunloupe-datepicker.js loads deferred at the end of <body>, so it may
    // not exist yet at this point (this script runs inline during parsing).
    // DOMContentLoaded always fires after every deferred script has run.
    document.addEventListener('DOMContentLoaded', function () {
      var purchaseDateInput = document.getElementById('ad-purchase-date');
      if (purchaseDateInput && window.GunloupeDatePicker) {
        window.GunloupeDatePicker.attach(purchaseDateInput, {
          maxDate: 'today',
          labels: {
            set: {{ 'custom.date_picker_set' | t | json }},
            cancel: {{ 'custom.date_picker_cancel' | t | json }},
            clear: {{ 'custom.date_picker_clear' | t | json }}
          }
        });
      }
    });
  })();
</script>

{% endif %}

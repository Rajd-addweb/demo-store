    // ────────────────────────────────────────────────────────────────────────
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('#ad-selection-section .filter-toggle');
      if (!btn) {
        if (!e.target.closest('#ad-selection-section .add-firearm-custom-dropdown.open')) {
          document.querySelectorAll('#ad-selection-section .add-firearm-custom-dropdown.open').forEach(function (d) { adCloseDropdown(d); });
        }
        return;
      }

      var dd = btn.closest('.add-firearm-custom-dropdown');
      if (!dd) return;

      // Block if locked or disabled
      if (dd.classList.contains('disabled') || dd.classList.contains('ad-calibre-locked')) return;

      var wasOpen = dd.classList.contains('open');
      document.querySelectorAll('#ad-selection-section .add-firearm-custom-dropdown.open').forEach(function (d) { if (d !== dd) adCloseDropdown(d); });

      if (!wasOpen) {
        adOpenDropdown(dd);
        var filter = dd.dataset.filter;
        if (filter === 'ad-marca') loadBrands();
        if (filter === 'ad-calibre' && (!_activeCaliberFilter || !_activeCaliberFilter.length)) loadCalibers();
        if (filter === 'ad-barrel' && !_barrelsCache) loadBarrelLengths();
        if (filter === 'ad-modelo' && adBrandIsCatalogue && !adAllProducts.length && !adIsFetching) { adShowModelSkeleton(); adFetchProducts(); }
      } else {
        adCloseDropdown(dd);
      }
    });


<div id="userPopup" class="popup small hidden">
  <div class="popup-box">
    <div>
      {% render 'icon-accountcircle' %}
      <a class="color-primary" href="{{ pages['perfil'].url | default: '/pages/perfil' }}">{{ 'custom.profile' | t }}</a>
    </div>
    <div>
      {% render 'icon-logout' %}
      <a class="color-primary" href="{{ routes.account_logout_url }}">{{ 'custom.end_session' | t }}</a>
    </div>
  </div>
</div>

